#!/bin/bash

# loaded by "${HOME}"/.local/bin/bash-functions

# adb-vendor-ids ───────────────────────────────────────────────────────────────

adb_vendor_ids () {

	local directory_settings="${HOME}/.android"
	local file_ids="${directory_settings}/adb_usb.ini"
	local file_rules="/etc/udev/rules.d/51-android.rules"
	local name_package_udev="udev"
	local format_id='0x%04x\n'
	local format_rule='SUBSYSTEM=="usb", SYSFS{idVendor}=="%s", MODE="0666" ;\n'
	local mode_settings="777"
	local count_id_maximum="65535"
	local offset_prefix="2"
	local status_package_udev
	local number_id
	local id_vendor
	local text_ids

	adb_download

	adb_set_environment

	mkdir --parents "${directory_settings}"

	for (( number_id = 0 ; number_id <= count_id_maximum ; number_id ++ ))
	do
		printf "${format_id}" "${number_id}"
	done >> "${file_ids}"

	chmod --recursive "${mode_settings}" "${directory_settings}"

	# udev package listing - empty if not installed

	status_package_udev="$(dpkg -l "${name_package_udev}")"

	if [ -n "${status_package_udev}" ]
	then
		# ids read back from the file

		text_ids="$(< "${file_ids}")"

		while read -r id_vendor
		do
			printf "${format_rule}" "${id_vendor:offset_prefix}"

		done <<< "${text_ids}" >> "${file_rules}"
	fi
}
