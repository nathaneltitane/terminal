	local count_memory_used
	local tenths_used
	local tenths_total
	local text_used
	local text_total
	local epoch_now
	local seconds_elapsed
	local text_elapsed
	local label
	local index_label
	local text_value
	local path_ps="/api/ps"
	local url_ps="${protocol_server}://${address_server}${path_ps}"
	local separator_entry='{"name":"'
	local pattern_size='"size":([0-9]+)'
	local pattern_vram='"size_vram":([0-9]+)'
	local name_unit="${name_service}"
	local pattern_tokens='llama_kv_cache: size =|task\.n_tokens = |stop processing: n_tokens = '
	local pattern_cache='llama_kv_cache: (size =|.*KV buffer size)'
	local pattern_cache_size='size = ([0-9]+)[.0-9]* MiB \( *([0-9]+) cells'
	local pattern_cache_buffer='^llama_kv_cache: +([^ ]+) KV buffer size = +([0-9]+)'
