	local list_segment_limits=()
	local list_segment_glyphs=("${glyph_memory}" "${glyph_card}" "${glyph_cache_filled}" "${glyph_cache_reserved}" "${glyph_rest}")
	local list_segment_colors=("${color_memory}" "${color_card}" "${color_cache_filled}" "${color_cache_reserved}" "${color_rest}")

	local list_models=()
