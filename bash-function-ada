	local list_values=()

	local list_labels=(
		"${label_model}"
		"${label_context}"
		"${label_memory}"
		"${label_processor}"
		"${label_system}"
		"${label_server}"
		"${label_session}"
	)

	# model memory and context

	state_loaded="false"

	text_models="$("${path_command}" ps 2> "${sink}")"

	status_models="${?}"

	mapfile -t list_models <<< "${text_models}"

	if [ "${status_models}" -ne 0 ]
	then
		text_memory="${label_server_down}"
		list_models=()
	fi

	for line_model in "${list_models[@]:index_row_first}"
	do
		read -r name_loaded text_identifier count_size unit_size text_shares text_processors count_context text_rest <<< "${line_model}"

		if [ "${name_loaded}" = "${name_model}" ] || [ "${name_loaded}" = "${name_model}${suffix_latest}" ]
		then
			state_loaded="true"

			if [ "${text_processors}" = "${name_shared}" ]
			then
				share_processor="${text_shares%%/*}"
				share_graphics="${text_shares##*/}"

			elif [ "${text_processors}" = "${name_graphics}" ]
			then
				share_processor="${share_none}"
				share_graphics="${text_shares}"
			else
				share_processor="${text_shares}"
				share_graphics="${share_none}"
			fi

			text_memory="${label_loaded}${separator_values}${count_size} ${unit_size}${separator_values}${share_processor} ${name_processor}${separator_values}${share_graphics} ${name_graphics}"
			text_context="${count_context} ${label_tokens}${separator_values}"

			# ollama ps only when no setting says

			if [ -z "${text_retention}" ] && [ "${text_rest}" = "${text_forever}" ]
			then
				text_until="${label_forever}"

			elif [ -z "${text_retention}" ]
			then
				text_until="${label_unloads} ${text_rest%"${suffix_until}"}"
			fi
		fi
	done

	if [ -z "${text_until}" ]
	then
		text_until="${label_default}"
	fi

	# processor load since last update

	read -r name_stat count_user count_nice count_system count_idle count_wait count_interrupt count_interrupt_soft count_steal text_rest < "${file_processor_stat}"

	stat_total=$(( count_user + count_nice + count_system + count_idle + count_wait + count_interrupt + count_interrupt_soft + count_steal ))
	stat_idle=$(( count_idle + count_wait ))

	if [ -n "${stat_total_last}" ]
	then
		delta_total=$(( stat_total - stat_total_last ))
		delta_idle=$(( stat_idle - stat_idle_last ))

		if [ "${delta_total}" -gt 0 ]
		then
			share_load=$(( ( delta_total - delta_idle ) * factor_percent / delta_total ))
		fi
	fi

	stat_total_last="${stat_total}"
	stat_idle_last="${stat_idle}"

	text_processor="${share_load}${unit_share} ${label_load}"

	if [ -n "${file_temperature_cpu}" ] && [ -r "${file_temperature_cpu}" ]
	then
		read -r count_degrees < "${file_temperature_cpu}"

		text_processor="${text_processor}${separator_values}$(( count_degrees / divisor_degrees ))${unit_temperature}"
	fi

	# system memory

	mapfile -t list_memory < "${file_memory}"

	for line_memory in "${list_memory[@]}"
	do
		read -r key_memory value_memory text_rest <<< "${line_memory}"

		if [ "${key_memory}" = "${key_memory_total}" ]
		then
			count_memory_total="${value_memory}"

		elif [ "${key_memory}" = "${key_memory_available}" ]
		then
			count_memory_available="${value_memory}"
		fi
	done

	count_memory_used=$(( count_memory_total - count_memory_available ))
	tenths_used=$(( count_memory_used * factor_tenths / divisor_memory ))
	tenths_total=$(( count_memory_total * factor_tenths / divisor_memory ))

	printf -v text_used "${format_tenths}" "$(( tenths_used / factor_tenths ))" "$(( tenths_used % factor_tenths ))"
	printf -v text_total "${format_tenths}" "$(( tenths_total / factor_tenths ))" "$(( tenths_total % factor_tenths ))"

	# memory bar - the model's share of system memory plus the card's own memory

	if [ -n "${file_card_total}" ] && [ -r "${file_card_total}" ]
	then
		read -r count_card_total < "${file_card_total}"
	fi

	count_bytes_total=$(( count_memory_total * factor_kibibyte + count_card_total ))

	if [ "${state_loaded}" = "true" ]
	then
		text_ps="$(curl --silent --max-time 1 "${url_ps}" 2> "${sink}")"

		mapfile -t list_ps <<< "${text_ps//"${separator_entry}"/$'\n'}"

		for entry_ps in "${list_ps[@]:index_row_first}"
		do
			name_entry="${entry_ps%%\"*}"

			if [ "${name_entry}" = "${name_model}" ] || [ "${name_entry}" = "${name_model}${suffix_latest}" ]
			then
				if [[ "${entry_ps}" =~ ${pattern_size} ]]
				then
					count_model_size="${BASH_REMATCH[1]}"
				fi

				if [[ "${entry_ps}" =~ ${pattern_vram} ]]
				then
					count_model_vram="${BASH_REMATCH[1]}"
				fi
			fi
		done
	fi

	# cache size and its card share - read again only when the model loads anew, newest log line first

	key_load="${count_model_size} ${count_model_vram}"

	if [ "${count_model_size}" -gt 0 ] && [ "${key_load}" != "${key_load_last}" ]
	then
		key_load_last="${key_load}"
		count_cache_bytes="0"
		count_cache_card="0"
		count_cache_cells="0"
		state_cache_size="false"

		mapfile -t list_cache < <(journalctl --quiet --unit "${name_unit}" --output cat --no-pager --reverse --lines "${count_lines_cache}" --grep "${pattern_cache}" 2> "${sink}")

		for line_cache in "${list_cache[@]}"
		do
			if [[ "${line_cache}" =~ ${pattern_cache_size} ]]
			then
				# the next size line belongs to an older load

				if [ "${state_cache_size}" = "true" ]
				then
					break
				fi

				state_cache_size="true"
				count_cache_bytes=$(( BASH_REMATCH[1] * factor_mebibyte ))
				count_cache_cells="${BASH_REMATCH[2]}"

			elif [ "${state_cache_size}" = "true" ] && [[ "${line_cache}" =~ ${pattern_cache_buffer} ]] && [ "${BASH_REMATCH[1]}" != "${name_buffer_processor}" ]
			then
				count_cache_card=$(( count_cache_card + BASH_REMATCH[2] * factor_mebibyte ))
			fi
		done

		# a cache larger than the model is from another one

		if [ "${count_cache_bytes}" -gt "${count_model_size}" ]
		then
			count_cache_bytes="0"
			count_cache_card="0"
		fi
	fi

	# tokens in the cache - none since the latest load

	if [ "${count_model_size}" -gt 0 ] && [ "${count_cache_cells}" -gt 0 ]
	then
		line_log="$(journalctl --quiet --unit "${name_unit}" --output cat --no-pager --reverse --lines 1 --grep "${pattern_tokens}" 2> "${sink}")"

		if [[ "${line_log}" != *"llama_kv_cache"* ]] && [[ "${line_log}" =~ ${pattern_count_tokens} ]]
		then
			count_tokens="${BASH_REMATCH[1]}"
		fi

		if [ "${count_tokens}" -gt "${count_cache_cells}" ]
		then
			count_tokens="${count_cache_cells}"
		fi
	fi

	if [ "${count_model_size}" -eq 0 ]
	then
		count_cache_bytes="0"
		count_cache_card="0"
	fi

	count_weights_card=$(( count_model_vram - count_cache_card ))

	if [ "${count_weights_card}" -lt 0 ]
	then
		count_weights_card="0"
	fi

	count_weights_memory=$(( count_model_size - count_cache_bytes - count_weights_card ))

	if [ "${count_weights_memory}" -lt 0 ]
	then
		count_weights_memory="0"
	fi

	count_cache_filled="0"

	if [ "${count_cache_cells}" -gt 0 ]
	then
		count_cache_filled=$(( count_cache_bytes * count_tokens / count_cache_cells ))
	fi

	count_cache_reserved=$(( count_cache_bytes - count_cache_filled ))

	list_segment_sizes=("${count_weights_memory}" "${count_weights_card}" "${count_cache_filled}" "${count_cache_reserved}")

	# cell where each part ends, rounded to the nearest cell

	count_cells=$(( count_bar_columns * count_bar_rows ))
	count_sum="0"
	list_segment_limits=()

	for segment_size in "${list_segment_sizes[@]}"
	do
		count_sum=$(( count_sum + segment_size ))

		if [ "${count_bytes_total}" -gt 0 ]
		then
			list_segment_limits+=("$(( ( count_sum * count_cells + count_bytes_total / 2 ) / count_bytes_total ))")
		else
			list_segment_limits+=("0")
		fi
	done

	list_segment_limits+=("${count_cells}")

	# rows from the bottom up, each row left to right

	list_bar=()

	for (( index_bar_row = 0 ; index_bar_row < count_bar_rows ; index_bar_row ++ ))
	do
		line_bar=""
		index_segment_last=""

		for (( index_bar_column = 0 ; index_bar_column < count_bar_columns ; index_bar_column ++ ))
		do
			index_cell=$(( ( count_bar_rows - 1 - index_bar_row ) * count_bar_columns + index_bar_column ))
			index_segment="0"

			while [ "${index_cell}" -ge "${list_segment_limits[index_segment]}" ]
			do
				(( index_segment ++ ))
			done

			if [ "${index_segment}" != "${index_segment_last}" ]
			then
				line_bar="${line_bar}${list_segment_colors[index_segment]}"
				index_segment_last="${index_segment}"
			fi

			line_bar="${line_bar}${list_segment_glyphs[index_segment]}"
		done

		list_bar+=("${line_bar}${reset}")
	done

	# session time

	printf -v epoch_now '%(%s)T' -1

	seconds_elapsed=$(( epoch_now - epoch_start ))

	printf -v text_elapsed "${format_elapsed}" \
		"$(( seconds_elapsed / seconds_hour ))" \
		"$(( seconds_elapsed % seconds_hour / seconds_minute ))" \
		"$(( seconds_elapsed % seconds_minute ))"

	list_values=(
		"${text_architecture}${separator_values}${text_parameters}${separator_values}${text_quantization}"
		"${text_context}${count_threads_model} ${label_threads}"
		"${text_memory}"
		"${text_processor}"
		"${text_used}${separator_memory}${text_total} ${unit_memory} ${label_memory_used}"
		"${name_command} ${text_version}${separator_values}${address_server}"
		"${text_until}${separator_values}${time_start}${separator_values}${text_elapsed}"
	)

	# labels in one column

	for label in "${list_labels[@]}"
	do
		if [ "${#label}" -gt "${width_label}" ]
		then
			width_label="${#label}"
		fi
	done

	width_label=$(( width_label + padding_label ))

	# values right aligned to the widest so far

	for text_value in "${list_values[@]}"
	do
		if [ "${#text_value}" -gt "${width_value_widest}" ]
		then
			width_value_widest="${#text_value}"
		fi
	done

	list_panel=()

	for index_label in "${!list_labels[@]}"
	do
		# padding by characters - printf counts bytes

		text_value="${list_values[index_label]}"

		printf -v line_model "${format_label}" "${width_label}" "${list_labels[index_label]}" "$(( width_value_widest - ${#text_value} ))" "" "${text_value}"

		list_panel+=("${line_model}")
	done

}

ada_panel_draw () {

	# use to draw the critter and panel

	local width_critter="15"
	local width_gap_critter="1"
	local padding_shrink="   "
	local marker_cut="${marker_elp:-...}"
	local width_cut
	local padding_shrunk="  "
	local count_shrink
	local width_frame_inner="3"
	local frame_top_left="⎡"
	local frame_top_right="⎤"
	local frame_middle_left="⎢"
	local frame_middle_right="⎥"
	local frame_bottom_left="⎣"
	local frame_bottom_right="⎦"
	local count_columns="${size_last##* }"
	local column_frame_minimum=$(( width_critter + width_gap_critter + 1 ))
	local index_last=$(( height_panel - 1 ))
	local column_frame
	local column_text
	local width_text
	local index_line
	local row_current
	local frame_left
	local frame_right
	local line_panel
	local text_part
	local text_output
	local count_ticks_view="40"
	local count_views="2"
	local width_gap_sheet="1"
	local padding_command="2"
	local width_command="0"
	local width_description="0"
	local width_sheet
	local column_sheet
	local column_sheet_text
	local column_sheet_right
	local index_view
	local text_command
	local text_description
	local line_sheet
	local width_bar_frames="4"
	local width_bar_block="0"
	local width_gap_bar="1"
	local column_bar
	local column_bar_text
	local column_right="${count_columns}"
	local state_bar="false"

	local list_critter=()
	local list_sheet=()
	local list_commands_first=()
	local list_commands_second=()
	local list_descriptions_first=()
	local list_descriptions_second=()
	local list_commands_view=()
	local list_descriptions_view=()

	# cheatsheet - each row alternates between its own two commands, descriptions right aligned

	if [ "${mode_run}" = "${mode_code}" ]
	then
		list_commands_first=("/help" "/cd" "/stats" "/reset" "/save" "/model" "/exit")
		list_descriptions_first=("all commands" "switch directory" "statistics" "fresh session" "save session" "show or set model" "exit session")
		list_commands_second=("/help" "/cd" "/context" "/resume" "/sessions" "/config" "/exit")
		list_descriptions_second=("all commands" "switch directory" "context occupancy" "resume session" "list sessions" "configuration" "exit session")
	else
		list_commands_first=("/help" "/show info" "/set parameter" "/set think" "/clear" "/save" "/bye")
		list_descriptions_first=("all commands" "model details" "set a parameter" "enable thinking" "clear context" "save session" "exit session")
		list_commands_second=("/help" "/set verbose" "/set system" '"""' "/clear" "/load" "/bye")
		list_descriptions_second=("all commands" "show statistics" "system message" "multiline input" "clear context" "load session" "exit session")
	fi

	# fixed width across both views

	for text_command in "${list_commands_first[@]}" "${list_commands_second[@]}"
	do
		if [ "${#text_command}" -gt "${width_command}" ]
		then
			width_command="${#text_command}"
		fi
	done

	for text_description in "${list_descriptions_first[@]}" "${list_descriptions_second[@]}"
	do
		if [ "${#text_description}" -gt "${width_description}" ]
		then
			width_description="${#text_description}"
		fi
	done

	width_command=$(( width_command + padding_command ))
	width_sheet=$(( width_command + width_description ))
	index_view=$(( count_ticks / count_ticks_view % count_views ))

	if [ "${index_view}" -eq 0 ]
	then
		list_commands_view=("${list_commands_first[@]}")
		list_descriptions_view=("${list_descriptions_first[@]}")
	else
		list_commands_view=("${list_commands_second[@]}")
		list_descriptions_view=("${list_descriptions_second[@]}")
	fi

	for index_line in "${!list_commands_view[@]}"
	do
		printf -v line_sheet "%-*s%*s" "${width_command}" "${list_commands_view[index_line]}" "${width_description}" "${list_descriptions_view[index_line]}"

		list_sheet+=("${line_sheet}")
	done

	local list_mouth=(
		' ██████████████'
		' ██████▀▀██████'
		' ██████  ██████'
	)

	local -A list_antenna=(
		[up]='  ▀█▄      ▄█▀'
		[wiggle]='  ▄█▀      ▀█▄'
	)

	local -A list_eyes=(
		[open]=' ███ ██████ ███'
		[shut]=' ███▄██████▄███'
	)

	local -A list_legs=(
		[stand]='   █ █    █ █'
		[left]='  █ █    █ █'
		[right]='    █ █    █ █'
	)

	list_critter=(
		"${list_antenna[${state_antenna}]}"
		'   ▄▄▄▄▄▄▄▄▄▄'
		' ▄████████████▄'
		"${list_eyes[${state_eyes}]}"
		"${list_mouth[index_mouth]}"
		' ██████████████'
		"${list_legs[${state_legs}]}"
	)

	# right aligned, as wide as the widest line so far

	for line_panel in "${list_panel[@]}"
	do
		if [ "${#line_panel}" -gt "${width_panel_widest}" ]
		then
			width_panel_widest="${#line_panel}"
		fi
	done

	# memory bar at the right edge, dropped before the panel shrinks

	if [ "${#list_bar[@]}" -gt 0 ]
	then
		width_bar_block=$(( count_bar_columns + width_bar_frames ))
	fi

	column_bar=$(( count_columns - width_bar_block + 1 ))
	column_bar_text=$(( column_bar + 2 ))

	if [ "${width_bar_block}" -gt 0 ] && [ $(( column_bar - width_gap_bar - 1 - width_panel_widest - width_frame_inner )) -ge "${column_frame_minimum}" ]
	then
		state_bar="true"
		column_right=$(( column_bar - width_gap_bar - 1 ))
	fi

	column_frame=$(( column_right - width_panel_widest - width_frame_inner ))

	if [ "${column_frame}" -lt "${column_frame_minimum}" ]
	then
		column_frame="${column_frame_minimum}"
	fi

	column_text=$(( column_frame + 2 ))
	width_text=$(( column_right - column_frame - width_frame_inner ))

	# cheatsheet left of the panel, only when both fit

	column_sheet_right=$(( column_frame - width_gap_sheet - 1 ))
	column_sheet=$(( column_sheet_right - width_sheet - width_frame_inner ))
	column_sheet_text=$(( column_sheet + 2 ))

	printf -v text_output "${sequence_cursor_save}"

	for (( index_line = 0 ; index_line <= index_last ; index_line ++ ))
	do
		row_current=$(( row_panel + index_line ))

		printf -v text_part "${format_cursor_position}${sequence_line_clear}%s%s%s" \
			"${row_current}" "${column_first}" "${lavender}" "${list_critter[index_line]}" "${reset}"

		text_output="${text_output}${text_part}"

		if [ "${width_text}" -lt 1 ]
		then
			continue
		fi

		# bracket piece for the row

		frame_left="${frame_middle_left}"
		frame_right="${frame_middle_right}"

		if [ "${index_line}" -eq 0 ]
		then
			frame_left="${frame_top_left}"
			frame_right="${frame_top_right}"

		elif [ "${index_line}" -eq "${index_last}" ]
		then
			frame_left="${frame_bottom_left}"
			frame_right="${frame_bottom_right}"
		fi

		line_panel="${list_panel[index_line]}"

		# narrow terminal - padding before the value goes first

		count_shrink=$(( ${#line_panel} - width_text ))

		while [ "${count_shrink}" -gt 0 ] && [[ "${line_panel}" == *"${padding_shrink}"* ]]
		do
			line_panel="${line_panel/"${padding_shrink}"/${padding_shrunk}}"

			(( count_shrink -- ))
		done

		# still too wide - cut the value and mark the cut

		width_cut=$(( width_text - ${#marker_cut} ))

		if [ "${#line_panel}" -gt "${width_text}" ] && [ "${width_cut}" -gt 0 ]
		then
			line_panel="${line_panel:0:width_cut}"
			line_panel="${line_panel% }${marker_cut}"
		fi

		if [ "${column_sheet}" -ge "${column_frame_minimum}" ]
		then
			printf -v text_part "${format_cursor_position}%s%s%s${format_cursor_position}%s${format_cursor_position}%s%s%s" \
				"${row_current}" "${column_sheet}" "${lavender}" "${frame_left}" "${reset}" \
				"${row_current}" "${column_sheet_text}" "${list_sheet[index_line]}" \
				"${row_current}" "${column_sheet_right}" "${lavender}" "${frame_right}" "${reset}"

			text_output="${text_output}${text_part}"
		fi

		printf -v text_part "${format_cursor_position}%s%s%s${format_cursor_position}%s${format_cursor_position}%s%s%s" \
			"${row_current}" "${column_frame}" "${lavender}" "${frame_left}" "${reset}" \
			"${row_current}" "${column_text}" "${line_panel:0:width_text}" \
			"${row_current}" "${column_right}" "${lavender}" "${frame_right}" "${reset}"

		text_output="${text_output}${text_part}"

		if [ "${state_bar}" = "true" ]
		then
			printf -v text_part "${format_cursor_position}%s%s%s${format_cursor_position}%s${format_cursor_position}%s%s%s" \
				"${row_current}" "${column_bar}" "${lavender}" "${frame_left}" "${reset}" \
				"${row_current}" "${column_bar_text}" "${list_bar[index_line]}" \
				"${row_current}" "${count_columns}" "${lavender}" "${frame_right}" "${reset}"

			text_output="${text_output}${text_part}"
		fi
	done

	printf -v text_part "${sequence_cursor_restore}"

	printf '%s' "${text_output}${text_part}"

}

# server time ──────────────────────────────────────────────────────────────────

ada_server_time () {

	# use to sum server processor time

	local directory_processes="/proc"
	local name_file_stat="stat"
	local name_file_children="children"
	local name_directory_tasks="task"
	local index_time_user="11"
	local index_time_system="12"
	local pid_server="${1}"
	local pid_process
	local file_children
	local file_stat
	local text_stat
	local count_time="0"

	local list_fields=()
	local list_processes=("${pid_server}")

	# runners of every server thread

	for file_children in "${directory_processes}/${pid_server}/${name_directory_tasks}"/*/"${name_file_children}"
	do
		read -r -a list_fields < "${file_children}" 2> "${sink}"

		list_processes+=("${list_fields[@]}")
	done

	for pid_process in "${list_processes[@]}"
	do
		file_stat="${directory_processes}/${pid_process}/${name_file_stat}"

		if [ -r "${file_stat}" ]
		then
			read -r text_stat < "${file_stat}"

			# user and system time

			read -r -a list_fields <<< "${text_stat##*) }"

			count_time=$(( count_time + list_fields[index_time_user] + list_fields[index_time_system] ))
		fi
	done

	echo "${count_time}"

}

