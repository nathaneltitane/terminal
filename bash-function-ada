#!/bin/bash

# loaded by "${HOME}"/.local/bin/bash-functions

# ada ──────────────────────────────────────────────────────────────────────────

ada () {

	local path_command
	local name_command
	local name_model
	local name_assistant
	local name_integration
	local mode_run
	local state_think
	local count_threads
	local count_threads_maximum
	local directory_models
	local file_settings
	local text_details
	local text_stats
	local count_rows
	local text_line_details
	local count_threads_model
	local text_rest

	local list_think=()

	# set before the help text - it is named there

	name_command="ollama"
	name_assistant="ada"
	name_integration="qwen"
	mode_run="chat"
	state_think="false"

	while (( $# ))
	do
		case "${1}" in

			-c|--code)
				mode_run="code"
			;;

			-t|--think)
				state_think="true"
			;;

			-r|--threads)
				count_threads="${2}"

				shift
			;;

			-h|--help)
				cat <<- HELP

				Usage: ada [option] [-r threads] [model]

				Chat with a local ${name_command} model: the ${name_assistant} model, else the one
				already in memory, else the newest installed one, or the model named.

				Options:

				-c, --code          Open the [c]oding assistant in this folder.

				-t, --think         Let the model [t]hink before it answers.

				-r, --threads       Set the ${name_assistant} model's processor th[r]eads and keep
				                    the setting in its settings file.

				-h, --help          Show this [h]elp message.

				HELP

				return 0
			;;

			*)
				name_model="${1}"
			;;

		esac

		shift
	done

	# ${name_command} command path - empty if not installed

	path_command="$(command -v "${name_command}")"

	if [ -z "${path_command}" ]
	then
		frobulator.err "Command not found" "[ ${name_command} ]"

		return 1
	fi

	# thread count - written to the assistant settings file, model rebuilt and unloaded so the next load uses it

	if [ -n "${count_threads}" ]
	then
		count_threads_maximum="$(nproc)"

		if [[ ! "${count_threads}" =~ ^[0-9]+$ ]] || [ "${count_threads}" -lt 1 ] || [ "${count_threads}" -gt "${count_threads_maximum}" ]
		then
			frobulator.err "Thread count must be 1 to ${count_threads_maximum}" "[ ${count_threads} ]"

			return 1
		fi

		# settings file kept with the models - folder read from the service

		directory_models="$(systemctl show "${name_command}" --property=Environment --value 2> "${sink}" | tr ' ' '\n' | grep '^OLLAMA_MODELS=' | cut -d '=' -f 2)"
		file_settings="${directory_models}/modelfile-${name_assistant}"

		if [ -z "${directory_models}" ] || [ ! -f "${file_settings}" ]
		then
			frobulator.err "Settings file not found" "[ ${file_settings} ]"

			return 1
		fi

		if grep -q '^PARAMETER num_thread ' "${file_settings}"
		then
			sed -i "s|^PARAMETER num_thread .*|PARAMETER num_thread ${count_threads}|" "${file_settings}"
		else
			echo "PARAMETER num_thread ${count_threads}" >> "${file_settings}"
		fi

		if ! "${path_command}" create "${name_assistant}" -f "${file_settings}" > "${sink}" 2>&1
		then
			frobulator.err "Unable to update model" "[ ${name_assistant} ]"

			return 1
		fi

		"${path_command}" stop "${name_assistant}" > "${sink}" 2>&1

		frobulator.scs "Processor threads set" "[ ${name_assistant} // ${count_threads} ]"
	fi

	# assistant model first - model in memory next - newest installed one last

	if [ -z "${name_model}" ] && "${path_command}" show "${name_assistant}" > "${sink}" 2>&1
	then
		name_model="${name_assistant}"
	fi

	if [ -z "${name_model}" ]
	then
		read -r name_model text_rest < <("${path_command}" ps 2> "${sink}" | tail -n +2)
	fi

	if [ -z "${name_model}" ]
	then
		read -r name_model text_rest < <("${path_command}" list 2> "${sink}" | tail -n +2)
	fi

	if [ -z "${name_model}" ]
	then
		frobulator.err "No model installed" "[ ${name_command} download <model> ]"

		return 1
	fi

	if [ "${mode_run}" = "code" ]
	then
		frobulator.inf "Opening coding assistant" "[ ${name_integration} // ${name_model} ]"

		"${path_command}" launch "${name_integration}" --model "${name_model}"

		return
	fi

	# thinking switch only for models that think

	text_details="$("${path_command}" show "${name_model}" 2> "${sink}")"

	if [[ "${text_details}" == *thinking* ]]
	then
		list_think=("--think=${state_think}")
	fi

	# load first - memory split only known once loaded

	frobulator.inf "Loading model" "[ ${name_model} ]"

	curl -s "http://${OLLAMA_HOST:-127.0.0.1:11434}/api/generate" -d "{\"model\":\"${name_model}\"}" > "${sink}" 2>&1

	# size, processor split and context from the loaded list - threads from the model settings

	text_stats="$("${path_command}" ps 2> "${sink}" | awk -v name="${name_model}" '$1 == name || $1 == name ":latest" { print $3 " " $4 " // " $5 " " $6 " // " $7 " context" }')"
	count_threads_model="$(awk '$1 == "num_thread" { print $2 }' <<< "${text_details}")"

	# model line pinned on top - details pinned on the bottom row - chat scrolls between them

	count_rows="$(tput lines)"

	text_line_details="$(frobulator.inf "Model details" "[ ${text_stats:-not loaded} // ${count_threads_model:-default} threads ]")"

	clear

	frobulator.inf "Chatting with model" "[ ${name_model} ]"

	# bottom row written without a newline - a newline there would scroll the screen

	printf '\e[%s;1H%s' "${count_rows}" "${text_line_details}"
	printf '\e[2;%sr\e[2;1H' "$(( count_rows - 1 ))"

	"${path_command}" run "${name_model}" "${list_think[@]}"

	# whole screen scrolls again

	printf '\e[r\e[%s;1H\n' "${count_rows}"

}

# tab completion ───────────────────────────────────────────────────────────────

ada_complete () {

	# line up to the cursor - model names hold colons that split bash words

	local text_line="${COMP_LINE:0:COMP_POINT}"
	local word_current="${text_line##* }"
	local prefix_colon="${word_current%"${word_current##*:}"}"
	local name_model
	local text_rest

	local list_models=()

	local list_options=(
		--code
		--think
		--threads
		--help
	)

	COMPREPLY=()

	if [ "${word_current:0:1}" = "-" ]
	then
		mapfile -t COMPREPLY < <(compgen -W "${list_options[*]}" -- "${word_current}")
	else
		while read -r name_model text_rest
		do
			list_models+=("${name_model}")
		done < <(command ollama list 2> /dev/null | tail -n +2)

		mapfile -t COMPREPLY < <(compgen -W "${list_models[*]}" -- "${word_current}")

		# bash completes only the part after the last colon

		COMPREPLY=("${COMPREPLY[@]#"${prefix_colon}"}")
	fi

}

complete -F ada_complete ada
