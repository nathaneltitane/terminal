	local glyph_rest="░"
	local color_memory="${lavender}"
	local color_card=$'\e[38;5;80m'
	local color_cache_filled=$'\e[38;5;183m'
	local color_cache_reserved=$'\e[38;5;60m'
	local color_rest=$'\e[38;5;237m'
	local text_ps
	local entry_ps
	local name_entry
	local count_model_size="0"
	local count_model_vram="0"
	local count_card_total="0"
	local count_bytes_total
