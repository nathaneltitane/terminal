#!/bin/bash

# loaded by "${HOME}"/.local/bin/bash-functions

# ada ──────────────────────────────────────────────────────────────────────────

ada () {

	# use to chat with a local model

	local path_command
	local name_command
	local name_service
	local name_model
	local name_assistant
	local name_agent
	local option_workspace
	local option_model
	local variable_keep_alive
	local keep_alive_agent_default
	local pattern_keep_alive
	local directory_agent_configuration
	local file_agent_configuration
	local text_agent_configuration
	local text_keep_alive
	local text_retention
	local path_agent
	local name_parameter_threads
	local keyword_parameter
	local variable_models
	local prefix_settings
	local suffix_latest
	local label_thinking
	local label_threads_default
	local option_think
	local pattern_number
	local property_environment
	local property_pid
	local separator_values
	local mode_run
	local mode_chat
	local mode_code
	local state_think
	local state_found
	local status_assistant
	local status_create
	local count_threads
	local count_threads_minimum
	local count_threads_maximum
	local count_threads_model
	local directory_models
	local file_settings
	local file_terminal
	local line_threads
	local entry_environment
	local index_setting
	local index_row_first
	local text_environment
	local text_details
	local text_key
	local text_value
	local text_rest
	local protocol_server
	local address_default
	local address_server
	local path_generate
	local url_generate
	local format_payload
	local payload_load
	local delay_loading
	local pid_status
	local epoch_start
	local time_start
	local format_time_start
	local row_status
	local row_gap
	local row_panel
	local row_gap_panel
	local row_rule
	local row_gap_rule
	local row_chat
	local height_panel
	local column_first
	local format_cursor_position
	local format_scroll_region
	local sequence_scroll_reset
	local sequence_cursor_save
	local sequence_cursor_restore
	local sequence_line_clear

	local list_think=()
	local list_environment=()
	local list_settings=()
	local list_lines=()

	# set before the help text

	name_command="ollama"
	name_service="${name_command}"
	name_assistant="ada"
	name_agent="ada"
	option_workspace="--workspace"
	option_model="--model"
	variable_keep_alive="OLLAMA_KEEP_ALIVE"
	keep_alive_agent_default="-1"
	pattern_keep_alive='"keep_alive"[[:space:]]*:[[:space:]]*"?([^",}[:space:]]+)'
	directory_agent_configuration="${ADA_CONFIG_DIR:-${HOME}/.config/ada}"
	file_agent_configuration="${directory_agent_configuration}/config.json"
	name_parameter_threads="num_thread"
	keyword_parameter="PARAMETER"
	variable_models="OLLAMA_MODELS"
	prefix_settings="modelfile"
	suffix_latest=":latest"
	label_thinking="thinking"
	label_threads_default="default"
	option_think="--think"
	pattern_number="^[0-9]+$"
	property_environment="Environment"
	property_pid="MainPID"
	separator_values=" // "
	mode_chat="chat"
	mode_code="code"
	mode_run="${mode_chat}"
	state_think="false"
	count_threads_minimum="1"
	file_terminal="/dev/tty"
	index_row_first="1"

	# server address

	protocol_server="http"
	address_default="127.0.0.1:11434"
	address_server="${OLLAMA_HOST:-${address_default}}"
	path_generate="/api/generate"
	url_generate="${protocol_server}://${address_server}${path_generate}"
	format_payload='{"model":"%s"}'

	# loading pause in seconds

	delay_loading="1"

	# screen rows

	row_status="1"
	row_gap="2"
	row_panel="3"
	height_panel="7"
	row_gap_rule=$(( row_panel + height_panel ))
	row_rule=$(( row_gap_rule + 1 ))
	row_gap_panel=$(( row_rule + 1 ))
	row_chat=$(( row_gap_panel + 1 ))
	column_first="1"

	# session start

	format_time_start="%H:%M"

	# terminal sequences

	format_cursor_position='\e[%s;%sH'
	format_scroll_region='\e[%s;%sr'
	sequence_scroll_reset='\e[r'
	sequence_cursor_save='\e7'
	sequence_cursor_restore='\e8'
	sequence_line_clear='\e[2K'

	while (( $# ))
	do
		case "${1}" in

			-c|--code)
				mode_run="${mode_code}"
			;;

			-t|--think)
				state_think="true"
			;;

			-r|--threads)
				count_threads="${2}"

				shift
			;;

			-h|--help)
				cat <<- EOF

				Usage: ada [option] [-r threads] [model]

				Chat with a local ${name_command} model: the ${name_assistant} model, else the one
				already in memory, else the newest installed one, or the model named.

				Options:

				-c, --code          Open the [c]oding agent in this folder, under the same
				                    header and with the same model.

				-t, --think         Let the model [t]hink before it answers.

				-r, --threads       Set the ${name_assistant} model's processor th[r]eads and keep
				                    the setting in its settings file.

				-h, --help          Show this [h]elp message.

				EOF

				return 0
			;;

			*)
				name_model="${1}"
			;;

		esac

		shift
	done

	# command path

	path_command="$(command -v "${name_command}")"

	if [ -z "${path_command}" ]
	then
		frobulator.err "Command not found" "[ ${name_command} ]"

		return 1
	fi

	# set model threads

	if [ -n "${count_threads}" ]
	then
		count_threads_maximum="$(nproc)"

		if [[ ! "${count_threads}" =~ ${pattern_number} ]] ||
		   [ "${count_threads}" -lt "${count_threads_minimum}" ] ||
		   [ "${count_threads}" -gt "${count_threads_maximum}" ]
		then
			frobulator.err "Thread count must be ${count_threads_minimum} to ${count_threads_maximum}" "[ ${count_threads} ]"

			return 1
		fi

		# settings file location

		text_environment="$(systemctl show "${name_service}" --property="${property_environment}" --value 2> "${sink}")"

		read -r -a list_environment <<< "${text_environment}"

		for entry_environment in "${list_environment[@]}"
		do
			if [[ "${entry_environment}" == "${variable_models}="* ]]
			then
				directory_models="${entry_environment#*=}"
			fi
		done

		file_settings="${directory_models}/${prefix_settings}-${name_assistant}"

		if [ -z "${directory_models}" ] || [ ! -f "${file_settings}" ]
		then
			frobulator.err "Settings file not found" "[ ${file_settings} ]"

			return 1
		fi

		# replace or add thread line

		line_threads="${keyword_parameter} ${name_parameter_threads} ${count_threads}"
		state_found="false"

		mapfile -t list_settings < "${file_settings}"

		for index_setting in "${!list_settings[@]}"
		do
			if [[ "${list_settings[index_setting]}" == "${keyword_parameter} ${name_parameter_threads} "* ]]
			then
				list_settings[index_setting]="${line_threads}"
				state_found="true"
			fi
		done

		if [ "${state_found}" = "false" ]
		then
			list_settings+=("${line_threads}")
		fi

		printf '%s\n' "${list_settings[@]}" > "${file_settings}"

		"${path_command}" create "${name_assistant}" -f "${file_settings}" > "${sink}" 2>&1

		status_create="${?}"

		if [ "${status_create}" -ne 0 ]
		then
			frobulator.err "Unable to update model" "[ ${name_assistant} ]"

			return 1
		fi

		"${path_command}" stop "${name_assistant}" > "${sink}" 2>&1

		frobulator.scs "Processor threads set" "[ ${name_assistant}${separator_values}${count_threads} ]"
	fi

	# pick model

	if [ -z "${name_model}" ]
	then
		"${path_command}" show "${name_assistant}" > "${sink}" 2>&1

		status_assistant="${?}"

		if [ "${status_assistant}" -eq 0 ]
		then
			name_model="${name_assistant}"
		fi
	fi

	if [ -z "${name_model}" ]
	then
		mapfile -t list_lines < <("${path_command}" ps 2> "${sink}")

		read -r name_model text_rest <<< "${list_lines[index_row_first]}"
	fi

	if [ -z "${name_model}" ]
	then
		mapfile -t list_lines < <("${path_command}" list 2> "${sink}")

		read -r name_model text_rest <<< "${list_lines[index_row_first]}"
	fi

	if [ -z "${name_model}" ]
	then
		frobulator.err "No model installed" "[ ${name_command} download <model> ]"

		return 1
	fi

	if [ "${mode_run}" = "${mode_code}" ]
	then
		path_agent="$(type -P "${name_agent}")"
	fi

	if [ "${mode_run}" = "${mode_code}" ] && [ -z "${path_agent}" ]
	then
		frobulator.err "Coding agent not installed" "[ bash ada/install.sh ]"

		return 1
	fi

	# retention from the settings that govern it - ada sends its own, ollama run uses the server's

	if [ "${mode_run}" = "${mode_code}" ]
	then
		text_keep_alive="${keep_alive_agent_default}"

		if [ -r "${file_agent_configuration}" ]
		then
			text_agent_configuration="$(< "${file_agent_configuration}")"

			if [[ "${text_agent_configuration}" =~ ${pattern_keep_alive} ]]
			then
				text_keep_alive="${BASH_REMATCH[1]}"
			fi
		fi
	else
		text_environment="$(systemctl show "${name_service}" --property="${property_environment}" --value 2> "${sink}")"

		read -r -a list_environment <<< "${text_environment}"

		for entry_environment in "${list_environment[@]}"
		do
			if [[ "${entry_environment}" == "${variable_keep_alive}="* ]]
			then
				text_keep_alive="${entry_environment#*=}"
			fi
		done
	fi

	if [ -n "${text_keep_alive}" ]
	then
		text_retention="$(ada_retention_describe "${text_keep_alive}")"
	fi

	# thinking models only

	text_details="$("${path_command}" show "${name_model}" 2> "${sink}")"

	if [[ "${text_details}" == *"${label_thinking}"* ]]
	then
		list_think=("${option_think}=${state_think}")
	fi

	# model thread count

	count_threads_model="${label_threads_default}"

	while read -r text_key text_value text_rest
	do
		if [ "${text_key}" = "${name_parameter_threads}" ]
		then
			count_threads_model="${text_value}"
		fi
	done <<< "${text_details}"

	# draw status and panel

	printf -v epoch_start '%(%s)T' -1
	printf -v time_start "%(${format_time_start})T" -1

	clear

	ada_status_draw

	printf "${format_cursor_position}" "${row_chat}" "${column_first}"

	# follow status outside job table

	pid_status="$(ada_status_follow > "${file_terminal}" 2> "${sink}" & echo "${!}")"

	# coding agent warms the model up itself

	if [ "${mode_run}" = "${mode_code}" ]
	then
		command "${name_agent}" "${option_workspace}" "${PWD}" "${option_model}" "${name_model}"
	else
		printf -v payload_load "${format_payload}" "${name_model}"

		curl --silent "${url_generate}" --data "${payload_load}" > "${sink}" 2>&1

		sleep "${delay_loading}"

		"${path_command}" run "${name_model}" "${list_think[@]}"
	fi

	kill "${pid_status}" 2> "${sink}"

	# restore whole screen

	printf "${sequence_scroll_reset}"

	clear

}

# retention ────────────────────────────────────────────────────────────────────

ada_retention_describe () {

	# use to describe an ollama keep-alive value

	local value_keep_alive="${1}"
	local label_forever="kept forever"
	local label_each="unloads after each answer"
	local label_unloads="unloads"
	local label_after="after use"
	local pattern_negative="^-"
	local pattern_seconds="^[0-9]+$"
	local pattern_duration="^([0-9]+h)?([0-9]+m)?([0-9]+)?(\\.[0-9]+)?s?$"
	local seconds_hour="3600"
	local seconds_minute="60"
	local count_hours="0"
	local count_minutes="0"
	local count_seconds="0"
	local text_part
	local text_duration=""

	local -A list_units=(
		[hour]="0"
		[minute]="0"
		[second]="0"
	)

	local list_order=(
		hour
		minute
		second
	)

	if [[ "${value_keep_alive}" =~ ${pattern_negative} ]]
	then
		echo "${label_forever}"

		return 0
	fi

	if [[ "${value_keep_alive}" =~ ${pattern_seconds} ]]
	then
		count_hours=$(( value_keep_alive / seconds_hour ))
		count_minutes=$(( value_keep_alive % seconds_hour / seconds_minute ))
		count_seconds=$(( value_keep_alive % seconds_minute ))

	elif [[ "${value_keep_alive}" =~ ${pattern_duration} ]]
	then
		count_hours="${BASH_REMATCH[1]%h}"
		count_minutes="${BASH_REMATCH[2]%m}"
		count_seconds="${BASH_REMATCH[3]}"
	else
		# unknown format shown as given

		echo "${label_unloads} ${value_keep_alive} ${label_after}"

		return 0
	fi

	list_units=(
		[hour]="$(( 10#${count_hours:-0} ))"
		[minute]="$(( 10#${count_minutes:-0} ))"
		[second]="$(( 10#${count_seconds:-0} ))"
	)

	for text_part in "${list_order[@]}"
	do
		if [ "${list_units[${text_part}]}" -eq 1 ]
		then
			text_duration="${text_duration} 1 ${text_part}"

		elif [ "${list_units[${text_part}]}" -gt 1 ]
		then
			text_duration="${text_duration} ${list_units[${text_part}]} ${text_part}s"
		fi
	done

	if [ -z "${text_duration}" ]
	then
		echo "${label_each}"
	else
		echo "${label_unloads}${text_duration} ${label_after}"
	fi

}

# status line ──────────────────────────────────────────────────────────────────

ada_status_draw () {

	# use to draw the status line

	local label_loading="Loading model"
	local label_chatting="Chatting with model"
	local label_coding="Coding with model"
	local label_status="${label_loading}"
	local character_rule="─"
	local text_size
	local count_rows
	local count_columns
	local text_line
	local text_rule
	local text_visible
	local count_excess
	local character_rule_pair="──"
	local pattern_escape=$'\e''(\[[0-9;]*m|\(B)'

	if [ "${state_loaded}" = "true" ] && [ "${mode_run}" = "${mode_code}" ]
	then
		label_status="${label_coding}"

	elif [ "${state_loaded}" = "true" ]
	then
		label_status="${label_chatting}"
	fi

	frobulator.columns

	# terminal size

	text_size="$(stty size 2> "${sink}" < "${file_terminal}")"
	count_rows="${text_size%% *}"
	count_columns="${text_size##* }"
	text_line="$(frobulator.llm "${label_status}" "[ ${name_model} ]")"

	# frobulator never lays out under 80 columns - the rule gives up the difference

	text_visible="${text_line}"

	while [[ "${text_visible}" =~ ${pattern_escape} ]]
	do
		text_visible="${text_visible/"${BASH_REMATCH[0]}"/}"
	done

	count_excess=$(( ${#text_visible} - count_columns ))

	while [ "${count_excess}" -gt 0 ] && [[ "${text_line}" == *"${character_rule_pair}"* ]]
	do
		text_line="${text_line/"${character_rule_pair}"/${character_rule}}"

		(( count_excess -- ))
	done

	# rule between header and chat

	printf -v text_rule '%*s' "${count_columns}" ""

	text_rule="${text_rule// /${character_rule}}"

	printf "${sequence_cursor_save}${format_cursor_position}${sequence_line_clear}%s${format_cursor_position}${sequence_line_clear}${format_cursor_position}${sequence_line_clear}${format_cursor_position}${sequence_line_clear}%s%s%s${format_cursor_position}${sequence_line_clear}${format_scroll_region}${sequence_cursor_restore}" \
		"${row_status}" \
		"${column_first}" \
		"${text_line}" \
		"${row_gap}" \
		"${column_first}" \
		"${row_gap_rule}" \
		"${column_first}" \
		"${row_rule}" \
		"${column_first}" \
		"${lavender}" \
		"${text_rule}" \
		"${reset}" \
		"${row_gap_panel}" \
		"${column_first}" \
		"${row_chat}" \
		"${count_rows}"

}

# information panel ────────────────────────────────────────────────────────────

ada_panel_update () {

	# use to gather the panel values

	local label_model="Model"
	local label_memory="Memory"
	local label_context="Context"
