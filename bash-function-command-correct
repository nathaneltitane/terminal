#!/bin/bash

# loaded by "${HOME}"/.local/bin/bash-functions

# command correct ──────────────────────────────────────────────────────────────

command_correct_distance () {

	# letter changes between two words - upper and lower case alike - two swapped letters count once
	# result in count_distance - limit plus one once over the limit

	local word_first="${1,,}"
	local word_second="${2,,}"
	local count_limit="${3}"

	local length_first="${#word_first}"
	local length_second="${#word_second}"
	local count_gap
	local index_first
	local index_second
	local count_best
	local count_cost
	local count_row_best
	local character_first
	local character_second

	local -a list_row_before=()
	local -a list_row_last=()
	local -a list_row_current=()

	count_distance=$(( count_limit + 1 ))

	# length gap alone too large

	count_gap=$(( length_first - length_second ))

	if [ "${count_gap#-}" -gt "${count_limit}" ]
	then
		return
	fi

	for (( index_second = 0; index_second <= length_second; index_second ++ ))
	do
		list_row_last[index_second]="${index_second}"
	done

	for (( index_first = 1; index_first <= length_first; index_first ++ ))
	do
		list_row_current=("${index_first}")

		count_row_best="${index_first}"

		character_first="${word_first:index_first - 1:1}"

		for (( index_second = 1; index_second <= length_second; index_second ++ ))
		do
			character_second="${word_second:index_second - 1:1}"

			count_cost=1

			if [[ "${character_first}" == "${character_second}" ]]
			then
				count_cost=0
			fi

			# removed added or changed letter

			count_best=$(( list_row_last[index_second] + 1 ))

			if (( list_row_current[index_second - 1] + 1 < count_best ))
			then
				count_best=$(( list_row_current[index_second - 1] + 1 ))
			fi

			if (( list_row_last[index_second - 1] + count_cost < count_best ))
			then
				count_best=$(( list_row_last[index_second - 1] + count_cost ))
			fi

			# two swapped letters

			if (( index_first > 1 && index_second > 1 )) && [[ "${character_first}" == "${word_second:index_second - 2:1}" && "${word_first:index_first - 2:1}" == "${character_second}" ]]
			then
				if (( list_row_before[index_second - 2] + 1 < count_best ))
				then
					count_best=$(( list_row_before[index_second - 2] + 1 ))
				fi
			fi

			list_row_current[index_second]="${count_best}"

			if (( count_best < count_row_best ))
			then
				count_row_best="${count_best}"
			fi
		done

		# whole row over the limit

		if (( count_row_best > count_limit ))
		then
			return
		fi

		list_row_before=("${list_row_last[@]}")
		list_row_last=("${list_row_current[@]}")
	done

	count_distance="${list_row_last[length_second]}"
}

command_correct_match () {

	# closest candidate to a word - one change allowed up to four letters, two above
	# result in word_match - empty when the word is valid or nothing is close

	local word="${1}"

	shift

	local -a list_candidates=("${@}")

	local item
	local count_best
	local count_gap
	local character_first="${word:0:1}"
	local character_second="${word:1:1}"
	local status_filter
	local count_limit
	local count_limit_short
	local count_limit_long
	local count_length_long
	local count_candidates_filter

	count_limit_short="1"
	count_limit_long="2"
	count_length_long="5"
	count_candidates_filter="5000"
	status_filter="false"
	count_limit="${count_limit_short}"

	unset word_match

	if [ "${#word}" -ge "${count_length_long}" ]
	then
		count_limit="${count_limit_long}"
	fi

	count_best=$(( count_limit + 1 ))

	# long lists - first letters kept close

	if [ "${#list_candidates[@]}" -gt "${count_candidates_filter}" ]
	then
		status_filter="true"
	fi

	for item in "${list_candidates[@]}"
	do
		if [ "${item}" = "${word}" ]
		then
			unset word_match

			return
		fi

		count_gap=$(( ${#item} - ${#word} ))

		if [ "${count_gap#-}" -gt "${count_limit}" ]
		then
			continue
		fi

		if [ "${status_filter}" = "true" ] && [[ "${item:0:1}" != "${character_first}" && "${item:0:1}" != "${character_second}" ]]
		then
			continue
		fi

		command_correct_distance "${word}" "${item}" "${count_limit}"

		# closer wins - same length breaks a tie

		if (( count_distance < count_best )) || { (( count_distance == count_best )) && [ "${#item}" -eq "${#word}" ] && [ "${#word_match}" -ne "${#word}" ]; }
		then
			count_best="${count_distance}"

			word_match="${item}"
		fi
	done

	if (( count_best > count_limit ))
	then
		unset word_match
	fi
}

command_correct_candidates () {

	# words the completion offers at one position of a command - starting with the given text
	# result in list_completion

	local text_current="${1}"
	local index_word="${2}"

	shift 2

	local -a list_segment=("${@}")

	local name_command="${list_segment[0]}"
	local text_specification
	local name_completion
	local name_loader
	local status_loader
	local file_completion
	local directory_system
	local pattern_function
	local pattern_command
	local prefix_complete
	local suffix_options
	local suffix_space
	local suffix_equal

	name_loader="_completion_loader"
	file_completion="share/bash-completion/bash_completion"
	directory_system="/usr"
	pattern_function=' -F ([^ ]+)'
	pattern_command=' -C '
	prefix_complete="complete "
	suffix_options=" *"
	suffix_space=" "
	suffix_equal="="

	local -a COMP_WORDS=()
	local COMP_CWORD
	local COMP_LINE
	local COMP_POINT
	local -a COMPREPLY=()

	list_completion=()

	# completion missing in login shells

	declare -F "${name_loader}" > "${sink}" 2>&1

	status_loader="${?}"

	if [ "${status_loader}" -ne 0 ]
	then
		if [ -f "${PREFIX}"/"${file_completion}" ]
		then
			. "${PREFIX}"/"${file_completion}"
		elif [ -f "${directory_system}"/"${file_completion}" ]
		then
			. "${directory_system}"/"${file_completion}"
		fi
	fi

	text_specification="$(complete -p -- "${name_command}" 2> "${sink}")"

	# completion loaded on first use

	declare -F "${name_loader}" > "${sink}" 2>&1

	status_loader="${?}"

	if [ -z "${text_specification}" ] && [ "${status_loader}" -eq 0 ]
	then
		"${name_loader}" "${name_command}" > "${sink}" 2>&1

		text_specification="$(complete -p -- "${name_command}" 2> "${sink}")"
	fi

	if [ -z "${text_specification}" ]
	then
		return
	fi

	if [[ "${text_specification}" =~ ${pattern_function} ]]
	then
		name_completion="${BASH_REMATCH[1]}"

		COMP_WORDS=("${list_segment[@]:0:index_word}" "${text_current}")
		COMP_CWORD="${index_word}"
		COMP_LINE="${COMP_WORDS[*]}"
		COMP_POINT="${#COMP_LINE}"

		"${name_completion}" "${name_command}" "${text_current}" "${COMP_WORDS[index_word - 1]}" > "${sink}" 2>&1

		list_completion=("${COMPREPLY[@]}")
	elif [[ "${text_specification}" != *${pattern_command}* ]]
	then
		# same options as the completion

		text_specification="${text_specification#${prefix_complete}}"
		text_specification="${text_specification%${suffix_options}}"

		mapfile -t list_completion < <(eval "compgen ${text_specification} -- \"\${text_current}\"" 2> "${sink}")
	fi

	# trailing spaces and equal signs

	list_completion=("${list_completion[@]%${suffix_space}}")
	list_completion=("${list_completion[@]%${suffix_equal}}")
}

command_correct_member () {

	# word found in a list
	# result in status_member

	local word_search="${1}"

	shift

	local item

	status_member="false"

	for item in "${@}"
	do
		if [ "${item}" = "${word_search}" ]
		then
			status_member="true"

			return
		fi
	done
}

command-correct () {

	# bound to alt enter: misspelled commands and words fixed on the line - enter runs it
	# runs as typed: unchanged line, or second alt enter on a line put back as typed

	local text_line="${READLINE_LINE}"
	local text_rest
	local text_corrected
	local word
	local word_lower
	local type_word
	local type_lower
	local status_command
	local status_skip
	local status_skip_next
	local status_capitals
	local status_member
	local status_wrapper
	local status_control
	local status_opener
	local index_word
	local index_start
	local index_end
	local key_accept
	local sequence_swap
	local function_accept
	local pattern_space
	local pattern_word
	local pattern_redirection
	local pattern_plain
	local pattern_option_short
	local pattern_number
	local pattern_operator_end
	local prefix_option_long
	local count_length_minimum

	local -a list_spaces=()
	local -a list_words=()
	local -a list_words_typed=()
	local -a list_segment=()
	local -a list_commands=()

	local -a list_control=(
		'|'
		'||'
		'&&'
		';'
		'&'
		'|&'
	)

	local -a list_wrappers=(
		sudo
		env
		time
		nohup
		nice
		command
		builtin
		exec
		xargs
		watch
		then
		do
		else
		elif
		if
		while
		until
		'!'
		'{'
		'('
	)

	local -a list_openers=(
		for
		case
		select
		function
	)

	key_accept='\C-x\C-a'
	sequence_swap='\C-x\C-x\C-x\C-x'
	function_accept="accept-line"
	pattern_space='[[:space:]]'
	pattern_word='^([[:space:]]*)([^[:space:]]+)(.*)$'
	pattern_redirection='^[0-9]*[\<\>]'
	pattern_plain='^[[:alnum:]._+-]+$'
	pattern_option_short='^-[^-]'
	pattern_number='^[0-9.]+$'
	pattern_operator_end='(\;|\||\&)$'
	prefix_option_long="--"
	count_length_minimum="2"
	status_command="true"
	status_skip="false"
	status_skip_next="false"
	status_capitals="false"

	# runs unless a fix is shown

	bind "\"${key_accept}\": ${function_accept}"

	if [ -z "${text_line//${pattern_space}/}" ] || [ "${text_line}" = "${line_command_typed}" ]
	then
		unset line_command_typed

		return
	fi

	# spaces and words in order

	text_rest="${text_line}"

	while [[ "${text_rest}" =~ ${pattern_word} ]]
	do
		list_spaces+=("${BASH_REMATCH[1]}")
		list_words+=("${BASH_REMATCH[2]}")

		text_rest="${BASH_REMATCH[3]}"
	done

	list_words_typed=("${list_words[@]}")

	# caps lock: capital command with a lowercase match

	word="${list_words[0]}"
	word_lower="${word,,}"

	type_word="$(type -t -- "${word}")"
	type_lower="$(type -t -- "${word_lower}")"

	if [[ "${word}" == "${word^^}" && "${word}" != "${word_lower}" ]] && [ -z "${type_word}" ] && [ -n "${type_lower}" ]
	then
		status_capitals="true"
	fi

	for index_word in "${!list_words[@]}"
	do
		word="${list_words[index_word]}"

		if [ "${status_capitals}" = "true" ] && [[ "${word}" == "${word^^}" && "${word}" != "${word,,}" ]]
		then
			word="${word,,}"
		fi

		status_skip="${status_skip_next}"

		status_skip_next="false"

		# control operators start a new command

		command_correct_member "${word}" "${list_control[@]}"

		if [ "${status_member}" = "true" ]
		then
			status_command="true"

			list_segment=()

		# redirections - next word is a file

		elif [[ "${word}" =~ ${pattern_redirection} ]]
		then
			status_skip_next="true"

		# quotes variables paths and short options left as typed

		elif [ "${status_skip}" = "false" ] && [ "${#word}" -ge "${count_length_minimum}" ] && [[ "${word}" =~ ${pattern_plain} ]] && [[ ! "${word}" =~ ${pattern_option_short} ]] && [[ ! "${word}" =~ ${pattern_number} ]] && [ ! -e "${word}" ]
		then
			if [ "${status_command}" = "true" ]
			then
				type_word="$(type -t -- "${word}")"

				if [ -z "${type_word}" ]
				then
					if [ "${#list_commands[@]}" -eq 0 ]
					then
						mapfile -t list_commands < <(compgen -c | sort -u)
					fi

					command_correct_match "${word}" "${list_commands[@]}"

					if [ -n "${word_match}" ]
					then
						word="${word_match}"
					fi
				fi
			elif [ "${#list_segment[@]}" -gt 0 ]
			then
				# word offered or started - full list otherwise

				command_correct_candidates "${word}" "${#list_segment[@]}" "${list_segment[@]}"

				if [ "${#list_completion[@]}" -gt 0 ]
				then
					list_completion=()
				elif [[ "${word}" == ${prefix_option_long}* ]]
				then
					command_correct_candidates "${prefix_option_long}" "${#list_segment[@]}" "${list_segment[@]}"
				else
					command_correct_candidates "" "${#list_segment[@]}" "${list_segment[@]}"
				fi

				if [ "${#list_completion[@]}" -gt 0 ]
				then
					command_correct_match "${word}" "${list_completion[@]}"

					if [ -n "${word_match}" ]
					then
						word="${word_match}"
					fi
				fi
			fi
		fi

		# command position after wrappers and keywords

		if [ "${status_command}" = "true" ]
		then
			command_correct_member "${word}" "${list_control[@]}"

			status_control="${status_member}"

			command_correct_member "${word}" "${list_wrappers[@]}"

			status_wrapper="${status_member}"

			command_correct_member "${word}" "${list_openers[@]}"

			status_opener="${status_member}"

			if [ "${status_control}" = "true" ] || [ "${status_wrapper}" = "true" ]
			then
				:
			elif [[ "${word}" == -* || "${word}" == *=* ]]
			then
				:
			elif [ "${status_opener}" = "true" ]
			then
				status_command="false"

				list_segment=()
			else
				status_command="false"

				list_segment=("${word}")
			fi
		elif [ "${#list_segment[@]}" -gt 0 ]
		then
			list_segment+=("${word}")
		fi

		# operators at the end of a word

		if [[ "${word}" =~ ${pattern_operator_end} ]] && [ "${#word}" -ge "${count_length_minimum}" ]
		then
			status_command="true"

			list_segment=()
		fi

		list_words[index_word]="${word}"
	done

	# corrected span from the first to the last changed word

	for index_word in "${!list_words[@]}"
	do
		text_corrected+="${list_spaces[index_word]}"

		if [ "${list_words[index_word]}" != "${list_words_typed[index_word]}" ]
		then
			if [ -z "${index_start}" ]
			then
				index_start="${#text_corrected}"
			fi

			index_end=$(( ${#text_corrected} + ${#list_words[index_word]} ))
		fi

		text_corrected+="${list_words[index_word]}"
	done

	text_corrected+="${text_rest}"

	# fix shown and colored - enter runs it

	if [ "${text_corrected}" != "${text_line}" ]
	then
		line_command_typed="${text_line}"

		READLINE_LINE="${text_corrected}"
		READLINE_MARK="${index_start}"
		READLINE_POINT="${index_end}"

		# swapping point and mark twice lights up the span

		bind "\"${key_accept}\": \"${sequence_swap}\""
	else
		unset line_command_typed
	fi
}
