#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-h|--help)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-h, --help    Show [h]elp and usage information."
			echo
			echo -e "'${script}'   [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

# defaults ─────────────────────────────────────────────────────────────────────

# functions ────────────────────────────────────────────────────────────────────

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(
	openssh*
)

frobulator.require ${list[@]}

list=()

# configuration ────────────────────────────────────────────────────────────────

frobulator.silence "service ssh restart" &

frobulator.process "Starting service"

# authorized keys file check

frobulator.fwd "Copying keys..."

if [ -f "${PREFIX}"/media/internal/.ssh/authorized_keys ]
then
	:
else
	frobulator.file "${PREFIX}"/media/internal/.ssh authorized_keys
fi

if [ -f "${PREFIX}"/media/internal/.ssh/sshd_config ]
then
	cp "${PREFIX}"/media/internal/.ssh/sshd_config "${PREFIX}"/etc/ssh/sshd_config
fi

if [ -d "${HOME}"/.ssh ]
then
	rm						\
			--recursive		\
			--force 		"${HOME}"/.ssh

	cp 						\
			--recursive		\
			--force			"${PREFIX}"/media/internal/.ssh "${HOME}"/.ssh

else
	cp 						\
			--recursive		\
			--force			"${PREFIX}"/media/internal/.ssh "${HOME}"/.ssh
fi

# set permissions

frobulator.fwd "Setting permissions..."

list=(
	"${HOME}"/.ssh
	"${PREFIX}"/media/internal/.ssh
)

for directory in ${list_directories[@]}
do
	# ownership

	sudo chown "${USER}" "${directory}"
	sudo chown "${USER}" "${directory}"/*
	sudo chown "${USER}" "${directory}"/.keys/
	sudo chown "${USER}" "${directory}"/.keys/*

	# permissions

	sudo chmod 700 "${directory}"
	sudo chmod 755 "${directory}"/known_hosts
	sudo chmod 400 "${directory}"/.keys/*
	sudo chmod 600 "${directory}"/config
	sudo chmod 600 "${directory}"/authorized_keys
done

list=()
