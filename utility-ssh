#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-09"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-b|--backup)
			option="backup"
		;;

		-r|--restore)
			option="restore"
		;;

		-d|--directory)
			directory_store="${2}"

			shift
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -b | -r [-d Directory] | -h"
			echo
			echo -e "Note:              Keys are generated by 'utility-ssh-generate-key'."
			echo
			echo -e "Options:"
			echo
			echo -e "-b, --backup       Run [b]ackup of this computer's ssh setup into the directory."
			echo
			echo -e "-r, --restore      Run [r]estore of the ssh setup from the directory."
			echo
			echo -e "-d, --directory    Specify ssh files [d]irectory."
			echo
			echo -e "                   [ /media/internal/.ssh ] [ Default ]"
			echo
			echo -e "-h, --help         Show [h]elp and usage information."
			echo
			echo -e "'${script}'        [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -b | -r [-d Directory] | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

# user ssh directory - keys kept in its .keys directory

directory_ssh="${HOME}"/.ssh

# server configuration and brute force protection rule

file_sshd_config=/etc/ssh/sshd_config
file_fail2ban_sshd=/etc/fail2ban/jail.d/sshd.local

# dolphin places - sftp entries shown under network

file_places="${HOME}/.local/share/user-places.xbel"

# devices - one ssh config host each - this computer skipped

list_devices=(
	pi
	phone
	tablet
	desktop
	notebook
)

# android devices - router name - shared storage as the place root

list_hosts_android=(
	notebook
	phone
	tablet
)

# defaults ─────────────────────────────────────────────────────────────────────

if [ -z "${option}" ]
then
	frobulator.err "Missing operation."
	frobulator.nul "Specify '--backup' or '--restore'."

	exit 1

elif [[ "${directory_store}" = -* ]]
then
	frobulator.err "Missing argument for '--directory'."

	exit 1
fi

# store - private - never a public repository

if [ -z "${directory_store}" ]
then
	directory_store=/media/internal/.ssh
fi

# functions ────────────────────────────────────────────────────────────────────

ssh_backup () {

	# user files - keys - server configuration - fail2ban rule - config is generated

	local status=0
	local file_ssh

	frobulator.directory "${directory_store}" .keys

	for file_ssh in known_hosts authorized_keys
	do
		if [ -f "${directory_ssh}/${file_ssh}" ]
		then
			cp "${directory_ssh}/${file_ssh}" "${directory_store}/${file_ssh}"

			frobulator.track
		fi
	done

	cp "${directory_ssh}"/.keys/* "${directory_store}"/.keys/ 2> "${sink}"

	frobulator.track

	cp "${file_sshd_config}" "${directory_store}"/sshd_config

	frobulator.track

	if [ -f "${file_fail2ban_sshd}" ]
	then
		cp "${file_fail2ban_sshd}" "${directory_store}"/fail2ban-sshd.local

		frobulator.track
	fi

	# store owned by the user - not root after escalation

	chown -R "${USER}:${USER}" "${directory_store}"

	frobulator.track

	return "${status}"
}

ssh_restore_user () {

	# user directory rebuilt from the store - ownership and permissions ssh accepts

	local status=0
	local file_ssh

	frobulator.directory "${directory_ssh}" .keys

	for file_ssh in known_hosts authorized_keys
	do
		if [ -f "${directory_store}/${file_ssh}" ]
		then
			cp "${directory_store}/${file_ssh}" "${directory_ssh}/${file_ssh}"

			frobulator.track
		fi
	done

	# authorized keys - created empty when missing - public keys of devices logging in

	touch "${directory_ssh}"/authorized_keys

	cp "${directory_store}"/.keys/* "${directory_ssh}"/.keys/ 2> "${sink}"

	frobulator.track

	chown -R "${USER}:${USER}" "${directory_ssh}"

	chmod 700 "${directory_ssh}" "${directory_ssh}"/.keys

	find "${directory_ssh}"/.keys -type f ! -name "*.pub" -exec chmod 600 {} +
	find "${directory_ssh}"/.keys -type f -name "*.pub" -exec chmod 644 {} +

	chmod 600 "${directory_ssh}"/authorized_keys

	if [ -f "${directory_ssh}"/config ]
	then
		chmod 600 "${directory_ssh}"/config
	fi

	if [ -f "${directory_ssh}"/known_hosts ]
	then
		chmod 644 "${directory_ssh}"/known_hosts
	fi

	return "${status}"
}

ssh_restore_config () {

	# user config generated - one framed host block per device - this computer skipped

	local status=0
	local file_config="${directory_ssh}/config"
	local name_device
	local name_host
	local line_frame

	{
		for name_device in "${list_devices[@]}"
		do
			if [ "${name_device}" = "$(hostname)" ]
			then
				continue
			fi

			# android devices - router name - others announce themselves as .local

			name_host="${name_device}.local"

			if [[ " ${list_hosts_android[*]} " == *" ${name_device} "* ]]
			then
				name_host="${name_device}"
			fi

			# frame line - 80 columns as the script section headers

			printf -v line_frame '%*s' $(( 80 - 3 - ${#name_device} )) ''

			printf '# %s %s\n\n' "${name_device}" "${line_frame// /─}"

			printf 'Host %s\n' "${name_device}"
			printf '\tHostName %s\n' "${name_host}"
			printf '\tUser %s\n' "${USER}"
			printf '\tIdentityFile ~/.ssh/.keys/%s.key\n' "${name_device}"
			printf '\tIdentitiesOnly yes\n'
			printf '\tDynamicForward 1337\n'
			printf '\tPort 22\n\n'
		done
	} > "${file_config}"

	frobulator.track

	chown "${USER}:${USER}" "${file_config}"

	chmod 600 "${file_config}"

	return "${status}"
}

ssh_restore_server () {

	# server configuration - checked before install - service enabled and reloaded

	local status=0

	if [ -f "${directory_store}"/sshd_config ]
	then
		sshd -t -f "${directory_store}"/sshd_config

		frobulator.track || return "${status}"

		cp "${directory_store}"/sshd_config "${file_sshd_config}"

		frobulator.track
	fi

	systemctl enable --now ssh > "${sink}" 2>&1

	frobulator.track

	systemctl reload ssh

	frobulator.track

	return "${status}"
}

ssh_restore_fail2ban () {

	# brute force protection - stored rule or default - journal read as debian keeps no auth log

	local status=0

	if [ -f "${directory_store}"/fail2ban-sshd.local ]
	then
		cp "${directory_store}"/fail2ban-sshd.local "${file_fail2ban_sshd}"
	else
		cat <<- FILE > "${file_fail2ban_sshd}"
		[sshd]
		enabled = true
		backend = systemd
		maxretry = 5
		findtime = 10m
		bantime = 10m
		ignoreip = 127.0.0.1/8 ::1 192.168.0.0/16
		FILE
	fi

	frobulator.track

	systemctl enable fail2ban > "${sink}" 2>&1

	frobulator.track

	systemctl restart fail2ban

	frobulator.track

	return "${status}"
}

ssh_restore_places () {

	# add a dolphin place for every ssh config host that has none

	local status=0
	local index_places=0

	local content_places
	local list_entries_places
	local stamp_places
	local name_host
	local title_host
	local path_host

	local -a list_hosts=()

	if [ ! -f "${file_places}" ]
	then
		frobulator.wrn "Places not updated - no dolphin places file" "[ '${file_places##*/}'${marker_spc}${marker_hnt}${marker_spc}missing ]"
		frobulator.nul "Open dolphin once, then run the restore again."

		return 0
	fi

	# hosts named in the ssh config - wildcard entries and this computer skipped

	while read -r _ name_host
	do
		if [[ "${name_host}" != *[*?]* ]] && [ "${name_host}" != "$(hostname)" ]
		then
			list_hosts+=("${name_host}")
		fi
	done < <(grep -E '^Host[[:space:]]' "${directory_ssh}"/config 2> "${sink}")

	content_places="$(< "${file_places}")"
	stamp_places="$(date +%s)"

	for name_host in "${list_hosts[@]}"
	do
		if [[ "${content_places}" = *"href=\"sftp://${name_host}/"* ]]
		then
			frobulator.inf "Place present - host" "[ ${name_host} ]"

			continue
		fi

		# place root - android shared storage - file system root otherwise

		path_host="/"

		if [[ " ${list_hosts_android[*]} " == *" ${name_host} "* ]]
		then
			path_host="/storage/emulated/0/"
		fi

		# title escaped for xml

		title_host="${name_host//&/&amp;}"
		title_host="${title_host//</&lt;}"
		title_host="${title_host//>/&gt;}"

		list_entries_places+=" <bookmark href=\"sftp://${name_host}${path_host}\">${NLN}"
		list_entries_places+="  <title>${title_host}</title>${NLN}"
		list_entries_places+="  <info>${NLN}"
		list_entries_places+="   <metadata owner=\"http://freedesktop.org\">${NLN}"
		list_entries_places+="    <bookmark:icon name=\"folder-remote\"/>${NLN}"
		list_entries_places+="   </metadata>${NLN}"
		list_entries_places+="   <metadata owner=\"http://www.kde.org\">${NLN}"
		list_entries_places+="    <ID>${stamp_places}/${index_places}</ID>${NLN}"
		list_entries_places+="   </metadata>${NLN}"
		list_entries_places+="  </info>${NLN}"
		list_entries_places+=" </bookmark>${NLN}"

		index_places=$(( index_places + 1 ))

		frobulator.add "Place added - host" "[ ${name_host} ]"
	done

	if [ -z "${list_entries_places}" ]
	then
		return 0
	fi

	# new entries go right before the closing tag

	if [[ "${content_places}" != *"</xbel>"* ]]
	then
		frobulator.err "Places failure - unexpected file format" "[ '${file_places##*/}'${marker_spc}${marker_hnt}${marker_spc}xbel ]"

		return 1
	fi

	printf '%s%s</xbel>\n' "${content_places%</xbel>*}" "${list_entries_places}" > "${file_places}"

	frobulator.track

	return "${status}"
}

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(
	openssh-server
)

if [ "${option}" = "restore" ]
then
	list+=(
		fail2ban
		python3-systemd
	)
fi

frobulator.require ${list[@]}

list=()

# configuration ────────────────────────────────────────────────────────────────

if [ "${option}" = "backup" ]
then
	frobulator.inf "Backing up ssh setup" "[ ${directory_store} ]"

	ssh_backup

	frobulator.complete

elif [ "${option}" = "restore" ]
then
	if [ ! -d "${directory_store}" ]
	then
		frobulator.err "Directory not found" "[ ${directory_store} ]"

		exit 1
	fi

	frobulator.inf "Restoring user files" "[ ${directory_ssh} ]"

	ssh_restore_user

	frobulator.complete

	frobulator.inf "Generating user config" "[ ${directory_ssh}/config ]"

	ssh_restore_config

	frobulator.complete

	frobulator.inf "Restoring server" "[ ${file_sshd_config} ]"

	ssh_restore_server

	frobulator.complete

	frobulator.inf "Restoring brute force protection" "[ fail2ban ]"

	ssh_restore_fail2ban

	frobulator.complete

	frobulator.inf "Restoring places" "[ dolphin // network ]"

	ssh_restore_places

	frobulator.complete
fi

frobulator.result "${script}"
