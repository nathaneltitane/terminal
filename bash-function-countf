#!/bin/bash

# loaded by "${HOME}"/.local/bin/bash-functions

# countf ───────────────────────────────────────────────────────────────────────

countf () {

	# output starts one line below the command

	local directory_search="."
	local count_files

	count_files="$(find "${directory_search}" -type f | wc --lines)"

	echo

	echo "${count_files} files under ${PWD}"

}
