#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-h|--help)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-h, --help    Show [h]elp and usage information."
			echo
			echo -e "'${script}'   [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

directory_media="/media"
directory_leocad="leocad"
directory_link="${HOME}/.config/LeoCAD Software"
file_source="leocad.conf"
file_target="LeoCAD.conf"
pattern_lego='^lego$'
pattern_media="${directory_media}/\([^/]*\)/\([^/]*\)"
count_lines_first="1"

# defaults ─────────────────────────────────────────────────────────────────────

# functions ────────────────────────────────────────────────────────────────────

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(

)

frobulator.require ${list[@]}

list=()

# configuration ────────────────────────────────────────────────────────────────

list_directories=(
	[aA]ndroid
	[iI]nternal
)

matches=()

for directory in ${list_directories[@]}
do
	pattern_directory="^${directory}$"
	match="$(ls "${directory_media}" 2> "${sink}" | grep --ignore-case "${pattern_directory}" | head --lines="${count_lines_first}")"

	if [ -n "$match" ]
	then
		matches+=("${match}")
	fi
done

for directory in ${matches[@]}
do
	subdirectory="$(ls "${directory_media}/${directory}" 2> "${sink}" | grep --ignore-case "${pattern_lego}" | head --lines="${count_lines_first}")"
	directory_lego="${directory_media}/${directory}/${subdirectory}"
	directory_source="${directory_lego}/${directory_leocad}"
	file_source_path="${directory_source}/${file_source}"
	expression_sed="s|${pattern_media}|${directory_lego}|g"

	if [ -n "${subdirectory}" ] && [ -d "${directory_lego}" ]
	then
		if [ -f "${file_source_path}" ]
		then
			frobulator.inf "Linking configuration"

			frobulator.link "${directory_source}" "${directory_link}" "${file_source}" "${file_target}"

			sed										\
				--in-place							\
				--expression="${expression_sed}"	\
													"${file_source_path}"
		fi
	fi
done

frobulator.scs "Done"
