#!/bin/bash

script=$(basename -- "${BASH_SOURCE[0]}")

terminal="i3-sensible-terminal"
command_file_manager="ranger"

separator=" // "
name_font="Monospace"
size_font=10
font="${name_font}:size=${size_font}"

color_background="#000000"
color_foreground="#FFFFFF"
color_selected_background="#666666"
color_selected_foreground="#000000"

lines=15
prompt="OPEN DIRECTORY${separator}"

format_name="%f\n"
depth_maximum=1
type_entry="d"

find "${HOME}" -maxdepth "${depth_maximum}" -type "${type_entry}" -printf "${format_name}" | dmenu -i -l "${lines}" -p "${prompt}" -fn "${font}" -nb "${color_background}" -nf "${color_foreground}" -sb "${color_selected_background}" -sf "${color_selected_foreground}" | xargs --no-run-if-empty "${terminal}" -e "${command_file_manager}"
