#!/bin/bash

# loaded by "${HOME}"/.local/bin/bash-functions

# when ─────────────────────────────────────────────────────────────────────────

when () {

	local format_time="+%I:%M %p"
	local format_date="+%A, %B %d %Y"
	local format_message="It is %s on %s\n"
	local time_current
	local date_current

	time_current="$(date "${format_time}")"
	date_current="$(date "${format_date}")"

	echo

	printf "${format_message}" "${time_current}" "${date_current}"

	echo

}
