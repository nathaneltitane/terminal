#!/bin/bash

script=$(basename -- "${BASH_SOURCE[0]}")

separator=" // "
name_font="Monospace"
size_font=10
font="${name_font}:size=${size_font}"

lines=15
label_prompt="PROMPT"
prompt="${label_prompt}${separator}"

color_background="#000000"
color_foreground="#FFFFFF"
color_selected_background="#666666"
color_selected_foreground="#000000"

selections_parse () {

	selections=(
		1
		2
		3
		4
	)

	IFS=$"\n"

	for selection in "${selections[@]}"
	do
		echo "${selection}"
	done

	IFS=""

	selections=()
}

selection_menu=$(selections_parse | dmenu -i -l "${lines}" -p "${prompt}" -fn "${font}" -nb "${color_background}" -nf "${color_foreground}" -sb "${color_selected_background}" -sf "${color_selected_foreground}")

case "${selection_menu}" in
	1)

	;;
	2)

	;;
	3)

	;;
	4)

	;;

	*)
		exit
	;;
esac
