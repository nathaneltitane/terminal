#!/bin/bash

indent="	"
separator=" // "
joiner=" > "

decimal_calculate () {

	value="${1}"
	factor_decimal="${2}"

	scale=$(bc <<< "scale=2; ${value} / ${factor_decimal}")

	echo "${scale}"

	unset value
}

memory_convert () {

	value="${1}"

	unit_from="${2}"
	unit_to="${3}"

	unit_memory="${unit_to}"

	case "${unit_from}"
	in
		KB)
			case "${unit_to}"
			in
				KB)
					echo "${value}"
				;;

				MB)
					echo "${value} / 1024" | bc
				;;

				GB)
					echo "${value} / 1024 / 1024" | bc
				;;

				TB)
					echo "${value} / 1024 / 1024 / 1024" | bc
				;;

				*)
					echo "Invalid unit_to: ${unit_to}"

					exit 1
				;;

			esac

			;;

		MB)
			case "${unit_to}"
			in
				KB)
					echo "${value} * 1024" | bc -l
				;;

				MB)
					echo "${value}"
				;;

				GB)
					echo "${value} / 1024" | bc -l
				;;

				TB)
					echo "${value} / 1024 / 1024" | bc -l
				;;

				*)
					echo "Invalid unit_to: ${unit_to}"

					exit 1
				;;

			esac

			;;

		GB)
			case "${unit_to}"
			in
				KB)
					echo "${value} * 1024 * 1024" | bc -l
				;;

				MB)
					echo "${value} * 1024" | bc -l
				;;

				GB)
					echo "${value}"
				;;

				TB)
					echo "${value} / 1024" | bc -l
				;;

				*)
					echo "Invalid unit_to: ${unit_to}"

					exit 1
				;;

			esac

			;;

		TB)
			case "${unit_to}"
			in
				KB)
					echo "${value} * 1024 * 1024 * 1024" | bc -l
				;;

				MB)
					echo "${value} * 1024 * 1024" | bc -l
				;;

				GB)
					echo "${value} * 1024" | bc -l
				;;

				TB)
					echo "${value}"
				;;

				*)
					echo "Invalid unit_to: ${unit_to}"

					exit 1
				;;

			esac

			;;

		*)
			echo "Invalid unit_from: ${unit_from}"

			exit 1
		;;

	esac

	unset value

}

uevent_parse () {

	name_uevent="${1}"
	directory_uevent="${2}"

	cat "${directory_uevent}" | grep -i "${name_uevent}=" | cut -d '=' -f 2

}

system_event_parse () {

	name_system_event="${1}"
	directory_system_event="${2}"

	cat "${directory_system_event}/${name_system_event}"

}

status_date () {

	#date_current=$(date +"%F")
	date_current=$(date +"%m-%d-%Y")

	status+="${date_current}${separator}"
}

status_time () {

	time_current=$(date +"%r")

	status+="${time_current}${separator}"
}

status_host () {

	if [ "$HOSTNAME" = "localhost" ]
	then
		HOSTNAME="Android"
	fi

	if [ -z "${USER}" ]
	then
		USER="termux"
	fi

	HOSTNAME="${HOSTNAME^^}"

	USER="${USER^^}"

	status+="${USER}${joiner}${HOSTNAME}${separator}"

}

