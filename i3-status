status_cpu_temperature () {

	count_cpu=$(nproc)

	for (( i = 0 ; i < ${count_cpu} ; i ++ ))
	do
		path_temperature_cpu="/sys/class/thermal/thermal_zone${i}/temp"

		if [ -f "${path_temperature_cpu}" ]
		then
			temperature_cpu=$(cat "${path_temperature_cpu}")
			temperature_cpu=$(decimal_calculate "${temperature_cpu}" 1000)

			unit_temperature_cpu="°C"

			status+="CPU${i} ${temperature_cpu}${unit_temperature_cpu}${separator}"
		fi
	done

}

status_memory_information () {

	unit_memory="GB"

	memory_total=$(grep -i 'memtotal' /proc/meminfo | awk '{print $2}')
	memory_available=$(grep -i 'memavailable' /proc/meminfo | awk '{print $2}')

	memory_used=$(( ${memory_total} - ${memory_available} ))

	memory_total=$(memory_convert ${memory_total} KB "${unit_memory}")
	memory_available=$(memory_convert ${memory_available} KB "${unit_memory}")
	memory_used=$(memory_convert ${memory_used} KB "${unit_memory}")

	unit_memory="${unit_memory^^}"

	percentage_memory_available=$(echo "scale=2; (${memory_available} / ${memory_total}) * 100" | bc)
	percentage_memory_used=$(echo "scale=2; (${memory_used} / ${memory_total}) * 100" | bc)

	unit_percentage_memory="%"

	status+="MEMORY TOTAL ${memory_total}${unit_memory}${joiner}"
	status+="MEMORY USED ${memory_used}${unit_memory} [ ${percentage_memory_used}${unit_percentage_memory} ]${joiner}"
	status+="MEMORY AVAILABLE ${memory_available}${unit_memory} [ ${percentage_memory_available}${unit_percentage_memory} ]${separator}"

}


status_network_information () {

	route_default=$(ip route | grep 'default')

	if [[ -n "${route_default}" ]]
	then
		device_interface_network=$(ip route | grep '^default' | cut -d ' ' -f 5)
		gateway_interface_network=$(ip route | grep '^default' | cut -d ' ' -f 3)
		address_interface_network=$(ip route | grep '^default' | cut -d ' ' -f 9)

		device_interface_network="${device_interface_network^^}"

		status+="INTERFACE ${device_interface_network}${joiner}"
		status+="GATEWAY ${gateway_interface_network}${joiner}"
		status+="IP ${address_interface_network}${separator}"
	else
		status+="Network: Disconnected${separator}"
	fi
}

status_feed () {

	i3status | while :
	do
		status_host

		status_time

		status_date

		status_battery

		status_cpu_temperature

		status_memory_information

		status_network_information

		echo -e "${status}${indent}"

		unset status

		sleep 1

	done
}

status_feed
