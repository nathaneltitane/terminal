#!/bin/bash

# loaded by "${HOME}"/.local/bin/bash-functions

# ssh ──────────────────────────────────────────────────────────────────────────

ssh () {

	local color_prompt_destination
	local color_prompt_reset

	# destination is always the last argument

	destination=${!#}

	# password prompt colors: destination in yellow - then back to normal

	color_prompt_destination="$(tput setaf 3)"
	color_prompt_reset="$(tput sgr 0)"

	echo -n -e "[  ${color_prompt_destination}${destination}${color_prompt_reset}  ] >_ ? "

	read -r -s password

	echo

	sshpass					\
		-p "${password}"	\
							ssh -X "${@}"

	unset destination

	unset password

}
