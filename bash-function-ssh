#!/bin/bash

# loaded by "${HOME}"/.local/bin/bash-functions

# ssh ──────────────────────────────────────────────────────────────────────────

ssh () {

	local prefix_option="-"
	local prefix_home="~"
	local pattern_option_value="^-[BbcDEeFIiJLlmOoPpQRSWw]$"
	local keyword_identity="identityfile"
	local option_host_key="StrictHostKeyChecking=accept-new"
	local color_index_destination="3"
	local color_index_reset="0"
	local host_destination
	local argument_ssh
	local argument_previous
	local color_destination
	local color_reset
	local password_ssh
	local status_ssh
	local name_option
	local file_identity
	local state_key="false"

	# destination - first argument that is neither an option nor an option value

	for argument_ssh in "${@}"
	do
		if [[ "${argument_ssh}" != "${prefix_option}"* ]] && [[ ! "${argument_previous}" =~ ${pattern_option_value} ]]
		then
			host_destination="${argument_ssh}"

			break
		fi

		argument_previous="${argument_ssh}"
	done

	# no destination - options only - plain ssh

	if [ -z "${host_destination}" ]
	then
		command ssh "${@}"

		return "${?}"
	fi

	# key host - an identity file ssh would offer exists - key login - no prompt

	# session started after the loop - inside it stdin would be the ssh -G output

	while read -r name_option file_identity
	do
		file_identity="${file_identity/#"${prefix_home}"/${HOME}}"

		if [ "${name_option}" = "${keyword_identity}" ] && [ -f "${file_identity}" ]
		then
			state_key="true"

			break
		fi
	done < <(command ssh -G "${@}" 2> "${sink}")

	if [ "${state_key}" = "true" ]
	then
		command ssh -X "${@}"

		return "${?}"
	fi

	# password prompt colors: destination in yellow - then back to normal

	color_destination="$(tput setaf "${color_index_destination}")"
	color_reset="$(tput sgr "${color_index_reset}")"

	echo -n -e "[  ${color_destination}${host_destination}${color_reset}  ] >_ ? "

	read -r -s password_ssh

	echo

	# empty password - plain ssh - key login and its own prompts

	if [ -z "${password_ssh}" ]
	then
		command ssh -X "${@}"

		return "${?}"
	fi

	# password passed through the environment - not shown in the process list
	# new host keys accepted - changed host keys still refused

	SSHPASS="${password_ssh}"			\
		sshpass -e						\
			ssh -X						\
				-o "${option_host_key}"	\
										"${@}"

	status_ssh="${?}"

	unset password_ssh

	# sshpass and ssh failures reported - other codes belong to the remote command

	if [ "${status_ssh}" -eq 5 ]
	then
		frobulator.err "Login refused - incorrect password" "[ ${host_destination} ]"

	elif [ "${status_ssh}" -eq 6 ]
	then
		frobulator.err "Host key unknown - not accepted" "[ ${host_destination} ]"

	elif [ "${status_ssh}" -eq 255 ]
	then
		frobulator.err "Connection failed" "[ ${host_destination} ]"
	fi

	return "${status_ssh}"

}
