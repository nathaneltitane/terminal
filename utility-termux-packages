#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

selection=()

while (( $# ))
do
	case "${1}"
	in
		-a|--all)
			selection+=(all)
		;;

		-t|--termux)
			selection+=(termux)
		;;

		-i|--api)
			selection+=(api)
		;;

		-g|--gui)
			selection+=(gui)
		;;

		-s|--styling)
			selection+=(styling)
		;;

		-k|--tasker)
			selection+=(tasker)
		;;

		-x|--x11)
			selection+=(x11)
		;;

		-d|--directory)
			directory="${2}"

			shift
		;;

		-f|--force)
			force=true
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -a | -t -i -g -s -k -x -d [Directory] -f | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-a, --all          Update [a]ll packages - default without selection."
			echo
			echo -e "-t, --termux       Update the [t]ermux app."
			echo
			echo -e "-i, --api          Update the termux-ap[i] addon."
			echo
			echo -e "-g, --gui          Update the termux-[g]ui addon."
			echo
			echo -e "-s, --styling      Update the termux-[s]tyling addon."
			echo
			echo -e "-k, --tasker       Update the termux-tas[k]er addon."
			echo
			echo -e "-x, --x11          Update the termux-[x]11 addon and package."
			echo
			echo -e "-d, --directory    Specify target [d]irectory."
			echo
			echo -e "                   [ script directory ] [ Default ]"
			echo
			echo -e "-f, --force        Allow [f]orced download of unchanged packages."
			echo
			echo -e "-h, --help         Show [h]elp and usage information."
			echo
			echo -e "'${script}'        [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -a | -t -i -g -s -k -x -d [Directory] -f | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

url_github_api="${marker_hts}api.github.com/repos/termux"

# package sources:
# package | repository | release (latest / newest / tag) | asset name ending | file

list_sources_package=(
	"termux|termux-app|latest|_arm64-v8a.apk|package-termux.apk"
	"termux|termux-app|latest|_x86_64.apk|package-termux-x86-64.apk"
	"api|termux-api|latest|.apk|package-termux-api.apk"
	"gui|termux-gui|newest|.apk|package-termux-gui.apk"
	"styling|termux-styling|latest|.apk|package-termux-styling.apk"
	"tasker|termux-tasker|latest|.apk|package-termux-tasker.apk"
	"x11|termux-x11|nightly|-universal-debug.apk|package-termux-x11.apk"
	"x11|termux-x11|nightly|-universal-debug.apk|package-termux-x11-x86-64.apk"
	"x11|termux-x11|nightly|-all.deb|package-termux-x11.deb"
)

declare -A list_cache_release
declare -A list_versions_package

# defaults ─────────────────────────────────────────────────────────────────────

if [ "${#selection[@]}" -eq 0 ] || [[ " ${selection[*]} " = *" all "* ]]
then
	selection=(termux api gui styling tasker x11)
fi

if [[ "${directory}" = -* ]]
then
	frobulator.err "Missing argument for '--directory'."

	exit 1
fi

# packages are served from the repository holding this script

if [ -z "${directory}" ]
then
	file_script="$(readlink -f -- "${BASH_SOURCE[0]}")"

	directory="$(dirname -- "${file_script}")"
fi

directory="${directory%/}"

# asset ids of downloaded packages - unchanged ones are skipped

file_versions="${directory}/package-termux.versions"

# functions ────────────────────────────────────────────────────────────────────

versions_load () {

	local name_file_versions
	local id_asset_versions

	if [ ! -f "${file_versions}" ]
	then
		return 0
	fi

	while read -r name_file_versions id_asset_versions
	do
		if [ -n "${name_file_versions}" ]
		then
			list_versions_package["${name_file_versions}"]="${id_asset_versions}"
		fi
	done < "${file_versions}"
}

versions_save () {

	local name_file_versions

	for name_file_versions in "${!list_versions_package[@]}"
	do
		echo "${name_file_versions} ${list_versions_package[${name_file_versions}]}"
	done | sort > "${file_versions}"
}

release_fetch () {

	# repository release json - fetched once per run

	local repository_release="${1}"
	local selector_release="${2}"
	local key_release="${repository_release}|${selector_release}"

	local url_release

	if [ -n "${list_cache_release[${key_release}]}" ]
	then
		return 0
	fi

	if [ "${selector_release}" = "latest" ]
	then
		url_release="${url_github_api}/${repository_release}/releases/latest"

	elif [ "${selector_release}" = "newest" ]
	then
		url_release="${url_github_api}/${repository_release}/releases?per_page=1"
	else
		url_release="${url_github_api}/${repository_release}/releases/tags/${selector_release}"
	fi

	list_cache_release["${key_release}"]="$(
		curl --silent --fail --location --connect-timeout 30 "${url_release}" 2> "${sink}" |
			jq -c 'if type == "array" then .[0] else . end' 2> "${sink}"
	)"
}

package_update () {

	# download every file of one package that changed upstream

	local package="${1}"
	local status_package=0

	local entry_source
	local name_package_source
	local repository_source
	local release_source
	local suffix_source
	local file_source
	local json_release
	local tag_release
	local id_asset
	local url_asset

	for entry_source in "${list_sources_package[@]}"
	do
		IFS='|' read -r name_package_source repository_source release_source suffix_source file_source <<< "${entry_source}"

		if [ "${name_package_source}" != "${package}" ]
		then
			continue
		fi

		release_fetch "${repository_source}" "${release_source}"

		json_release="${list_cache_release[${repository_source}|${release_source}]}"

		tag_release="$(jq -r '.tag_name // empty' <<< "${json_release}" 2> "${sink}")"

		read -r id_asset url_asset < <(
			jq -r --arg suffix "${suffix_source}" \
				'[.assets[]? | select(.name | endswith($suffix))][0] // empty | "\(.id) \(.browser_download_url)"' \
				<<< "${json_release}" 2> "${sink}"
		)

		if [ -z "${url_asset}" ]
		then
			frobulator.err "Release unavailable - ${package}" "[ '${file_source}'${marker_spc}${marker_hnt}${marker_spc}${repository_source} ]"

			status_package=1

			continue
		fi

		if [ "${force}" != true ] && [ -f "${directory}/${file_source}" ] &&
		   [ "${list_versions_package[${file_source}]}" = "${id_asset}" ]
		then
			frobulator.inf "Up to date - ${package}" "[ '${file_source}'${marker_spc}${marker_hnt}${marker_spc}${tag_release} ]"

			continue
		fi

		frobulator.download "${url_asset}" "${directory}/${file_source}"

		if [ "${?}" -ne 0 ]
		then
			status_package=1

			continue
		fi

		list_versions_package["${file_source}"]="${id_asset}"
	done

	return "${status_package}"
}

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(
	curl
	jq
)

frobulator.require ${list[@]}

list=()

# configuration ────────────────────────────────────────────────────────────────

if [ ! -d "${directory}" ]
then
	frobulator.err "Directory not found" "[ ${directory} ]"

	exit 1
fi

frobulator.inf "Target directory" "[ ${directory} ]"

versions_load

for package in "${selection[@]}"
do
	package_update "${package}"

	frobulator.complete continue "Package update failure" "[ ${package} ]"
done

versions_save

frobulator.ownership "${directory}"

frobulator.result "${script}"
