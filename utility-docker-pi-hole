#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (($#))
do
	case "${1}"
	in
		-n|--name)
			docker_image_name="${2}"

			shift
		;;

		-a|--address)
			docker_image_address="${2}"

			shift
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -n [Name] -a [Address] | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-n, --name       Specify [n]ame of the deployed container."
			echo
			echo -e "                 [ pihole ] [ Default ]"
			echo
			echo -e "-a, --address    Specify LAN [a]ddress to bind for FTL DNS resolution."
			echo
			echo -e "                 [ XXX.XXX.XXX.XXX ]"
			echo
			echo -e "-h, --help       Show [h]elp and usage information."
			echo
			echo -e "'${script}'      [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -n [Name] -a [Address] | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

docker_image_name="${docker_image_name:-pihole}"
docker_image_address="${docker_image_address:-192.168.86.13}"
docker_image_base="/var"
docker_image_container="docker"
docker_image_directory="${docker_image_base}"/"${docker_image_container}"/"${docker_image_name}"
docker_image_source="${docker_image_name}"/"${docker_image_name}:latest"

# defaults ─────────────────────────────────────────────────────────────────────

# functions ────────────────────────────────────────────────────────────────────

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(
	docker
	docker-clean
	docker-compose
	docker-registry
	docker.io
)

frobulator.require ${list[@]}

frobulator.complete

list=()

# configuration ────────────────────────────────────────────────────────────────

if [[ ! -d "${docker_image_directory}" ]]
then
	frobulator.directory "${docker_image_base}/${docker_image_container}" "${docker_image_name}"

	frobulator.complete
else
	frobulator.log "docker stop ${docker_image_name}"

	frobulator.complete

	frobulator.log "docker rm -f ${docker_image_name}"

	frobulator.complete

	frobulator.delete "${docker_image_base}/${docker_image_container}" "${docker_image_name}"

	frobulator.complete

	frobulator.directory "${docker_image_base}/${docker_image_container}" "${docker_image_name}"

	frobulator.complete
fi

frobulator.inf "Deploying" "[ ${docker_image_name} ]"

frobulator.fwd "Deploying..."

docker run																					\
	--detach																				\
	--name "${docker_image_name}"															\
	--dns=127.0.0.1																			\
	--dns=1.1.1.1																			\
	--restart=unless-stopped																\
	--hostname "${docker_image_name}"														\
	-p 53:53/tcp																			\
	-p 53:53/udp																			\
	-p 80:80																				\
	-v "${docker_image_directory}/etc-${docker_image_name}:/etc/${docker_image_name}"		\
	-v "${docker_image_directory}/etc-dnsmasq.d:/etc/dnsmasq.d"								\
	-e tz="america/toronto"																	\
	-e virtual_host="${docker_image_name}"													\
	-e proxy_location="${docker_image_name}"												\
	-e ftlconf_local_ipv4="${docker_image_address}"											\
																							"${docker_image_source}" > "${sink}" 2>&1

frobulator.complete

docker_image_id=$(docker container ls --all --quiet --filter "name=${docker_image_name}")

frobulator.complete

seconds="0"
timeout="30"

while [ -z "${docker_image_password}" ] && [ "${seconds}" -lt "${timeout}" ]
do
	docker_image_password=$(docker logs "${docker_image_name}" 2> "${sink}" | grep 'password:' | cut -d ':' -f 2 | sed 's/^ //')

	if [ -z "${docker_image_password}" ]
	then
		sleep 1

		seconds=$(( seconds + 1 ))
	fi
done

frobulator.complete

frobulator.write "append" "${docker_image_password}" "${docker_image_directory}" password

frobulator.complete

frobulator.inf "Image ID" "[ ${docker_image_id} ]"

frobulator.inf "Password" "[ ${docker_image_password} ]"

frobulator.result "${script}"

frobulator.scs "Done"
