#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-n|--name)
			name_image_docker="${2}"

			shift
		;;

		-a|--address)
			address_docker="${2}"

			shift
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -n [Name] -a [Address] | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-n, --name       Specify [n]ame of the deployed container."
			echo
			echo -e "                 [ pihole ] [ Default ]"
			echo
			echo -e "-a, --address    Specify LAN [a]ddress to bind for FTL DNS resolution."
			echo
			echo -e "                 [ XXX.XXX.XXX.XXX ]"
			echo
			echo -e "-h, --help       Show [h]elp and usage information."
			echo
			echo -e "'${script}'      [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -n [Name] -a [Address] | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

name_image_docker="${name_image_docker:-pihole}"
address_docker="${address_docker:-192.168.86.13}"
directory_base_docker="/var"
name_directory_docker="docker"
directory_image_docker="${directory_base_docker}"/"${name_directory_docker}"/"${name_image_docker}"
source_image_docker="${name_image_docker}"/"${name_image_docker}:latest"

# defaults ─────────────────────────────────────────────────────────────────────

# functions ────────────────────────────────────────────────────────────────────

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(
	docker
	docker-clean
	docker-compose
	docker-registry
	docker.io
)

frobulator.require ${list[@]}

frobulator.complete

list=()

# configuration ────────────────────────────────────────────────────────────────

if [[ ! -d "${directory_image_docker}" ]]
then
	frobulator.directory "${directory_base_docker}/${name_directory_docker}" "${name_image_docker}"

	frobulator.complete
else
	frobulator.log "docker stop ${name_image_docker}"

	frobulator.complete

	frobulator.log "docker rm -f ${name_image_docker}"

	frobulator.complete

	frobulator.delete "${directory_base_docker}/${name_directory_docker}" "${name_image_docker}"

	frobulator.complete

	frobulator.directory "${directory_base_docker}/${name_directory_docker}" "${name_image_docker}"

	frobulator.complete
fi

frobulator.inf "Deploying" "[ ${name_image_docker} ]"

frobulator.fwd "Deploying..."

docker run																					\
	--detach																				\
	--name "${name_image_docker}"															\
	--dns=127.0.0.1																			\
	--dns=1.1.1.1																			\
	--restart=unless-stopped																\
	--hostname "${name_image_docker}"														\
	-p 53:53/tcp																			\
	-p 53:53/udp																			\
	-p 80:80																				\
	-v "${directory_image_docker}/etc-${name_image_docker}:/etc/${name_image_docker}"		\
	-v "${directory_image_docker}/etc-dnsmasq.d:/etc/dnsmasq.d"								\
	-e tz="america/toronto"																	\
	-e virtual_host="${name_image_docker}"													\
	-e proxy_location="${name_image_docker}"												\
	-e ftlconf_local_ipv4="${address_docker}"											\
																							"${source_image_docker}" > "${sink}" 2>&1

frobulator.complete

id_image_docker=$(docker container ls --all --quiet --filter "name=${name_image_docker}")

frobulator.complete

seconds="0"
timeout="30"

while [ -z "${password_docker}" ] && [ "${seconds}" -lt "${timeout}" ]
do
	password_docker=$(docker logs "${name_image_docker}" 2> "${sink}" | grep 'password:' | cut -d ':' -f 2 | sed 's/^ //')

	if [ -z "${password_docker}" ]
	then
		sleep 1

		seconds=$(( seconds + 1 ))
	fi
done

frobulator.complete

frobulator.write "append" "${password_docker}" "${directory_image_docker}" password

frobulator.complete

frobulator.inf "Image ID" "[ ${id_image_docker} ]"

frobulator.inf "Password" "[ ${password_docker} ]"

frobulator.result "${script}"

frobulator.scs "Done"
