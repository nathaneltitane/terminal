#!/bin/bash

# loaded by "${HOME}"/.local/bin/bash-functions

# export-vector ────────────────────────────────────────────────────────────────

export-vector () {

	local type_export
	local type_default
	local extension_vector
	local size_width
	local file
	local name_file

	type_default="png"
	extension_vector="svg"
	size_width="4096"

	frobulator.require inkscape

	type_export="${1}"

	if [ -z "${type_export}" ]
	then
		type_export="${type_default}"
	fi

	for file in *."${extension_vector}"
	do
		if [ -f "${file}" ]
		then
			name_file="${file%.*}"

			inkscape "${file}"					\
				--batch-process					\
				--export-width="${size_width}"	\
				--export-area-page				\
				--export-type="${type_export}"	\
				--export-filename="${name_file}"."${type_export}"
		fi
	done
}
