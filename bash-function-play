#!/bin/bash

# loaded by "${HOME}"/.local/bin/bash-functions

# play ─────────────────────────────────────────────────────────────────────────

play () {

	local command_mpv
	local bracket_open
	local bracket_close
	local action
	local file_audio
	local title_audio
	local list_frames_ticker
	local index_frame
	local id_process_player
	local frame_ticker
	local label_action
	local count_arguments_action
	local delay_ticker
	local directory_process
	local sequence_carriage_return
	local sequence_line_continue

	# 'mpv' path - empty if not installed

	# output starts one line below the command

	echo

	command_mpv="$(command -v mpv)"

	if [ -z "${command_mpv}" ]
	then
		frobulator.require mpv
	fi

	bracket_open="[${marker_spc}"
	bracket_close="${marker_spc}]"

	label_action="Playing"
	count_arguments_action="2"
	delay_ticker="0.25"
	directory_process="/proc"
	sequence_carriage_return='\r'
	sequence_line_continue='\c'

	action="${label_action}"

	file_audio="${1}"

	if [ $# -eq "${count_arguments_action}" ]
	then
		action="${1}"

		file_audio="${2}"
	fi

	title_audio="${file_audio##*/}"

	# frobulator.pmt "${@}"

	# substitute standard input for function specific criteria:
	# [ ... ] action ───────────────────────────────────────────...─── [ title_audio ]

	frobulator.pmt "${action}" "${title_audio}"

	prompt="${prompt_string[@]}"

	list_frames_ticker=(
		".  "
		".. "
		"..."
		" .."
		"  ."
		"   "
	)

	index_frame=0

	# player started in the background - no job notices - ticker drawn below while it plays

	frobulator.background --	\
		mpv						\
			--no-video			\
			--really-quiet		\
								"${file_audio}" < "${sink}" > "${sink}" 2>&1

	id_process_player="${frobulator_return[0]}"

	while [ -d "${directory_process}"/"${id_process_player}" ]
	do
		frame_ticker="${list_frames_ticker[index_frame ++ % ${#list_frames_ticker[@]}]}"

		echo -n -e "${sequence_carriage_return}${bracket_open}${frame_ticker}${bracket_close}${reset}${marker_spc}${prompt}${sequence_line_continue}"

		sleep "${delay_ticker}"
	done
}
