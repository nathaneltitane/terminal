#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-22"

# usage ────────────────────────────────────────────────────────────────────────

# set before the help text

mode_install="install"
mode_uninstall="uninstall"
mode_bind="bind"
mode_unbind="unbind"
suffix_slash="/"

while (( $# ))
do
	case "${1}"
	in
		-r|--root)
			directory_root="${2%${suffix_slash}}"

			shift
		;;

		-u|--uninstall)
			option="${mode_uninstall}"
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -r [Directory] -u | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-r, --root         Specify [r]oot directory of another installed system."
			echo
			echo -e "                   [ / ] [ Default ]"
			echo
			echo -e "-u, --uninstall    Run [u]ninstall and restore the text boot."
			echo
			echo -e "-h, --help         Show [h]elp and usage information."
			echo
			echo -e "'${script}'        [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -r [Directory] -u | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

name_theme="refind"
name_kernels="all"

path_themes="/usr/share/plymouth/themes"
path_root="/"

directory_theme="${directory_root}${path_themes}/${name_theme}"
directory_icons="/boot/efi/EFI/refind/themes/icons"

file_options="${directory_root}/boot/refind_linux.conf"
file_modules="${directory_root}/etc/initramfs-tools/modules"
file_refind="/boot/efi/EFI/refind/refind.conf"
file_release="${directory_root}/etc/os-release"
file_mounts="/proc/mounts"
file_logo="logo.png"

directory_systemd="${directory_root}/etc/systemd/system"
directory_sbin="${directory_root}/usr/local/sbin"

format_line='%s\n'
character_quote='"'
permission_executable="755"
permission_readable="644"

# extra splash time before login screen

seconds_splash="2"

line_refind="use_graphics_for linux"
line_modules="# plymouth early graphics"

# silent boot parameters

list_parameters=(
	# boot splash
	splash
	# small native console font
	fbcon=font:VGA8x16
	# kernel errors only
	loglevel=3
	# udev errors only
	udev.log_level=3
	# hidden console cursor
	vt.global_cursor_default=0
	# no systemd status output
	systemd.show_status=false
)

# defaults ─────────────────────────────────────────────────────────────────────

if [ -z "${option}" ]
then
	option="${mode_install}"
fi

# functions ────────────────────────────────────────────────────────────────────

# use to run commands on target system

intent_run () {

	if [ -n "${directory_root}" ]
	then
		chroot "${directory_root}" "${@}"
	else
		"${@}"
	fi
}

# use to bind system mounts into target

intent_mounts () {

	local mode="${1}"
	local item
	local index_mount
	local text_mounts

	local -a list_mounts=(
		dev
		dev/pts
		proc
		sys
		run
	)

	if [ -z "${directory_root}" ]
	then
		return
	fi

	text_mounts="$(< "${file_mounts}")"

	if [ "${mode}" = "${mode_bind}" ]
	then
		for item in "${list_mounts[@]}"
		do
			if [[ "${text_mounts}" != *" ${directory_root}/${item} "* ]]
			then
				mount --bind "${path_root}${item}" "${directory_root}/${item}"
			fi
		done
	else
		# unmount in reverse

		for (( index_mount = ${#list_mounts[@]} - 1; index_mount >= 0; index_mount -- ))
		do
			item="${list_mounts[${index_mount}]}"

			if [[ "${text_mounts}" == *" ${directory_root}/${item} "* ]]
			then
				umount "${directory_root}/${item}"
			fi
		done
	fi
}

# use to set kernel boot parameters

intent_options () {

	local mode="${1}"
	local index_line
	local line_options
	local list_keep
	local list_line
	local list_option
	local option_boot
	local options_boot
	local prefix_entry
	local option_quiet

	prefix_entry='"Boot with standard options"'
	option_quiet="quiet"

	if [ ! -f "${file_options}" ]
	then
		frobulator.wrn "No rEFInd boot options" "[ ${file_options} ]"

		return
	fi

	mapfile -t list_line < "${file_options}"

	for index_line in "${!list_line[@]}"
	do
		line_options="${list_line[${index_line}]}"

		# standard entry only

		if [[ "${line_options}" != ${prefix_entry}* ]]
		then
			continue
		fi

		options_boot="${line_options%${character_quote}}"
		options_boot="${options_boot##*${character_quote}}"

		read -r -a list_option <<< "${options_boot}"

		list_keep=()

		# managed options matched by name

		for option_boot in "${list_option[@]}"
		do
			if [[ " ${list_parameters[*]%%=*} " != *" ${option_boot%%=*} "* ]]
			then
				list_keep+=("${option_boot}")
			fi
		done

		if [ "${mode}" = "${mode_install}" ]
		then
			if [[ " ${list_keep[*]} " != *" ${option_quiet} "* ]]
			then
				list_keep+=("${option_quiet}")
			fi

			list_keep+=("${list_parameters[@]}")
		fi

		list_line[${index_line}]="${line_options%${character_quote}${options_boot}${character_quote}}${character_quote}${list_keep[*]}${character_quote}"

		frobulator.add "Boot options" "[ ${list_keep[*]} ]"
	done

	printf "${format_line}" "${list_line[@]}" > "${file_options}"
}

# use to load graphics driver early

intent_modules () {

	local mode="${1}"
	local directory_card
	local directory_driver
	local index_line
	local list_drivers=()
	local list_keep=()
	local list_line=()
	local name_driver
	local pattern_card
	local pattern_connector
	local path_driver

	pattern_card="/sys/class/drm/card*"
	pattern_connector="*-*"
	path_driver="device/driver"

	if [ -f "${file_modules}" ]
	then
		mapfile -t list_line < "${file_modules}"
	fi

	# drop previous block

	for (( index_line = 0; index_line < ${#list_line[@]}; index_line ++ ))
	do
		if [ "${list_line[${index_line}]}" = "${line_modules}" ]
		then
			(( index_line ++ ))

			continue
		fi

		list_keep+=("${list_line[${index_line}]}")
	done

	if [ "${mode}" = "${mode_install}" ]
	then
		# drivers of display cards

		for directory_card in ${pattern_card}
		do
			if [[ "${directory_card##*/}" == ${pattern_connector} ]] || [ ! -d "${directory_card}"/"${path_driver}" ]
			then
				continue
			fi

			directory_driver="$(readlink --canonicalize "${directory_card}"/"${path_driver}")"
			name_driver="${directory_driver##*/}"

			if [[ " ${list_drivers[*]} " != *" ${name_driver} "* ]]
			then
				list_drivers+=("${name_driver}")
			fi
		done

		for name_driver in "${list_drivers[@]}"
		do
			list_keep+=("${line_modules}" "${name_driver}")

			frobulator.add "Early graphics" "[ ${name_driver} ]"
		done
	fi

	printf "${format_line}" "${list_keep[@]}" > "${file_modules}"
}

# use to keep refind in graphics mode

intent_refind () {

	local mode="${1}"
	local item
	local list_keep=()
	local list_line

	if [ ! -f "${file_refind}" ]
	then
		return
	fi

	mapfile -t list_line < "${file_refind}"

	for item in "${list_line[@]}"
	do
		if [ "${item}" != "${line_refind}" ]
		then
			list_keep+=("${item}")
		fi
	done

	if [ "${mode}" = "${mode_install}" ]
	then
		list_keep+=("${line_refind}")
	fi

	printf "${format_line}" "${list_keep[@]}" > "${file_refind}"
}

# use to show logo longer

intent_quit () {

	local mode="${1}"
	local name_quit_directory
	local name_manager_directory
	local name_quit_file
	local name_manager_file

	name_quit_directory="plymouth-quit.service.d"
	name_manager_directory="display-manager.service.d"
	name_quit_file="delay.conf"
	name_manager_file="plymouth.conf"

	if [ "${mode}" = "${mode_install}" ]
	then
		mkdir --parents "${directory_systemd}"/"${name_quit_directory}" "${directory_systemd}"/"${name_manager_directory}"

		# splash delay and console font missed while splash held tty1

		cat <<- FILE > "${directory_systemd}"/"${name_quit_directory}"/"${name_quit_file}"
			[Service]
			ExecStartPre=/bin/sleep ${seconds_splash}
			ExecStartPost=-/bin/sh -c '[ -f /etc/console-setup/cached_setup_font.sh ] && exec /bin/sh /etc/console-setup/cached_setup_font.sh'
		FILE

		# login screen after splash

		cat <<- 'FILE' > "${directory_systemd}"/"${name_manager_directory}"/"${name_manager_file}"
			[Unit]
			After=plymouth-quit.service
		FILE
	else
		frobulator.delete "${directory_systemd}"/"${name_quit_directory}" "${name_quit_file}"

		frobulator.delete "${directory_systemd}"/"${name_manager_directory}" "${name_manager_file}"
	fi
}

# use to silence reboot broadcasts

intent_wall () {

	local mode="${1}"
	local item
	local name_logind_directory
	local name_logind_file
	local name_wrapper
	local marker_wrapper
	local file_wrapper
	local text_wrapper

	local -a list_power=(
		poweroff
		halt
		shutdown
	)

	name_logind_directory="systemd-logind.service.d"
	name_logind_file="wall.conf"
	name_wrapper="reboot"
	marker_wrapper="without reboot broadcast"
	file_wrapper="${directory_sbin}"/"${name_wrapper}"

	if [ "${mode}" = "${mode_install}" ]
	then
		mkdir --parents "${directory_systemd}"/"${name_logind_directory}" "${directory_sbin}"

		cat <<- 'FILE' > "${directory_systemd}"/"${name_logind_directory}"/"${name_logind_file}"
			[Service]
			ExecStartPost=-/usr/bin/busctl call org.freedesktop.login1 /org/freedesktop/login1 org.freedesktop.login1.Manager SetWallMessage sb "" false
		FILE

		# power commands ahead of systemctl links

		cat <<- 'FILE' > "${file_wrapper}"
			#!/bin/bash

			# power commands without reboot broadcast

			exec -a "${0##*/}" /usr/bin/systemctl --no-wall "${@}"
		FILE

		chmod "${permission_executable}" "${file_wrapper}"

		for item in "${list_power[@]}"
		do
			ln --symbolic --force "${name_wrapper}" "${directory_sbin}/${item}"
		done
	else
		frobulator.delete "${directory_systemd}"/"${name_logind_directory}" "${name_logind_file}"

		# own wrapper only

		if [ -f "${file_wrapper}" ]
		then
			text_wrapper="$(< "${file_wrapper}")"
		fi

		if [ -f "${file_wrapper}" ] && [[ "${text_wrapper}" == *"${marker_wrapper}"* ]]
		then
			for item in "${name_wrapper}" "${list_power[@]}"
			do
				frobulator.delete "${directory_sbin}" "${item}"
			done
		fi
	fi
}

# use to write plymouth theme

intent_theme () {

	local file_icon
	local name_distribution
	local name_entry
	local value_entry
	local separator_entry
	local name_key_distribution
	local prefix_icon
	local suffix_icon
	local name_distribution_default

	separator_entry="="
	name_key_distribution="ID"
	prefix_icon="os_"
	suffix_icon=".png"
	name_distribution_default="linux"

	# distribution icon from refind theme

	while IFS="${separator_entry}" read -r name_entry value_entry
	do
		if [ "${name_entry}" = "${name_key_distribution}" ]
		then
			name_distribution="${value_entry//${character_quote}/}"
		fi
	done < "${file_release}"

	file_icon="${directory_icons}/${prefix_icon}${name_distribution}${suffix_icon}"

	if [ ! -f "${file_icon}" ]
	then
		file_icon="${directory_icons}/${prefix_icon}${name_distribution_default}${suffix_icon}"
	fi

	# system folders stay root owned

	mkdir --parents "${directory_theme}"

	cp "${file_icon}" "${directory_theme}"/"${file_logo}"

	chmod "${permission_readable}" "${directory_theme}"/"${file_logo}"

	cat <<- FILE > "${directory_theme}/${name_theme}.plymouth"
		[Plymouth Theme]
		Name=${name_theme}
		Description=refind background with distribution logo
		ModuleName=script

		[script]
		ImageDir=${path_themes}/${name_theme}
		ScriptFile=${path_themes}/${name_theme}/${name_theme}.script
	FILE

	cat <<- 'FILE' > "${directory_theme}/${name_theme}.script"
		# refind banner color

		Window.SetBackgroundTopColor(0.008, 0.024, 0.024);
		Window.SetBackgroundBottomColor(0.008, 0.024, 0.024);

		# centered logo

		logo.image = Image("logo.png");
		logo.sprite = Sprite(logo.image);
		logo.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
		logo.sprite.SetY(Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2);

		# text under logo

		message.sprite = Sprite();

		fun message_show (text)
		{
			global.message.image = Image.Text(text, 0.8, 0.8, 0.8);
			global.message.sprite.SetImage(global.message.image);
			global.message.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - global.message.image.GetWidth() / 2);
			global.message.sprite.SetY(global.logo.sprite.GetY() + global.logo.image.GetHeight() + 48);
			global.message.sprite.SetOpacity(1);
		}

		fun message_hide ()
		{
			global.message.sprite.SetOpacity(0);
		}

		# password prompt

		fun password_show (prompt, bullets)
		{
			text = prompt + " ";

			for (index = 0; index < bullets; index++)
				text = text + "*";

			message_show(text);
		}

		# question prompt

		fun question_show (prompt, entry)
		{
			message_show(prompt + " " + entry);
		}

		Plymouth.SetDisplayPasswordFunction(password_show);
		Plymouth.SetDisplayQuestionFunction(question_show);
		Plymouth.SetDisplayNormalFunction(message_hide);
		Plymouth.SetMessageFunction(message_show);
	FILE
}

# update ───────────────────────────────────────────────────────────────────────

frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(

)

frobulator.require ${list[@]}

list=()

# configuration ────────────────────────────────────────────────────────────────

if [ -n "${directory_root}" ] && [ ! -f "${file_release}" ]
then
	frobulator.err "No system found" "[ ${directory_root} ]"

	exit 1
fi

intent_mounts "${mode_bind}"

if [ "${option}" = "${mode_install}" ]
then
	frobulator.inf "Setting up silent boot" "[ ${directory_root:-${path_root}} ]"

	intent_run apt-get install --yes plymouth plymouth-label > "${sink}" 2>&1

	frobulator.complete halt "Package install failed" "[ plymouth ]"

	intent_theme

	intent_run plymouth-set-default-theme "${name_theme}"

	frobulator.complete

	intent_modules "${mode_install}"

	intent_options "${mode_install}"

	intent_refind "${mode_install}"

	intent_quit "${mode_install}"

	intent_wall "${mode_install}"
fi

if [ "${option}" = "${mode_uninstall}" ]
then
	frobulator.inf "Restoring text boot" "[ ${directory_root:-${path_root}} ]"

	intent_run plymouth-set-default-theme --reset

	frobulator.delete "${directory_root}${path_themes}" "${name_theme}"

	intent_modules "${mode_uninstall}"

	intent_options "${mode_uninstall}"

	intent_quit "${mode_uninstall}"

	intent_wall "${mode_uninstall}"

	# shared refind setting kept for other systems

	if [ -z "${directory_root}" ]
	then
		intent_refind "${mode_uninstall}"
	fi
fi

frobulator.fwd "Updating initramfs"

intent_run update-initramfs -u -k "${name_kernels}" > "${sink}" 2>&1

frobulator.complete

intent_mounts "${mode_unbind}"

frobulator.result "${script}"
