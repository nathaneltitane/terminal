#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

list_sites=()

while (( $# ))
do
	case "${1}"
	in
		-s|--site)
			list_sites+=("${2}")

			shift
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -s [Site] [-s [Site] ...] | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-s, --site    Specify [s]ite to configure - repeatable for multiple sites."
			echo
			echo -e "              [ mechablocks ] [ Default ]"
			echo
			echo -e "-h, --help    Show [h]elp and usage information."
			echo
			echo -e "'${script}'   [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -s [Site] [-s [Site] ...] | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

directory_web_development=/var/www

process="apache2"
service="${process}.service"

web="www"
hostname="${HOSTNAME}"

ip=$(hostname -I)
ip="${ip%% *}"

list_sites=("${list_sites[@]:-mechablocks}")

# defaults ─────────────────────────────────────────────────────────────────────

# functions ────────────────────────────────────────────────────────────────────

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(
	apache2
)

frobulator.require ${list[@]}

frobulator.complete

list=()

# configuration ────────────────────────────────────────────────────────────────

# sites

for item in "${list_sites[@]}"
do
	frobulator.directory "${directory_web_development}" "${item}"

	frobulator.complete

	content_vhost=$(cat <<- FILE
	<VirtualHost *:80>
		ServerName ${item}.local
		DocumentRoot /var/www/${item}/

		<Directory "/var/www/${item}/">
			Options None
			AllowOverride None
			Order allow,deny
			Allow from all
		</Directory>

		ErrorLog /var/log/${item}-error.log
		CustomLog /var/log/${item}-access.log combined
	</VirtualHost>
	FILE
	)

	frobulator.write "write" "${content_vhost}" /etc/apache2/sites-available "${item}.conf"

	frobulator.complete

	# site activation report: 'enabled' on success - 'error' on failure

	output_site_activation="$(a2ensite "${item}".conf)"

	line_site_enabled="$(echo "${output_site_activation}" | grep -e "enabled")"
	line_site_error="$(echo "${output_site_activation}" | grep -e "error")"

	if [ -n "${line_site_enabled}" ]
	then
		frobulator.scs "Configuration validation success" "[ ${item} ]"
	elif [ -n "${line_site_error}" ]
	then
		frobulator.err "Configuration validation failed" "[ ${item} ]"

		exit 1
	fi

	# site hosts file entry - empty if missing

	line_hosts_entry="$(grep -F "${item}.local" /etc/hosts)"

	if [ -z "${line_hosts_entry}" ]
	then
		frobulator.write "append" "127.0.0.1$(printf '\t\t')${item}.local" /etc hosts

		frobulator.complete
	fi

	frobulator.inf "Setting ownership"

	chmod -R 755 "${directory_web_development}"/"${item}"

	frobulator.complete

	chown -R "${USER}":"${USER}" "${directory_web_development}"/"${item}"

	frobulator.complete

done

# service activation

frobulator.service activate "${service}"

frobulator.complete halt

frobulator.complete

frobulator.result "${script}"

frobulator.scs "Done"
