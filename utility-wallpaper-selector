#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (($#))
do
	case "${1}"
	in
		-h|--help)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-h, --help    Show [h]elp and usage information."
			echo
			echo -e "'${script}'   [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# prompt ───────────────────────────────────────────────────────────────────────

# variables ────────────────────────────────────────────────────────────────────

# defaults ─────────────────────────────────────────────────────────────────────

# functions ────────────────────────────────────────────────────────────────────

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(
	gsettings
	zenity
)

frobulator.require ${list[@]}

list=()

# configuration ────────────────────────────────────────────────────────────────

cat <<- 'FILE' > /usr/bin/wallpaper-selector
#!/bin/bash

# wallpaper selector #

rgb_to_hex () {

	IFS='(,)'

	read _ value_red value_green value_blue <<< "${1}"

	printf '%02x%02x%02x\n' ${value_red} ${value_green} ${value_blue}
}

hex_to_rgb () {

	read code_hex <<< "${1}"

	[[ ${code_hex:0:1} = "#" ]] && code_hex=${code_hex:1:6}

	value_red=$(( 16#${code_hex:0:2} ))
	value_green=$(( 16#${code_hex:2:2} ))
	value_blue=$(( 16#${code_hex:4:2} ))

	printf '%03d %03d %03d\n' ${value_red} ${value_green} ${value_blue}
}

color_default="333333"

input_color="$(zenity --color-selection --color="${color_default}" --show-palette)"
code_hex_selection=$(rgb_to_hex "${input_color}")

if [ ! -z "${input_color}" ]
then
	color="#${code_hex_selection}"
else
	color="#${color_default}"
fi

# desktop #

gsettings set org.gnome.desktop.background primary-color "{$color}"
gsettings set org.gnome.desktop.background secondary-color "{$color}"
gsettings set org.gnome.desktop.background picture-uri "''"

# lockscreen #

gsettings set org.gnome.desktop.screensaver primary-color "{$color}"
gsettings set org.gnome.desktop.screensaver secondary-color "{$color}"
gsettings set org.gnome.desktop.screensaver picture-uri "''"

# login screen #

gsettings set org.gnome.desktop.background primary-color "{$color}"
gsettings set org.gnome.desktop.background secondary-color "{$color}"
gsettings set org.gnome.desktop.background picture-uri "''"

	unset command_picture_option

	command_picture_option+="zenity"
	command_picture_option+=" --title='Select a picture option'"
	command_picture_option+=" --width=300"
	command_picture_option+=" --height=250"
	command_picture_option+=" --text='Specify an image layout option'"
	command_picture_option+=" --list"
	command_picture_option+=" --radiolist"
	command_picture_option+=" --column=Selection"
	command_picture_option+=" TRUE"
	command_picture_option+=" FALSE"
	command_picture_option+=" FALSE"
	command_picture_option+=" FALSE"
	command_picture_option+=" FALSE"
	command_picture_option+=" FALSE"
	command_picture_option+=" --column=Option"
	command_picture_option+=" wallpaper"
	command_picture_option+=" center"
	command_picture_option+=" scaled"
	command_picture_option+=" stretched"
	command_picture_option+=" zoom"
	command_picture_option+=" spanned"

	${command_picture_option} 2> "${sink}"

command_picture_uri+="zenity"
command_picture_uri+=" --file-selection"
command_picture_uri+=" --separator=$'\n'"
command_picture_uri+=" --title='Select a Directory'"

${command_picture_uri} 2> "${sink}"

# desktop #

gsettings set org.gnome.desktop.background picture-options "$command_picture_option"
gsettings set org.gnome.desktop.background picture-uri "file:///$command_picture_uri"


# lockscreen #

gsettings set org.gnome.desktop.screensaver picture-options "$command_picture_option"
gsettings set org.gnome.desktop.screensaver picture-uri "file:///$command_picture_uri"


# login screen #

sudo su gdm -s /bin/bash << FILE
gsettings set org.gnome.desktop.background picture-options "$command_picture_option"
gsettings set org.gnome.desktop.background picture-uri "file:///$command_picture_uri"

FILE

sudo chmod +x /usr/bin/wallpaper-selector

# generate launcher

cat <<- 'FILE' > /usr/share/applications/wallpaper-selector.desktop
[Desktop Entry]
Name=Wallpaper Selector
Comment=Select and configure desktop and lock screen background wallpapers
Exec=/usr/bin/wallpaper-selector
Icon=preferences-desktop-wallpaper
Terminal=false
Type=Application
StartupNotify=true
Categories=Utility;
FILE
