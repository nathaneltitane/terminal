#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-p|--prefix)
			lan="${2}"

			shift
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -p [Prefix] | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-p, --prefix    Specify lan [p]refix to scan for open ports."
			echo
			echo -e "                [ XXX.XXX.XXX ]"
			echo -e "                [ (empty) ]     [ Default - detects via 'hostname -I' ]"
			echo
			echo -e "-h, --help      Show [h]elp and usage information."
			echo
			echo -e "'${script}'     [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -p [Prefix] | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

prefix_option="-"
pattern_letters='[a-zA-Z]'
pattern_prefix='^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})'
separator_octet="."
separator_result=":"
format_address_display="%03d.%03d.%03d.%03d"
format_prefix_display="%03d.%03d.%03d"
port_ssh="22"
delay_connect="5"
delay_probe="0.125"
count_host_maximum="255"
count_octet_maximum="255"
count_plural="2"
value_yes="yes"
value_no="no"
label_port="port"
label_ssh="ssh"
label_sftp="sftp"
label_scan="scan"
label_address_single="Address"
label_address_plural="Addresses"
text_denied="permission denied"
text_welcome="welcome"
text_login="last login"
text_prompt="sftp>"

# defaults ─────────────────────────────────────────────────────────────────────

# validate arguments

if [[ "${lan}" = ${prefix_option}* ]]
then
	frobulator.err "Missing argument for '--prefix'."

	exit 1

elif [[ "${lan}" =~ ${pattern_letters} ]]
then
	frobulator.err "Invalid IP address format."

	exit 1
fi

# functions ────────────────────────────────────────────────────────────────────

ssh_scan () {

	lan="${1}"

	# split ip into individual octets

	IFS="${separator_octet}" read -r octet_01 octet_02 octet_03 <<< "${lan%?}"

	for (( octet_host = 1 ; octet_host <= count_host_maximum ; octet_host ++ ))
	do
		# ip used for networking

		address_host="${octet_01}${separator_octet}${octet_02}${separator_octet}${octet_03}${separator_octet}${octet_host}"

		# ip used for informational display

		address_display=$(printf "${format_address_display}" "${octet_01}" "${octet_02}" "${octet_03}" "${octet_host}")

		timeout "${delay_probe}" "${SHELL}" -c "echo > /dev/tcp/${address_host}/${port_ssh}" 2> "${sink}"

		status_probe="${?}"

		if [ "${status_probe}" -eq 0 ]
		then
			echo "${label_port}${separator_result}${address_display}" >> "${file_results}"

			# secure shell

			output_ssh=$(
				ssh									\
					-oBatchMode="${value_yes}"				\
					-oStrictHostKeyChecking="${value_no}"	\
					-oConnectTimeout="${delay_connect}"		\
					-oUserKnownHostsFile="${sink}"			\
														"${address_host}" exit 2>&1
			)

			if [[ "${output_ssh,,}" == *"${text_denied}"* || "${output_ssh,,}" == *"${text_welcome}"* || "${output_ssh,,}" == *"${text_login}"* ]]
			then
				echo "${label_ssh}${separator_result}${address_display}" >> "${file_results}"
			fi

			# secure file transfer

			output_sftp=$(
				sftp								\
					-oBatchMode="${value_yes}"				\
					-oStrictHostKeyChecking="${value_no}"	\
					-oConnectTimeout="${delay_connect}"		\
					-oUserKnownHostsFile="${sink}"			\
														"${address_host}" 2>&1
			)

			if [[ "${output_sftp,,}" == *"${text_prompt}"* || "${output_sftp,,}" == *"${text_denied}"* ]]
			then
				echo "${label_sftp}${separator_result}${address_display}" >> "${file_results}"
			fi

		fi

	done

	# unset IFS

	IFS=''

}

ssh_results () {

	# port

	if [ ${#list_port_open[@]} -gt 0 ]
	then
		if [ ${#list_port_open[@]} -eq 1 ]
		then
			message="${label_address_single}"

		elif [ ${#list_port_open[@]} -ge "${count_plural}" ]
		then
			message="${label_address_plural}"
		fi

		frobulator.inf "${message} with open port found at:"

		for address in "${list_port_open[@]}"
		do
			frobulator.ind "${address}"
		done

	else
		frobulator.wrn "No open port addresse(s) found"
	fi

	# shell

	if [ ${#list_ssh_open[@]} -gt 0 ]
	then
		if [ ${#list_ssh_open[@]} -eq 1 ]
		then
			message="${label_address_single}"

		elif [ ${#list_ssh_open[@]} -ge "${count_plural}" ]
		then
			message="${label_address_plural}"
		fi

		frobulator.inf "${message} with available ssh found at:"

		for address in "${list_ssh_open[@]}"
		do
			frobulator.ind "${address}"
		done

	else
		frobulator.wrn "No available ssh addresse(s) found"
	fi

	# file transfer

	if [ ${#list_sftp_open[@]} -gt 0 ]
	then
		if [ ${#list_sftp_open[@]} -eq 1 ]
		then
			message="${label_address_single}"

		elif [ ${#list_sftp_open[@]} -ge "${count_plural}" ]
		then
			message="${label_address_plural}"
		fi

		frobulator.inf "${message} with available sftp found at:"

		for address in "${list_sftp_open[@]}"
		do
			frobulator.ind "${address}"
		done

	else
		frobulator.wrn "No available sftp addresse(s) found"
	fi

}

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(
	ssh*
)

frobulator.require ${list[@]}

list=()

# configuration ────────────────────────────────────────────────────────────────

if [ -z "${lan}" ]
then
	lan="$(hostname -I 2> "${sink}")"

	lan="${lan%% *}"

	lan="${lan%${separator_octet}*}"

	IFS="${separator_octet}" read -r octet_auto_01 octet_auto_02 octet_auto_03 <<< "${lan}"

	lan=$(printf "${format_prefix_display}" "${octet_auto_01}" "${octet_auto_02}" "${octet_auto_03}")

	frobulator.inf "No prefix - defaulting" "[ ${lan} ]"
fi

# extract and validate first 3 octets

if [[ "${lan}" =~ ${pattern_prefix} ]]
then
	octet_validate_01="${BASH_REMATCH[1]}"
	octet_validate_02="${BASH_REMATCH[2]}"
	octet_validate_03="${BASH_REMATCH[3]}"

	if [ "${octet_validate_01}" -le "${count_octet_maximum}" ] && [ "${octet_validate_02}" -le "${count_octet_maximum}" ] && [ "${octet_validate_03}" -le "${count_octet_maximum}" ]
	then
		lan="${octet_validate_01}${separator_octet}${octet_validate_02}${separator_octet}${octet_validate_03}${separator_octet}"
	else
		unset lan
	fi
else
	unset lan
fi

if [ -z "${lan}" ]
then
	frobulator.err "Invalid lan prefix."

	exit 1
fi

file_results="$(mktemp)"

frobulator.background "${label_scan}" -- ssh_scan "${lan}"

while IFS="${separator_result}" read -r category address
do
	if [ "${category}" = "${label_port}" ]
	then
		list_port_open+=("${address}")
	fi

	if [ "${category}" = "${label_ssh}" ]
	then
		list_ssh_open+=("${address}")
	fi

	if [ "${category}" = "${label_sftp}" ]
	then
		list_sftp_open+=("${address}")
	fi

done < "${file_results}"

rm -f "${file_results}"

ssh_results
