#!/bin/bash

# loaded by "${HOME}"/.local/bin/bash-functions

# extract ──────────────────────────────────────────────────────────────────────

extract () {

	local file
	local directory
	local extension
	local archive
	local extension_tar_bzip
	local extension_tar_bzip_short
	local extension_tar_gzip
	local extension_tar_gzip_short
	local extension_tar
	local extension_7zip
	local extension_rar
	local extension_zip

	# output starts one line below the command

	echo

	list+=(
		7zip
		bunzip2
		gunzip
		tar
		unrar
		unzip
	)

	frobulator.require ${list[@]}

	# unset array

	list=()

	extension_tar_bzip="tar.bz2"
	extension_tar_bzip_short="tbz2"
	extension_tar_gzip="tar.gz"
	extension_tar_gzip_short="tgz"
	extension_tar="tar"
	extension_7zip="7z"
	extension_rar="rar"
	extension_zip="zip"

	file="${1}"
	directory="${2}"
	extension="${3}"

	archive="${file##*/}"

	if [ -z "${directory}" ]
	then
		directory="${PWD}"
	fi

	if [ -z "${extension}" ]
	then
		extension="${file##*.}"
	fi

	if [ ! -d "${directory}" ]
	then
		mkdir --parents "${directory}"
	fi

	if [ "${extension}" = "${extension_tar_bzip}" ] ||
	   [ "${extension}" = "${extension_tar_bzip_short}" ]
	then
		tar								\
			--extract					\
			--bzip2						\
			--file="${file}" 			\
			--directory="${directory}"

		frobulator.inf "Extracting" "[ ${archive} ]"

	elif [ "${extension}" = "${extension_tar_gzip}" ] ||
	     [ "${extension}" = "${extension_tar_gzip_short}" ]
	then
		tar								\
			--extract					\
			--gzip						\
			--file="${file}" 			\
			--directory="${directory}"

		frobulator.inf "Extracting" "[ ${archive} ]"

	elif [ "${extension}" = "${extension_tar}" ]
	then
		tar								\
			--extract					\
			--file="${file}" 			\
			--directory="${directory}"

		frobulator.inf "Extracting" "[ ${archive} ]"

	elif [ "${extension}" = "${extension_7zip}" ]
	then
		7z								\
			x "${file}" 				\
			-o							"${directory}"

		frobulator.inf "Extracting" "[ ${archive} ]"

	elif [ "${extension}" = "${extension_rar}" ]
	then
		unrar e "${file}" "${directory}"

		frobulator.inf "Extracting" "[ ${archive} ]"

	elif [ "${extension}" = "${extension_zip}" ]
	then
		unzip							\
			-o							\
			-qq "${file}"				\
			-d							"${directory}"

		frobulator.inf "Extracting" "[ ${archive} ]"

	else
		frobulator.err "Unsupported archive type" "[ '${archive}' ]"

		return 1

	fi
}
