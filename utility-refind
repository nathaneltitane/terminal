#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-21"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-h|--help)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-h, --help    Show [h]elp and usage information."
			echo
			echo -e "'${script}'   [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

host_download="get.trmnl.me"
directory_boot="/boot"
directory_efi="${directory_boot}/efi"
directory_loaders="${directory_efi}/EFI"
directory_refind="${directory_loaders}/refind"
directory_themes="${directory_refind}/themes"
directory_block="/sys/class/block"
file_firmware="/sys/firmware/efi"
file_release="/etc/os-release"
file_loader="${directory_refind}/refind_x64.efi"
file_configuration="refind.conf"
file_theme="archive-refind-theme.tar.gz"
file_partition="partition"
name_download_configuration="refind-configuration"
name_package_refind="refind"
name_package_grub="grub"
pattern_package_grub='grub*'
pattern_package_shim='shim*'
pattern_secure_boot_disabled="*disabled*"
pattern_entry="^Boot([0-9A-Fa-f]{4})[*[:space:]][[:space:]](.*)$"
separator_tab=$'\t'

# defaults ─────────────────────────────────────────────────────────────────────

# functions ────────────────────────────────────────────────────────────────────

# update ───────────────────────────────────────────────────────────────────────

frobulator.update

frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(

)

frobulator.require ${list[@]}

list=()

# configuration ────────────────────────────────────────────────────────────────

if [ -e "${file_firmware}" ]
then

	# install

	list=(
		"${name_package_refind}"
	)

	frobulator.install ${list[@]}

	list=()

	refind-install --yes 1> "${sink}"

	# purge

	apt purge --yes "${pattern_package_grub}" > "${sink}" 2>&1

	list=(
		"${name_package_grub}"
	)

	frobulator.delete "${directory_boot}" ${list[@]}

	list=()

	# remove

	list=(
		"${file_configuration}"
	)

	frobulator.delete "${directory_refind}" ${list[@]}

	frobulator.download "${host_download}" "${name_download_configuration}" "${directory_refind}" "${file_configuration}"

	frobulator.download "${host_download}" "${directory_themes}" "${file_theme}"

	frobulator.extract "${directory_themes}/${file_theme}" "${directory_themes}"

	frobulator.delete "${directory_themes}" "${file_theme}"

	# cleanup

	# remove leftover efi loaders

	name_distribution="$(source "${file_release}"; echo "${ID}")"

	if [ -f "${file_loader}" ] && [ -n "${name_distribution}" ]
	then
		list=(
			"${name_distribution}"
		)

		frobulator.delete "${directory_loaders}" ${list[@]}

		list=()
	fi

	# purge shim without secure boot

	state_secure_boot="$(mokutil --sb-state 2> "${sink}")"

	if [[ "${state_secure_boot}" = ${pattern_secure_boot_disabled} ]]
	then
		apt purge --yes "${pattern_package_shim}" > "${sink}" 2>&1
	fi

	# remove stale firmware boot entries

	partition_efi="$(findmnt --noheadings --output SOURCE "${directory_efi}")"
	number_partition_efi="$(cat "${directory_block}"/"${partition_efi##*/}"/"${file_partition}" 2> "${sink}")"
	guid_partition_efi="$(lsblk --noheadings --output PARTUUID "${partition_efi}")"

	pattern_path_entry="^hd\(([0-9]+),gpt,${guid_partition_efi,,}"

	mapfile -t list_entries < <(efibootmgr --verbose 2> "${sink}")

	for entry in "${list_entries[@]}"
	do
		if [[ "${entry}" =~ ${pattern_entry} ]]
		then
			number_entry="${BASH_REMATCH[1]}"
			label_entry="${BASH_REMATCH[2]%%"${separator_tab}"*}"
			path_entry="${BASH_REMATCH[2]#*"${separator_tab}"}"

			unset state_entry_remove

			if [ "${label_entry,,}" = "${name_distribution,,}" ]
			then
				state_entry_remove="true"
			fi

			if [[ "${path_entry,,}" =~ ${pattern_path_entry} ]] &&
			   [ "${BASH_REMATCH[1]}" != "${number_partition_efi}" ]
			then
				state_entry_remove="true"
			fi

			if [ "${state_entry_remove}" = "true" ]
			then
				frobulator.rem "Removing boot entry" "[ ${number_entry} // ${label_entry} ]"

				efibootmgr --quiet --bootnum "${number_entry}" --delete-bootnum
			fi
		fi
	done

	unset list_entries state_entry_remove

fi
