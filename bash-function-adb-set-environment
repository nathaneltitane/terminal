#!/bin/bash

# loaded by "${HOME}"/.local/bin/bash-functions

# adb-set-environment ──────────────────────────────────────────────────────────

adb_set_environment () {

	local name_command="adb"
	local name_variable_fwmark="ANDROID_NO_USE_FWMARK"
	local value_fwmark="1"
	local name_variable_socket="ADB_SERVER_SOCKET"
	local prefix_socket="localfilesystem:"
	local directory_adb="${HOME}/.adb"
	local file_socket="${directory_adb}/adb_server_socket"
	local command_adb

	# 'adb' path - empty if not installed

	command_adb="$(command -v "${name_command}")"

	if [ -n "${command_adb}" ]
	then
		export "${name_variable_fwmark}=${value_fwmark}"

		if [ ! -d "${directory_adb}" ]
		then
			mkdir --parents "${directory_adb}"
		fi

		export "${name_variable_socket}=${prefix_socket}${file_socket}"
	fi

}
