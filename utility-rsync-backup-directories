#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

list_keep=()
prune=false

while (( $# ))
do
	case "${1}"
	in
		-s|--source)
			directory_source="${2}"

			shift
		;;

		-d|--destination)
			directory_destination_base="${2}"

			shift
		;;

		-i|--interval)
			interval_periodic="${2}"

			shift
		;;

		-k|--keep)
			list_keep+=("${2}")

			shift
		;;

		-p|--prune)
			prune=true
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -s [Source] -d [Destination] -i [Interval] | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-s, --source         Specify [s]ource directory to mirror from."
			echo
			echo -e "                     [ /media/internal ] [ Default ]"
			echo
			echo -e "-d, --destination    Specify [d]estination directory for the backup drive - 'external' is appended."
			echo
			echo -e "                     [ /media/\${USER} ] [ Default ]"
			echo
			echo -e "-i, --interval       Specify periodic fallback [i]nterval, in seconds."
			echo
			echo -e "                     [ 300 ] [ Default ]"
			echo
			echo -e "-k, --keep           Specify path/pattern to [k]eep on destination - repeatable."
			echo
			echo -e "-p, --prune          Delete items on destination not [p]resent on source."
			echo
			echo -e "                     [ off ] [ Default - nothing is ever deleted ]"
			echo
			echo -e "-h, --help           Show [h]elp and usage information."
			echo
			echo -e "'${script}'          [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -s [Source] -d [Destination] -i [Interval] | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

directory_mount="/media"

directory_source="${directory_source:-${directory_mount}/internal}"
directory_destination_base="${directory_destination_base:-${directory_mount}/${USER}}"
directory_destination="${directory_destination_base}/external"
interval_periodic="${interval_periodic:-300}"

list_arguments_exclude_keep=()

for item_keep in "${list_keep[@]}"
do
	list_arguments_exclude_keep+=(--exclude "${item_keep}")
done

list_arguments_prune=()

if [ "${prune}" = true ]
then
	list_arguments_prune+=(--delete)
fi

file_lock_synchronize="${HOME}"/.local/bin/backup-internal-external-sync-lock

# requirements ─────────────────────────────────────────────────────────────────

list=(
	inotify-tools
	rsync
)

frobulator.require ${list[@]}

frobulator.complete

list=()

# configuration ────────────────────────────────────────────────────────────────

if [ ! -d "${directory_source}" ]
then
	frobulator.err "Source directory not found" "[ ${directory_source} ]"

	exit 1
fi

if [ ! -d "${directory_destination}" ]
then
	frobulator.err "Destination directory not found" "[ ${directory_destination} ]"

	exit 1
fi

# inotify watch limit

# raises the per-user watch limit so recursive monitoring of large trees
# does not silently fail past the default (typically far too low)

count_watches_required="524288"

count_watches_current=$(cat /proc/sys/fs/inotify/max_user_watches)

if [ "${count_watches_current}" -lt "${count_watches_required}" ]
then
	frobulator.inf "Raising inotify watch limit" "[ ${count_watches_required} ]"

	sysctl -w fs.inotify.max_user_watches="${count_watches_required}" > "${sink}"

	frobulator.write "write" "fs.inotify.max_user_watches=${count_watches_required}" /etc/sysctl.d 99-inotify.conf

	frobulator.complete
fi

# mirror

synchronize () {

	exec 200> "${file_lock_synchronize}"

	if ! flock -n 200
	then
		echo "Synchronize already running - skipping"
		return 0
	fi

	echo
	echo "Mirror start"
	echo

	rsync									\
		--archive							\
		"${list_arguments_prune[@]}"			\
		--exclude '.Trash-*'				\
		--exclude 'lost+found'				\
		"${list_arguments_exclude_keep[@]}"		\
									"${directory_source}/" "${directory_destination}/"

	frobulator.fail "Mirror failed"

	echo
	echo "Mirror end"
	echo

}

# initial mirror, then event-driven for source changes, periodic as a fallback

synchronize

(
	while true
	do
		sleep "${interval_periodic}"

		synchronize
	done
) &

inotifywait																\
	--monitor															\
	--recursive															\
	--event modify,create,delete,move,attrib							\
	--exclude '(\.?Trash.*|lost\+found)'								\
																		"${directory_source}" |
while read -r directory_event name_event file_event
do
	state_debounce_pending=true

	while ${state_debounce_pending}
	do
		read -t 2 -r directory_event name_event file_event 2> "${sink}"
		status_read="${?}"

		if [ "${status_read}" -ge 128 ] || [ "${status_read}" -eq 1 ]
		then
			state_debounce_pending=false
		fi
	done

	synchronize
done
