#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (($#))
do
	case "${1}"
	in
		-p|--platform)
			platform="${2}"

			shift
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -p [Platform] | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-p, --platform    Specify target [p]latform to pull and repackage images for."
			echo
			echo -e "                  [ linux/amd64 ]"
			echo -e "                  [ linux/aarch64 ] [ Default ]"
			echo
			echo -e "-h, --help        Show [h]elp and usage information."
			echo
			echo -e "'${script}'       [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -p [Platform] | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

platform="${platform:-linux/aarch64}"

# defaults ─────────────────────────────────────────────────────────────────────

# functions ────────────────────────────────────────────────────────────────────

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(
	docker
	docker-clean
	docker-compose
	docker-registry
	docker.io
	7zip
	bunzip2
	gunzip
	tar
	unrar
	unzip
)

frobulator.require ${list[@]}

frobulator.complete

list=()

# configuration ────────────────────────────────────────────────────────────────

directory_origin="${PWD}"

frobulator.temporary directory_temporary

frobulator.complete

frobulator.trap "${directory_temporary}"

frobulator.complete

if [ -d "${directory_temporary}" ]
then
	cd "${directory_temporary}"

	frobulator.complete
else
	frobulator.err "Directory not found" "[ ${directory_temporary} ]"

	exit 1
fi

declare -A distributions_list=(
	[ubuntu]="18.04 20.04 22.04 24.04"
	[debian]="10 11 12 13"
	[fedora]="38 39 40 41"
)

for distribution in "${!distributions_list[@]}"
do
	for distribution_version in ${distributions_list[${distribution}]}
	do
		docker pull --quiet --platform="${platform}" "${distribution}:${distribution_version}"

		frobulator.complete

		docker image save "${distribution}:${distribution_version}" | xz > "${distribution}-${distribution_version}-container.tar.xz"

		frobulator.complete

		for archive_input in *container.tar.xz
		do
			archive_output="${archive_input/-container.tar.xz/.tar.xz}"

			frobulator.temporary directory_extraction

			frobulator.complete

			frobulator.fwd "Extracting .."

			tar										\
				--extract							\
					--file="${archive_input}"   	\
					--xz                        	\
					--directory="${directory_extraction}"

			frobulator.complete

			archive_layer=$(find "${directory_extraction}" -name "layer.tar")

			if [ -f "${archive_layer}" ]
			then
				xz -c "${archive_layer}" > "${archive_output}"

				mv "${archive_output}" "${directory_origin}"/"${archive_output}"

				frobulator.scs "Repackaged" "[ ${archive_output} ]"
			else
				frobulator.err "'layer.tar' not found in extracted content" "[ ${archive_input} ]"
			fi

			rm -r -f "${directory_extraction}"

			rm -r -f "${archive_input}"
		done
	done
done

if [ -d "${directory_origin}" ]
then
	cd "${directory_origin}"

	frobulator.complete
else
	frobulator.err "Directory not found" "[ ${directory_origin} ]"

	exit 1
fi

frobulator.result "${script}"

frobulator.scs "Repackaging complete" "[ ${platform} ]"
