#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="YYYY-MM-DD"

# usage ────────────────────────────────────────────────────────────────────────

while (($#))
do
	case "${1}"
	in
		-i|--install)
			option="install"
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -i | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-i, --install    Run [i]nstallation of ${script} to ${HOME}/.local/bin."
			echo
			echo -e "-h, --help       Show [h]elp and usage information."
			echo
			echo -e "'${script}'      [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -i | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

directory_install="${HOME}"/.local/bin

# defaults ─────────────────────────────────────────────────────────────────────

if [ -z "${option}" ]
then
	option="install"
fi

# functions ────────────────────────────────────────────────────────────────────

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(

)

frobulator.require ${list[@]}

list=()

# configuration ────────────────────────────────────────────────────────────────

# install

if [ "${option}" = "install" ]
then
	file_script="$(realpath "${BASH_SOURCE[0]}")"

	directory_script="$(dirname "${file_script}")"

	if [ "${directory_script}" -ef "${directory_install}" ]
	then
		frobulator.inf "Already installed" "[ ${directory_install}/${script} ]"
	else
		frobulator.copy "${directory_script}" "${directory_install}" "${script}"

		frobulator.permissions public execute "${directory_install}/${script}"

		frobulator.scs "Installed" "[ ${directory_install}/${script} ]"
	fi
fi

frobulator.result "${script}"

frobulator.scs "Done"
