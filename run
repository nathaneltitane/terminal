#!/bin/bash

# run a bash function from krunner

# usage:      run [function] [arguments]
#             [function] [arguments]      [ link to run ]

# reopen in a terminal when launched without one

if [ ! -t 0 ] || [ ! -t 1 ]
then
	command_terminal="$(command -v konsole)"

	# window name for the closing prompt

	if [ -n "${command_terminal}" ]
	then
		exec konsole -e env name_window_run=konsole bash "${BASH_SOURCE[0]}" "${@}"
	else
		exec x-terminal-emulator -e env name_window_run=terminal bash "${BASH_SOURCE[0]}" "${@}"
	fi
fi

# user functions

source "${HOME}"/.local/bin/bash-functions

# link name is the function

name_called="${0##*/}"

if [ "${name_called}" != "run" ]
then
	set -- "${name_called}" "${@}"
fi

if [ -z "${1}" ]
then
	echo
	echo "Usage: run [function] [arguments]"
	echo

	exit 1
fi

# dashed file names with underscored functions

name_function="${1}"

if [ -z "$(declare -F "${name_function}")" ] && [ -n "$(declare -F "${name_function//-/_}")" ]
then
	name_function="${name_function//-/_}"
fi

shift

"${name_function}" "${@}"

# keep own window open

if [ -n "${name_window_run}" ]
then
	frobulator.separate

	frobulator.rtn "Press to close" "[ ${name_window_run} // '${name_function}' ]"

	frobulator.read -r -s _
fi
