#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

frobulator="${HOME}"/.local/bin/frobulator

source "${frobulator}"

# superuser ────────────────────────────────────────────────────────────────────

# script ───────────────────────────────────────────────────────────────────────

# version ──────────────────────────────────────────────────────────────────────

version="2026-09-20"

# defaults ─────────────────────────────────────────────────────────────────────

self="${BASH_SOURCE[0]}"

# usage ────────────────────────────────────────────────────────────────────────

# executed directly: install only

if [[ "${self}" = "${0}" ]]
then
	script="$(basename -- "${self}")"

	directory_install="${HOME}"/.local/bin

	while (( $# ))
	do
		case "${1}"
		in
			-i|--install)
				option="install"
			;;

			-h|--help)
				echo
				echo -e "Usage: ./${script} -i | -h"
				echo
				echo -e "Options:"
				echo
				echo -e "-i, --install    Run [i]nstallation of ${script} to ${directory_install}."
				echo
				echo -e "-h, --help       Show [h]elp and usage information."
				echo
				echo -e "'${script}'      [ Version // ${version} ]"
				echo

				exit
			;;

			"")
				# handle empty argument:
				# use default values specified in script

				:
			;;

			*)
				echo
				echo -e "Usage: ./${script} -i | -h"
				echo
				echo -e "Unknown option: '${script} ${1}':"
				echo -e "Type './${script} -h' for help and usage information."
				echo

				exit 1

			;;

			esac

		shift

	done

	# default to install

	if [ -z "${option}" ]
	then
		option="install"
	fi

	# install

	if [ "${option}" = "install" ]
	then
		# blank line - output separated from the shell prompt

		echo

		file_script="$(realpath "${self}")"

		directory_script="$(dirname "${file_script}")"

		if [ "${directory_script}" -ef "${directory_install}" ]
		then
			frobulator.inf "Already installed" "[ ${directory_install}/${script} ]"
		else
			frobulator.copy "${directory_script}" "${directory_install}" "${script}"

			frobulator.permissions public execute "${directory_install}/${script}"

			frobulator.scs "Installed" "[ ${directory_install}/${script} ]"
		fi
	fi

	exit
fi

# logout ───────────────────────────────────────────────────────────────────────

if [ -n "${TERMUX_VERSION}" ]
then
	frobulator.fwd "Logging out..."

	frobulator.timeout
fi

# dextop ───────────────────────────────────────────────────────────────────────

if [ -n "${TERMUX_VERSION}" ]
then
	# automatic session stop

	# automatic session stop selection: 'logout' when enabled

	content_logout_dextop="$(cat "${HOME}"/.dextop/dextop-logout)"

	if [ "${content_logout_dextop}" = "logout" ]
	then
		# audio

		# running pulseaudio process ids - empty if stopped

		id_process_pulseaudio="$(pgrep -f pulseaudio)"

		if [ -n "${id_process_pulseaudio}" ]
		then
			pulseaudio --kill
		fi

		# display

		# running termux x11 display process ids - empty if stopped

		id_process_x11="$(pgrep -f com.termux.x11)"

		if [ -n "${id_process_x11}" ]
		then
			container-session -x

			pkill -f com.termux.x11

			pkill -f virgl
		fi
	fi
fi

unset content_logout_dextop id_process_pulseaudio id_process_x11
