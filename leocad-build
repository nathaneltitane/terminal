#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (($#))
do
	case "${1}"
	in
		-s|--source)
			url_source="${2}"

			shift
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -s [Source] | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-s, --source    Specify [s]ource URL to build from."
			echo
			echo -e "                [ https://github.com/leozide/leocad.git ] [ Default ]"
			echo
			echo -e "-h, --help      Show [h]elp and usage information."
			echo
			echo -e "'${script}'     [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -s [Source] | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

application="leocad"
url_source="${url_source:-https://github.com/leozide/leocad.git}"

# defaults ─────────────────────────────────────────────────────────────────────

# functions ────────────────────────────────────────────────────────────────────

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(
	git
	hub
	g++
	make
	zip
	zlib1g-dev
	leocad
	libqt5concurrent5
	libqt5opengl5
	libqt5opengl5-dev
	libqt5printsupport5
	libqt5xml5
	qtbase5-dev
	qttools5-dev
	qttools5-dev-tools
)

frobulator.require ${list[@]}

frobulator.complete

list=()

# configuration ────────────────────────────────────────────────────────────────

frobulator.temporary directory_build

frobulator.complete

frobulator.trap "${directory_build}"

frobulator.complete

# get source code

command_clone="git clone --quiet"

frobulator.silence "${command_clone} ${url_source} ${directory_build}" &

frobulator.progress "clone"

frobulator.complete

if [ -d "${directory_build}" ]
then
	cd "${directory_build}"

	frobulator.complete
else
	frobulator.err "Directory not found" "[ ${directory_build} ]"

	exit 1
fi

# compile project

frobulator.silence "qmake ${application}.pro"

frobulator.complete halt "Unable to configure project" "[ ${application} ]"

frobulator.complete

# compile binary

command_build="make -j$(nproc)"

frobulator.log "${command_build}" &

frobulator.progress "build"

frobulator.complete

# update binary

frobulator.copy "${directory_build}"/build/release /usr/bin "${application}"

frobulator.complete

# generate launcher

launcher_content=$(cat <<- 'FILE'
[Desktop Entry]
Name=LeoCAD
Comment=LDraw model editor
Exec=leocad %f
Terminal=false
Type=Application
Icon=leocad
MimeType=application/vnd.leocad;application/x-ldraw;application/x-multi-part-ldraw;application/x-multipart-ldraw;application/x-ldlite;
Categories=Graphics;3DGraphics;
Keywords=CAD;LEGO;LDraw;
FILE
)

frobulator.write "write" "${launcher_content}" /usr/share/applications leocad.desktop

frobulator.complete

frobulator.result "${script}"

frobulator.scs "Done"
