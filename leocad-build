#!/bin/bash

# dependencies /////////////////////////////////////////////////////////////////

script="$(basename -- ${BASH_SOURCE[0]})"

if [[ "${frobulator_loaded}" != "true" ]]
then
	echo

	ticker () {

		for ticker in '>  ' '>> ' '>>>'
		do
			echo -n -e "\r[  ${ticker}  ] ${1^}..."

			sleep 0.5
		done

		echo

		echo

	}

	if [[ $(id -u -n) = "root" ]]
	then
		USER="${SUDO_USER:-root}"

		if [ "${USER}" = "root" ]
		then
			HOME=/root
		else
			HOME="/home/${USER}"
		fi
	fi

	ticker checking

	package_managers_list=(
		"apt-get --quiet --quiet update > /dev/null 2>&1; apt-get --quiet --quiet install --yes"
		"dnf --quiet install --assumeyes"
		"yum --quiet install --assumeyes"
		"apk add --quiet"
		"pacman --sync --refresh --noconfirm --noprogressbar"
		"zypper --quiet --non-interactive install"
	)

	package="curl"

	if [[ -z $(command -v "${package}") ]]
	then
		for package_manager in "${package_managers_list[@]}"
		do
			entry="${package_manager%% *}"

			if [[ -n $(command -v "${entry}") ]]
			then
				eval "${package_manager} ${package} > /dev/null 2>&1"

				break
			fi
		done

		if [[ -z $(command -v "${package}") ]]
		then
			echo "[  !  ] Unable to install or binary not found /////////////////////// [ '${package}' ]"
			echo

			exit 1
		fi
	fi

	mkdir -p "${HOME}"/.local/bin

	frobulator="${HOME}"/.local/bin/frobulator

	version_online=$(curl -s -L get.frbltr.app | grep -m 1 '^# version=' | cut -d '"' -f 2)

	version_local=$(grep -m 1 '^# version=' "${frobulator}" 2>/dev/null | cut -d '"' -f 2)

	version_local="${version_local:-1970-01-01}"

	if [ ! -f "${frobulator}" ] || [[ "${version_online}" > "${version_local}" ]]
	then
		curl -s -L get.frbltr.app > "${frobulator}"

		chmod +x "${frobulator}"
	fi

	ticker initializing

	source "${frobulator}"

	export self_arguments="${@}"
fi

# superuser ////////////////////////////////////////////////////////////////////

frobulator.escalate

# script ///////////////////////////////////////////////////////////////////////

frobulator.script

# version //////////////////////////////////////////////////////////////////////

version="2026-08-02"

# usage ////////////////////////////////////////////////////////////////////////

while (($#))
do
	case "${1}"
	in
		-s|--source)
			url_source="${2}"

			shift
		;;

		-h|--help)
			echo
			echo -e "Usage: ${script} -s [Source] | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-s, --source        Repository URL to build from."
			echo
			echo -e "                    [ https://github.com/leozide/leocad.git ]    [ Default ]"
			echo
			echo -e "-h, --help          Show help and usage information."
			echo
			echo -e "'${script}' [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			:
		;;

		*)
			echo
			echo -e "${script}: Unknown option '${1}'"
			echo -e "Type './${script} --help' for help and usage information."
			echo

			exit 1
		;;

	esac

	shift

done

# variables ////////////////////////////////////////////////////////////////////

application="leocad"
url_source="${url_source:-https://github.com/leozide/leocad.git}"

# defaults /////////////////////////////////////////////////////////////////////

# functions ////////////////////////////////////////////////////////////////////

# update ///////////////////////////////////////////////////////////////////////

# frobulator.update

# frobulator.upgrade

# requirements /////////////////////////////////////////////////////////////////

list=(
	git
	hub
	g++
	make
	zip
	zlib1g-dev
	leocad
	libqt5concurrent5
	libqt5opengl5
	libqt5opengl5-dev
	libqt5printsupport5
	libqt5xml5
	qtbase5-dev
	qttools5-dev
	qttools5-dev-tools
)

frobulator.require ${list[@]}

frobulator.complete

list=()

# configuration ////////////////////////////////////////////////////////////////

frobulator.temporary directory_build

frobulator.complete

frobulator.trap "${directory_build}"

frobulator.complete

# get source code

command_clone="git clone --quiet"

frobulator.silence "${command_clone} ${url_source} ${directory_build}" &

frobulator.progress "clone"

frobulator.complete

if [ -d "${directory_build}" ]
then
	cd "${directory_build}"

	frobulator.complete
else
	frobulator.err "Directory not found" "[ ${directory_build} ]"
	echo

	exit 1
fi

# compile project

frobulator.silence "qmake ${application}.pro"

if [ "${?}" -ne 0 ]
then
	frobulator.err "Unable to configure project" "[ ${application} ]"
	echo

	exit 1
fi

frobulator.complete

# compile binary

command_build="make -j$(nproc)"

frobulator.log "${command_build}" &

frobulator.progress "build"

frobulator.complete

# update binary

frobulator.copy "${directory_build}"/build/release /usr/bin "${application}"

frobulator.complete

# generate launcher

launcher_content=$(cat <<- 'FILE'
[Desktop Entry]
Name=LeoCAD
Comment=LDraw model editor
Exec=leocad %f
Terminal=false
Type=Application
Icon=leocad
MimeType=application/vnd.leocad;application/x-ldraw;application/x-multi-part-ldraw;application/x-multipart-ldraw;application/x-ldlite;
Categories=Graphics;3DGraphics;
Keywords=CAD;LEGO;LDraw;
FILE
)

frobulator.flag "${launcher_content}" /usr/share/applications leocad.desktop

frobulator.complete

frobulator.result "${script}"

frobulator.scs "Done"
echo
