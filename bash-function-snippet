#!/bin/bash

# loaded by "${HOME}"/.local/bin/bash-functions

# snippet ──────────────────────────────────────────────────────────────────────

snippet () {

	local protocol_service="http"
	local host_service="sprunge.us"
	local field_form='sprunge=<-'
	local url_service="${protocol_service}://${host_service}"

	if [ "${#}" -gt 0 ]
	then
		curl --form "${field_form}" "${url_service}" < "${1}"
	else
		curl --form "${field_form}" "${url_service}"
	fi

}
