#!/bin/bash

# dependencies /////////////////////////////////////////////////////////////////

if [[ $(id -u -n) = "root" ]]
then
	SUDO_HOME=/root

	USER="${SUDO_USER:-root}"

	if [ "${USER}" = "root" ]
	then
		HOME=/root
	else
		HOME="/home/${USER}"
	fi
fi

ticker () {
	for symbol in '>  ' '>> ' '>>>'
	do
		echo -n -e "\r[  ${symbol}  ] ${1^}..."

		sleep 0.5
	done

	echo
}

echo

ticker checking

echo

package="curl"

if [[ -z $(command -v "${package}") ]]
then
	package_managers_list=(
		"apt-get --quiet --quiet update > /dev/null 2>&1; apt-get --quiet --quiet install --yes"
		"dnf --quiet install --assumeyes"
		"yum --quiet install --assumeyes"
		"apk add --quiet"
		"pacman --sync --refresh --noconfirm --noprogressbar"
		"zypper --quiet --non-interactive install"
	)

	for package_manager in "${package_managers_list[@]}"
	do
		entry="${package_manager%% *}"

		if [[ -n $(command -v "${entry}") ]]
		then
			eval "${package_manager} ${package} > /dev/null 2>&1"

			break
		fi
	done

	if [[ -z $(command -v "${package}") ]]
	then
		echo "[  !  ] Unable to install or binary not found /////////////////////// [ '${package}' ]"
		echo

		exit 1
	fi
fi

mkdir -p "${HOME}"/.local/bin

frobulator="${HOME}"/.local/bin/frobulator

version_online=$(	curl -s -L get.frbltr.app | grep -m 1 '^# version=' | cut -d '"' -f 2)

version_local=$(grep -m 1 '^# version=' "${frobulator}" 2>/dev/null | cut -d '"' -f 2)

version_local="${version_local:-1970-01-01}"

if [ ! -f "${frobulator}" ] || [[ "${version_online}" > "${version_local}" ]]
then
	curl -s -L get.frbltr.app > "${frobulator}"

	chmod +x "${frobulator}"
fi

ticker initializing

source "${frobulator}"

# script ///////////////////////////////////////////////////////////////////////

script="$(basename -- ${BASH_SOURCE[0]})"

# version //////////////////////////////////////////////////////////////////////

version="2026-09-06"

# prompt ///////////////////////////////////////////////////////////////////////

frobulator.script "Setting up ${script#*-}"

# superuser ////////////////////////////////////////////////////////////////////

export self_arguments="${@}"

frobulator.escalate

# variables ////////////////////////////////////////////////////////////////////

process="ollama"
service="${process}.service"

model="llama3.2"

# path to a separate mount so models survive a system reinstall/format

models_directory="/media/internal/${process}"

# 'hades canyon' nuc (nuc8i7hvk / nuc8i7hnk) ships radeon rx vega m gh/gl:
# not an officially supported rocm target - identifier: gfx902

# hsa_override_gfx_version spoofs the closest supported architecture (gfx900)
# so ollama attempts gpu offload rather than silently falling back to cpu-only

gpu_override="9.0.0"

# defaults /////////////////////////////////////////////////////////////////////

# functions ////////////////////////////////////////////////////////////////////

install_from_url () {

	local label="${1}"
	local command_name="${2}"
	local url="${3}"
	local ownership_paths=("${@:4}")

	if [[ -n $(command -v "${command_name}") ]]
	then
		frobulator.wrn "Already installed" "[ ${label} ]"
		echo

		return 0
	fi

	frobulator.inf "Installing" "[ ${label} ]"
	echo

	installer="$(mktemp)"

	curl												\
		--fail											\
		--silent										\
		--show-error									\
		--location										\
		--output "${installer}" 						"${url}"

	if [ "${?}" -ne 0 ] || [ ! -s "${installer}" ]
	then
		frobulator.err "Unable to fetch installer" "[ ${label} ]"
		echo

		rm -f "${installer}"

		return 1
	fi

	bash "${installer}"

	if [ "${?}" -ne 0 ]
	then
		frobulator.err "Installation failed" "[ ${label} ]"
		echo

		rm -f "${installer}"

		return 1
	fi

	rm -f "${installer}"

	if [ "${USER}" != "root" ] && [ "${#ownership_paths[@]}" -gt 0 ]
	then
		chown -R "${USER}:$(id -g "${USER}")" "${ownership_paths[@]}" > /dev/null 2>&1
	fi

	frobulator.scs "Installed" "[ ${label} ]"
	echo

	return 0
}

# requirements /////////////////////////////////////////////////////////////////

list=(
	curl
)

frobulator.require "${list[@]}"

list=()

# gpu readiness check

if [ ! -e /dev/kfd ]
then
	frobulator.wrn "AMD GPU compute interface not found" "[ /dev/kfd ]"
	echo
fi

# install

install_from_url "${process}" ollama https://ollama.com/install.sh

if [ "${?}" -ne 0 ]
then
	exit 1
fi

# gpu override

frobulator.inf "Configuring GPU override" "[ gfx902 -> ${gpu_override} ]"
echo

frobulator.directory /etc/systemd/system "${service}".d

# models directory

frobulator.inf "Configuring models directory" "[ ${models_directory} ]"
echo

frobulator.directory "$(dirname "${models_directory}")" "$(basename "${models_directory}")"

chown -R ollama:ollama "${models_directory}"

cat <<- FILE > /etc/systemd/system/"${service}".d/override.conf
[Service]
Environment="HSA_OVERRIDE_GFX_VERSION=${gpu_override}"
Environment="OLLAMA_MODELS=${models_directory}"
FILE

# service

frobulator.service reload

frobulator.service status "${service}"

frobulator.service activate "${service}"

# model

frobulator.inf "Pulling model" "[ ${model} ]"
echo

ollama pull "${model}"

if [ "${?}" -ne 0 ]
then
	frobulator.err "Unable to pull model" "[ ${model} ]"
	echo

	exit 1
fi

# claude code

install_from_url "claude code" claude https://claude.ai/install.sh "${HOME}"/.local/bin/claude "${HOME}"/.claude

# verification

frobulator.ntf inf "GPU acceleration" "Run 'ollama ps' after a prompt:

if it reports CPU instead of a GPU percentage, the gfx902 override did not take.

Try HSA_OVERRIDE_GFX_VERSION=9.0.2 as an alternate value in the override.conf.

Run 'frobulator.service reload' then 'frobulator.service restart ${service}'."

frobulator.scs "Done"
