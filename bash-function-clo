#!/bin/bash

# loaded by "${HOME}"/.local/bin/bash-functions

# clo ──────────────────────────────────────────────────────────────────────────

clo () {

	local path_command
	local name_command
	local directory_projects
	local command_search_list
	local file_session
	local id_session
	local id_session_short
	local line_agent
	local kind_agent
	local id_agent
	local status_background
	local name_projects
	local pattern_session
	local format_search
	local extension_session
	local pattern_kind
	local pattern_session_id
	local pattern_close
	local prefix_value
	local kind_interactive
	local length_session_short
	local state_found
	local state_background_default

	# set before the help text

	name_command="claude"
	name_projects="projects"
	pattern_session="*.jsonl"
	format_search='%T@ %p\n'
	extension_session=".jsonl"
	pattern_kind='*'"\"kind\":"'*'
	pattern_session_id='*'"\"sessionId\":"'*'
	pattern_close='*}*'
	prefix_value=': "'
	kind_interactive="interactive"
	state_found="true"
	state_background_default="false"
	length_session_short="8"

	case "${1}" in

		-h|--help)
			cat <<- EOF

			Usage: clo [option]

			Attach to the most recent ${name_command} session when it runs in the background
			or resume it in this terminal when it is not running.

			Options:

			-h, --help          Show this [h]elp message.

			EOF

			return 0
		;;

	esac

	# ${name_command} command path - empty if not installed

	path_command="$(command -v "${name_command}")"

	if [ -z "${path_command}" ]
	then
		frobulator.err "Command not found" "[ ${name_command} ]"

		return 1
	fi

	directory_projects="${HOME}/.${name_command}/${name_projects}"

	if [ ! -d "${directory_projects}" ]
	then
		frobulator.wrn "No session history found."

		return 1
	fi

	command_search_list=(find "${directory_projects}" -name "${pattern_session}" -printf "${format_search}")

	file_session=$("${command_search_list[@]}" 2>"${sink}" | sort --reverse --numeric-sort | head --lines=1 | cut --delimiter=' ' --fields=2-)

	if [ -z "${file_session}" ]
	then
		frobulator.wrn "No saved session(s) found."

		return 1
	fi

	echo

	id_session="$(basename "${file_session}" "${extension_session}")"
	id_session_short="${id_session:0:length_session_short}"

	frobulator.scs "Session found."

	# active sessions - interactive ones live in another terminal and only resume

	unset kind_agent
	unset id_agent

	status_background="${state_background_default}"

	while IFS= read -r line_agent
	do
		if [[ "${line_agent}" == ${pattern_kind} ]]
		then
			kind_agent="${line_agent#*${prefix_value}}"
			kind_agent="${kind_agent%%\"*}"

		elif [[ "${line_agent}" == ${pattern_session_id} ]]
		then
			id_agent="${line_agent#*${prefix_value}}"
			id_agent="${id_agent%%\"*}"

		elif [[ "${line_agent}" == ${pattern_close} ]]
		then
			if [ "${id_agent}" = "${id_session}" ] &&
			   [ -n "${kind_agent}" ] &&
			   [ "${kind_agent}" != "${kind_interactive}" ]
			then
				status_background="${state_found}"
			fi

			unset kind_agent
			unset id_agent
		fi
	done < <("${path_command}" agents --json 2>"${sink}")

	if [ "${status_background}" = "${state_found}" ]
	then
		frobulator.inf "Attaching to background session" "[ ${id_session} ]"

		"${path_command}" attach "${id_session_short}"
	else
		frobulator.inf "Resuming session" "[ ${id_session} ]"

		"${path_command}" --dangerously-skip-permissions --resume "${id_session}"
	fi

}
