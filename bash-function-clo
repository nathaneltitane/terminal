#!/bin/bash

# loaded by "${HOME}"/.local/bin/bash-functions

# clo ──────────────────────────────────────────────────────────────────────────

clo () {

	local path_command
	local name_command
	local directory_projects
	local command_search_list
	local file_session
	local id_session
	local id_session_short
	local line_agent
	local kind_agent
	local id_agent
	local status_background

	# set before the help text - it is named there

	name_command="claude"

	case "${1}" in

		-h|--help)
			cat <<- EOF

			Usage: clo [option]

			Attach to the most recent ${name_command} session when it runs in the background
			or resume it in this terminal when it is not running.

			Options:

			-h, --help          Show this [h]elp message.

			EOF

			return 0
		;;

	esac

	# ${name_command} command path - empty if not installed

	path_command="$(command -v "${name_command}")"

	if [ -z "${path_command}" ]
	then
		frobulator.err "Command not found" "[ ${name_command} ]"

		return 1
	fi

	directory_projects="${HOME}/.${name_command}/projects"

	if [ ! -d "${directory_projects}" ]
	then
		frobulator.wrn "No session history found."

		return 1
	fi

	command_search_list=(find "${directory_projects}" -name '*.jsonl' -printf '%T@ %p\n')

	file_session=$("${command_search_list[@]}" 2>"${sink}" | sort --reverse --numeric-sort | head --lines=1 | cut --delimiter=' ' --fields=2-)

	if [ -z "${file_session}" ]
	then
		frobulator.wrn "No saved session(s) found."

		return 1
	fi

	echo

	id_session="$(basename "${file_session}" .jsonl)"
	id_session_short="${id_session:0:8}"

	frobulator.scs "Session found."

	# active sessions - interactive ones live in another terminal and only resume

	unset kind_agent
	unset id_agent
	unset status_background

	while IFS= read -r line_agent
	do
		if [[ "${line_agent}" == *'"kind":'* ]]
		then
			kind_agent="${line_agent#*: \"}"
			kind_agent="${kind_agent%%\"*}"

		elif [[ "${line_agent}" == *'"sessionId":'* ]]
		then
			id_agent="${line_agent#*: \"}"
			id_agent="${id_agent%%\"*}"

		elif [[ "${line_agent}" == *'}'* ]]
		then
			if [ "${id_agent}" = "${id_session}" ] && [ -n "${kind_agent}" ] && [ "${kind_agent}" != "interactive" ]
			then
				status_background="found"
			fi

			unset kind_agent
			unset id_agent
		fi
	done < <("${path_command}" agents --json 2>"${sink}")

	if [ -n "${status_background}" ]
	then
		frobulator.inf "Attaching to background session" "[ ${id_session} ]"

		"${path_command}" attach "${id_session_short}"
	else
		frobulator.inf "Resuming session" "[ ${id_session} ]"

		"${path_command}" --dangerously-skip-permissions --resume "${id_session}"
	fi

}
