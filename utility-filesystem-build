#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-23"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-i|--image)
			option="image"
			name_distribution="${2}"

			shift

			version_distribution="${2}"

			shift
		;;

		-s|--selection)
			option="selection"
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -i [Distribution Name] [Distribution Version] | -s [Selection] | [OPTION]"
			echo
			echo -e "Options:"
			echo
			echo -e "-i, --image        Specify distribution [i]mage name and version."
			echo
			echo -e "-s, --selection    Show setup [s]election options."
			echo
			echo -e "-h, --help         Show [h]elp and usage information."
			echo
			echo -e "'${script}'        [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -i [Distribution Name] [Distribution Version] | -s [Selection] | [OPTION]"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

architecture_distribution="arm64"

# supported distribution versions - name version codename - fedora has none

list_versions_debian=(
	debian	10	buster
	debian	11	bullseye
	debian	12	bookworm
	debian	13	trixie
)

list_versions_fedora=(
	fedora	41	-
	fedora	42	-
	fedora	43	-
	fedora	44	-
)

list_versions_ubuntu=(
	ubuntu	18.04	bionic
	ubuntu	20.04	focal
	ubuntu	22.04	jammy
	ubuntu	24.04	noble
)

list_versions=(
	${list_versions_debian[@]}
	${list_versions_fedora[@]}
	${list_versions_ubuntu[@]}
)

# fedora official container images - current releases then archived ones

list_urls_fedora=(
	https://dl.fedoraproject.org/pub/fedora/linux/releases
	https://archives.fedoraproject.org/pub/archive/fedora/linux/releases
)

# defaults ─────────────────────────────────────────────────────────────────────

if [ "${option}" != "image" ] && [ "${option}" != "selection" ]
then
	name_distribution="debian"
	version_distribution="12"
	codename_distribution="bookworm"
fi

# functions ────────────────────────────────────────────────────────────────────

image_select () {

	# list distributions

	if [ -z "${name_distribution}"     ] ||
	   [ -z "${version_distribution}"  ] ||
	   [ -z "${codename_distribution}" ]
	then
		frobulator.msg "Select distribution version to generate."

		# continue list using array selection of suppported values

		for (( index_version = 0 ; index_version < ${#list_versions[@]} ; index_version += 3 ))
		do
			number_entry=$(( ( ${index_version} / 3 ) + 1 ))

			name_entry="${list_versions[${index_version}]}"
			version_entry="${list_versions[${index_version}+1]}"
			codename_entry="${list_versions[${index_version}+2]}"

			indent="${marker_tab}"

			if [ ${#version_entry} -le 2 ]
			then
				indent+="${marker_tab}"
			fi

			if [ "${number_entry}" -le 9 ]
			then
				# handle number spacing for entries 1-9

				number_entry=" ${number_entry}"
			else
				# handle number spacing for entries 10+

				number_entry="${number_entry}"
			fi

			if [ "${codename_entry}" = "-" ]
			then
				echo "${marker_nul}" "[ ${number_entry} ]" "${name_entry}" "${version_entry}"
			else
				echo "${marker_nul}" "[ ${number_entry} ]" "${name_entry}" "${version_entry}" "${indent}" "[ ${codename_entry} ]"
			fi

		done

		echo

		# values #

		list_values=(
			selection
		)

		# handle user input for list_values

		eval ${frobulator_return[@]}

		frobulator.ipt "Selection:"

		frobulator.read selection

		unset version_distribution

		# integer check:
		# handle numerical selection

		count_entries=$(( ${#list_versions[@]} / 3 ))

		while [[ ! "${selection}" =~ ^[0-9]+$ ]] || [ "${selection}" -lt 1 ] || [ "${selection}" -gt "${count_entries}" ]
		do
			echo
			frobulator.err "Invalid selection:"

			frobulator.wrn "Select image [ 1 - ${count_entries} ]"

			frobulator.ipt "Selection:"

			frobulator.read selection
		done

			index_version=$(( ${selection} ))
			index_version=$(( ( ${index_version} * 3 ) - 3 ))

			name_entry="${list_versions[${index_version}]}"
			version_entry="${list_versions[${index_version}+1]}"
			codename_entry="${list_versions[${index_version}+2]}"

			number_entry="${selection}"

			name_distribution="${name_entry}"
			version_distribution="${version_entry}"
			codename_distribution="${codename_entry}"

			if [ "${codename_entry}" = "-" ]
			then
				unset codename_entry
				unset codename_distribution
			fi

		frobulator.inf "User selection" "[ ${selection} // ${name_entry} ${version_entry}${codename_entry:+ - '${codename_entry}'} ]"

	fi
}

image_handle () {

	# validate name and version against the supported list - codename from the list

	local index_version
	local status_supported

	name_distribution="${name_distribution,,}"

	unset codename_distribution

	for (( index_version = 0 ; index_version < ${#list_versions[@]} ; index_version += 3 ))
	do
		if [ "${list_versions[${index_version}]}" = "${name_distribution}" ] && [ "${list_versions[${index_version}+1]}" = "${version_distribution}" ]
		then
			status_supported="found"
			codename_distribution="${list_versions[${index_version}+2]}"
		fi
	done

	if [ "${codename_distribution}" = "-" ]
	then
		unset codename_distribution
	fi

	if [ -z "${status_supported}" ]
	then
		frobulator.err "Unsupported distribution version" "[ ${name_distribution} ${version_distribution} ]"
		frobulator.nul "Type './${script} -s' to select a supported version."

		exit 1
	fi

	# ubuntu arm images on the ports mirror

	unset url_distribution

	if [ "${name_distribution}" = ubuntu ]
	then
		if [ "${architecture_distribution}" = "amd64" ] || [ "${architecture_distribution}" = "i386" ]
		then
			url_distribution="http://archive.ubuntu.com/ubuntu"
		else
			url_distribution="http://ports.ubuntu.com/ubuntu-ports"
		fi
	fi

	frobulator.scs "Supported distribution version" "[ ${name_distribution} ${version_distribution}${codename_distribution:+ - '${codename_distribution}'} ]"
}

image_fedora () {

	# official container image - single layer unpacked as the root filesystem

	local status=0
	local url_release
	local url_images
	local architecture_fedora
	local directory_oci="${directory_build}/.oci"
	local file_index="${directory_oci}/index.html"
	local line_index
	local name_link
	local file_image
	local file_checksum
	local text_index
	local digest_manifest
	local digest_layer

	if [ "${architecture_distribution}" = "arm64" ]
	then
		architecture_fedora="aarch64"

	elif [ "${architecture_distribution}" = "amd64" ]
	then
		architecture_fedora="x86_64"
	else
		frobulator.err "Unsupported fedora architecture" "[ ${architecture_distribution} ]"

		return 1
	fi

	mkdir -p "${directory_oci}"

	# first mirror listing the release

	for url_release in "${list_urls_fedora[@]}"
	do
		url_images="${url_release}/${version_distribution}/Container/${architecture_fedora}/images"

		frobulator.download "${url_images}/" "${file_index}" > "${sink}" 2>&1

		if [ ! -f "${file_index}" ]
		then
			continue
		fi

		unset file_image
		unset file_checksum

		while IFS= read -r line_index || [ -n "${line_index}" ]
		do
			# every link on the line

			while [[ "${line_index}" == *'href="'* ]]
			do
				line_index="${line_index#*href=\"}"
				name_link="${line_index%%\"*}"

				if [[ "${name_link}" == Fedora-Container-Base-Generic-${version_distribution}-*.${architecture_fedora}.oci.tar.xz ]]
				then
					file_image="${name_link}"

				elif [[ "${name_link}" == Fedora-Container-${version_distribution}-*-${architecture_fedora}-CHECKSUM ]]
				then
					file_checksum="${name_link}"
				fi
			done
		done < "${file_index}"

		if [ -n "${file_image}" ] && [ -n "${file_checksum}" ]
		then
			break
		fi
	done

	if [ -z "${file_image}" ] || [ -z "${file_checksum}" ]
	then
		frobulator.err "Fedora image not found" "[ ${version_distribution} // ${architecture_fedora} ]"

		return 1
	fi

	frobulator.download "${url_images}/${file_image}" "${directory_oci}/" > "${sink}" 2>&1
	frobulator.download "${url_images}/${file_checksum}" "${directory_oci}/" > "${sink}" 2>&1

	# published checksum

	(
		cd "${directory_oci}" &&
		sha256sum --check --ignore-missing --quiet "${file_checksum}"
	) > "${sink}" 2>&1

	frobulator.track || return "${status}"

	tar --extract --file="${directory_oci}/${file_image}" --directory="${directory_oci}" > "${sink}" 2>&1

	frobulator.track || return "${status}"

	# index - manifest - first layer

	text_index="$(< "${directory_oci}"/index.json)"
	digest_manifest="${text_index#*\"digest\":\"sha256:}"
	digest_manifest="${digest_manifest%%\"*}"

	text_index="$(< "${directory_oci}"/blobs/sha256/"${digest_manifest}")"
	text_index="${text_index#*\"layers\"}"
	digest_layer="${text_index#*\"digest\":\"sha256:}"
	digest_layer="${digest_layer%%\"*}"

	tar										\
		--extract							\
		--gzip								\
		--numeric-owner						\
		--preserve-permissions				\
			--file="${directory_oci}/blobs/sha256/${digest_layer}"	\
				--directory="${directory_build}"	> "${sink}" 2>&1

	frobulator.track || return "${status}"

	frobulator.delete "${directory_build}" .oci

	[ -e "${directory_build}"/etc/os-release ]

	frobulator.track

	return "${status}"
}

image_build () {

	if [ "${name_distribution}" = fedora ]
	then
		image_fedora

		return
	fi

	variant="minbase"

	parameters="${codename_distribution} ${directory_build} ${url_distribution}"

	unset command_image_build

	command_image_build="
		debootstrap									\
			--foreign								\
			--arch="${architecture_distribution}"	\
			--variant="${variant}"					\
													"${parameters}"
	"

	frobulator.silence log ${command_image_build}

}

image_archive () {

	extension="tar.xz"
	archive="${name_distribution}"-"${version_distribution}"."${extension}"

	cd "${directory_build}"

	unset command_image_archive

	command_image_archive="
		tar --create								\
			--file="${archive}"						\
				--use-compress-program='xz -9'		\
				--exclude='debootstrap' 			\
													*
	"

	frobulator.silence log ${command_image_archive}

	cp "${directory_build}"/"${archive}" "${HOME}"/"${archive}"

}

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(
	qemu-user-static
	binfmt-support
	debootstrap
)

frobulator.install ${list[@]}

list=()

# configuration ────────────────────────────────────────────────────────────────

if [ "${option}" = "selection" ]
then
	unset name_distribution
	unset version_distribution
	unset codename_distribution
	unset url_distribution

	# select image version

	image_select
fi

image_handle

frobulator.temporary directory_build

directory_build=${frobulator_return[@]}

frobulator.trap "${directory_build}"

frobulator.background "build" -- image_build

frobulator.background "archive" -- image_archive

frobulator.scs "Done"
