#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-23"

# usage ────────────────────────────────────────────────────────────────────────

option_image="image"
option_selection="selection"

while (( $# ))
do
	case "${1}"
	in
		-i|--image)
			option="${option_image}"
			name_distribution="${2}"

			shift

			version_distribution="${2}"

			shift
		;;

		-s|--selection)
			option="${option_selection}"
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -i [Distribution Name] [Distribution Version] | -s [Selection] | [OPTION]"
			echo
			echo -e "Options:"
			echo
			echo -e "-i, --image        Specify distribution [i]mage name and version."
			echo
			echo -e "-s, --selection    Show setup [s]election options."
			echo
			echo -e "-h, --help         Show [h]elp and usage information."
			echo
			echo -e "'${script}'        [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -i [Distribution Name] [Distribution Version] | -s [Selection] | [OPTION]"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

name_debian="debian"
name_fedora="fedora"
name_ubuntu="ubuntu"
architecture_arm64="arm64"
architecture_amd64="amd64"
architecture_i386="i386"
architecture_fedora_arm64="aarch64"
architecture_fedora_amd64="x86_64"
version_default="13"
codename_default="trixie"
version_debian_archive="11"
text_codename_none="-"
separator_codename=" - "
separator_path="/"
directory_current="."
prefix_archive="archive-"
suffix_archive=".tar.xz"
label_selection="Selection:"
pattern_number="^[0-9]+$"
count_fields="3"
length_version_short="2"
number_single_digit_maximum="9"
padding_number=" "
url_fedora_current="https://dl.fedoraproject.org/pub/fedora/linux/releases"
url_fedora_archive="https://archives.fedoraproject.org/pub/archive/fedora/linux/releases"

architecture_distribution="${architecture_arm64}"

# archives saved next to the script

directory_script="${BASH_SOURCE[0]}"

if [[ "${directory_script}" != *${separator_path}* ]]
then
	directory_script="${directory_current}${separator_path}${directory_script}"
fi

directory_script="${directory_script%${separator_path}*}"

if [[ "${directory_script}" != ${separator_path}* ]]
then
	directory_script="${PWD}${separator_path}${directory_script}"
fi

# supported distribution versions - name version codename - fedora has none

list_versions_debian=(
	debian	10	buster
	debian	11	bullseye
	debian	12	bookworm
	debian	13	trixie
)

list_versions_fedora=(
	fedora	41	-
	fedora	42	-
	fedora	43	-
	fedora	44	-
)

list_versions_ubuntu=(
	ubuntu	18.04	bionic
	ubuntu	20.04	focal
	ubuntu	22.04	jammy
	ubuntu	24.04	noble
)

list_versions=(
	${list_versions_debian[@]}
	${list_versions_fedora[@]}
	${list_versions_ubuntu[@]}
)

# fedora official container images - current releases then archived ones

list_urls_fedora=(
	"${url_fedora_current}"
	"${url_fedora_archive}"
)

# defaults ─────────────────────────────────────────────────────────────────────

if [ "${option}" != "${option_image}" ] && [ "${option}" != "${option_selection}" ]
then
	name_distribution="${name_debian}"
	version_distribution="${version_default}"
	codename_distribution="${codename_default}"
fi

# functions ────────────────────────────────────────────────────────────────────

image_select () {

	# list distributions

	if [ -z "${name_distribution}"     ] ||
	   [ -z "${version_distribution}"  ] ||
	   [ -z "${codename_distribution}" ]
	then
		frobulator.msg "Select distribution version to generate."

		# continue list using array selection of suppported values

		for (( index_version = 0 ; index_version < ${#list_versions[@]} ; index_version += count_fields ))
		do
			number_entry=$(( ( index_version / count_fields ) + 1 ))

			name_entry="${list_versions[${index_version}]}"
			version_entry="${list_versions[index_version + 1]}"
			codename_entry="${list_versions[index_version + 2]}"

			indent="${marker_tab}"

			if [ "${#version_entry}" -le "${length_version_short}" ]
			then
				indent+="${marker_tab}"
			fi

			if [ "${number_entry}" -le "${number_single_digit_maximum}" ]
			then
				# handle number spacing for entries 1-9

				number_entry="${padding_number}${number_entry}"
			else
				# handle number spacing for entries 10+

				number_entry="${number_entry}"
			fi

			if [ "${codename_entry}" = "${text_codename_none}" ]
			then
				echo "${marker_nul}" "[ ${number_entry} ]" "${name_entry}" "${version_entry}"
			else
				echo "${marker_nul}" "[ ${number_entry} ]" "${name_entry}" "${version_entry}" "${indent}" "[ ${codename_entry} ]"
			fi

		done

		echo

		# values #

		list_values=(
			selection
		)

		# handle user input for list_values

		eval ${frobulator_return[@]}

		frobulator.ipt "${label_selection}"

		frobulator.read selection

		unset version_distribution

		# integer check:
		# handle numerical selection

		count_entries=$(( ${#list_versions[@]} / count_fields ))

		while [[ ! "${selection}" =~ ${pattern_number} ]] || [ "${selection}" -lt 1 ] || [ "${selection}" -gt "${count_entries}" ]
		do
			echo
			frobulator.err "Invalid selection:"

			frobulator.wrn "Select image [ 1 - ${count_entries} ]"

			frobulator.ipt "${label_selection}"

			frobulator.read selection
		done

			index_version=$(( selection ))
			index_version=$(( ( index_version * count_fields ) - count_fields ))

			name_entry="${list_versions[${index_version}]}"
			version_entry="${list_versions[index_version + 1]}"
			codename_entry="${list_versions[index_version + 2]}"

			number_entry="${selection}"

			name_distribution="${name_entry}"
			version_distribution="${version_entry}"
			codename_distribution="${codename_entry}"

			if [ "${codename_entry}" = "${text_codename_none}" ]
			then
				unset codename_entry
				unset codename_distribution
			fi

		frobulator.inf "User selection" "[ ${selection} // ${name_entry} ${version_entry}${codename_entry:+${separator_codename}'${codename_entry}'} ]"

	fi
}

image_handle () {

	# validate name and version against the supported list - codename from the list

	local url_debian="http://deb.debian.org/debian"
	local url_debian_archive="http://archive.debian.org/debian"
	local url_ubuntu="http://archive.ubuntu.com/ubuntu"
	local url_ubuntu_ports="http://ports.ubuntu.com/ubuntu-ports"

	local index_version
	local state_supported

	name_distribution="${name_distribution,,}"

	unset codename_distribution

	state_supported="false"

	for (( index_version = 0 ; index_version < ${#list_versions[@]} ; index_version += count_fields ))
	do
		if [ "${list_versions[index_version]}" = "${name_distribution}" ] && [ "${list_versions[index_version + 1]}" = "${version_distribution}" ]
		then
			state_supported="true"
			codename_distribution="${list_versions[index_version + 2]}"
		fi
	done

	if [ "${codename_distribution}" = "${text_codename_none}" ]
	then
		unset codename_distribution
	fi

	if [ "${state_supported}" = "false" ]
	then
		frobulator.err "Unsupported distribution version" "[ ${name_distribution} ${version_distribution} ]"
		frobulator.nul "Type './${script} -s' to select a supported version."

		exit 1
	fi

	# debian before bullseye on the archive mirror - ubuntu arm images on the ports mirror

	unset url_distribution

	if [ "${name_distribution}" = "${name_debian}" ]
	then
		if [ "${version_distribution}" -lt "${version_debian_archive}" ]
		then
			url_distribution="${url_debian_archive}"
		else
			url_distribution="${url_debian}"
		fi

	elif [ "${name_distribution}" = "${name_ubuntu}" ]
	then
		if [ "${architecture_distribution}" = "${architecture_amd64}" ] || [ "${architecture_distribution}" = "${architecture_i386}" ]
		then
			url_distribution="${url_ubuntu}"
		else
			url_distribution="${url_ubuntu_ports}"
		fi
	fi

	frobulator.scs "Supported distribution version" "[ ${name_distribution} ${version_distribution}${codename_distribution:+${separator_codename}'${codename_distribution}'} ]"
}

image_fedora () {

	# official container image - single layer unpacked as the root filesystem

	local status=0
	local url_release
	local url_images
	local architecture_fedora
	local name_directory_oci=".oci"
	local name_file_index="index.html"
	local name_file_manifest_index="index.json"
	local directory_blobs="blobs/sha256"
	local name_directory_container="Container"
	local name_directory_images="images"
	local pattern_link='href="'
	local prefix_digest='"digest":"sha256:'
	local key_layers='"layers"'
	local prefix_image="Fedora-Container-Base-Generic-"
	local suffix_image=".oci.tar.xz"
	local prefix_checksum="Fedora-Container-"
	local suffix_checksum="CHECKSUM"
	local file_release="/etc/os-release"
	local directory_oci="${directory_build}/${name_directory_oci}"
	local file_index="${directory_oci}/${name_file_index}"
	local line_index
	local name_link
	local file_image
	local file_checksum
	local text_index
	local digest_manifest
	local digest_layer
	local status_directory

	if [ "${architecture_distribution}" = "${architecture_arm64}" ]
	then
		architecture_fedora="${architecture_fedora_arm64}"

	elif [ "${architecture_distribution}" = "${architecture_amd64}" ]
	then
		architecture_fedora="${architecture_fedora_amd64}"
	else
		frobulator.err "Unsupported fedora architecture" "[ ${architecture_distribution} ]"

		return 1
	fi

	mkdir --parents "${directory_oci}"

	# first mirror listing the release

	for url_release in "${list_urls_fedora[@]}"
	do
		url_images="${url_release}/${version_distribution}/${name_directory_container}/${architecture_fedora}/${name_directory_images}"

		frobulator.download "${url_images}/" "${file_index}" > "${sink}" 2>&1

		if [ ! -f "${file_index}" ]
		then
			continue
		fi

		unset file_image
		unset file_checksum

		while IFS= read -r line_index || [ -n "${line_index}" ]
		do
			# every link on the line

			while [[ "${line_index}" == *"${pattern_link}"* ]]
			do
				line_index="${line_index#*${pattern_link}}"
				name_link="${line_index%%\"*}"

				if [[ "${name_link}" == ${prefix_image}${version_distribution}-*.${architecture_fedora}${suffix_image} ]]
				then
					file_image="${name_link}"

				elif [[ "${name_link}" == ${prefix_checksum}${version_distribution}-*-${architecture_fedora}-${suffix_checksum} ]]
				then
					file_checksum="${name_link}"
				fi
			done
		done < "${file_index}"

		if [ -n "${file_image}" ] && [ -n "${file_checksum}" ]
		then
			break
		fi
	done

	if [ -z "${file_image}" ] || [ -z "${file_checksum}" ]
	then
		frobulator.err "Fedora image not found" "[ ${version_distribution} // ${architecture_fedora} ]"

		return 1
	fi

	frobulator.download "${url_images}/${file_image}" "${directory_oci}/" > "${sink}" 2>&1
	frobulator.download "${url_images}/${file_checksum}" "${directory_oci}/" > "${sink}" 2>&1

	# published checksum

	(
		cd "${directory_oci}"

		status_directory="${?}"

		if [ "${status_directory}" -ne 0 ]
		then
			exit "${status_directory}"
		fi

		sha256sum --check --ignore-missing --quiet "${file_checksum}"
	) > "${sink}" 2>&1

	frobulator.track || return "${status}"

	tar --extract --file="${directory_oci}/${file_image}" --directory="${directory_oci}" > "${sink}" 2>&1

	frobulator.track || return "${status}"

	# index - manifest - first layer

	text_index="$(< "${directory_oci}/${name_file_manifest_index}")"
	digest_manifest="${text_index#*${prefix_digest}}"
	digest_manifest="${digest_manifest%%\"*}"

	text_index="$(< "${directory_oci}/${directory_blobs}/${digest_manifest}")"
	text_index="${text_index#*${key_layers}}"
	digest_layer="${text_index#*${prefix_digest}}"
	digest_layer="${digest_layer%%\"*}"

	tar \
		--extract \
		--gzip \
		--numeric-owner \
		--preserve-permissions \
		--file="${directory_oci}/${directory_blobs}/${digest_layer}" \
		--directory="${directory_build}" > "${sink}" 2>&1

	frobulator.track || return "${status}"

	frobulator.delete "${directory_build}" "${name_directory_oci}"

	[ -e "${directory_build}${file_release}" ]

	frobulator.track

	return "${status}"
}

image_build () {

	local file_keyring_removed="/usr/share/keyrings/debian-archive-removed-keys.gpg"
	local file_script_debian="/usr/share/debootstrap/scripts/sid"
	local file_script_ubuntu="/usr/share/debootstrap/scripts/gutsy"
	local url_keyring_ubuntu="https://archive.ubuntu.com/ubuntu/project/ubuntu-archive-keyring.gpg"
	local suffix_keyring=".keyring"
	local prefix_option_keyring="--keyring="
	local file_second_stage="/debootstrap/debootstrap"

	local status=0
	local file_keyring
	local file_script
	local option_keyring
	local status_download

	if [ "${name_distribution}" = "${name_fedora}" ]
	then
		image_fedora

		return
	fi

	# release keys and suite script - shared scripts cover releases newer than debootstrap

	if [ "${name_distribution}" = "${name_debian}" ]
	then
		file_script="${file_script_debian}"

		# keys of archived releases are retired

		if [ "${version_distribution}" -lt "${version_debian_archive}" ]
		then
			option_keyring="${prefix_option_keyring}${file_keyring_removed}"
		fi

	elif [ "${name_distribution}" = "${name_ubuntu}" ]
	then
		file_script="${file_script_ubuntu}"

		# official ubuntu keyring over https - kept out of the image

		file_keyring="${directory_build}${suffix_keyring}"

		curl --silent --location --fail --output "${file_keyring}" "${url_keyring_ubuntu}" > "${sink}" 2>&1

		status_download="${?}"

		if [ "${status_download}" -ne 0 ]
		then
			wget --quiet --output-document "${file_keyring}" "${url_keyring_ubuntu}" > "${sink}" 2>&1
		fi

		frobulator.track || return "${status}"

		option_keyring="${prefix_option_keyring}${file_keyring}"
	fi

	variant="minbase"

	parameters="${codename_distribution} ${directory_build} ${url_distribution} ${file_script}"

	unset command_image_build

	command_image_build="
		debootstrap									\
			--foreign								\
			--arch="${architecture_distribution}"	\
			--variant="${variant}"					\
			${option_keyring}						\
													"${parameters}"
	"

	frobulator.silence log ${command_image_build}

	frobulator.track

	# keyring only needed by the first stage

	if [ -n "${file_keyring}" ]
	then
		rm --force "${file_keyring}"
	fi

	if [ "${status}" -ne 0 ]
	then
		return "${status}"
	fi

	# second stage inside the image - foreign architectures run through qemu binfmt

	frobulator.silence log chroot "${directory_build}" "${file_second_stage}" --second-stage

	frobulator.track || return "${status}"

	# package cache left by the install

	frobulator.silence log chroot "${directory_build}" apt-get clean

	frobulator.track

	return "${status}"
}

image_archive () {

	# archive next to the script under the served name - hidden entries kept

	local status=0
	local file_archive="${prefix_archive}${name_distribution}-${version_distribution}${suffix_archive}"
	local name_debootstrap="debootstrap"
	local program_compress="xz -9 -T0"
	local depth_minimum="1"
	local depth_maximum="1"
	local item

	local list_items=()

	while IFS= read -r item
	do
		list_items+=("${item##*/}")
	done < <(find "${directory_build}" -mindepth "${depth_minimum}" -maxdepth "${depth_maximum}" ! -name "${name_debootstrap}" ! -name "${file_archive}")

	tar \
		--create \
		--file="${directory_build}/${file_archive}" \
		--use-compress-program="${program_compress}" \
		--directory="${directory_build}" \
		"${list_items[@]}" > "${sink}" 2>&1

	frobulator.track || return "${status}"

	cp --force "${directory_build}/${file_archive}" "${directory_script}/${file_archive}"

	frobulator.track || return "${status}"

	chown "${USER}": "${directory_script}/${file_archive}"

	frobulator.track

	return "${status}"
}

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(
	qemu-user-static
	binfmt-support
	debootstrap
)

frobulator.install ${list[@]}

list=()

# configuration ────────────────────────────────────────────────────────────────

if [ "${option}" = "${option_selection}" ]
then
	unset name_distribution
	unset version_distribution
	unset codename_distribution
	unset url_distribution

	# select image version

	image_select
fi

image_handle

frobulator.temporary directory_build

directory_build="${frobulator_return[@]}"

frobulator.trap "${directory_build}"

frobulator.background "build" "[ ${name_distribution} ${version_distribution} ]" -- image_build

frobulator.complete halt "Image build failed" "[ ${name_distribution} ${version_distribution} ]"

frobulator.background "archive" "[ ${prefix_archive}${name_distribution}-${version_distribution}${suffix_archive} ]" -- image_archive

frobulator.complete halt "Image archive failed" "[ ${directory_script} ]"

frobulator.result "${script}"
