#!/bin/bash

selection_navigation="${HOME}"

separator=" // "
name_font="Monospace"
size_font=10
font="${name_font}:size=${size_font}"

lines=60
prompt="NAVIGATION${separator}"
color_background_normal='#000000'
color_foreground_normal='#FFFFFF'
color_background_selected='#666666'
color_foreground_selected='#000000'

count_entries_history=3
file_history="${HOME}/.local/bin/.i3-navigation-history"
format_line='%s\n'
prefix_path="/"
selection_current="."
pattern_url="^(https?|ftps):"
label_selections_empty=''
label_selections_separator='////////////////////////////////////////////////////////////////////////////////'
label_selections_history='[ History ]  ↴'
label_selections_terminal='[ Open Terminal Here ]'
label_selections_terminal_visual='[ Open Visual Terminal Here ]'

command_file_manager="ranger"
terminal="i3-sensible-terminal"

list="ls -a"
read="cat"

handler_open () {

	xdg-open "${@}"
}

terminal_open () {

	"${terminal}" -e "${@}"
}

terminal_open_visual () {

	"${terminal}" -e "${command_file_manager} ${@}"
}

history_write () {

	entry_history="${1}"

	expression_delete="\\:${entry_history}:d"

	sed --in-place "${expression_delete}" "${file_history}"

	printf "${format_line}" "${entry_history}" >> "${file_history}"

	text_history="$(tail --lines "${count_entries_history}" "${file_history}")"

	printf "${format_line}" "${text_history}" > "${file_history}"
}


selections_parse () {

	directory_working="${selection_navigation}"

	label_selections_working_directory="DIRECTORY${separator}${directory_working}"

	selections=(
		"${label_selections_working_directory}"
		"${label_selections_empty}"
		"${label_selections_terminal}"
		"${label_selections_terminal_visual}"
		"${label_selections_empty}"
		"$(${list} "${selection_navigation}")"
		"${label_selections_empty}"
		"${label_selections_history}"
		"${label_selections_empty}"
		"$(${read} "${file_history}")"
	)

	IFS=$"\n"

	for selection in "${selections[@]}"
	do
		echo "${selection}"
	done

	IFS=""

	selections=()
}

while :
do
	selection="$(selections_parse | dmenu -i -l "${lines}" -p "${prompt}" -fn "${font}" -nb "${color_background_normal}" -nf "${color_foreground_normal}" -sb "${color_background_selected}" -sf "${color_foreground_selected}" "${@}")"

	status_selection="${?}"

	if [ "${status_selection}" -ne 0 ]
	then
		exit 1
	fi

	if [ "${selection}" = "${label_selections_terminal}" ]
	then
		terminal_open "${selection_navigation}"

		history_write "${selection_navigation}"

	elif [ "${selection}" = "${label_selections_terminal_visual}" ]
	then
		terminal_open_visual "${selection_navigation}"

		history_write "${selection_navigation}"

	elif [[ "${selection}" == "${prefix_path}"* ]]
	then
		selection_navigation="${selection}"

	elif [[ "${selection}" =~ ${pattern_url} ]]
	then
		handler_open "${selection}"

		history_write "${selection}"

	else
		selection_navigation="$(realpath "${selection_navigation}/${selection}")"
	fi

	if [ -f "${selection_navigation}" ] || [ "${selection}" = "${selection_current}" ]
	then
		handler_open "${selection_navigation}"

		history_write "${selection_navigation}"

	elif [ -d "${selection_navigation}" ]
	then
		selections=(
			"${label_selections_working_directory}"
			"${label_selections_empty}"
			"${label_selections_terminal}"
			"${label_selections_terminal_visual}"
			"${label_selections_empty}"
			"$(${list} "${selection_navigation}")"
		)
	else
		selection_navigation="$(dirname "${selection_navigation}")"
	fi
done
