#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (($#))
do
	case "${1}"
	in
		-i|--installer)
			installer="${2}"

			shift
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -i [Installer] | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-i, --installer    Specify path to the SOLIDWORKS [i]nstaller 'setup.exe'."
			echo
			echo -e "                   [ /path/to/setup.exe ]"
			echo
			echo -e "-h, --help         Show [h]elp and usage information."
			echo
			echo -e "'${script}'        [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -i [Installer] | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

wine_prefix="${HOME}"/.wine
wine_drive="${wine_prefix}"/drive_c

WINEPREFIX="${wine_prefix}"

# defaults ─────────────────────────────────────────────────────────────────────

# functions ────────────────────────────────────────────────────────────────────

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(
	cabextract
	curl
	p7zip
	p7zip-full
	p7zip-rar
	rfkill
	wget
	winbind
)

frobulator.require ${list[@]}

frobulator.complete

list=()

# configuration ────────────────────────────────────────────────────────────────

frobulator.inf "Updating system"

apt-get update

apt-get --assume-yes upgrade

frobulator.complete

frobulator.inf "Adding i386 architecture"

dpkg --add-architecture i386

frobulator.complete

frobulator.inf "Adding WineHQ repository"

wget -qO - https://dl.winehq.org/wine-builds/winehq.key | apt-key add -

add-apt-repository --yes 'deb https://dl.winehq.org/wine-builds/debian/ bookworm main'

apt-get update

apt-get --assume-yes upgrade

frobulator.complete

frobulator.inf "Installing WineHQ" "[ staging ]"

apt-get --assume-yes install --install-recommends winehq-staging

frobulator.complete

# gecko

frobulator.download "https://dl.winehq.org/wine/wine-gecko/2.47.3/wine-gecko-2.47.3-x86.msi" "${HOME}/Downloads" wine-gecko.msi

frobulator.complete

WINEPREFIX="${wine_prefix}" msiexec /i "${HOME}"/Downloads/wine-gecko.msi /qn

frobulator.complete

# mono

frobulator.download "https://dl.winehq.org/wine/wine-mono/7.4.0/wine-mono-7.4.0-x86.msi" "${HOME}/Downloads" wine-mono.msi

frobulator.complete

WINEPREFIX="${wine_prefix}" msiexec /i "${HOME}"/Downloads/wine-mono.msi /qn

frobulator.complete

# winetricks

frobulator.download "https://raw.githubusercontent.com/Winetricks/winetricks/master/src/winetricks" "${HOME}/.local/bin" winetricks

frobulator.complete

winetricks_list=(
	win10
	allfonts
	dxvk
	vcrun2019
	dotnet48
	msxml6
	msxml4
	msxml3
	ie8
)

for winetricks_verb in "${winetricks_list[@]}"
do
	frobulator.inf "Winetricks" "[ ${winetricks_verb} ]"

	WINEPREFIX="${wine_prefix}" "${SHELL}" "${HOME}"/.local/bin/winetricks -q "${winetricks_verb}"

	frobulator.complete
done

# vba 7.1

frobulator.download "https://github.com/cryinkfly/SOLIDWORKS-Linux-Wine-Version-/raw/main/files/VBA/vba7.1.zip" "${HOME}/Downloads" vba7.1.zip

frobulator.complete

unzip -q "${HOME}"/Downloads/vba7.1.zip -d "${HOME}"/Downloads

frobulator.complete

cp -r "${HOME}"/Downloads/vba7.1/* "${wine_drive}"

frobulator.complete

# vba 7.1 patch

frobulator.download "https://github.com/cryinkfly/SOLIDWORKS-Linux-Wine-Version-/raw/main/files/VBA/vba71-kb2783832-x64.msp" "${HOME}/Downloads" vba-patch.msp

frobulator.complete

WINEPREFIX="${wine_prefix}" msiexec /p "${HOME}"/Downloads/vba-patch.msp REINSTALL=ALL REINSTALLMODE=omus /qn

frobulator.complete

# solidworks

if [ -z "${installer}" ]
then
	frobulator.err "No installer specified"

	exit 1
fi

if [ ! -f "${installer}" ]
then
	frobulator.err "Installer not found" "[ ${installer} ]"

	exit 1
fi

frobulator.inf "Launching SOLIDWORKS installer"

WINEPREFIX="${wine_prefix}" wine "${installer}"

frobulator.complete

frobulator.result "${script}"

frobulator.scs "Setup complete"
