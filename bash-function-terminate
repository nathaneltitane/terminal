#!/bin/bash

# loaded by "${HOME}"/.local/bin/bash-functions

# terminate ────────────────────────────────────────────────────────────────────

terminate () {

	local command_pgrep
	local command_pkill
	local ids_process

	name_process="${1}"

	# 'pgrep' and 'pkill' paths - empty if not installed

	command_pgrep="$(command -v pgrep)"
	command_pkill="$(command -v pkill)"

	if [ -n "${command_pgrep}" ] &&
	   [ -n "${command_pkill}" ]
	then
		# process ids still matching the name - empty once all are gone

		ids_process="$(pgrep -f "${name_process}")"

		while [ -n "${ids_process}" ]
		do
			pkill -f "${name_process}"

			ids_process="$(pgrep -f "${name_process}")"
		done
	fi
}
