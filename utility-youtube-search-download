#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-31"

# variables ────────────────────────────────────────────────────────────────────

duration_minimum=120

duration_maximum=780

count_search=1

duration_sleep_minimum=1

duration_sleep_maximum=5

solver="deno"

path_solver="$(command -v ${solver})"

runtime_javascript="${solver}:${path_solver}"

extension_track="mp3"

mode_input="input"

mode_file="file"

directory_default="${HOME}/tracks"

format_stamp="%m-%d-%Y-%H-%M-%S"

suffix_desktop=".desktop"

prefix_search="ytsearch"

separator_search=":"

separator_track=" - "

prefix_comment="#"

pattern_track="*.${extension_track}"

pattern_metadata='^.*$'

pattern_browser_firefox="firefox*"
pattern_browser_librewolf="librewolf*"
pattern_browser_waterfox="waterfox*"
pattern_browser_chrome="chrome*"
pattern_browser_google_chrome="google-chrome*"
pattern_browser_chromium="chromium*"
pattern_browser_brave="brave*"
pattern_browser_vivaldi="vivaldi*"
pattern_browser_opera="opera*"

name_browser_firefox="firefox"
name_browser_chrome="chrome"

field_title="title"
field_artist="artist"

filter_duration=".duration"
filter_url=".webpage_url"

value_null="null"

template_extension='%(ext)s'

format_find='%f\n'

characters_upper='[:upper:]'
characters_lower='[:lower:]'
characters_separator_from='/:'
characters_separator_to='--'

expression_strip='s/[^a-z0-9._ -]//g'
expression_spaces='s/[[:space:]]\+/ /g'
expression_leading='s/^ *//g'
expression_trailing='s/ *$//g'

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-d|--directory)
			directory_download="${2}"

			shift
		;;

		-i|--input)
			option="${mode_input}"
			input_user="${2}"

			shift
		;;

		-f|--file)
			option="${mode_file}"
			file_input="${2}"

			shift
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -i ['Artist - Track'] | -f [File] [-d Directory] | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-i, --input       Search and download s[i]ngle track."
			echo
			echo -e "-f, --file        Search and download tracks from list in [f]ile."
			echo
			echo -e "-d, --directory   Specify download [d]irectory - default ~/tracks."
			echo
			echo -e "-h, --help        Show [h]elp and usage information."
			echo
			echo -e "'${script}'       [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -i ['Artist - Track'] | -f [File] [-d Directory] | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# clear ────────────────────────────────────────────────────────────────────────

frobulator.clear

# variables ────────────────────────────────────────────────────────────────────

stamp="$(date +"${format_stamp}")"

# defaults ─────────────────────────────────────────────────────────────────────

if [ -z "${option}" ]
then
	frobulator.err 'No option selected'

	exit 1
fi

if [ -z "${directory_download}" ]
then
	frobulator.wrn "No download directory specified"

	frobulator.inf "Defaulting" "[ ${directory_default} ]"

	directory_download="${directory_default}"

else
	directory_download="${directory_download}"
fi

if [ "${option}" = "${mode_input}" ] &&
   [ -z "${input_user}"    ]
then
	frobulator.err "Missing input track"

	usage

	exit 1
fi

if [ "${option}" = "${mode_file}" ] &&
   [ -z "${file_input}"   ]
then
	frobulator.err 'No input file specified'

	exit 1
fi

if [ "${option}" = "${mode_file}" ] &&
   [ ! -f "${file_input}" ]
then
	frobulator.err "No input file found" "[ ${file_input} ]"

	exit 1
fi

# functions ────────────────────────────────────────────────────────────────────

browser_identify () {

	browser=$(
		xdg-settings get default-web-browser 2>"${sink}"
	)

	browser=${browser%"${suffix_desktop}"}

	if [[ "${browser}" = ${pattern_browser_firefox} ]] ||
	   [[ "${browser}" = ${pattern_browser_librewolf} ]] ||
	   [[ "${browser}" = ${pattern_browser_waterfox} ]]
	then
		browser="${name_browser_firefox}"

	elif [[ "${browser}" = ${pattern_browser_chrome} ]] ||
	     [[ "${browser}" = ${pattern_browser_google_chrome} ]] ||
	     [[ "${browser}" = ${pattern_browser_chromium} ]] ||
	     [[ "${browser}" = ${pattern_browser_brave} ]] ||
	     [[ "${browser}" = ${pattern_browser_vivaldi} ]] ||
	     [[ "${browser}" = ${pattern_browser_opera} ]]
	then
		browser="${name_browser_chrome}"

	else
		frobulator.err "No compatible browser found on system"

		exit 1
	fi
}

normalize () {

	echo "${1}"															|

		tr "${characters_upper}" "${characters_lower}"					|

		tr "${characters_separator_from}" "${characters_separator_to}"	|

		sed											\
			--expression="${expression_strip}"		\
			--expression="${expression_spaces}"		\
			--expression="${expression_leading}"	\
			--expression="${expression_trailing}"
}

sleep_randomize () {

	duration_sleep=$(( RANDOM % ( duration_sleep_maximum - duration_sleep_minimum + 1 ) + duration_sleep_minimum ))

	frobulator.inf "Seeping" "[ ${duration_sleep} second(s) ]"

	sleep "${duration_sleep}"
}

youtube_search () {

	local track="${1}"

	sleep_randomize

	yt-dlp										\
		--quiet									\
		--no-update								\
		--cookies-from-browser "${browser}"		\
		--js-runtimes "${runtime_javascript}"	\
		--sleep-requests "${duration_sleep}"	\
		--flat-playlist							\
		--dump-json								\
												"${prefix_search}${count_search}${separator_search}${track}" 2>"${sink}"
}

youtube_download () {

	local url="${1}"
	local artist="${2}"
	local title="${3}"
	local filename="${4}"
	local quality_audio="0"
	local format_audio='bestaudio/best'

	sleep_randomize

	yt-dlp														\
		--quiet													\
		--no-update												\
		--ignore-errors											\
		--js-runtimes "${runtime_javascript}"					\
		--cookies-from-browser "${browser}"						\
		--sleep-requests "${duration_sleep}"					\
		--extract-audio											\
		--audio-format "${extension_track}"						\
		--audio-quality "${quality_audio}"						\
		--format "${format_audio}"								\
		--embed-metadata										\
		--no-playlist											\
		--replace-in-metadata "${field_title}" "${pattern_metadata}" "${title}"	\
		--replace-in-metadata "${field_artist}" "${pattern_metadata}" "${artist}"		\
		--output "${directory_download}/${filename}.${template_extension}"	\
																"${url}"
}

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(
	ffmpeg
	jq
	nodejs
	pip
	xdg-settings
)

frobulator.require "${list[@]}"

unset list

list=(
	yt-dlp
	yt-dlp-ejs
	deno
)

for item in "${list[@]}"
do
	pip install "${item}"
done

list=()

# configuration ────────────────────────────────────────────────────────────────

# initialize setup

# browser

browser_identify

frobulator.inf "Browser identification" "[ ${browser} ]"

# download directory

frobulator.directory "${directory_download}"

# tracks list

list_tracks_input=()

if [ -n "${input_user}" ]
then
	list_tracks_input+=("${input_user}")
fi

if [ -n "${file_input}" ]
then
	while IFS= read -r track
	do
		list_tracks_input+=("${track}")

	done < "${file_input}"

	unset IFS
fi

# downloads - pending

list_tracks_pending=()

if [[ -d "${directory_download}" ]]
then

	frobulator.inf "Download directory present"

	# initiate comparative analysis

	frobulator.fwd "Comparing${marker_elp}"

	# downloads - existing

	list_files_tracks_existing=()

	while IFS= read -r file_track_existing
	do
		list_files_tracks_existing+=( "${file_track_existing}" )

	done < <(
		find "${directory_download}"		\
			-type f							\
			-iname "${pattern_track}"	\
			-printf "${format_find}"
	)

	unset IFS

	list_tracks_existing=()

	for track_existing in "${list_files_tracks_existing[@]}"
	do
		track_existing=${track_existing%."${extension_track}"}

		track_existing="$(normalize "${track_existing}")"

		list_tracks_existing+=("${track_existing}")

	done

	for track in "${list_tracks_input[@]}"
	do
		# skip empty lines

		if [ -z "${track}" ]
		then
			continue
		fi

		# skip comments

		if [[ ${track} = "${prefix_comment}"* ]]
		then
			continue
		fi

		# normalize filename for comparisons

		name_file_normalized="$(normalize "${track}")"

		# preserve original filename for output

		filename="$(echo "${track}" | tr "${characters_separator_from}" "${characters_separator_to}")"

		found="false"

		# compare against existing downloads

		for track_existing in "${list_tracks_existing[@]}"
		do
			if [ "${track_existing}" = "${name_file_normalized}" ]
			then
				found="true"

				break
			fi
		done

		# append only missing tracks

		if [ "${found}" = "false" ]
		then
			frobulator.ret "Adding ${track}"

			list_tracks_pending+=("${track}")
		else
			frobulator.rel "Skipping ${track}"
		fi

	done
fi

# summary ──────────────────────────────────────────────────────────────────────

frobulator.inf "Tracks pending" "[ ${#list_tracks_pending[@]} ]"

# download

if [ "${#list_tracks_pending[@]}" -gt 0 ]
then
	count=0

	file_search="$(mktemp)"

	for track in "${list_tracks_pending[@]}"
	do
		frobulator.fwd "Searching${marker_elp}" "[ ${track} ]"

		# parse artist

		artist=${track%%"${separator_track}"*}

		# parse title

		title=${track#*"${separator_track}"}

		# normalize filename for comparisons

		name_file_normalized="$(normalize "${track}")"

		# preserve original filename for output

		filename="$(echo "${track}" | tr "${characters_separator_from}" "${characters_separator_to}")"

		unset url

		# retrieve candidates

		youtube_search "${track}" > "${file_search}"

		results="$(cat "${file_search}")"

		# select first reasonable duration

		while IFS= read -r result
		do
			duration_track="$(echo "${result}" | jq --raw-output "${filter_duration}")"

			# skip invalid duration

			if [ "${duration_track}" = "${value_null}" ]
			then
				frobulator.wrn "No valid duration match" "[ ${track} ]"

				continue
			fi

			# accept only valid duration

			if [ "${duration_track}" -ge "${duration_minimum}" ] &&
			   [ "${duration_track}" -le "${duration_maximum}" ]
			then
				url="$(echo "${result}" | jq --raw-output "${filter_url}")"

				break
			fi

		done <<< "${results}"

		unset IFS

		# validate

		if [ -z "${url}" ]
		then
			frobulator.err "No valid match found" "[ ${track} ]"

			continue
		fi

		frobulator.url "Match found" "[ ${url} ]"

		# download

		frobulator.background "download" -- youtube_download	\
			"${url}"		\
			"${artist}"		\
			"${title}"		\
							"${filename}"

		echo

		frobulator.scs "${directory_download}/${filename}.${extension_track}"

		# increment file count

		count=$(( count + 1 ))

	done

	unset IFS

	frobulator.delete "${file_search}"

	frobulator.scs "${count} downloads saved" "[ ${directory_download} ]"
fi
