#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version='05-21-2026'

# variables ────────────────────────────────────────────────────────────────────

duration_minimum=120

duration_maximum=780

count_search=1

duration_sleep_minimum=1

duration_sleep_maximum=5

solver="deno"

runtime_javascript="${solver}:$(command -v ${solver})"

extension_track="mp3"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-d|--directory)
			option="directory"
			directory_download="${2}"

			shift
		;;

		-i|--input)
			option="input"
			input_user="${2}"

			shift
		;;

		-f|--file)
			option="file"
			file_input="${2}"

			shift
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -i ['Artist - Track'] | -f [File] | -h [OPTION]"
			echo
			echo -e "Options:"
			echo
			echo -e "-i, --input    Search and download s[i]ngle track."
			echo
			echo -e "-f, --file     Search and download tracks from list in [f]ile."
			echo
			echo -e "-h, --help     Show [h]elp and usage information."
			echo
			echo -e "'${script}'    [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -i ['Artist - Track'] | -f [File] | -h [OPTION]"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# clear ────────────────────────────────────────────────────────────────────────

frobulator.clear

# variables ────────────────────────────────────────────────────────────────────

stamp=$(date +"%m-%d-%Y-%H-%M-%S")

# defaults ─────────────────────────────────────────────────────────────────────

if [ -z "${option}" ]
then
	frobulator.err 'No option selected'

	exit 1
fi

if [ -z "${directory_download}" ]
then
	frobulator.wrn "No download directory specified"

	frobulator.inf "Defaulting" "[ ${HOME}/tracks ]"

	directory_download="${HOME}"/tracks

else
	directory_download="${directory_download}"
fi

if [ "${option}" = "input" ] &&
   [ -z "${input_user}"    ]
then
	frobulator.err "Missing input track"

	usage

	exit 1
fi

if [ "${option}" = "file" ] &&
   [ -z "${file_input}"   ]
then
	frobulator.err 'No input file specified'

	exit 1
fi

if [ "${option}" = 'file' ] &&
   [ ! -f "${file_input}" ]
then
	frobulator.err "No input file found" "[ ${file_input} ]"

	exit 1
fi

# functions ────────────────────────────────────────────────────────────────────

browser_identify () {

	browser=$(
		xdg-settings get default-web-browser 2>"${sink}"
	)

	browser=${browser%.desktop}

	if [[ "${browser}" = firefox*         ]] ||
	   [[ "${browser}" = librewolf*       ]] ||
	   [[ "${browser}" = waterfox*        ]]
	then
		browser="firefox"

	elif [[ "${browser}" = chrome*        ]] ||
	     [[ "${browser}" = google-chrome* ]] ||
	     [[ "${browser}" = chromium*      ]] ||
	     [[ "${browser}" = brave*         ]] ||
	     [[ "${browser}" = vivaldi*       ]] ||
	     [[ "${browser}" = opera*         ]]
	then
		browser="chrome"

	else
		frobulator.err "No compatible browser found on system"

		exit 1
	fi
}

normalize () {

	echo "${1}"						|

		tr '[:upper:]' '[:lower:]'	|

		tr '/:' '--'				|

		sed								\
			-e 's/[^a-z0-9._ -]//g'		\
			-e 's/[[:space:]]\+/ /g'	\
			-e 's/^ *//g'				\
			-e 's/ *$//g'
}

sleep_randomize () {

	duration_sleep=$(( RANDOM % ( duration_sleep_maximum - duration_sleep_minimum + 1 ) + duration_sleep_minimum ))

	frobulator.inf "Seeping" "[ ${duration_sleep} second(s) ]"

	sleep "${duration_sleep}"
}

youtube_search () {

	local track="${1}"

	sleep_randomize

	yt-dlp										\
		--quiet									\
		--no-update								\
		--cookies-from-browser "${browser}"		\
		--js-runtimes "${runtime_javascript}"	\
		--sleep-requests "${duration_sleep}"	\
		--flat-playlist							\
		--dump-json								\
												"ytsearch${count_search}:${track}" 2>"${sink}"
}

youtube_download () {

	local url="${1}"
	local artist="${2}"
	local title="${3}"
	local filename="${4}"

	quality_audio="0"

	format_audio='bestaudio/best'

	sleep_randomize

	yt-dlp														\
		--quiet													\
		--no-update												\
		--ignore-errors											\
		--js-runtimes "${runtime_javascript}"					\
		--cookies-from-browser "${browser}"						\
		--sleep-requests "${duration_sleep}"					\
		--extract-audio											\
		--audio-format "${extension_track}"						\
		--audio-quality "${quality_audio}"						\
		--format "${format_audio}"								\
		--embed-metadata										\
		--no-playlist											\
		--replace-in-metadata title '^.*$' "${title}"			\
		--replace-in-metadata artist '^.*$' "${artist}"			\
		--output "${directory_download}/${filename}.%(ext)s"	\
																"${url}"
}

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(
	ffmpeg
	jq
	nodejs
	pip
	xdg-settings
)

frobulator.require "${list[@]}"

unset list

list=(
	yt-dlp
	yt-dlp-ejs
	deno
)

for item in "${list[@]}"
do
	pip install "${item}"
done

list=()

# configuration ────────────────────────────────────────────────────────────────

# initialize setup

# browser

browser_identify

frobulator.inf "Browser identification" "[ ${browser} ]"

# download directory

frobulator.directory "${directory_download}"

# tracks list

list_tracks_input=()

if [ -n "${input_user}" ]
then
	list_tracks_input+=("${input_user}")
fi

if [ -n "${file_input}" ]
then
	while IFS= read -r track
	do
		list_tracks_input+=("${track}")

	done < "${file_input}"

	unset IFS
fi

# downloads - pending

list_tracks_pending=()

if [[ -d "${directory_download}" ]]
then

	frobulator.inf "Download directory present"

	# initiate comparative analysis

	frobulator.fwd "Comparing${marker_elp}"

	# downloads - existing

	list_files_tracks_existing=()

	while IFS= read -r file_track_existing
	do
		list_files_tracks_existing+=( "${file_track_existing}" )

	done < <(
		find "${directory_download}"		\
			-type f							\
			-iname "*.${extension_track}"	\
			-printf '%f\n'
	)

	unset IFS

	list_tracks_existing=()

	for track_existing in "${list_files_tracks_existing[@]}"
	do
		track_existing=${track_existing%."${extension_track}"}

		track_existing=$(normalize "${track_existing}")

		list_tracks_existing+=("${track_existing}")

	done

	for track in "${list_tracks_input[@]}"
	do
		# skip empty lines

		if [ -z "${track}" ]
		then
			continue
		fi

		# skip comments

		if [[ ${track} = \#* ]]
		then
			continue
		fi

		# normalize filename for comparisons

		name_file_normalized=$(normalize "${track}")

		# preserve original filename for output

		filename=$(echo "${track}" | tr '/:' '--')

		found='false'

		# compare against existing downloads

		for track_existing in "${list_tracks_existing[@]}"
		do
			if [ "${track_existing}" = "${name_file_normalized}" ]
			then
				found='true'

				break
			fi
		done

		# append only missing tracks

		if [ "${found}" = 'false' ]
		then
			frobulator.ret "Adding ${track}"

			list_tracks_pending+=("${track}")
		else
			frobulator.rel "Skipping ${track}"
		fi

	done
fi

# summary ──────────────────────────────────────────────────────────────────────

frobulator.inf "Tracks pending" "[ ${#list_tracks_pending[@]} ]"

# download

if [ "${#list_tracks_pending[@]}" -gt 0 ]
then
	count=0

	file_search=$(mktemp)

	for track in "${list_tracks_pending[@]}"
	do
		frobulator.fwd "Searching${marker_elp}" "[ ${track} ]"

		# parse artist

		artist=${track%% - *}

		# parse title

		title=${track#* - }

		# normalize filename for comparisons

		name_file_normalized=$(normalize "${track}")

		# preserve original filename for output

		filename=$(echo "${track}" | tr '/:' '--')

		url=''

		# retrieve candidates

		youtube_search "${track}" > "${file_search}"

		results=$(cat "${file_search}")

		# select first reasonable duration

		while IFS= read -r result
		do
			duration_track=$(echo "${result}" | jq -r '.duration')

			# skip invalid duration

			if [ "${duration_track}" = 'null' ]
			then
				frobulator.wrn "No valid duration match" "[ ${track} ]"

				continue
			fi

			# accept only valid duration

			if [ "${duration_track}" -ge "${duration_minimum}" ] &&
			   [ "${duration_track}" -le "${duration_maximum}" ]
			then
				url=$(echo "${result}" | jq -r '.webpage_url')

				break
			fi

		done <<< "${results}"

		unset IFS

		# validate

		if [ -z "${url}" ]
		then
			frobulator.err "No valid match found" "[ ${track} ]"

			continue
		fi

		frobulator.url "Match found" "[ ${url} ]"

		# download

		youtube_download	\
			"${url}"		\
			"${artist}"		\
			"${title}"		\
							"${filename}" &

		frobulator.progress "download"

		echo

		frobulator.scs "${directory_download}/${filename}.${extension_track}"

		# increment file count

		count=$(( count + 1 ))

	done

	unset IFS

	frobulator.delete "${file_search}"

	frobulator.scs "${count} downloads saved" "[ ${directory_download} ]"
fi
