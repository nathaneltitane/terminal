#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

# set before the help text

option_termux="termux"
option_git="git"
option_shell="shell"
option_adb="adb"
option_geany="geany"
option_all="all"

while (( $# ))
do
	case "${1}"
	in
		-t|--termux)
			option="${option_termux}"
		;;

		-g|--git)
			option="${option_git}"
		;;

		-s|--shell)
			option="${option_shell}"
		;;

		-d|--adb)
			option="${option_adb}"
		;;

		-e|--geany)
			option="${option_geany}"
		;;

		-a|--all)
			option="${option_all}"
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -t | -g | -s | -d | -e | -a | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-t, --termux    Set up [t]ermux colors, font, and properties."
			echo
			echo -e "-g, --git       Set up [g]it configuration and credentials."
			echo
			echo -e "-s, --shell     Set up [s]hell dotfiles."
			echo
			echo -e "-d, --adb       Set up a[d]b, fastboot, and related tools."
			echo
			echo -e "-e, --geany     Set up g[e]any editor configuration."
			echo
			echo -e "-a, --all       Run [a]ll modules explicitly."
			echo
			echo -e "-h, --help      Show [h]elp and usage information."
			echo
			echo -e "'${script}'     [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -t | -g | -s | -d | -e | -a | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

label_setting_up="Setting up"
directory_bin="${HOME}/.local/bin"
directory_termux="${HOME}/.termux"
directory_geany="${HOME}/.config/geany"
url_termux="get.trmx.app"
url_terminal="get.trmnl.me"
url_android="${url_terminal}/android"
directory_storage_desktop="/media/internal"
directory_storage_android="/storage/emulated/0"
directory_storage_prefix="${PREFIX}/media/internal"
directory_git="Git"
directory_terminal="${directory_storage_prefix}/${directory_git}/terminal"

# defaults ─────────────────────────────────────────────────────────────────────

if [ -z "${option}" ]
then
	option="${option_all}"
fi

# functions ────────────────────────────────────────────────────────────────────

settings_intent () {

	local action_reload
	local package_termux

	local command_settings=()

	action_reload="com.termux.app.reload_style"
	package_termux="com.termux"

	# reload termux settings

	command_settings+=(am broadcast)
	command_settings+=(--user 0)
	command_settings+=(-a "${action_reload}")
	command_settings+=("${package_termux}")

	frobulator.silence "${command_settings[@]}"
}

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(

)

frobulator.require ${list[@]}

list=()

# configuration ────────────────────────────────────────────────────────────────

# termux

if [ "${option}" = "${option_termux}" ] ||
   [ "${option}" = "${option_all}" ]
then
	frobulator.inf "${label_setting_up}" "[ ${option_termux} ]"

	list+=(
		termux-colors
		termux-font
		termux-properties
	)

	frobulator.download "${url_termux}" "${directory_bin}" ${list[@]}

	frobulator.link "${directory_bin}" "${directory_termux}" termux-colors     colors.properties
	frobulator.link "${directory_bin}" "${directory_termux}" termux-font       font.ttf
	frobulator.link "${directory_bin}" "${directory_termux}" termux-properties termux.properties

	settings_intent

	list=()
fi

# git

if [ "${option}" = "${option_git}" ] ||
   [ "${option}" = "${option_all}" ]
then
	frobulator.inf "${label_setting_up}" "[ ${option_git} ]"

	if [ -z "${TERMUX_VERSION}" ]
	then
		storage="${directory_storage_desktop}"
	else
		if [ -d "${directory_storage_prefix}" ]
		then
			storage="${directory_storage_prefix}"
		else
			storage="${directory_storage_android}"
		fi
	fi

	frobulator.link "${storage}/${directory_git}" "${HOME}" git-configuration .gitconfig
	frobulator.link "${storage}/${directory_git}" "${HOME}" git-credentials   .git-credentials
fi

# shell

if [ "${option}" = "${option_shell}" ] ||
   [ "${option}" = "${option_all}" ]
then
	frobulator.inf "${label_setting_up}" "[ ${option_shell} ]"

	list+=(
		bash-aliases
		bash-configuration
		bash-functions
		bash-login
		bash-logout
		bash-profile
	)

	frobulator.download "${url_terminal}" "${directory_bin}" ${list[@]}

	frobulator.link "${directory_bin}" "${HOME}" bash-aliases       .bash_aliases
	frobulator.link "${directory_bin}" "${HOME}" bash-configuration .bashrc
	frobulator.link "${directory_bin}" "${HOME}" bash-configuration .bash_configuration
	frobulator.link "${directory_bin}" "${HOME}" bash-functions     .bash_functions
	frobulator.link "${directory_bin}" "${HOME}" bash-login         .bash_login
	frobulator.link "${directory_bin}" "${HOME}" bash-logout        .bash_logout
	frobulator.link "${directory_bin}" "${HOME}" bash-profile       .bash_profile

	list=()
fi

# adb

if [ "${option}" = "${option_adb}" ] ||
   [ "${option}" = "${option_all}" ]
then
	frobulator.inf "${label_setting_up}" "[ ${option_adb} ]"

	list+=(
		adb
		fastboot
		e2fsdroid
		f2fs_sload
		make_f2fs
	)

	frobulator.download "${url_android}" "${directory_bin}" ${list[@]}

	list=()
fi

# geany

if [ "${option}" = "${option_geany}" ] ||
   [ "${option}" = "${option_all}" ]
then
	frobulator.inf "${label_setting_up}" "[ ${option_geany} ]"

	frobulator.directory "${directory_geany}"

	frobulator.link "${directory_terminal}" "${directory_geany}" geany-configuration geany.conf
	frobulator.link "${directory_terminal}" "${directory_geany}" geany-keyboard      keybindings.conf
	frobulator.link "${directory_terminal}" "${directory_geany}" geany-toolbar       ui_toolbar.xml
fi

