#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (($#))
do
	case "${1}"
	in
		-t|--termux)
			option="termux"
		;;

		-g|--git)
			option="git"
		;;

		-s|--shell)
			option="shell"
		;;

		-d|--adb)
			option="adb"
		;;

		-e|--geany)
			option="geany"
		;;

		-a|--all)
			option="all"
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -t | -g | -s | -d | -e | -a | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-t, --termux    Set up [t]ermux colors, font, and properties."
			echo
			echo -e "-g, --git       Set up [g]it configuration and credentials."
			echo
			echo -e "-s, --shell     Set up [s]hell dotfiles."
			echo
			echo -e "-d, --adb       Set up a[d]b, fastboot, and related tools."
			echo
			echo -e "-e, --geany     Set up g[e]any editor configuration."
			echo
			echo -e "-a, --all       Run [a]ll modules explicitly."
			echo
			echo -e "-h, --help      Show [h]elp and usage information."
			echo
			echo -e "'${script}'     [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -t | -g | -s | -d | -e | -a | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

# defaults ─────────────────────────────────────────────────────────────────────

if [ -z "${option}" ]
then
	option="all"
fi

# functions ────────────────────────────────────────────────────────────────────

settings_intent () {

	# reload termux settings

	settings_command=()

	settings_command+=(am broadcast)
	settings_command+=(--user 0)
	settings_command+=(-a com.termux.app.reload_style)
	settings_command+=(com.termux)

	frobulator.silence "${settings_command[@]}"
}

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(

)

frobulator.require ${list[@]}

list=()

# configuration ────────────────────────────────────────────────────────────────

# termux

if [ "${option}" = "termux" ] || [ "${option}" = "all" ]
then
	frobulator.inf "Setting up" "[ termux ]"

	list+=(
		termux-colors
		termux-font
		termux-properties
	)

	frobulator.download get.trmx.app "${HOME}"/.local/bin ${list[@]}

	frobulator.link "${HOME}"/.local/bin "${HOME}"/.termux termux-colors     colors.properties
	frobulator.link "${HOME}"/.local/bin "${HOME}"/.termux termux-font       font.ttf
	frobulator.link "${HOME}"/.local/bin "${HOME}"/.termux termux-properties termux.properties

	settings_intent

	list=()
fi

# git

if [ "${option}" = "git" ] || [ "${option}" = "all" ]
then
	frobulator.inf "Setting up" "[ git ]"

	if [ -z "${TERMUX_VERSION}" ]
	then
		storage=/media/internal
	else
		if [ -d "${PREFIX}"/media/internal ]
		then
			storage="${PREFIX}"/media/internal
		else
			storage=/storage/emulated/0
		fi
	fi

	frobulator.link "${storage}"/Git "${HOME}" git-configuration .gitconfig
	frobulator.link "${storage}"/Git "${HOME}" git-credentials   .git-credentials
fi

# shell

if [ "${option}" = "shell" ] || [ "${option}" = "all" ]
then
	frobulator.inf "Setting up" "[ shell ]"

	list+=(
		bash-aliases
		bash-configuration
		bash-functions
		bash-login
		bash-logout
		bash-profile
	)

	frobulator.download get.trmnl.me "${HOME}"/.local/bin ${list[@]}

	frobulator.link "${HOME}"/.local/bin "${HOME}" bash-aliases       .bash_aliases
	frobulator.link "${HOME}"/.local/bin "${HOME}" bash-configuration .bashrc
	frobulator.link "${HOME}"/.local/bin "${HOME}" bash-configuration .bash_configuration
	frobulator.link "${HOME}"/.local/bin "${HOME}" bash-functions     .bash_functions
	frobulator.link "${HOME}"/.local/bin "${HOME}" bash-login         .bash_login
	frobulator.link "${HOME}"/.local/bin "${HOME}" bash-logout        .bash_logout
	frobulator.link "${HOME}"/.local/bin "${HOME}" bash-profile       .bash_profile

	list=()
fi

# adb

if [ "${option}" = "adb" ] || [ "${option}" = "all" ]
then
	frobulator.inf "Setting up" "[ adb ]"

	list+=(
		adb
		fastboot
		e2fsdroid
		f2fs_sload
		make_f2fs
	)

	frobulator.download get.trmnl.me/android "${HOME}"/.local/bin ${list[@]}

	list=()
fi

# geany

if [ "${option}" = "geany" ] || [ "${option}" = "all" ]
then
	frobulator.inf "Setting up" "[ geany ]"

	frobulator.directory "${HOME}"/.config/geany

	frobulator.link "${PREFIX}"/media/internal/Git/terminal "${HOME}"/.config/geany geany-configuration geany.conf
	frobulator.link "${PREFIX}"/media/internal/Git/terminal "${HOME}"/.config/geany geany-keyboard      keybindings.conf
	frobulator.link "${PREFIX}"/media/internal/Git/terminal "${HOME}"/.config/geany geany-toolbar       ui_toolbar.xml
fi

