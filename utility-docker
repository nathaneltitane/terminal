#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-09"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-s|--setup)
			option_setup="${2}"

			shift
		;;

		-n|--name)
			option_name="${2}"

			shift
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -s [Setup] [-n Name] | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-s, --setup    Specify container [s]etup to deploy."
			echo
			echo -e "               auto-update       Daily image updates - containers recreated from their run files."
			echo -e "               home-assistant    Home automation - web on port 8123."
			echo -e "               nextcloud         File hosting and sharing - web on port 8080."
			echo -e "               pi-hole           Network wide ad blocking - dns on port 53 - web on port 80."
			echo -e "               portainer         Container management - web on port 9443."
			echo -e "               tailscale         Private network access - login link shown after deploying."
			echo
			echo -e "-n, --name     Specify [n]ame of the deployed container."
			echo
			echo -e "               [ setup name ] [ Default ]"
			echo
			echo -e "-h, --help     Show [h]elp and usage information."
			echo
			echo -e "'${script}'    [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -s [Setup] [-n Name] | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

# setup names and docker settings - shared by the setups

name_setup_update="auto-update"
prefix_function_setup="setup_"
prefix_option="-"
separator_values=" // "
separator_dash="-"
separator_underscore="_"
separator_password=": "
property_timezone="Timezone"
zone_default="UTC"
protocol_web="http"
protocol_web_secure="https"
protocol_port="tcp"
protocol_port_udp="udp"
policy_restart="unless-stopped"
network_host="host"
name_environment_timezone="TZ"
name_file_run="run"
mode_run="700"
mode_update="755"
count_timeout_log="30"
count_lines_first="1"
delay_poll="1"
format_run_header='#!/bin/bash\n\n'
format_run_command='docker run'
format_run_argument=' \\\n\t%q'
format_run_end='\n'

# setups - one setup_<name> function each - dashes become underscores

list_setups=(
	"${name_setup_update}"
	home-assistant
	nextcloud
	pi-hole
	portainer
	tailscale
)

# containers - one data directory each

directory_docker=/var/docker

# timezone of this computer - handed to the containers

zone_time="$(timedatectl show --property "${property_timezone}" --value 2> "${sink}")"

# lan address of this computer - web interface links

text_addresses="$(hostname -I)"

address_lan="${text_addresses%% *}"

# defaults ─────────────────────────────────────────────────────────────────────

if [ -z "${option_setup}" ]
then
	frobulator.err "Missing setup."
	frobulator.nul "Specify '--setup' - one of: ${list_setups[*]}"

	exit 1

elif [[ "${option_setup}" = "${prefix_option}"* ]]
then
	frobulator.err "Missing argument for '--setup'."

	exit 1

elif [[ ! " ${list_setups[*]} " == *" ${option_setup} "* ]]
then
	frobulator.err "Unknown setup" "[ ${option_setup} ]"

	exit 1

elif [[ "${option_name}" = "${prefix_option}"* ]]
then
	frobulator.err "Missing argument for '--name'."

	exit 1
fi

name_container="${option_name:-${option_setup}}"

directory_container="${directory_docker}/${name_container}"

zone_time="${zone_time:-${zone_default}}"

hint_logs="docker logs ${name_container}"

# functions ────────────────────────────────────────────────────────────────────

container_prepare () {

	# previous container removed - data directory kept - created when missing

	local status=0
	local filter_container="name=^${name_container}$"
	local id_container_existing

	id_container_existing="$(docker container ls --all --quiet --filter "${filter_container}")"

	if [ -n "${id_container_existing}" ]
	then
		frobulator.silence log "docker stop ${name_container}"

		frobulator.track

		frobulator.silence log "docker rm -f ${name_container}"

		frobulator.track
	fi

	if [ ! -d "${directory_container}" ]
	then
		frobulator.directory "${directory_docker}" "${name_container}"

		frobulator.track
	fi

	return "${status}"
}

container_log_line () {

	# first log line holding a text - waited for up to 30 seconds

	local text_search="${1}"
	local seconds=0
	local timeout="${count_timeout_log}"
	local line_log

	while [ -z "${line_log}" ] && [ "${seconds}" -lt "${timeout}" ]
	do
		line_log="$(docker logs "${name_container}" 2>&1 | grep --max-count "${count_lines_first}" --fixed-strings "${text_search}")"

		if [ -z "${line_log}" ]
		then
			sleep "${delay_poll}"

			seconds=$(( seconds + 1 ))
		fi
	done

	echo "${line_log}"
}

container_run () {

	# run file kept beside the data - reused by the automatic updates

	local status=0
	local file_run="${directory_container}/${name_file_run}"
	local argument_run

	{
		printf "${format_run_header}"
		printf "${format_run_command}"

		for argument_run in "${@}"
		do
			printf "${format_run_argument}" "${argument_run}"
		done

		printf "${format_run_end}"
	} > "${file_run}"

	frobulator.track || return "${status}"

	chmod "${mode_run}" "${file_run}"

	bash "${file_run}" > "${sink}" 2>&1

	frobulator.track

	return "${status}"
}

setup_auto_update () {

	# daily image updates - containers with a newer image recreated from their run file - data kept

	local status=0
	local file_update_script="/usr/local/bin/docker-auto-update"
	local file_update_service="/etc/systemd/system/docker-auto-update.service"
	local file_update_timer="/etc/systemd/system/docker-auto-update.timer"
	local name_update_timer="docker-auto-update.timer"
	local time_update="04:00"

	cat << 'UPDATE' > "${file_update_script}"
#!/bin/bash

# docker auto update - images pulled - containers with a newer image recreated from their run file

directory_docker=/var/docker

for file_run in "${directory_docker}"/*/run
do
	if [ ! -f "${file_run}" ]
	then
		continue
	fi

	name_container="$(basename "$(dirname "${file_run}")")"
	name_image="$(docker inspect --format '{{.Config.Image}}' "${name_container}" 2> /dev/null)"

	if [ -z "${name_image}" ]
	then
		continue
	fi

	docker pull --quiet "${name_image}" > /dev/null 2>&1

	id_image_running="$(docker inspect --format '{{.Image}}' "${name_container}")"
	id_image_latest="$(docker image inspect --format '{{.Id}}' "${name_image}")"

	if [ "${id_image_running}" != "${id_image_latest}" ]
	then
		logger -t docker-auto-update "updating ${name_container} - ${name_image}"

		docker rm --force "${name_container}" > /dev/null

		bash "${file_run}" > /dev/null
	fi
done

# images no longer used by any container

docker image prune --force > /dev/null
UPDATE

	frobulator.track || return "${status}"

	chmod "${mode_update}" "${file_update_script}"

	cat << 'SERVICE' > "${file_update_service}"
[Unit]
Description=Docker auto update - newer images pulled - containers recreated
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/docker-auto-update
SERVICE

	frobulator.track

	cat << 'TIMER' > "${file_update_timer}"
[Unit]
Description=Docker auto update - daily

[Timer]
OnCalendar=*-*-* 04:00:00
RandomizedDelaySec=30min
Persistent=true

[Install]
WantedBy=timers.target
TIMER

	frobulator.track

	systemctl daemon-reload

	systemctl enable --now "${name_update_timer}" > "${sink}" 2>&1

	frobulator.track

	frobulator.inf "Daily updates" "[ ${name_update_timer}${separator_values}${time_update} ]"

	return "${status}"
}

setup_home_assistant () {

	# home automation - host network for device discovery - dbus read only for bluetooth

	local status=0
	local port_web="8123"
	local path_dbus="/run/dbus"
	local path_config="/config"
	local name_directory_config="config"
	local mode_read_only="ro"
	local image_container="ghcr.io/home-assistant/home-assistant:stable"

	container_run																			\
		--detach																			\
		--name "${name_container}"															\
		--restart="${policy_restart}"														\
		--network="${network_host}"															\
		-v "${directory_container}/${name_directory_config}:${path_config}"					\
		-v "${path_dbus}:${path_dbus}:${mode_read_only}"									\
		-e "${name_environment_timezone}=${zone_time}"										\
																							"${image_container}"

	frobulator.track || return "${status}"

	frobulator.inf "Web interface" "[ ${protocol_web}://${address_lan}:${port_web} ]"

	return "${status}"
}

setup_nextcloud () {

	# file hosting - port 8080 - port 80 kept for pi-hole - admin created in the web interface

	local status=0
	local port_web="8080"
	local port_container="80"
	local path_html="/var/www/html"
	local name_directory_html="html"
	local image_container="nextcloud:latest"

	container_run																			\
		--detach																			\
		--name "${name_container}"															\
		--restart="${policy_restart}"														\
		-p "${port_web}:${port_container}/${protocol_port}"									\
		-v "${directory_container}/${name_directory_html}:${path_html}"						\
		-e "${name_environment_timezone}=${zone_time}"										\
																							"${image_container}"

	frobulator.track || return "${status}"

	frobulator.inf "Web interface" "[ ${protocol_web}://${address_lan}:${port_web} ]"

	return "${status}"
}

setup_pi_hole () {

	# network wide ad blocking - random admin password read from the logs

	local status=0
	local port_dns="53"
	local port_web="80"
	local address_dns_local="127.0.0.1"
	local address_dns_upstream="1.1.1.1"
	local path_config="/etc/pihole"
	local name_directory_config="etc-pihole"
	local name_environment_listening="FTLCONF_dns_listeningMode"
	local value_listening="ALL"
	local text_search_password="password:"
	local name_file_password="password"
	local path_admin="/admin"
	local image_container="pihole/pihole:latest"
	local line_password
	local password_admin

	container_run																			\
		--detach																			\
		--name "${name_container}"															\
		--hostname "${name_container}"														\
		--dns="${address_dns_local}"														\
		--dns="${address_dns_upstream}"														\
		--restart="${policy_restart}"														\
		-p "${port_dns}:${port_dns}/${protocol_port}"										\
		-p "${port_dns}:${port_dns}/${protocol_port_udp}"									\
		-p "${port_web}:${port_web}/${protocol_port}"										\
		-v "${directory_container}/${name_directory_config}:${path_config}"					\
		-e "${name_environment_timezone}=${zone_time}"										\
		-e "${name_environment_listening}=${value_listening}"								\
																							"${image_container}"

	frobulator.track || return "${status}"

	line_password="$(container_log_line "${text_search_password}")"

	password_admin="${line_password##*"${separator_password}"}"

	if [ -n "${line_password}" ] && [ -n "${password_admin}" ]
	then
		frobulator.write append "${password_admin}" "${directory_container}" "${name_file_password}"

		frobulator.track

		frobulator.inf "Password" "[ ${password_admin} ]"
	else
		frobulator.wrn "Password not found in the logs" "[ ${hint_logs} ]"
	fi

	frobulator.inf "Web interface" "[ ${protocol_web}://${address_lan}${path_admin} ]"

	return "${status}"
}

setup_portainer () {

	# container management - docker socket - admin created in the web interface within minutes of the first start

	local status=0
	local port_edge="8000"
	local port_web="9443"
	local path_socket="/var/run/docker.sock"
	local path_data="/data"
	local name_directory_data="data"
	local image_container="portainer/portainer-ce:latest"

	container_run																			\
		--detach																			\
		--name "${name_container}"															\
		--restart="${policy_restart}"														\
		-p "${port_edge}:${port_edge}/${protocol_port}"										\
		-p "${port_web}:${port_web}/${protocol_port}"										\
		-v "${path_socket}:${path_socket}"													\
		-v "${directory_container}/${name_directory_data}:${path_data}"						\
																							"${image_container}"

	frobulator.track || return "${status}"

	frobulator.inf "Web interface" "[ ${protocol_web_secure}://${address_lan}:${port_web} ]"
	frobulator.nul "Create the admin account within a few minutes of the first start."

	return "${status}"
}

setup_tailscale () {

	# private network access - host network - tun device - login link read from the logs

	local status=0
	local path_state="/var/lib/tailscale"
	local path_device_tun="/dev/net/tun"
	local name_directory_state="state"
	local capability_admin="NET_ADMIN"
	local capability_raw="NET_RAW"
	local name_environment_state="TS_STATE_DIR"
	local name_environment_userspace="TS_USERSPACE"
	local value_userspace="false"
	local url_login_base="${protocol_web_secure}://login.tailscale.com/"
	local image_container="tailscale/tailscale:latest"
	local name_host
	local line_login
	local url_login

	name_host="$(hostname)"

	container_run																			\
		--detach																			\
		--name "${name_container}"															\
		--hostname "${name_host}"															\
		--restart="${policy_restart}"														\
		--network="${network_host}"															\
		--cap-add="${capability_admin}"														\
		--cap-add="${capability_raw}"														\
		--device "${path_device_tun}:${path_device_tun}"									\
		-v "${directory_container}/${name_directory_state}:${path_state}"					\
		-e "${name_environment_state}=${path_state}"										\
		-e "${name_environment_userspace}=${value_userspace}"								\
																							"${image_container}"

	frobulator.track || return "${status}"

	line_login="$(container_log_line "${url_login_base}")"

	url_login="${url_login_base}${line_login##*"${url_login_base}"}"
	url_login="${url_login%% *}"

	if [ -n "${line_login}" ]
	then
		frobulator.inf "Login" "[ ${url_login} ]"
		frobulator.nul "Open the link to add this computer to your tailnet."
	else
		frobulator.wrn "Login link not found in the logs" "[ ${hint_logs} ]"
	fi

	return "${status}"
}

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(
	docker.io
)

frobulator.require ${list[@]}

frobulator.complete

list=()

# configuration ────────────────────────────────────────────────────────────────

# container setups - data directory prepared - auto-update installs a timer only

if [ "${option_setup}" != "${name_setup_update}" ]
then
	frobulator.inf "Preparing" "[ ${name_container}${separator_values}${directory_container} ]"

	container_prepare

	frobulator.complete
fi

frobulator.inf "Deploying" "[ ${option_setup}${separator_values}${name_container} ]"

"${prefix_function_setup}${option_setup//${separator_dash}/${separator_underscore}}"

frobulator.complete

if [ "${option_setup}" != "${name_setup_update}" ]
then
	id_container="$(docker container ls --all --quiet --filter "name=${name_container}")"

	frobulator.inf "Container ID" "[ ${id_container} ]"
fi

frobulator.result "${script}"

frobulator.scs "Done"
