#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-12"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-i|--install)
			option_install="true"
		;;

		-u|--ui)
			option_ui="true"
		;;

		-r|--register)
			option_register="true"
		;;

		-x|--uninstall)
			option_uninstall="true"
		;;

		-k|--keyboard)
			option_keyboard="true"

			# layout optional - taken from the desktop keyboard when the next argument is another option

			if [ -n "${2}" ] && [[ "${2}" != -* ]]
			then
				name_layout="${2}"

				shift
			fi
		;;

		-s|--share)
			option_share="true"

			# directory optional - default used when the next argument is another option

			if [ -n "${2}" ] && [[ "${2}" != -* ]]
			then
				directory_share="${2}"

				shift
			fi
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -i | -u | -r | -s [Directory] | -k [Layout] | -x | -h"
			echo
			echo -e "Note:                 Android apps on this computer - waydroid with google apps - computer folders shared into android storage."
			echo
			echo -e "                      1. Run '${script} -i' - install and download the android image."
			echo -e "                      2. Run '${script} -u' - first boot - android storage created."
			echo -e "                      3. Run '${script} -r' - register the shown id at google.com/android/uncertified - restart waydroid."
			echo -e "                      4. Run '${script} -s' - share the folder - sign in to google and install the sync app."
			echo
			echo -e "Options:"
			echo
			echo -e "-i, --install         [I]nstall waydroid, weston and bindfs - android ipc devices - google apps image."
			echo
			echo -e "-u, --ui              Start the android [u]ser interface - inside a weston window on x11."
			echo
			echo -e "-r, --register        Show the android id to [r]egister for google play services."
			echo
			echo -e "-s, --share           [S]hare a computer folder into android storage - started at every boot."
			echo
			echo -e "                      [ /media/internal ] [ Default ]"
			echo
			echo -e "-k, --keyboard        Set the android physical [k]eyboard layout - on-screen keyboard hidden while typing."
			echo
			echo -e "                      [ desktop keyboard layout ] [ Default ]"
			echo -e "                      [ us | gb | ca | fr | de | es | it | pt | br | be | ch | se | no | dk | fi | ru ]"
			echo
			echo -e "-x, --uninstall       Remove waydroid and everything it installed - shared folders untouched - local images kept."
			echo
			echo -e "-h, --help            Show [h]elp and usage information."
			echo
			echo -e "'${script}'           [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -i | -u | -r | -s [Directory] | -k [Layout] | -x | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

directory_share="${directory_share:-/media/internal}"
directory_share="${directory_share%/}"

id_user="$(id -u "${USER}")"

directory_runtime="/run/user/${id_user}"
directory_data_waydroid="${HOME}/.local/share/waydroid"
directory_storage_android="${directory_data_waydroid}/data/media/0"
directory_system_android="${directory_data_waydroid}/data/system"
directory_applications="${HOME}/.local/share/applications"
directory_systemd="/etc/systemd/system"
directory_modprobe="/etc/modprobe.d"
directory_modules="/etc/modules-load.d"
directory_state_waydroid="/var/lib/waydroid"
directory_images="${directory_state_waydroid}/images"
directory_keyrings="/usr/share/keyrings"
directory_repository="/etc/apt/sources.list.d"
directory_dropin="${directory_systemd}/waydroid-container.service.d"
directory_configuration="${HOME}/.config"

# android storage user - media_rw - files seen by android apps as their own

id_media_rw=1023

host_repository="repo.waydro.id"
url_repository="https://${host_repository}"
name_keyring="waydroid.gpg"
name_repository="waydroid.list"
url_keyring="${url_repository}/${name_keyring}"
file_keyring="${directory_keyrings}/${name_keyring}"
file_repository="${directory_repository}/${name_repository}"
file_release="/etc/os-release"
file_history_apt="/var/log/apt/history.log"
file_image_system="system.img"
file_image_vendor="vendor.img"
file_binder="binder.conf"
file_dropin="docker-forward.conf"
file_keyboard="input-manager-state.xml"
file_database_services="/data/data/com.google.android.gsf/databases/gservices.db"

# local copy of the android images - system.img and vendor.img - used instead of downloading

directory_images_local=/media/internal/Linux/Waydroid

name_package_curl="curl"
name_package_waydroid="waydroid"
name_package_weston="weston"
name_package_bindfs="bindfs"
name_module_binder="binder_linux"
name_devices_binder="binder,hwbinder,vndbinder"
name_service_container="waydroid-container.service"
name_chain_docker="DOCKER-USER"
name_interface_waydroid="waydroid0"
name_type_image="GAPPS"
name_session_x11="x11"
name_property_display="Display"
name_property_type="Type"
name_label_none="none"
prefix_unit_share="waydroid-share-"
suffix_unit=".service"
label_layout="layout:"
protocol_curl="=https"
pattern_codename='^VERSION_CODENAME='
pattern_image="*.img"
pattern_launcher="waydroid.*.desktop"
pattern_history_install='^Install: .*waydroid:'
pattern_layout="^${label_layout}"
expression_history_prefix='s/^Install: //'
expression_history_split='s/), /)\n/g'
expression_history_suffix='s/:.*//'
format_status_package='${Status}'
status_package_installed="install ok installed"
separator_layouts=","
character_space=" "
frontend_apt="noninteractive"
owner_android="1000:1000"
mode_file_private="0600"
value_boot_completed="1"
width_weston="1280"
height_weston="800"
count_matches_first="1"
count_attempts_register="24"
count_attempts_keyboard="60"
delay_weston="3"
delay_register="5"
delay_keyboard="3"

pattern_share_unit="${prefix_unit_share}*${suffix_unit}"

socket_weston="waydroid-0"
pattern_weston_process="weston .*--socket=${socket_weston}"

# weston settings for the android window - no top panel

file_weston="${directory_configuration}/weston-waydroid.ini"

list_packages_waydroid=(
	"${name_package_waydroid}"
	"${name_package_weston}"
	"${name_package_bindfs}"
)

# defaults ─────────────────────────────────────────────────────────────────────

# functions ────────────────────────────────────────────────────────────────────

user_run () {

	# command run as the desktop user - display and session bus kept

	runuser -u "${USER}" --													\
		env																	\
			HOME="${HOME}"													\
			DISPLAY="${DISPLAY:-:0}"										\
			XAUTHORITY="${XAUTHORITY:-${HOME}/.Xauthority}"					\
			XDG_RUNTIME_DIR="${directory_runtime}"							\
			DBUS_SESSION_BUS_ADDRESS="unix:path=${directory_runtime}/bus"	\
																			"${@}"
}

# validation ───────────────────────────────────────────────────────────────────

if [ "${option_install}" != "true" ] && [ "${option_ui}" != "true" ] && [ "${option_register}" != "true" ] && [ "${option_share}" != "true" ] && [ "${option_uninstall}" != "true" ] && [ "${option_keyboard}" != "true" ]
then
	frobulator.err "Missing operation."
	frobulator.nul "Type './${script} -h' for help and usage information."

	exit 1
fi

# install ──────────────────────────────────────────────────────────────────────

if [ "${option_install}" = "true" ]
then
	list=(
		"${name_package_curl}"
	)

	frobulator.require ${list[@]}

	frobulator.complete

	list=()

	# waydroid repository - signing key and source list - distribution codename

	frobulator.inf "Adding repository" "[ ${host_repository} ]"

	name_codename="$(grep --max-count="${count_matches_first}" "${pattern_codename}" "${file_release}")"
	name_codename="${name_codename#*=}"

	if [ ! -f "${file_keyring}" ]
	then
		curl --silent --proto "${protocol_curl}" --tlsv1.2 --show-error --fail "${url_keyring}" --output "${file_keyring}"

		frobulator.complete
	fi

	frobulator.write write "deb [signed-by=${file_keyring}] ${url_repository}/ ${name_codename} main" "${directory_repository}" "${name_repository}"

	frobulator.complete

	frobulator.silence "apt-get update"

	frobulator.complete

	list=(
		"${list_packages_waydroid[@]}"
	)

	frobulator.install ${list[@]}

	frobulator.complete

	list=()

	# android ipc - three binder devices - the debian kernel has no binderfs

	frobulator.inf "Configuring android ipc" "[ binder // hwbinder // vndbinder ]"

	frobulator.write write "options ${name_module_binder} devices=${name_devices_binder}" "${directory_modprobe}" "${file_binder}"

	frobulator.complete

	frobulator.write write "${name_module_binder}" "${directory_modules}" "${file_binder}"

	frobulator.complete

	modprobe "${name_module_binder}"

	frobulator.complete

	# android image with google apps - downloaded once

	list_images=("${directory_images}"/${pattern_image})

	if [ -e "${list_images[0]}" ]
	then
		frobulator.inf "Android image present" "[ ${directory_images} ]"

	elif [ -f "${directory_images_local}/${file_image_system}" ] && [ -f "${directory_images_local}/${file_image_vendor}" ]
	then
		frobulator.inf "Using local android image" "[ ${directory_images_local} ]"

		waydroid init -i "${directory_images_local}" -f

		frobulator.complete
	else
		frobulator.inf "Downloading android image" "[ lineage // google apps ]"

		waydroid init -s "${name_type_image}" -f

		frobulator.complete

		# kept for the next install - no download then

		frobulator.directory "${directory_images_local}"

		cp "${directory_images}/${file_image_system}" "${directory_images}/${file_image_vendor}" "${directory_images_local}"/

		frobulator.complete
	fi

	# docker drops forwarded traffic by default - android would have no internet
	# waydroid allowed through the docker user chain - before every container start

	path_docker="$(command -v docker)"

	if [ -n "${path_docker}" ]
	then
		frobulator.inf "Allowing android network through docker" "[ ${name_chain_docker} // ${name_interface_waydroid} ]"

		rule_inbound="iptables -C ${name_chain_docker} -i ${name_interface_waydroid} -j ACCEPT 2> /dev/null || iptables -I ${name_chain_docker} -i ${name_interface_waydroid} -j ACCEPT"
		rule_return="iptables -C ${name_chain_docker} -o ${name_interface_waydroid} -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT 2> /dev/null || iptables -I ${name_chain_docker} -o ${name_interface_waydroid} -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT"

		content_dropin=$(cat <<- FILE
		# waydroid network through docker - docker drops forwarded traffic by default
		[Unit]
		After=docker.service

		[Service]
		ExecStartPre=/bin/sh -c '${rule_inbound}; ${rule_return}; true'
		FILE
		)

		frobulator.write write "${content_dropin}" "${directory_dropin}" "${file_dropin}"

		frobulator.complete

		frobulator.service reload

		frobulator.complete
	fi

	frobulator.service activate "${name_service_container}"

	frobulator.complete
fi

# user interface ───────────────────────────────────────────────────────────────

if [ "${option_ui}" = "true" ]
then
	# x11 session - waydroid needs wayland - weston window as the wayland display

	type_session="$(loginctl show-user "${USER}" -p "${name_property_display}" --value 2> "${sink}")"
	type_session="$(loginctl show-session "${type_session}" -p "${name_property_type}" --value 2> "${sink}")"

	display_wayland="${WAYLAND_DISPLAY}"

	if [ "${type_session}" = "${name_session_x11}" ] || [ -z "${display_wayland}" ]
	then
		# weston already open - reused - a new one would leave android on the old display

		list_weston="$(pgrep -u "${USER}" -f "${pattern_weston_process}")"

		if [ -n "${list_weston}" ]
		then
			frobulator.inf "Reusing weston window" "[ ${socket_weston} ]"

			display_wayland="${socket_weston}"
		fi
	fi

	if [ "${type_session}" = "${name_session_x11}" ] && [ -z "${list_weston}" ] || [ -z "${display_wayland}" ]
	then
		# android session tied to a closed window - stopped so it starts on the new one

		user_run waydroid session stop > "${sink}" 2>&1

		frobulator.inf "Starting weston window" "[ ${socket_weston} ]"

		content_weston=$(cat <<- FILE
		[shell]
		panel-position=none
		FILE
		)

		frobulator.write write "${content_weston}" "${directory_configuration}" "${file_weston##*/}"

		frobulator.complete

		user_run weston --config="${file_weston}" --socket="${socket_weston}" --width="${width_weston}" --height="${height_weston}" > "${sink}" 2>&1 &

		sleep "${delay_weston}"

		display_wayland="${socket_weston}"
	fi

	frobulator.inf "Starting android interface"

	user_run env WAYLAND_DISPLAY="${display_wayland}" waydroid show-full-ui > "${sink}" 2>&1 &

	frobulator.complete
fi

# register ─────────────────────────────────────────────────────────────────────

if [ "${option_register}" = "true" ]
then
	# google services id - read from the running android

	# created by google services on its first check-in - needs android online - up to two minutes

	query_register="select value from main where name = 'android_id';"

	frobulator.inf "Waiting for the android id"

	for (( count_wait = 0 ; count_wait < count_attempts_register ; count_wait ++ ))
	do
		id_android="$(waydroid shell -- sh -c "sqlite3 ${file_database_services} \"${query_register}\"" 2> "${sink}")"

		if [ -n "${id_android}" ]
		then
			break
		fi

		sleep "${delay_register}"
	done

	if [ -z "${id_android}" ]
	then
		frobulator.err "Android id not found - android booted and online?" "[ ${script} -u ]"

		exit 1
	fi

	frobulator.scs "Android id" "[ ${id_android} ]"
	frobulator.nul "Register it at https://www.google.com/android/uncertified - then restart waydroid."
fi

# share ────────────────────────────────────────────────────────────────────────

if [ "${option_share}" = "true" ]
then
	if [ ! -d "${directory_share}" ]
	then
		frobulator.err "Directory not found" "[ ${directory_share} ]"

		exit 1
	fi

	if [ ! -d "${directory_storage_android}" ]
	then
		frobulator.err "Android storage not created yet - start the interface once first" "[ ${script} -u ]"

		exit 1
	fi

	# folder name inside android storage - service named after it

	name_share="$(basename -- "${directory_share}")"
	name_share="${name_share^}"

	directory_target="${directory_storage_android}/${name_share}"
	name_service="${prefix_unit_share}${name_share,,}${suffix_unit}"

	# bindfs - android sees media_rw as owner - files created from android belong to the desktop user

	content_service=$(cat <<- FILE
	[Unit]
	Description=Waydroid - ${directory_share} shared into android storage as ${name_share}
	After=local-fs.target

	[Service]
	Type=forking
	ExecStartPre=/usr/bin/mkdir -p "${directory_target}"
	ExecStart=/usr/bin/bindfs --force-user=${id_media_rw} --force-group=${id_media_rw} --create-for-user=${id_user} --create-for-group=${id_user} -o allow_other "${directory_share}" "${directory_target}"
	ExecStop=/usr/bin/fusermount -u "${directory_target}"
	RemainAfterExit=yes

	[Install]
	WantedBy=multi-user.target
	FILE
	)

	frobulator.write write "${content_service}" "${directory_systemd}" "${name_service}"

	frobulator.complete

	frobulator.service reload

	frobulator.complete

	frobulator.service activate "${name_service}"

	frobulator.complete

	frobulator.scs "Shared into android storage" "[ ${directory_share} >> ${name_share} ]"
	frobulator.nul "Restart waydroid so android sees the new folder."
fi

# keyboard ─────────────────────────────────────────────────────────────────────

if [ "${option_keyboard}" = "true" ]
then
	# desktop keyboard layout - first one listed by the x keyboard settings

	if [ -z "${name_layout}" ]
	then
		text_layout="$(user_run setxkbmap -query 2> "${sink}" | grep --max-count="${count_matches_first}" "${pattern_layout}")"
		text_layout="${text_layout#"${label_layout}"}"
		text_layout="${text_layout//"${character_space}"/}"

		name_layout="${text_layout%%"${separator_layouts}"*}"
	fi

	# desktop layout code to the android keyboard layout name

	declare -A layouts_android=(
		[us]="english_us"
		[gb]="english_uk"
		[ca]="french_ca"
		[fr]="french"
		[de]="german"
		[es]="spanish"
		[it]="italian"
		[pt]="portuguese"
		[br]="brazilian"
		[be]="belgian"
		[ch]="swiss_german"
		[se]="swedish"
		[no]="norwegian"
		[dk]="danish"
		[fi]="finnish"
		[ru]="russian"
	)

	name_layout_android="${layouts_android[${name_layout}]}"

	if [ -z "${name_layout_android}" ]
	then
		frobulator.err "Keyboard layout not supported" "[ ${name_layout:-${name_label_none}} ]"

		exit 1
	fi

	frobulator.inf "Setting android keyboard layout" "[ ${name_layout} // ${name_layout_android} ]"

	# android stopped - its input settings are read at start - written back on change only

	user_run waydroid session stop > "${sink}" 2>&1

	frobulator.complete

	# waydroid keyboard - device vendor 1 product 1 - plain xml read as well as binary xml

	content_keyboard=$(cat <<- FILE
	<?xml version='1.0' encoding='UTF-8' standalone='yes' ?>
	<input-manager-state>
	  <input-devices>
	    <input-device descriptor="vendor:1,product:1">
	      <keyboard-layout descriptor="com.android.inputdevices/com.android.inputdevices.InputDeviceReceiver/keyboard_layout_${name_layout_android}" current="true" />
	    </input-device>
	  </input-devices>
	</input-manager-state>
	FILE
	)

	frobulator.write write "${content_keyboard}" "${directory_system_android}" "${file_keyboard}"

	frobulator.complete

	# android system user owns it

	chown "${owner_android}" "${directory_system_android}/${file_keyboard}"
	chmod "${mode_file_private}" "${directory_system_android}/${file_keyboard}"

	frobulator.complete

	# android started again in the open window - on-screen keyboard hidden while a physical keyboard types

	user_run env WAYLAND_DISPLAY="${socket_weston}" waydroid show-full-ui > "${sink}" 2>&1 &

	for (( count_wait = 0 ; count_wait < count_attempts_keyboard ; count_wait ++ ))
	do
		state_boot="$(waydroid shell -- getprop sys.boot_completed < "${sink}" 2> "${sink}")"

		if [ "${state_boot}" = "${value_boot_completed}" ]
		then
			break
		fi

		sleep "${delay_keyboard}"
	done

	waydroid shell -- settings put secure show_ime_with_hard_keyboard 0 < "${sink}" > "${sink}" 2>&1

	frobulator.complete

	frobulator.scs "Android keyboard layout set" "[ ${name_layout_android} ]"
	frobulator.nul "The on-screen keyboard language is chosen in android settings - system - languages and input."
fi

# uninstall ────────────────────────────────────────────────────────────────────

if [ "${option_uninstall}" = "true" ]
then
	# stopped first - window, android session, container and shares

	frobulator.inf "Stopping waydroid"

	pkill -u "${USER}" -f "${pattern_weston_process}" > "${sink}" 2>&1

	user_run waydroid session stop > "${sink}" 2>&1

	list_units_share=("${directory_systemd}"/${pattern_share_unit})

	for file_unit in "${list_units_share[@]}"
	do
		if [ -f "${file_unit}" ]
		then
			systemctl disable --now "${file_unit##*/}" > "${sink}" 2>&1
		fi
	done

	systemctl disable --now "${name_service_container}" > "${sink}" 2>&1

	frobulator.complete

	# shared folders - must be unmounted - anything removed below would otherwise reach the real folders

	list_mounts_share="$(findmnt --raw --noheadings --output TARGET | grep --fixed-strings "${directory_storage_android}/")"

	for directory_mount in ${list_mounts_share}
	do
		fusermount -u "${directory_mount}" > "${sink}" 2>&1
	done

	list_mounts_share="$(findmnt --raw --noheadings --output TARGET | grep --fixed-strings "${directory_storage_android}/")"

	if [ -n "${list_mounts_share}" ]
	then
		frobulator.err "Shared folder still mounted - nothing removed" "[ ${list_mounts_share} ]"

		exit 1
	fi

	# configuration - share units - docker drop-in - android ipc - repository

	frobulator.inf "Removing configuration"

	list_files_configuration=(
		"${directory_systemd}"/${pattern_share_unit}
		"${directory_dropin}"
		"${directory_modprobe}/${file_binder}"
		"${directory_modules}/${file_binder}"
		"${file_repository}"
		"${file_keyring}"
	)

	for file_configuration in "${list_files_configuration[@]}"
	do
		if [ -e "${file_configuration}" ]
		then
			gio trash "${file_configuration}"
		fi
	done

	systemctl daemon-reload

	frobulator.complete

	# firewall rules added for the android network

	iptables -D "${name_chain_docker}" -i "${name_interface_waydroid}" -j ACCEPT > "${sink}" 2>&1
	iptables -D "${name_chain_docker}" -o "${name_interface_waydroid}" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT > "${sink}" 2>&1

	# android ipc driver - unloaded now when free - at next reboot otherwise

	modprobe -r "${name_module_binder}" > "${sink}" 2>&1

	# packages - those installed together with waydroid - read from the apt history - nothing installed before it

	frobulator.inf "Removing packages"

	list_packages_installed=(
		$(grep --no-filename "${pattern_history_install}" "${file_history_apt}" 2> "${sink}" |
			sed --expression="${expression_history_prefix}" --expression="${expression_history_split}" |
			sed --expression="${expression_history_suffix}" |
			sort --unique)
	)

	list_packages_removed=()

	for name_package in "${list_packages_installed[@]}" "${list_packages_waydroid[@]}"
	do
		state_package="$(dpkg-query --show --showformat="${format_status_package}" "${name_package}" 2> "${sink}")"

		if [ "${state_package}" = "${status_package_installed}" ]
		then
			list_packages_removed+=("${name_package}")
		fi
	done

	if [ "${#list_packages_removed[@]}" -gt 0 ]
	then
		DEBIAN_FRONTEND="${frontend_apt}" apt-get purge --assume-yes "${list_packages_removed[@]}" > "${sink}" 2>&1

		frobulator.complete
	fi

	# data - android system and user data - app launchers - weston settings
	# moved to the trash - recoverable until emptied

	frobulator.inf "Removing waydroid data"

	list_launchers=("${directory_applications}"/${pattern_launcher})

	list_files_data=(
		"${directory_state_waydroid}"
		"${directory_data_waydroid}"
		"${file_weston}"
		"${list_launchers[@]}"
	)

	for file_data in "${list_files_data[@]}"
	do
		if [ -e "${file_data}" ]
		then
			gio trash "${file_data}"
		fi
	done

	frobulator.complete

	frobulator.scs "Waydroid removed" "[ ${#list_packages_removed[@]} package(s) ]"
	frobulator.nul "Local images kept - ${directory_images_local}"
fi

frobulator.result "${script}"
