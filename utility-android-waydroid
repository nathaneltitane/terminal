#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-12"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-i|--install)
			option_install="true"
		;;

		-u|--ui)
			option_ui="true"
		;;

		-r|--register)
			option_register="true"
		;;

		-x|--uninstall)
			option_uninstall="true"
		;;

		-s|--share)
			option_share="true"

			# directory optional - default used when the next argument is another option

			if [ -n "${2}" ] && [[ "${2}" != -* ]]
			then
				directory_share="${2}"

				shift
			fi
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -i | -u | -r | -s [Directory] | -x | -h"
			echo
			echo -e "Note:                 Android apps on this computer - waydroid with google apps - computer folders shared into android storage."
			echo
			echo -e "                      1. Run '${script} -i' - install and download the android image."
			echo -e "                      2. Run '${script} -u' - first boot - android storage created."
			echo -e "                      3. Run '${script} -r' - register the shown id at google.com/android/uncertified - restart waydroid."
			echo -e "                      4. Run '${script} -s' - share the folder - sign in to google and install the sync app."
			echo
			echo -e "Options:"
			echo
			echo -e "-i, --install         [I]nstall waydroid, weston and bindfs - android ipc devices - google apps image."
			echo
			echo -e "-u, --ui              Start the android [u]ser interface - inside a weston window on x11."
			echo
			echo -e "-r, --register        Show the android id to [r]egister for google play services."
			echo
			echo -e "-s, --share           [S]hare a computer folder into android storage - started at every boot."
			echo
			echo -e "                      [ /media/internal ] [ Default ]"
			echo
			echo -e "-x, --uninstall       Remove waydroid and everything it installed - shared folders untouched - local images kept."
			echo
			echo -e "-h, --help            Show [h]elp and usage information."
			echo
			echo -e "'${script}'           [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -i | -u | -r | -s [Directory] | -x | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

directory_share="${directory_share:-/media/internal}"
directory_share="${directory_share%/}"

id_user="$(id -u "${USER}")"

directory_runtime="/run/user/${id_user}"
directory_storage_android="${HOME}/.local/share/waydroid/data/media/0"

# android storage user - media_rw - files seen by android apps as their own

id_media_rw=1023

file_repository=/etc/apt/sources.list.d/waydroid.list

# local copy of the android images - system.img and vendor.img - used instead of downloading

directory_images_local=/media/internal/Linux/Waydroid
file_keyring=/usr/share/keyrings/waydroid.gpg

socket_weston="waydroid-0"

# weston settings for the android window - no top panel

file_weston="${HOME}/.config/weston-waydroid.ini"

# defaults ─────────────────────────────────────────────────────────────────────

# functions ────────────────────────────────────────────────────────────────────

user_run () {

	# command run as the desktop user - display and session bus kept

	runuser -u "${USER}" --													\
		env																	\
			HOME="${HOME}"													\
			DISPLAY="${DISPLAY:-:0}"										\
			XAUTHORITY="${XAUTHORITY:-${HOME}/.Xauthority}"					\
			XDG_RUNTIME_DIR="${directory_runtime}"							\
			DBUS_SESSION_BUS_ADDRESS="unix:path=${directory_runtime}/bus"	\
																			"${@}"
}

# validation ───────────────────────────────────────────────────────────────────

if [ "${option_install}" != "true" ] && [ "${option_ui}" != "true" ] && [ "${option_register}" != "true" ] && [ "${option_share}" != "true" ] && [ "${option_uninstall}" != "true" ]
then
	frobulator.err "Missing operation."
	frobulator.nul "Type './${script} -h' for help and usage information."

	exit 1
fi

# install ──────────────────────────────────────────────────────────────────────

if [ "${option_install}" = "true" ]
then
	list=(
		curl
	)

	frobulator.require ${list[@]}

	frobulator.complete

	list=()

	# waydroid repository - signing key and source list - distribution codename

	frobulator.inf "Adding repository" "[ repo.waydro.id ]"

	name_codename="$(grep -m 1 '^VERSION_CODENAME=' /etc/os-release)"
	name_codename="${name_codename#*=}"

	if [ ! -f "${file_keyring}" ]
	then
		curl -s --proto '=https' --tlsv1.2 -Sf https://repo.waydro.id/waydroid.gpg --output "${file_keyring}"

		frobulator.complete
	fi

	frobulator.write write "deb [signed-by=${file_keyring}] https://repo.waydro.id/ ${name_codename} main" /etc/apt/sources.list.d waydroid.list

	frobulator.complete

	frobulator.silence "apt-get update"

	frobulator.complete

	list=(
		waydroid
		weston
		bindfs
	)

	frobulator.install ${list[@]}

	frobulator.complete

	list=()

	# android ipc - three binder devices - the debian kernel has no binderfs

	frobulator.inf "Configuring android ipc" "[ binder // hwbinder // vndbinder ]"

	frobulator.write write "options binder_linux devices=binder,hwbinder,vndbinder" /etc/modprobe.d binder.conf

	frobulator.complete

	frobulator.write write "binder_linux" /etc/modules-load.d binder.conf

	frobulator.complete

	modprobe binder_linux

	frobulator.complete

	# android image with google apps - downloaded once

	list_images=(/var/lib/waydroid/images/*.img)

	if [ -e "${list_images[0]}" ]
	then
		frobulator.inf "Android image present" "[ /var/lib/waydroid/images ]"

	elif [ -f "${directory_images_local}/system.img" ] && [ -f "${directory_images_local}/vendor.img" ]
	then
		frobulator.inf "Using local android image" "[ ${directory_images_local} ]"

		waydroid init -i "${directory_images_local}" -f

		frobulator.complete
	else
		frobulator.inf "Downloading android image" "[ lineage // google apps ]"

		waydroid init -s GAPPS -f

		frobulator.complete

		# kept for the next install - no download then

		frobulator.directory "${directory_images_local}"

		cp /var/lib/waydroid/images/system.img /var/lib/waydroid/images/vendor.img "${directory_images_local}"/

		frobulator.complete
	fi

	# docker drops forwarded traffic by default - android would have no internet
	# waydroid allowed through the docker user chain - before every container start

	path_docker="$(command -v docker)"

	if [ -n "${path_docker}" ]
	then
		frobulator.inf "Allowing android network through docker" "[ DOCKER-USER // waydroid0 ]"

		rule_inbound="iptables -C DOCKER-USER -i waydroid0 -j ACCEPT 2> /dev/null || iptables -I DOCKER-USER -i waydroid0 -j ACCEPT"
		rule_return="iptables -C DOCKER-USER -o waydroid0 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT 2> /dev/null || iptables -I DOCKER-USER -o waydroid0 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT"

		content_dropin=$(cat <<- FILE
		# waydroid network through docker - docker drops forwarded traffic by default
		[Unit]
		After=docker.service

		[Service]
		ExecStartPre=/bin/sh -c '${rule_inbound}; ${rule_return}; true'
		FILE
		)

		frobulator.write write "${content_dropin}" /etc/systemd/system/waydroid-container.service.d docker-forward.conf

		frobulator.complete

		frobulator.service reload

		frobulator.complete
	fi

	frobulator.service activate waydroid-container.service

	frobulator.complete
fi

# user interface ───────────────────────────────────────────────────────────────

if [ "${option_ui}" = "true" ]
then
	# x11 session - waydroid needs wayland - weston window as the wayland display

	type_session="$(loginctl show-user "${USER}" -p Display --value 2> "${sink}")"
	type_session="$(loginctl show-session "${type_session}" -p Type --value 2> "${sink}")"

	display_wayland="${WAYLAND_DISPLAY}"

	if [ "${type_session}" = "x11" ] || [ -z "${display_wayland}" ]
	then
		# weston already open - reused - a new one would leave android on the old display

		list_weston="$(pgrep -u "${USER}" -f "weston .*--socket=${socket_weston}")"

		if [ -n "${list_weston}" ]
		then
			frobulator.inf "Reusing weston window" "[ ${socket_weston} ]"

			display_wayland="${socket_weston}"
		fi
	fi

	if [ "${type_session}" = "x11" ] && [ -z "${list_weston}" ] || [ -z "${display_wayland}" ]
	then
		# android session tied to a closed window - stopped so it starts on the new one

		user_run waydroid session stop > "${sink}" 2>&1

		frobulator.inf "Starting weston window" "[ ${socket_weston} ]"

		content_weston=$(cat <<- FILE
		[shell]
		panel-position=none
		FILE
		)

		frobulator.write write "${content_weston}" "${HOME}/.config" "${file_weston##*/}"

		frobulator.complete

		user_run weston --config="${file_weston}" --socket="${socket_weston}" --width=1280 --height=800 > "${sink}" 2>&1 &

		sleep 3

		display_wayland="${socket_weston}"
	fi

	frobulator.inf "Starting android interface"

	user_run env WAYLAND_DISPLAY="${display_wayland}" waydroid show-full-ui > "${sink}" 2>&1 &

	frobulator.complete
fi

# register ─────────────────────────────────────────────────────────────────────

if [ "${option_register}" = "true" ]
then
	# google services id - read from the running android

	# created by google services on its first check-in - needs android online - up to two minutes

	query_register="select value from main where name = 'android_id';"

	frobulator.inf "Waiting for the android id"

	for (( count_wait = 0 ; count_wait < 24 ; count_wait ++ ))
	do
		id_android="$(waydroid shell -- sh -c "sqlite3 /data/data/com.google.android.gsf/databases/gservices.db \"${query_register}\"" 2> "${sink}")"

		if [ -n "${id_android}" ]
		then
			break
		fi

		sleep 5
	done

	if [ -z "${id_android}" ]
	then
		frobulator.err "Android id not found - android booted and online?" "[ ${script} -u ]"

		exit 1
	fi

	frobulator.scs "Android id" "[ ${id_android} ]"
	frobulator.nul "Register it at https://www.google.com/android/uncertified - then restart waydroid."
fi

# share ────────────────────────────────────────────────────────────────────────

if [ "${option_share}" = "true" ]
then
	if [ ! -d "${directory_share}" ]
	then
		frobulator.err "Directory not found" "[ ${directory_share} ]"

		exit 1
	fi

	if [ ! -d "${directory_storage_android}" ]
	then
		frobulator.err "Android storage not created yet - start the interface once first" "[ ${script} -u ]"

		exit 1
	fi

	# folder name inside android storage - service named after it

	name_share="$(basename -- "${directory_share}")"
	name_share="${name_share^}"

	directory_target="${directory_storage_android}/${name_share}"
	name_service="waydroid-share-${name_share,,}.service"

	# bindfs - android sees media_rw as owner - files created from android belong to the desktop user

	content_service=$(cat <<- FILE
	[Unit]
	Description=Waydroid - ${directory_share} shared into android storage as ${name_share}
	After=local-fs.target

	[Service]
	Type=forking
	ExecStartPre=/usr/bin/mkdir -p "${directory_target}"
	ExecStart=/usr/bin/bindfs --force-user=${id_media_rw} --force-group=${id_media_rw} --create-for-user=${id_user} --create-for-group=${id_user} -o allow_other "${directory_share}" "${directory_target}"
	ExecStop=/usr/bin/fusermount -u "${directory_target}"
	RemainAfterExit=yes

	[Install]
	WantedBy=multi-user.target
	FILE
	)

	frobulator.write write "${content_service}" /etc/systemd/system "${name_service}"

	frobulator.complete

	frobulator.service reload

	frobulator.complete

	frobulator.service activate "${name_service}"

	frobulator.complete

	frobulator.scs "Shared into android storage" "[ ${directory_share} >> ${name_share} ]"
	frobulator.nul "Restart waydroid so android sees the new folder."
fi

# uninstall ────────────────────────────────────────────────────────────────────

if [ "${option_uninstall}" = "true" ]
then
	# stopped first - window, android session, container and shares

	frobulator.inf "Stopping waydroid"

	pkill -u "${USER}" -f "weston .*--socket=${socket_weston}" > "${sink}" 2>&1

	user_run waydroid session stop > "${sink}" 2>&1

	list_units_share=(/etc/systemd/system/waydroid-share-*.service)

	for file_unit in "${list_units_share[@]}"
	do
		if [ -f "${file_unit}" ]
		then
			systemctl disable --now "${file_unit##*/}" > "${sink}" 2>&1
		fi
	done

	systemctl disable --now waydroid-container.service > "${sink}" 2>&1

	frobulator.complete

	# shared folders - must be unmounted - anything removed below would otherwise reach the real folders

	list_mounts_share="$(findmnt -rno TARGET | grep -F "${directory_storage_android}/")"

	for directory_mount in ${list_mounts_share}
	do
		fusermount -u "${directory_mount}" > "${sink}" 2>&1
	done

	list_mounts_share="$(findmnt -rno TARGET | grep -F "${directory_storage_android}/")"

	if [ -n "${list_mounts_share}" ]
	then
		frobulator.err "Shared folder still mounted - nothing removed" "[ ${list_mounts_share} ]"

		exit 1
	fi

	# configuration - share units - docker drop-in - android ipc - repository

	frobulator.inf "Removing configuration"

	list_files_configuration=(
		/etc/systemd/system/waydroid-share-*.service
		/etc/systemd/system/waydroid-container.service.d
		/etc/modprobe.d/binder.conf
		/etc/modules-load.d/binder.conf
		"${file_repository}"
		"${file_keyring}"
	)

	for file_configuration in "${list_files_configuration[@]}"
	do
		if [ -e "${file_configuration}" ]
		then
			gio trash "${file_configuration}"
		fi
	done

	systemctl daemon-reload

	frobulator.complete

	# firewall rules added for the android network

	iptables -D DOCKER-USER -i waydroid0 -j ACCEPT > "${sink}" 2>&1
	iptables -D DOCKER-USER -o waydroid0 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT > "${sink}" 2>&1

	# android ipc driver - unloaded now when free - at next reboot otherwise

	modprobe -r binder_linux > "${sink}" 2>&1

	# packages - those installed together with waydroid - read from the apt history - nothing installed before it

	frobulator.inf "Removing packages"

	list_packages_installed=(
		$(grep -h "^Install: .*waydroid:" /var/log/apt/history.log 2> "${sink}" |
			sed -e 's/^Install: //' -e 's/), /)\n/g' |
			sed -e 's/:.*//' |
			sort -u)
	)

	list_packages_removed=()

	for name_package in "${list_packages_installed[@]}" waydroid weston bindfs
	do
		state_package="$(dpkg-query -W -f='${Status}' "${name_package}" 2> "${sink}")"

		if [ "${state_package}" = "install ok installed" ]
		then
			list_packages_removed+=("${name_package}")
		fi
	done

	if [ "${#list_packages_removed[@]}" -gt 0 ]
	then
		DEBIAN_FRONTEND=noninteractive apt-get purge --assume-yes "${list_packages_removed[@]}" > "${sink}" 2>&1

		frobulator.complete
	fi

	# data - android system and user data - app launchers - weston settings
	# moved to the trash - recoverable until emptied

	frobulator.inf "Removing waydroid data"

	list_launchers=("${HOME}"/.local/share/applications/waydroid.*.desktop)

	list_files_data=(
		/var/lib/waydroid
		"${HOME}/.local/share/waydroid"
		"${file_weston}"
		"${list_launchers[@]}"
	)

	for file_data in "${list_files_data[@]}"
	do
		if [ -e "${file_data}" ]
		then
			gio trash "${file_data}"
		fi
	done

	frobulator.complete

	frobulator.scs "Waydroid removed" "[ ${#list_packages_removed[@]} package(s) ]"
	frobulator.nul "Local images kept - ${directory_images_local}"
fi

frobulator.result "${script}"
