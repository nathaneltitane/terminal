#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-i|--interface)
			interface="${2}"

			shift
		;;

		-b|--bridge)
			name_bridge="${2}"

			shift
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -i [Interface] -b [Bridge] | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-i, --interface    Specify physical ethernet [i]nterface to bridge."
			echo
			echo -e "                   [ enp2s0 ] [ Default ]"
			echo
			echo -e "-b, --bridge       Specify name for the created [b]ridge device."
			echo
			echo -e "                   [ bridge0 ] [ Default ]"
			echo
			echo -e "-h, --help         Show [h]elp and usage information."
			echo
			echo -e "'${script}'        [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -i [Interface] -b [Bridge] | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

interface_default="enp2s0"
name_bridge_default="bridge0"

interface="${interface:-${interface_default}}"
name_bridge="${name_bridge:-${name_bridge_default}}"

format_stamp="%m-%d-%Y-%H-%M-%S"

stamp="$(date +"${format_stamp}")"

directory_images=""${directory_images}""
file_bashrc=".bashrc"
name_file_bridge="bridge.xml"
name_service_libvirt="libvirtd.service"
name_service_tuned="tuned"
name_profile_tuned="virtual-host"
name_hypervisor="qemu"
name_network="bridge"
name_group_libvirt="libvirt"
name_connection_slave="Bridge Connection"
type_bridge="bridge"
type_ethernet="ethernet"
property_autoconnect="connection.autoconnect-slaves"
value_autoconnect="1"
line_export="export LIBVIRT_DEFAULT_URI='qemu:///system'"
permission_acl_user="u:${USER}:rwX"
permission_acl_default="d:u:${USER}:rwx"

# defaults ─────────────────────────────────────────────────────────────────────

# functions ────────────────────────────────────────────────────────────────────

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(
	aqemu
	guestfs-tools
	libosinfo-bin
	libvirt-daemon-system
	ovmf
	qemu-system-x86
	qemu-utils
	swtpm
	tuned
	tuned-utils
	virt-manager
	virt-viewer
	virtinst
)

frobulator.require ${list[@]}

frobulator.complete

list=()


# configuration ────────────────────────────────────────────────────────────────

frobulator.inf "Enabling libvirt"

frobulator.service enable "${name_service_libvirt}"

frobulator.complete

frobulator.inf "Validating host"

virt-host-validate "${name_hypervisor}"

frobulator.complete

frobulator.inf "Enabling tuned"

frobulator.service enable "${name_service_tuned}"

frobulator.complete

tuned-adm active

frobulator.complete

tuned-adm profile "${name_profile_tuned}"

frobulator.complete

# bridge

frobulator.inf "Creating network bridge"

nmcli device status

frobulator.complete

nmcli														\
		connection add type "${type_bridge}"				\
		con-name ${name_bridge}								\
		ifname ${name_bridge}

frobulator.complete

nmcli														\
		connection add type "${type_ethernet}"				\
		slave-type "${type_bridge}"							\
		con-name "${name_connection_slave}"					\
		ifname ${interface}									\
		master ${name_bridge}

frobulator.complete

nmcli														\
		connection up ${name_bridge}

frobulator.complete

nmcli														\
		connection modify ${name_bridge}					\
		"${property_autoconnect}" "${value_autoconnect}"

frobulator.complete

nmcli														\
		connection up ${name_bridge}

frobulator.complete

nmcli														\
		device status

frobulator.complete

# network

frobulator.inf "Defining libvirt network"

frobulator.temporary directory_temporary

frobulator.complete

frobulator.trap "${directory_temporary}"

frobulator.complete

file_bridge_xml="${directory_temporary}/${name_file_bridge}"

cat > "${file_bridge_xml}" << FILE
<network>
<name>${name_network}</name>
<forward mode='bridge'/>
<bridge name='${name_bridge}'/>
</network>
FILE

virsh net-define "${file_bridge_xml}"

frobulator.complete

virsh net-start "${name_network}"

frobulator.complete

virsh net-autostart "${name_network}"

frobulator.complete

# permissions

frobulator.inf "Configuring permissions"

usermod										\
	--append								\
	--groups "${name_group_libvirt}"		\
											"${USER}"

frobulator.complete

frobulator.write append "${line_export}" "${HOME}" "${file_bashrc}"

frobulator.complete

setfacl										\
	--recursive								\
	--remove-all							\
											"${directory_images}"

frobulator.complete

setfacl										\
	--recursive								\
	--modify "${permission_acl_user}"		\
											"${directory_images}"

frobulator.complete

setfacl										\
	--modify "${permission_acl_default}"	\
											"${directory_images}"

frobulator.complete

frobulator.result "${script}"

frobulator.scs "KVM host ready"
