#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-i|--interface)
			interface="${2}"

			shift
		;;

		-b|--bridge)
			name_bridge="${2}"

			shift
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -i [Interface] -b [Bridge] | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-i, --interface    Specify physical ethernet [i]nterface to bridge."
			echo
			echo -e "                   [ enp2s0 ] [ Default ]"
			echo
			echo -e "-b, --bridge       Specify name for the created [b]ridge device."
			echo
			echo -e "                   [ bridge0 ] [ Default ]"
			echo
			echo -e "-h, --help         Show [h]elp and usage information."
			echo
			echo -e "'${script}'        [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -i [Interface] -b [Bridge] | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

interface="${interface:-enp2s0}"
name_bridge="${name_bridge:-bridge0}"

stamp=$(date +"%m-%d-%Y-%H-%M-%S")

# defaults ─────────────────────────────────────────────────────────────────────

# functions ────────────────────────────────────────────────────────────────────

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(
	aqemu
	guestfs-tools
	libosinfo-bin
	libvirt-daemon-system
	ovmf
	qemu-system-x86
	qemu-utils
	swtpm
	tuned
	tuned-utils
	virt-manager
	virt-viewer
	virtinst
)

frobulator.require ${list[@]}

frobulator.complete

list=()


# configuration ────────────────────────────────────────────────────────────────

frobulator.inf "Enabling libvirt"

frobulator.service enable libvirtd.service

frobulator.complete

frobulator.inf "Validating host"

virt-host-validate qemu

frobulator.complete

frobulator.inf "Enabling tuned"

frobulator.service enable tuned

frobulator.complete

tuned-adm active

frobulator.complete

tuned-adm profile virtual-host

frobulator.complete

# bridge

frobulator.inf "Creating network bridge"

nmcli device status

frobulator.complete

nmcli													\
		connection add type bridge 						\
		con-name ${name_bridge} 						\
		ifname ${name_bridge}

frobulator.complete

nmcli													\
		connection add type ethernet 					\
		slave-type bridge 								\
		con-name 'Bridge Connection' 					\
		ifname ${interface} 							\
		master ${name_bridge}

frobulator.complete

nmcli													\
		connection up ${name_bridge}

frobulator.complete

nmcli													\
		connection modify ${name_bridge} 				\
		connection.autoconnect-slaves 1

frobulator.complete

nmcli													\
		connection up ${name_bridge}

frobulator.complete

nmcli													\
		device status

frobulator.complete

# network

frobulator.inf "Defining libvirt network"

frobulator.temporary directory_temporary

frobulator.complete

frobulator.trap "${directory_temporary}"

frobulator.complete

file_bridge_xml="${directory_temporary}"/bridge.xml

cat > "${file_bridge_xml}" << FILE
<network>
<name>bridge</name>
<forward mode='bridge'/>
<bridge name='${name_bridge}'/>
</network>
FILE

virsh net-define "${file_bridge_xml}"

frobulator.complete

virsh net-start bridge

frobulator.complete

virsh net-autostart bridge

frobulator.complete

# permissions

frobulator.inf "Configuring permissions"

usermod 									\
	--append								\
	--groups libvirt						\
											"${USER}"

frobulator.complete

frobulator.write append "export LIBVIRT_DEFAULT_URI='qemu:///system'" "${HOME}" .bashrc

frobulator.complete

setfacl 									\
	--recursive								\
	--remove-all							/var/lib/libvirt/images

frobulator.complete

setfacl										\
	--recursive								\
	--modify u:"${USER}":rwX				/var/lib/libvirt/images

frobulator.complete

setfacl										\
	--modify d:u:"${USER}":rwx				/var/lib/libvirt/images

frobulator.complete

frobulator.result "${script}"

frobulator.scs "KVM host ready"
