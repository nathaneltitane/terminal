#!/bin/bash

# loaded by "${HOME}"/.local/bin/bash-functions

# adb-download ─────────────────────────────────────────────────────────────────

adb_download () {

	local name_archive="platform-tools.zip"
	local name_extracted="platform-tools"
	local name_adb="adb"
	local name_fastboot="fastboot"
	local name_root="root"
	local label_tools="Android Platform Tools"
	local directory_binaries="${HOME}/.local/bin"
	local directory_temporary
	local directory_extracted
	local file_archive
	local file_adb
	local file_fastboot
	local name_utility
	local group_id
	local text_version
	local status_fetch
	local status_extract

	local list_utilities=(
		"${name_adb}"
		"${name_fastboot}"
	)

	frobulator.temporary directory_temporary

	if [ -z "${directory_temporary}" ] || [ ! -d "${directory_temporary}" ]
	then
		frobulator.err "Unable to create temporary directory"

		return 1
	fi

	file_archive="${directory_temporary}/${name_archive}"
	directory_extracted="${directory_temporary}/${name_extracted}"
	file_adb="${directory_binaries}/${name_adb}"
	file_fastboot="${directory_binaries}/${name_fastboot}"

	frobulator.inf "Fetching latest" "[ ${label_tools} ]"

	curl							\
		--silent					\
		--fail						\
		--location					\
		--output "${file_archive}"	\
									"${url_android_platform_tools}"

	status_fetch="${?}"

	if [ "${status_fetch}" -ne 0 ]
	then
		frobulator.delete "${directory_temporary}"

		frobulator.err "Unable to fetch" "[ ${label_tools} ]"

		return 1
	fi

	unzip -q "${file_archive}" -d "${directory_temporary}"

	status_extract="${?}"

	if [ "${status_extract}" -ne 0 ]
	then
		frobulator.delete "${directory_temporary}"

		frobulator.err "Unable to extract" "[ ${label_tools} ]"

		return 1
	fi

	if [ ! -x "${directory_extracted}/${name_adb}" ] || [ ! -x "${directory_extracted}/${name_fastboot}" ]
	then
		frobulator.delete "${directory_temporary}"

		frobulator.err "Invalid archive" "[ ${label_tools} ]"

		return 1
	fi

	frobulator.terminate "${name_adb}"

	frobulator.directory "${directory_android}"

	frobulator.directory "${directory_binaries}"

	frobulator.delete "${directory_platform_tools}"

	mv "${directory_extracted}" "${directory_platform_tools}"

	for name_utility in "${list_utilities[@]}"
	do
		frobulator.link "${directory_platform_tools}" "${directory_binaries}" "${name_utility}"
	done

	if [ "${USER}" != "${name_root}" ]
	then
		group_id="$(id -g "${USER}")"

		chown --recursive "${USER}:${group_id}" "${directory_android}" "${file_adb}" "${file_fastboot}"
	fi

	frobulator.delete "${directory_temporary}"

	export PATH="${directory_binaries}:${directory_platform_tools}:${PATH}"

	hash -r

	text_version="$("${name_adb}" version | head --lines=1)"

	frobulator.fwd "Utilities version: ${text_version}"

	frobulator.scs "Utilities deployment ready" "[ ${label_tools} ]"

}
