#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- ${BASH_SOURCE[0]})"

if [[ "${frobulator_loaded}" != "true" ]]
then
	echo

	ticker () {

		for ticker in '>  ' '>> ' '>>>'
		do
			echo -n -e "\r[  ${ticker}  ] ${1^}..."

			sleep 0.5
		done

		echo

		echo

	}

	if [[ $(id -u -n) = "root" ]]
	then
		USER="${SUDO_USER:-root}"

		if [ "${USER}" = "root" ]
		then
			HOME=/root
		else
			HOME="/home/${USER}"
		fi
	fi

	ticker checking

	package_managers_list=(
		"apt-get --quiet --quiet update > /dev/null 2>&1; apt-get --quiet --quiet install --yes"
		"dnf --quiet install --assumeyes"
		"yum --quiet install --assumeyes"
		"apk add --quiet"
		"pacman --sync --refresh --noconfirm --noprogressbar"
		"zypper --quiet --non-interactive install"
	)

	package="curl"

	if [[ -z $(command -v "${package}") ]]
	then
		for package_manager in "${package_managers_list[@]}"
		do
			entry="${package_manager%% *}"

			if [[ -n $(command -v "${entry}") ]]
			then
				eval "${package_manager} ${package} > /dev/null 2>&1"

				break
			fi
		done

		if [[ -z $(command -v "${package}") ]]
		then
			echo "[  !  ] Unable to install or binary not found ─────────────────────── [ '${package}' ]"
			echo

			exit 1
		fi
	fi

	mkdir -p "${HOME}"/.local/bin

	frobulator="${HOME}"/.local/bin/frobulator

	version_online=$(curl -s -L get.frbltr.app | grep -m 1 '^update=' | cut -d '"' -f 2)

	version_local=$(grep -m 1 '^update=' "${frobulator}" 2>/dev/null | cut -d '"' -f 2)

	version_local="${version_local:-1970-01-01}"

	if [ ! -f "${frobulator}" ] || [[ "${version_online}" > "${version_local}" ]]
	then
		curl -s -L get.frbltr.app > "${frobulator}"

		chmod +x "${frobulator}"
	fi

	ticker initializing

	source "${frobulator}"

	# script arguments for escalation

	self_arguments=("${@}")
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-09-29"

# usage ────────────────────────────────────────────────────────────────────────

add=false
remove=false
mirror=false

execute=false
confirm=true

count_arguments="${#}"

while (($#))
do
	case "${1}"
	in
		-f|--from)
			from="${2}"

			shift
		;;

		-t|--to)
			to="${2}"

			shift
		;;

		-a|--add)
			add=true
		;;

		-r|--remove)
			remove=true
		;;

		-m|--mirror)
			mirror=true
		;;

		-e|--execute)
			execute=true
		;;

		-y|--yes)
			confirm=false
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -f [From] -t [To] -a | -r | -m | -e | -y | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-f, --from       Set '[f]rom' (origin) directory reference."
			echo
			echo -e "-t, --to         Set '[t]o' (destination) directory."
			echo
			echo -e "-a, --add        Run [a]dd operation for files missing from 'to' directory."
			echo
			echo -e "-r, --remove     Run [r]emove operation for files missing from 'from' directory."
			echo
			echo -e "-m, --mirror     Run [m]irror operation to make 'to' directory an exact copy of 'from' directory."
			echo
			echo -e "                 [ mirror ] [ Default ]"
			echo
			echo -e "-e, --execute    Ex[e]cute selected operation."
			echo
			echo -e "-y, --yes        Assume [y]es and skip confirmation."
			echo
			echo -e "-h, --help       Show [h]elp and usage information."
			echo
			echo -e "Interactive mirror - prompts for 'from' and 'to', dry run, then confirmation:"
			echo
			echo -e "./${script}"
			echo
			echo -e "Dry run:"
			echo
			echo -e "./${script} -f /path/from -t /path/to -a"
			echo
			echo -e "./${script} -f /path/from -t /path/to -r"
			echo
			echo -e "./${script} -f /path/from -t /path/to -m"
			echo
			echo -e "Execute with confirmation:"
			echo
			echo -e "./${script} -f /path/from -t /path/to -a -e"
			echo
			echo -e "./${script} -f /path/from -t /path/to -r -e"
			echo
			echo -e "./${script} -f /path/from -t /path/to -m -e"
			echo
			echo -e "Execute without confirmation:"
			echo
			echo -e "./${script} -f /path/from -t /path/to -a -e -y"
			echo
			echo -e "./${script} -f /path/from -t /path/to -r -e -y"
			echo
			echo -e "./${script} -f /path/from -t /path/to -m -e -y"
			echo
			echo -e "'${script}'      [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -f [From] -t [To] -a | -r | -m | -e | -y | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

frobulator.temporary directory_temporary

frobulator.complete

frobulator.trap "${directory_temporary}"

frobulator.complete

list_from="${directory_temporary}/from.list"
list_to="${directory_temporary}/to.list"
list_changes="${directory_temporary}/changes.list"

list_sizes_from="${directory_temporary}/from.sizes"
list_sizes_to="${directory_temporary}/to.sizes"
list_rename="${directory_temporary}/rename.list"
list_copy="${directory_temporary}/copy.list"
list_remove="${directory_temporary}/remove.list"

count_differential=0

reply=""

# defaults ─────────────────────────────────────────────────────────────────────

# interactive: prompt for directories, dry run, then confirm

if [ "${count_arguments}" -eq 0 ]
then
	frobulator.qst "Set 'from' directory:"

	frobulator.read -e from

	frobulator.qst "Set 'to' directory:"

	frobulator.read -e to

	from="${from/#\~/${HOME}}"
	to="${to/#\~/${HOME}}"

	execute=true
fi

# validate arguments

count_operations=0

for flag in "${add}" "${remove}" "${mirror}"
do
	if [ "${flag}" = true ]
	then
		count_operations=$(( count_operations + 1 ))
	fi
done

if [ -z "${from}" ]
then
	frobulator.err "Missing 'from' directory."

	exit 1

elif [[ "${from}" = -* ]]
then
	frobulator.err "Missing argument for '--from'."

	exit 1

elif [ -z "${to}" ]
then
	frobulator.err "Missing 'to' directory."

	exit 1

elif [[ "${to}" = -* ]]
then
	frobulator.err "Missing argument for '--to'."

	exit 1

elif [ "${count_operations}" -gt 1 ]
then
	frobulator.err "Only one operation can be used."

	exit 1


elif [ "${confirm}" = false ] && [ "${execute}" = false ]
then
	frobulator.err "'--yes' requires '--execute'."

	exit 1
fi

# validate directories

if [ ! -d "${from}" ]
then
	frobulator.err "'From' directory not found" "[ ${from} ]"

	exit 1

elif [ ! -d "${to}" ]
then
	frobulator.err "'To' directory not found" "[ ${to} ]"

	exit 1
fi

from=$(cd "${from}" && pwd -P)

to=$(cd "${to}" && pwd -P)

if [ "${from}" = "${to}" ]
then
	frobulator.err "'From' and 'to' directories cannot be the same."

	exit 1
fi

# determine operation: mirror by default

if [ "${count_operations}" -eq 0 ]
then
	mirror=true
fi

if [ "${add}" = true ]
then
	operation="add"

elif [ "${remove}" = true ]
then
	operation="remove"

elif [ "${mirror}" = true ]
then
	operation="mirror"
fi

# functions ────────────────────────────────────────────────────────────────────

index () {

	source="${1}"
	destination="${2}"

	cd "${source}"

	status="${?}"

	if [ "${status}" -ne 0 ]
	then
		return 1
	fi

	find . -type f | sed 's|^\./||' | sort > "${destination}"

	status="${?}"

	if [ "${status}" -ne 0 ]
	then
		return 1
	fi

	return 0

}

display () {

	source="${1}"

	number=0

	while IFS= read -r file
	do
		(( number++ ))

		frobulator.num "${number}" "${file}"

	done < "${source}"

}

add () {

	while IFS= read -r file
	do
		destination="${to}/${file}"

		mkdir -p "$(dirname -- "${destination}")"

		status="${?}"

		if [ "${status}" -ne 0 ]
		then
			frobulator.err "Failed to create directory" "[ ${destination} ]"

			return 1
		fi

		frobulator.add "Adding" "[ ${file} ]"

		cp -a -- "${from}/${file}" "${destination}"

		status="${?}"

		if [ "${status}" -ne 0 ]
		then
			frobulator.err "Failed to add" "[ ${file} ]"

			return 1
		fi

	done < "${list_changes}"

	return 0

}

remove () {

	while IFS= read -r file
	do
		frobulator.rem "Removing" "[ ${file} ]"

		rm -f -- "${to}/${file}"

		status="${?}"

		if [ "${status}" -ne 0 ]
		then
			frobulator.err "Failed to remove" "[ ${file} ]"

			return 1
		fi

	done < "${list_changes}"

	return 0

}

# mirror: file name and size index

index_size () {

	local source="${1}"
	local destination="${2}"

	find "${source}" -type f -printf '%P\t%s\n' > "${destination}"
}

# mirror: case and accent insensitive name for matching renamed files

fold_name () {

	local folded

	folded="$(iconv -f UTF-8 -t ASCII//TRANSLIT <<< "${1}" 2> "${sink}")"

	echo "${folded,,}"
}

# mirror: rename, copy and remove lists from both indexes

mirror_plan () {

	local predict="${1}"

	local file_fold
	local file
	local size

	local -A sizes_from
	local -A sizes_to
	local -A renamed_folds

	while IFS=$'\t' read -r file size
	do
		sizes_from["${file}"]="${size}"
	done < "${list_sizes_from}"

	while IFS=$'\t' read -r file size
	do
		sizes_to["${file}"]="${size}"
	done < "${list_sizes_to}"

	: > "${list_rename}"
	: > "${list_copy}"
	: > "${list_remove}"

	for file in "${!sizes_from[@]}"
	do
		if [ -n "${sizes_to[${file}]+set}" ]
		then
			# same name: update when size differs

			if [ "${sizes_to[${file}]}" != "${sizes_from[${file}]}" ]
			then
				echo "${file}" >> "${list_copy}"
			fi

		elif [ -e "${to}/${file}" ]
		then
			# listed under another case or accent form

			echo "${file}" >> "${list_rename}"

			renamed_folds["$(fold_name "${file}")"]=1

			size="$(stat -c '%s' "${to}/${file}")"

			if [ "${size}" != "${sizes_from[${file}]}" ]
			then
				echo "${file}" >> "${list_copy}"
			fi
		else
			echo "${file}" >> "${list_copy}"
		fi
	done

	for file in "${!sizes_to[@]}"
	do
		if [ -n "${sizes_from[${file}]+set}" ]
		then
			continue
		fi

		# stale spelling of a renamed file: gone once renamed

		# case and accent insensitive form of the name, as stored for renamed files

		file_fold="$(fold_name "${file}")"

		if [ "${predict}" = true ] && [ -n "${renamed_folds[${file_fold}]+set}" ]
		then
			continue
		fi

		echo "${file}" >> "${list_remove}"
	done

	sort -o "${list_rename}" "${list_rename}"
	sort -o "${list_copy}" "${list_copy}"
	sort -o "${list_remove}" "${list_remove}"
}

mirror_rename () {

	local number=0

	local file
	local temporary

	while IFS= read -r file
	do
		(( number++ ))

		temporary="$(dirname -- "${to}/${file}")/.mirror-rename-${number}"

		frobulator.inf "Renaming" "[ ${file} ]"

		mv -- "${to}/${file}" "${temporary}"

		frobulator.fail "Failed to rename" "[ ${file} ]" || return

		mv -- "${temporary}" "${to}/${file}"

		frobulator.fail "Failed to rename" "[ ${file} ]" || return

	done < "${list_rename}"

	return 0
}

mirror_copy () {

	local file

	while IFS= read -r file
	do
		mkdir -p "$(dirname -- "${to}/${file}")"

		frobulator.fail "Failed to create directory" "[ ${file} ]" || return

		frobulator.add "Copying" "[ ${file} ]"

		cp -- "${from}/${file}" "${to}/${file}"

		frobulator.fail "Failed to copy" "[ ${file} ]" || return

	done < "${list_copy}"

	return 0
}

mirror_remove () {

	local file

	while IFS= read -r file
	do
		frobulator.rem "Removing" "[ ${file} ]"

		rm -f -- "${to}/${file}"

		frobulator.fail "Failed to remove" "[ ${file} ]" || return

	done < "${list_remove}"

	return 0
}

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(

)

frobulator.require "${list[@]}"

frobulator.complete

list=()

# configuration ────────────────────────────────────────────────────────────────

# mirror

if [ "${operation}" = "mirror" ]
then
	index_size "${from}" "${list_sizes_from}" &

	frobulator.progress index "[ from ]"

	index_size "${to}" "${list_sizes_to}" &

	frobulator.progress index "[ to ]"

	mirror_plan true

	count_rename=$(wc -l < "${list_rename}")
	count_copy=$(wc -l < "${list_copy}")
	count_remove=$(wc -l < "${list_remove}")

	# all planned changes together

	count_changes=$(( count_rename + count_copy + count_remove ))

	if [ "${count_changes}" -eq 0 ]
	then
		frobulator.scs "Directories already mirrored."

		exit 0
	fi

	if [ "${count_rename}" -gt 0 ]
	then
		frobulator.inf "Files to be renamed" "[ ${count_rename} ]"

		display "${list_rename}"

		echo
	fi

	if [ "${count_copy}" -gt 0 ]
	then
		frobulator.add "Files to be copied" "[ ${count_copy} ]"

		display "${list_copy}"

		echo
	fi

	if [ "${count_remove}" -gt 0 ]
	then
		frobulator.rem "Files to be removed" "[ ${count_remove} ]"

		display "${list_remove}"

		echo
	fi

	if [ "${execute}" = false ]
	then
		frobulator.wrn "Dry run only - mirror:"
		frobulator.nul "Run ${script} again with '--execute' to apply changes."

		exit 0
	fi

	if [ "${confirm}" = true ]
	then
		frobulator.separate

		frobulator.wrn "Changes are permanent" "[ ${to} ]"

		frobulator.qst "Proceed with mirror?"

		frobulator.read reply

		if [[ "${reply}" != [yY]         ]] &&
		   [[ "${reply}" != [yY][eE][sS] ]]
		then
			frobulator.stp "Operation cancelled."

			exit 0
		fi
	fi

	frobulator.fwd "Mirroring..."

	mirror_rename

	frobulator.complete halt "File rename failed."

	# index again: renamed files now match

	index_size "${to}" "${list_sizes_to}"

	mirror_plan false

	mirror_copy

	frobulator.complete halt "File copy failed."

	mirror_remove

	frobulator.complete halt "File removal failed."

	find "${to}" -mindepth 1 -depth -type d -empty -delete

	# files in each list: one per line

	count_copy="$(wc -l < "${list_copy}")"
	count_remove="$(wc -l < "${list_remove}")"

	frobulator.inf "Files renamed" "[ ${count_rename} ]"
	frobulator.inf "Files copied" "[ ${count_copy} ]"
	frobulator.inf "Files removed" "[ ${count_remove} ]"

	frobulator.scs "Done"

	exit 0
fi

# index directories

index "${from}" "${list_from}" &

frobulator.progress index "[ from ]"

index "${to}" "${list_to}" &

frobulator.progress index "[ to ]"

# determine changes

if [ "${operation}" = "add" ]
then
	comm -2 -3 "${list_from}" "${list_to}" > "${list_changes}"

elif [ "${operation}" = "remove" ]
then
	comm -1 -3 "${list_from}" "${list_to}" > "${list_changes}"
fi

count_differential=$(wc -l < "${list_changes}")

# display changes

if [ "${count_differential}" -gt 0 ]
then
	if [ "${operation}" = "add" ]
	then
		frobulator.add "Files to be added" "[ ${count_differential} ]"

	elif [ "${operation}" = "remove" ]
	then
		frobulator.rem "Files to be removed" "[ ${count_differential} ]"
	fi

	display "${list_changes}"

	echo
else
	if [ "${operation}" = "add" ]
	then
		frobulator.inf "No files to be added."

	elif [ "${operation}" = "remove" ]
	then
		frobulator.inf "No files to be removed."
	fi

	exit 0
fi

# display dry run

if [ "${execute}" = false ]
then
	frobulator.wrn "Dry run only - ${operation}:"
	frobulator.nul "Run ${script} again with '--execute' to apply changes."

	exit 0
fi

# confirm operation

if [ "${confirm}" = true ]
then
	frobulator.separate

	if [ "${operation}" = "add" ]
	then
		frobulator.qst "Proceed with addition?"

	elif [ "${operation}" = "remove" ]
	then
		frobulator.qst "Proceed with removal?"
	fi

	frobulator.read reply

	if [[ "${reply}" != [yY]         ]] &&
	   [[ "${reply}" != [yY][eE][sS] ]]
	then
		frobulator.stp "Operation cancelled."

		exit 0
	fi
fi

# execute operation

if [ "${operation}" = "add" ]
then
	frobulator.fwd "Adding..."

	add

	status="${?}"

	if [ "${status}" -ne 0 ]
	then
		frobulator.err "File addition failed."

		exit 1
	fi

	frobulator.inf "Files added to destination" "[ ${count_differential} ]"

elif [ "${operation}" = "remove" ]
then
	frobulator.fwd "Removing..."

	remove

	status="${?}"

	if [ "${status}" -ne 0 ]
	then
		frobulator.err "File removal failed."

		exit 1
	fi

	# remove empty directories

	find "${to}" -depth -type d -empty -delete

	status="${?}"

	if [ "${status}" -ne 0 ]
	then
		frobulator.err "Failed to remove empty directories."

		exit 1
	fi

	frobulator.inf "Files removed from destination" "[ ${count_differential} ]"
fi

# cleanup

frobulator.scs "Done"
