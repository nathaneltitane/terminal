#!/bin/bash

# dependencies /////////////////////////////////////////////////////////////////

ticker () {

	echo

	for ticker in '>  ' '>> ' '>>>'
	do
		echo -n -e "\r[  ${ticker}  ] ${1^}..."

		sleep 0.5
	done

	echo

	echo

}

if [[ $(id -u -n) = "root" ]]
then
	USER="${SUDO_USER:-root}"

	if [ "${USER}" = "root" ]
	then
		HOME=/root
	else
		HOME="/home/${USER}"
	fi
fi

ticker checking

package_managers_list=(
	"apt-get --quiet --quiet update > /dev/null 2>&1; apt-get --quiet --quiet install --yes"
	"dnf --quiet install --assumeyes"
	"yum --quiet install --assumeyes"
	"apk add --quiet"
	"pacman --sync --refresh --noconfirm --noprogressbar"
	"zypper --quiet --non-interactive install"
)

package="curl"

if [[ -z $(command -v "${package}") ]]
then
	for package_manager in "${package_managers_list[@]}"
	do
		entry="${package_manager%% *}"

		if [[ -n $(command -v "${entry}") ]]
		then
			eval "${package_manager} ${package} > /dev/null 2>&1"

			break
		fi
	done

	if [[ -z $(command -v "${package}") ]]
	then
		echo "[  !  ] Unable to install or binary not found /////////////////////// [ '${package}' ]"
		echo

		exit 1
	fi
fi

mkdir -p "${HOME}"/.local/bin

frobulator="${HOME}"/.local/bin/frobulator

version_online=$(curl -s -L get.frbltr.app | grep -m 1 '^# version=' | cut -d '"' -f 2)
version_local=$(grep -m 1 '^# version=' "${frobulator}" 2>/dev/null | cut -d '"' -f 2)

version_local="${version_local:-1970-01-01}"

if [ ! -f "${frobulator}" ] || [[ "${version_online}" > "${version_local}" ]]
then
	curl -s -L get.frbltr.app > "${frobulator}"

	chmod +x "${frobulator}"
fi

ticker initializing

source "${frobulator}"

# script ///////////////////////////////////////////////////////////////////////

script="$(basename -- ${BASH_SOURCE[0]})"

# version //////////////////////////////////////////////////////////////////////

version="2026-07-18"

# usage ////////////////////////////////////////////////////////////////////////

add=false
remove=false

execute=false
confirm=true

while (($#))
do
	case "${1}"
	in
		-f|--from)
			from="${2}"

			shift
		;;

		-t|--to)
			to="${2}"

			shift
		;;

		-a|--add)
			add=true
		;;

		-r|--remove)
			remove=true
		;;

		-e|--execute)
			execute=true
		;;

		-y|--yes)
			confirm=false
		;;

		-h|--help)
			echo
			echo "Usage:"
			echo
			echo "Options:"
			echo
			echo "-f, --from       Set [f]rom directory reference."
			echo "-t, --to         Set destination [t]o directory."
			echo "-a, --add        [A]dd files missing from to directory."
			echo "-r, --remove     [R]emove files missing from from directory."
			echo "-e, --execute    Ex[e]cute selected operation."
			echo "-y, --yes        Assume [y]es and skip confirmation."
			echo "-h, --help       Show [h]elp and usage information."
			echo
			echo "Dry run:"
			echo
			echo "${script} -f /path/from -t /path/to -a"
			echo
			echo "${script} -f /path/from -t /path/to -r"
			echo
			echo "Execute with confirmation:"
			echo
			echo "${script} -f /path/from -t /path/to -a -e"
			echo
			echo "${script} -f /path/from -t /path/to -r -e"
			echo
			echo "Execute without confirmation:"
			echo
			echo "${script} -f /path/from -t /path/to -a -e -y"
			echo
			echo "${script} -f /path/to/from -t /path/to/to -r -e -y"
			echo

			exit
		;;

		"")
			:
		;;

		*)
			echo
			echo "Usage: ${script} -f [From] -t [To] --add | --remove"
			echo
			echo "${script}: Unknown option '${1}'"
			echo "Type './${script} --help' for help and usage information."
			echo

			exit 1
		;;

	esac

	shift
done

# prompt ///////////////////////////////////////////////////////////////////////

frobulator.script "Setting up ${script#*-}"

# variables ////////////////////////////////////////////////////////////////////

temporary="$(mktemp -d)"

list_from="${temporary}/from.list"
list_to="${temporary}/to.list"
list_changes="${temporary}/changes.list"

count_differential=0

reply=""

# defaults /////////////////////////////////////////////////////////////////////

# validate arguments

if [ -z "${from}" ]
then
	frobulator.err "Missing from directory."
	echo

	exit 1

elif [[ "${from}" = -* ]]
then
	frobulator.err "Missing argument for '--from'."
	echo

	exit 1

elif [ -z "${to}" ]
then
	frobulator.err "Missing to directory."
	echo

	exit 1

elif [[ "${to}" = -* ]]
then
	frobulator.err "Missing argument for '--to'."
	echo

	exit 1

elif [ "${add}" = true ] && [ "${remove}" = true ]
then
	frobulator.err "Add and remove cannot be used together."
	echo

	exit 1

elif [ "${add}" = false ] && [ "${remove}" = false ]
then
	frobulator.err "Missing operation."
	frobulator.nul "Specify either '--add' or '--remove'."
	echo

	exit 1

elif [ "${confirm}" = false ] && [ "${execute}" = false ]
then
	frobulator.err "'--yes' requires '--execute'."
	echo

	exit 1
fi

# validate directories

if [ ! -d "${from}" ]
then
	frobulator.err "From directory not found" "[ ${from} ]"
	echo

	exit 1

elif [ ! -d "${to}" ]
then
	frobulator.err "To directory not found" "[ ${to} ]"
	echo

	exit 1
fi

from=$(cd "${from}" && pwd -P)

to=$(cd "${to}" && pwd -P)

if [ "${from}" = "${to}" ]
then
	frobulator.err "From and to directories cannot be the same."
	echo

	exit 1
fi

# determine operation

if [ "${add}" = true ]
then
	operation="add"

elif [ "${remove}" = true ]
then
	operation="remove"
fi

# functions ////////////////////////////////////////////////////////////////////

index () {

	source="${1}"
	destination="${2}"

	cd "${source}"

	status="${?}"

	if [ "${status}" -ne 0 ]
	then
		return 1
	fi

	find . -type f | sed 's|^\./||' | sort > "${destination}"

	status="${?}"

	if [ "${status}" -ne 0 ]
	then
		return 1
	fi

	return 0

}

display () {

	source="${1}"

	number=0

	while IFS= read -r file
	do
		(( number++ ))

		frobulator.num "${number}" "${file}"

	done < "${source}"

}

add () {

	while IFS= read -r file
	do
		destination="${to}/${file}"

		mkdir -p "$(dirname -- "${destination}")"

		status="${?}"

		if [ "${status}" -ne 0 ]
		then
			frobulator.err "Failed to create directory" "[ ${destination} ]"
			echo

			return 1
		fi

		frobulator.add "Adding" "[ ${file} ]"
		echo

		cp -a -- "${from}/${file}" "${destination}"

		status="${?}"

		if [ "${status}" -ne 0 ]
		then
			frobulator.err "Failed to add" "[ ${file} ]"
			echo

			return 1
		fi

	done < "${list_changes}"

	return 0

}

remove () {

	while IFS= read -r file
	do
		frobulator.rem "Removing" "[ ${file} ]"
		echo

		rm -f -- "${to}/${file}"

		status="${?}"

		if [ "${status}" -ne 0 ]
		then
			frobulator.err "Failed to remove" "[ ${file} ]"
			echo

			return 1
		fi

	done < "${list_changes}"

	return 0

}

# update ///////////////////////////////////////////////////////////////////////

# frobulator.update

# frobulator.upgrade

# requirements /////////////////////////////////////////////////////////////////

list=(

)

frobulator.require "${list[@]}"

list=()

# configuration ////////////////////////////////////////////////////////////////

# index directories

index "${from}" "${list_from}" &

frobulator.progress index "[ from ]"

index "${to}" "${list_to}" &

frobulator.progress index "[ to ]"

# determine changes

if [ "${operation}" = "add" ]
then
	comm -2 -3 "${list_from}" "${list_to}" > "${list_changes}"

elif [ "${operation}" = "remove" ]
then
	comm -1 -3 "${list_from}" "${list_to}" > "${list_changes}"
fi

count_differential=$(wc -l < "${list_changes}")

# display changes

if [ "${count_differential}" -gt 0 ]
then
	if [ "${operation}" = "add" ]
	then
		frobulator.add "Files to be added" "[ ${count_differential} ]"

	elif [ "${operation}" = "remove" ]
	then
		frobulator.rem "Files to be removed" "[ ${count_differential} ]"
	fi

	echo

	display "${list_changes}"

	echo
else
	if [ "${operation}" = "add" ]
	then
		frobulator.inf "No files to be added."
		echo

	elif [ "${operation}" = "remove" ]
	then
		frobulator.inf "No files to be removed."
		echo
	fi

	frobulator.delete "${temporary}"

	exit 0
fi

# display dry run

if [ "${execute}" = false ]
then
	frobulator.wrn "Dry run only - ${operation}:"
	frobulator.nul "Run ${script} again with '--execute' to apply changes."
	echo

	frobulator.delete "${temporary}"

	exit 0
fi

# confirm operation

if [ "${confirm}" = true ]
then
	frobulator.separate

	if [ "${operation}" = "add" ]
	then
		frobulator.ask "Proceed with addition?"

	elif [ "${operation}" = "remove" ]
	then
		frobulator.ask "Proceed with removal?"
	fi

	frobulator.read reply

	if [[ "${reply}" != [yY]         ]] && \
	   [[ "${reply}" != [yY][eE][sS] ]]
	then
		frobulator.fwd "Operation cancelled."
		echo

		frobulator.delete "${temporary}"

		exit 0
	fi
fi

# execute operation

if [ "${operation}" = "add" ]
then
	frobulator.fwd "Adding..."
	echo

	add

	status="${?}"

	if [ "${status}" -ne 0 ]
	then
		frobulator.err "File addition failed."
		echo

		frobulator.delete "${temporary}"

		exit 1
	fi

	frobulator.inf "Files added to destination" "[ ${count_differential} ]"
	echo

elif [ "${operation}" = "remove" ]
then
	frobulator.fwd "Removing..."
	echo

	remove

	status="${?}"

	if [ "${status}" -ne 0 ]
	then
		frobulator.err "File removal failed."
		echo

		frobulator.delete "${temporary}"

		exit 1
	fi

	# remove empty directories

	find "${to}" -depth -type d -empty -delete

	status="${?}"

	if [ "${status}" -ne 0 ]
	then
		frobulator.err "Failed to remove empty directories."
		echo

		frobulator.delete "${temporary}"

		exit 1
	fi

	frobulator.inf "Files removed from destination" "[ ${count_differential} ]"
	echo
fi

# cleanup

frobulator.delete "${temporary}"

frobulator.scs "Done"
