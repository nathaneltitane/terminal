#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-a|--all)
			option="all"
		;;

		-d|--device)
			option="device"

			device="${2}"

			shift
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -a | -d [Device] | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-a, --all       Generate keys for [a]ll devices."
			echo
			echo -e "-d, --device    Generate key for a single [d]evice."
			echo
			echo -e "                [ desktop | notebook | pi | tablet | phone ]"
			echo
			echo -e "-h, --help      Show [h]elp and usage information."
			echo
			echo -e "'${script}'     [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -a | -d [Device] | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

type_key="ed25519"

# key store - copied to ~/.ssh by utility-ssh - names match ~/.ssh/config identity files

directory_key=/media/internal/.ssh/.keys

list_devices=(
	desktop
	notebook
	pi
	tablet
	phone
)

# defaults ─────────────────────────────────────────────────────────────────────

# all devices or one device - explicit

if [ -z "${option}" ]
then
	frobulator.err "No option specified" "[ -a | -d [Device] ]"

	exit 1
fi

# single device - must be one of the listed devices

if [ "${option}" = "device" ]
then
	if [[ ! " ${list_devices[*]} " == *" ${device} "* ]]
	then
		frobulator.err "Unknown device" "[ ${device} ]"

		exit 1
	fi

	list_devices=(
		"${device}"
	)
fi

# functions ────────────────────────────────────────────────────────────────────

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(
	openssh*
	ssh*
)

frobulator.require ${list[@]}

list=()

# configuration ────────────────────────────────────────────────────────────────

frobulator.directory "$(dirname "${directory_key}")" "$(basename "${directory_key}")"

for device in "${list_devices[@]}"
do
	# key files of this device

	file_key_private="${directory_key}/${device}.key"
	file_key_public="${file_key_private}.pub"

	# previous key pair replaced

	rm --force "${file_key_private}" "${file_key_public}"

	# generate key - no passphrase

	ssh-keygen								\
		-q									\
		-t "${type_key}"					\
		-f "${file_key_private}"			\
		-N ''								\
		-C "${USER}@${device}"

	frobulator.complete

	# ownership - the user running the script - not root after escalation

	chown "${USER}:${USER}" "${file_key_private}" "${file_key_public}"

	# permissions - private key readable by its owner only

	chmod 0600 "${file_key_private}"
	chmod 0644 "${file_key_public}"

	frobulator.scs "Key generated" "[ ${device} // ${file_key_private} ]"
done

frobulator.result "${script}"
