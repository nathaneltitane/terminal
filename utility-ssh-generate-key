#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-h|--help)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-h, --help    Show [h]elp and usage information."
			echo
			echo -e "'${script}'   [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

type_key="ed25519"

directory_key="${HOME}"

key="${directory_key}"/"${device}"

file_key_public="${key}.pub"

# defaults ─────────────────────────────────────────────────────────────────────

# functions ────────────────────────────────────────────────────────────────────

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(
	openssh*
	ssh*
)

frobulator.require ${list[@]}

list=()

# configuration ────────────────────────────────────────────────────────────────

list_devices=(
	desktop
	notebook
	pi
	tablet
	phone
)

for device in ${list_devices[@]}
do

	# remove existing key files if they exist

	if [ -f "${key}" ]
	then
		rm					\
			--recursive		\
			--force			\
							"${key}"
	fi

	if [ -f "${file_key_public}" ]
	then
		rm					\
			--recursive		\
			--force			\
							"${file_key_public}"
	fi

	# generate key(s):
	# overwrite - no passphrase

	yes | ssh-keygen						\
		-t "${type_key}"					\
		-f "${directory_key}"/"${device}"	\
		-N ''								\
		-C "${USER}@${device}"

	# set ownership

	if [ -f "${key}" ]
	then
		chown 					\
			"${USER}:${USER}"	\
								"${key}"
	fi

	if [ -f "${file_key_public}" ]
	then
		chown					\
			"${USER}:${USER}"	\
								"${file_key_public}"
	fi

	# set permissions

	if [ -f "${key}" ]
	then
		chmod		\
			0600	\
					"${key}"
	fi

	if [ -f "${file_key_public}" ]
	then
		chmod		\
			0644	\
					"${file_key_public}"
	fi

done
