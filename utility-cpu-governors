#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-h|--help)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-h, --help    Show [h]elp and usage information."
			echo
			echo -e "'${script}'   [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

# defaults ─────────────────────────────────────────────────────────────────────

# functions ────────────────────────────────────────────────────────────────────

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(
	cpufreq-set
)

frobulator.require ${list[@]}

# configuration ────────────────────────────────────────────────────────────────

# set governor aliases

list_governors=(
	$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_available_governors)
)

for index_governor in "${!list_governors[@]}"
do
	cat <<- FILE >> /etc/bash.bashrc

	# governor - ${list_governors[index_governor]} #

	${list_governors[index_governor]}() {
		for (( index_core = 0 ; index_core < $(grep -c processor /proc/cpuinfo) ; index_core ++ ))
		do
			sudo cpufreq-set -c "\${index_core}" -g ${list_governors[index_governor]}
		done
	}
	FILE

	cat <<- FILE > /usr/bin/${list_governors[index_governor]}
	#!/bin/bash

	# cpu governor (${list_governors[index_governor]}) #

	# processor core count

	count_cpu="\$(grep -c processor /proc/cpuinfo)"

	for (( index_core = 0 ; index_core < count_cpu ; index_core ++ ))
	do
		sudo cpufreq-set		\
			-c "\${index_core}"	\
			-g ${list_governors[index_governor]}
	done

	# 'notify-send' path - empty if not installed

	command_notify_send="\$(command -v notify-send)"

	if [ -n "\${command_notify_send}" ]
	then
		notify-send						\
			-i gnome-system-monitor		\
			"CPU governor set to ${list_governors[index_governor]}"
	fi
	FILE

	sudo chmod +x /usr/bin/${list_governors[index_governor]}
done

# write switch

cat <<- 'FILE' > /usr/bin/cpu-switch
#!/bin/bash

# cpu-switch #

# processor core count

count_cpu="$(grep -c processor /proc/cpuinfo)"

# governor of the first core - next governor in the cycle

name_governor_current="$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor)"

case "${name_governor_current}"
in
	powersave)
		name_governor="conservative"
	;;

	conservative)
		name_governor="ondemand"
	;;

	ondemand)
		name_governor="performance"
	;;

	performance)
		name_governor="powersave"
	;;
esac

for (( index_core = 0 ; index_core < count_cpu ; index_core ++ ))
do
	sudo cpufreq-set		\
		-c "${index_core}"	\
		-g "${name_governor}"
done

# 'notify-send' path - empty if not installed

command_notify_send="$(command -v notify-send)"

if [ -n "${command_notify_send}" ]
then
	notify-send						\
		-i gnome-system-monitor		\
		"CPU governor set to ${name_governor}"
fi
FILE

# set permissions

sudo chmod +x /usr/bin/cpu-switch
