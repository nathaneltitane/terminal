#!/bin/bash

# loaded by "${HOME}"/.local/bin/bash-functions

# colors ───────────────────────────────────────────────────────────────────────

colors () {

	local number_color_foreground
	local code_color_foreground
	local number_color_background
	local code_color_background
	local code_color_reset
	local format_color
	local count_colors

	local list_requirements=()

	format_color='F:%s B:%s '
	count_colors="8"

	# output starts one line below the command

	echo

	list_requirements=(
		tput
		printf
	)

	frobulator.require ${list_requirements[@]}

	list_requirements=()

	# print palette

	for (( number_color_foreground = 0 ; number_color_foreground < count_colors ; number_color_foreground ++ ))
	do
		code_color_foreground=$(tput setaf "${number_color_foreground}")

		for (( number_color_background = 0 ; number_color_background < count_colors ; number_color_background ++ ))
		do
			code_color_background=$(tput setab "${number_color_background}")

			echo -n "${code_color_background} ${code_color_foreground}"

			printf "${format_color}" "${number_color_foreground}" "${number_color_background}"
		done

		# reset

		code_color_reset=$(tput sgr0)

		echo ${code_color_reset}
	done

	echo
}
