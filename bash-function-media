#!/bin/bash

# loaded by "${HOME}"/.local/bin/bash-functions

# media ────────────────────────────────────────────────────────────────────────

media () {

	local type_media="${1}"
	local source_media="${2}"
	local directory_output="${3}"
	local directory_binary="${HOME}/.local/bin"

	local file_archive_deno
	local path_file_media
	local list_files_media
	local directory_file
	local name_source
	local name_target
	local name_browser
	local duration_sleep
	local format_download
	local extension_media
	local directory_origin="${PWD}"
	local architecture_machine
	local directory_profile

	local -a list_options_type=()
	local -a list_options_url=()
	local -a list_options_site=()

	if [ -z "${type_media}" ]
	then
		frobulator.err "No type specified" "[ audio | video ]"

		return 1
	fi

	if [ "${type_media}" != "audio" ] && [ "${type_media}" != "video" ]
	then
		frobulator.err "Invalid type" "[ ${type_media} ]"

		return 1
	fi

	if [ -z "${source_media}" ]
	then
		frobulator.err "No source specified"

		return 1
	fi

	if [ -z "${directory_output}" ]
	then
		directory_output="${PWD}"
	fi

	if [ ! -d "${directory_output}" ]
	then
		directory_output="${PWD}"
	fi

	if [ ! -f "${directory_binary}/yt-dlp" ]
	then
		frobulator.download "https://github.com/yt-dlp/yt-dlp/releases/latest/download" "${directory_binary}" "yt-dlp"
	else
		frobulator.silence "${directory_binary}/yt-dlp --update"
	fi

	if [ ! -x "${directory_binary}/yt-dlp" ]
	then
		frobulator.err "Downloader unavailable" "[ yt-dlp ]"

		return 1
	fi

	if [ ! -f "${directory_binary}/deno" ]
	then
		# deno build matching this processor - x86_64 or aarch64

		architecture_machine="$(uname -m)"

		if [ "${architecture_machine}" = "arm64" ]
		then
			architecture_machine="aarch64"
		fi

		file_archive_deno="deno-${architecture_machine}-unknown-linux-gnu.zip"

		frobulator.download "https://github.com/denoland/deno/releases/latest/download" "${directory_binary}" "${file_archive_deno}"

		unzip -o -q "${directory_binary}/${file_archive_deno}" -d "${directory_binary}"

		rm -f "${directory_binary}/${file_archive_deno}"

		chmod +x "${directory_binary}/deno"
	else
		frobulator.silence "${directory_binary}/deno upgrade"
	fi

	if [ ! -x "${directory_binary}/deno" ]
	then
		frobulator.err "Solver unavailable" "[ deno ]"

		return 1
	fi

	if [ "${type_media}" = "audio" ]
	then
		format_download="bestaudio"
		extension_media="mp3"

		list_options_type+=( --extract-audio )
		list_options_type+=( --audio-format "${extension_media}" )
		list_options_type+=( --audio-quality best )
		list_options_type+=( --output '%(uploader)s - %(title)s.%(ext)s' )

	elif [ "${type_media}" = "video" ]
	then
		format_download="bestvideo+bestaudio"
		extension_media="mp4"

		list_options_type+=( --merge-output-format "${extension_media}" )
		list_options_type+=( --output '%(uploader)s/%(playlist)s/%(playlist_index)s - %(title)s.%(ext)s' )
	fi

	if [ -f "${source_media}" ]
	then
		list_options_url+=( --batch-file )
	fi

	# browser cookies - not for soundcloud
	# desktop default browser - else the first browser profile on disk - else none

	if [ "${source_media#*soundcloud.com}" = "${source_media}" ]
	then
		name_browser="$(xdg-settings get default-web-browser 2> "${sink}")"

		name_browser="${name_browser%.desktop}"

		case "${name_browser}"
		in
			firefox*)			name_browser="firefox" ;;
			librewolf*)			name_browser="firefox:${HOME}/.librewolf" ;;
			waterfox*)			name_browser="firefox:${HOME}/.waterfox" ;;
			google-chrome*)		name_browser="chrome" ;;
			chromium*)			name_browser="chromium" ;;
			brave*)				name_browser="brave" ;;
			vivaldi*)			name_browser="vivaldi" ;;
			opera*)				name_browser="opera" ;;
			*)					name_browser="" ;;
		esac

		# no desktop session - browser profiles on disk

		if [ -z "${name_browser}" ]
		then
			for directory_profile in									\
				"firefox:${HOME}/.mozilla/firefox"						\
				"firefox:${HOME}/.librewolf"							\
				"chrome:${HOME}/.config/google-chrome"					\
				"chromium:${HOME}/.config/chromium"						\
				"brave:${HOME}/.config/BraveSoftware/Brave-Browser"		\
				"vivaldi:${HOME}/.config/vivaldi"						\
				"opera:${HOME}/.config/opera"
			do
				if [ -d "${directory_profile#*:}" ]
				then
					name_browser="${directory_profile%%:*}"

					if [ "${directory_profile}" = "firefox:${HOME}/.librewolf" ]
					then
						name_browser="${directory_profile}"
					fi

					break
				fi
			done
		fi

		if [ -n "${name_browser}" ]
		then
			list_options_site+=( --cookies-from-browser "${name_browser}" )
		else
			frobulator.wrn "No browser profile found - downloading without cookies"
			frobulator.nul "Some videos may need a signed in browser to download."
		fi
	fi

	cd "${directory_output}"

	duration_sleep=$(( RANDOM % 5 + 1 ))

	"${directory_binary}/yt-dlp"									\
		--remote-components		"ejs:github"				\
		--js-runtimes			"deno:${directory_binary}/deno"	\
		--ffmpeg-location		"/usr/bin/ffmpeg"			\
		--quiet												\
		--no-update											\
		--ignore-errors										\
		--no-overwrites										\
		--sleep-requests		"${duration_sleep}"			\
		--yes-playlist										\
		--format				"${format_download}"					\
		"${list_options_site[@]}"								\
		"${list_options_type[@]}"								\
		"${list_options_url[@]}"									\
		"${source_media}" &

	frobulator.progress download

	list_files_media="$(find "${PWD}" -type f -iname "*.${extension_media}")"

	IFS=$'\n'

	for path_file_media in ${list_files_media}
	do
		directory_file="${path_file_media%/*}"
		name_source="${path_file_media##*/}"

		name_target="${name_source// - Topic/}"

		if [ "${name_source}" != "${name_target}" ]
		then
			mv -- "${path_file_media}" "${directory_file}/${name_target}"
		fi
	done

	unset IFS

	# back to the directory the function was called from

	cd "${directory_origin}"
}
