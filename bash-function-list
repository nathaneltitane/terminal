#!/bin/bash

# loaded by "${HOME}"/.local/bin/bash-functions

# list ─────────────────────────────────────────────────────────────────────────

list () {

	local directory="${1:-${PWD}}"
	local label_directories="directories"
	local label_files="files"
	local count_directories
	local count_files
	local text_types

	if [ ! -d "${directory}" ]
	then
		frobulator.err "Directory not found" "[ ${directory} ]"

		return 1
	fi

	ls								\
		-a							\
		-h							\
		-l							\
		--group-directories-first	\
									"${directory}"

	# whole tree in one pass - one letter per entry - listed directory itself excluded

	text_types="$(find "${directory}" -mindepth 1 \( -type d -printf 'd' \) -o \( -type f -printf 'f' \))"

	# letters counted by removing the other one

	count_directories="${text_types//f/}"
	count_directories="${#count_directories}"

	count_files="${text_types//d/}"
	count_files="${#count_files}"

	if [ "${count_directories}" -eq 1 ]
	then
		label_directories="directory"
	fi

	if [ "${count_files}" -eq 1 ]
	then
		label_files="file"
	fi

	echo
	echo "${count_directories} ${label_directories}"
	echo
	echo "${count_files} ${label_files}"
	echo
}
