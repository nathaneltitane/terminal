#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="079-13-2026"

# usage ────────────────────────────────────────────────────────────────────────

while (($#))
do
	case "${1}"
	in
		-h|--help)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-h, --help    Show [h]elp and usage information."
			echo
			echo -e "'${script}'   [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

stamp=$(date +"%m-%d-%Y-%H-%M-%S")

# functions ────────────────────────────────────────────────────────────────────

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(
	conky
	convert
	zenity
)

frobulator.require ${list[@]}

list=()

# configuration ────────────────────────────────────────────────────────────────

cat << "FILE" > /usr/bin/conky-picture-selector
#!/bin/bash

process="${directory}"/conky-picture-frame/conky-picture-framerc

# specify source image

dimension="full"

# small:  25%
# medium: 50%
# large:  75%
# full:   100%

source=$(zenity --file-selection --separator=$'\n' --title="Select a Directory") 2> "${sink}"

# set dimension flags

if [ "${dimension}" == "small" ]
then
	# canvas at 25%

	ratio="128x"

elif [ "${dimension}" == "medium" ]
then
	# canvas at 50%

	ratio="256x"

elif [ "${dimension}" == "large" ]
then
	# canvas at 75%

	ratio="384x"

elif [ "${dimension}" == "full" ]
then
	# canvas at 100%

	ratio="512x"
fi

# cleanup files

if [[ -e .picture.png ]]
then
	rm					\
		--recursive		\
		--force			 .picture.png
fi

# picture frame compositor

convert "${source}" -resize "${ratio}" .picture.png

# get dimensions

dimensions=$(identify .picture.png | awk '{print $3}')

IFS='x'
read width height <<< "$dimensions"

# send result to conky

sed -i -e "s/^minimum_size\ .*/minimum_size ${width} ${height}/g" "${directory}"/conky-picture-frame/conky-picture-framerc

wait

echo "${image .picture.png}"

wait

sudo kill -SIGTERM $(pgrep -f "${process}")

wait

conky -c "${process}" &
FILE

chmod +x /usr/bin/conky-picture-selector

# generate launcher

cat <<- 'FILE' > /usr/share/applications/conky-picture-selector.desktop
[Desktop Entry]
Name=Conky Picture Selector
Comment=Highly configurable system monitor
Exec=/usr/bin/conky-picture-selector/usr/bin/conky-picture-selector/usr/bin/conky-picture-selector
Icon=conky
Terminal=false
Type=Application
StartupNotify=true
Categories=Utility;
FILE
