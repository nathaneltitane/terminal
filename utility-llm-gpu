#!/bin/bash

# dependencies /////////////////////////////////////////////////////////////////

script="$(basename -- ${BASH_SOURCE[0]})"

if [[ "${frobulator_loaded}" != "true" ]]
then
	echo

	ticker () {

		for ticker in '>  ' '>> ' '>>>'
		do
			echo -n -e "\r[  ${ticker}  ] ${1^}..."

			sleep 0.5
		done

		echo

		echo

	}

	if [[ $(id -u -n) = "root" ]]
	then
		USER="${SUDO_USER:-root}"

		if [ "${USER}" = "root" ]
		then
			HOME=/root
		else
			HOME="/home/${USER}"
		fi
	fi

	ticker checking

	package_managers_list=(
		"apt-get --quiet --quiet update > /dev/null 2>&1; apt-get --quiet --quiet install --yes"
		"dnf --quiet install --assumeyes"
		"yum --quiet install --assumeyes"
		"apk add --quiet"
		"pacman --sync --refresh --noconfirm --noprogressbar"
		"zypper --quiet --non-interactive install"
	)

	package="curl"

	if [[ -z $(command -v "${package}") ]]
	then
		for package_manager in "${package_managers_list[@]}"
		do
			entry="${package_manager%% *}"

			if [[ -n $(command -v "${entry}") ]]
			then
				eval "${package_manager} ${package} > /dev/null 2>&1"

				break
			fi
		done

		if [[ -z $(command -v "${package}") ]]
		then
			echo "[  !  ] Unable to install or binary not found /////////////////////// [ '${package}' ]"
			echo

			exit 1
		fi
	fi

	mkdir -p "${HOME}"/.local/bin

	frobulator="${HOME}"/.local/bin/frobulator

	version_online=$(curl -s -L get.frbltr.app | grep -m 1 '^# version=' | cut -d '"' -f 2)

	version_local=$(grep -m 1 '^# version=' "${frobulator}" 2>/dev/null | cut -d '"' -f 2)

	version_local="${version_local:-1970-01-01}"

	if [ ! -f "${frobulator}" ] || [[ "${version_online}" > "${version_local}" ]]
	then
		curl -s -L get.frbltr.app > "${frobulator}"

		chmod +x "${frobulator}"
	fi

	ticker initializing

	source "${frobulator}"

	export self_arguments="${@}"
fi

# superuser ////////////////////////////////////////////////////////////////////

frobulator.escalate

# script ///////////////////////////////////////////////////////////////////////

frobulator.script

# version //////////////////////////////////////////////////////////////////////

version="2026-09-20"

# usage ////////////////////////////////////////////////////////////////////////

while (($#))
do
	case "${1}"
	in
		-m|--model)
			model_name="${2}"

			shift
		;;

		-e|--model-version)
			model_version="${2}"

			shift
		;;

		-s|--size)
			model_size="${2}"

			shift
		;;

		-v|--vulkan-device)
			vulkan_device="${2}"

			shift
		;;

		-d|--directory)
			directory="${2}"

			shift
		;;

		-h|--help)
			echo
			echo -e "Usage: ${script} -m [Model] -e [Version] -s [Size] -v [Vulkan device] -d [Directory] | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-m, --model          Model name."
			echo -e "                     [ qwen ]    [ Default ]"
			echo
			echo -e "-e, --model-version  Model version."
			echo -e "                     [ 3.6 ]    [ Default ]"
			echo
			echo -e "-s, --size           Model size."
			echo -e "                     [ 27b ]    [ Default ]"
			echo
			echo -e "-v, --vulkan-device  Vulkan GPU device index."
			echo -e "                     [ 0 ]           [ Default ]"
			echo
			echo -e "-d, --directory      Base directory for model storage."
			echo -e "                     [ /language/model/directory/label ]"
			echo
			echo -e "-h, --help           Show help and usage information."
			echo
			echo -e "'${script}' [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			:
		;;

		*)
			echo
			echo -e "${script}: Unknown option '${1}'"
			echo -e "Type './${script} --help' for help and usage information."
			echo

			exit 1
		;;

	esac

	shift
done

# variables ////////////////////////////////////////////////////////////////////

label="LLM"

process="ollama"
service="${process}.service"

model_name="${model_name:-qwen}"
model_version="${model_version:-3.5}"
model_size="${model_size:-2b}"
model="${model_name}${model_version}:${model_size}"
model_url="https://ollama.com/install.sh"

# path to a separate mount so models survive a system reinstall/format

directory="${directory:-/media/internal}"
models_directory="${directory}/${label}"

# defaults /////////////////////////////////////////////////////////////////////

# hades canyon nuc (nuc8i7hvk / nuc8i7hnk) ships radeon rx vega m gh/gl.
# current ollama builds support vulkan directly, so no rocm gfx spoof is needed.
# vulkan0 corresponds to the discrete radeon rx vega m gh on this system.

vulkan_device="${vulkan_device:-0}"

# functions ////////////////////////////////////////////////////////////////////

url_install () {

	local run_as="${1}"
	local label="${2}"
	local command_name="${3}"
	local url="${4}"
	local ownership_paths=("${@:5}")
	local installer

	if [[ -n $(command -v "${command_name}") ]]
	then
		frobulator.wrn "Already installed" "[ ${label} ]"
		echo

		return 0
	fi

	frobulator.inf "Installing" "[ ${label} ]"
	echo

	installer="$(mktemp)"

	curl						\
		--fail					\
		--silent				\
		--show-error			\
		--location				\
		--output "${installer}"	\
								"${url}"

	if [ "${?}" -ne 0 ] || [ ! -s "${installer}" ]
	then
		frobulator.err "Unable to fetch installer" "[ ${label} ]"
		echo

		rm -f "${installer}"

		return 1
	fi

	chmod +r "${installer}"

	if [ "${run_as}" = "user" ] && [ -n "${SUDO_USER}" ]
	then
		sudo -u "${SUDO_USER}" bash "${installer}"
	else
		bash "${installer}"
	fi

	if [ "${?}" -ne 0 ]
	then
		frobulator.err "Installation failed" "[ ${label} ]"
		echo

		rm -f "${installer}"

		return 1
	fi

	rm -f "${installer}"

	if [ "${USER}" != "root" ] && [ "${#ownership_paths[@]}" -gt 0 ]
	then
		chown -R "${USER}:$(id -g "${USER}")" "${ownership_paths[@]}" > "${sink}" 2>&1
	fi

	frobulator.scs "Installed" "[ ${label} ]"
	echo

	return 0
}

# requirements /////////////////////////////////////////////////////////////////

list=(
	curl
)

frobulator.require "${list[@]}"

list=()

# vulkan readiness

if [ ! -e /dev/dri/renderD128 ]
then
	frobulator.wrn "GPU render device not found" "[ /dev/dri/renderD128 ]"
	echo
fi

if [[ -z $(command -v vulkaninfo) ]]
then
	frobulator.wrn "Vulkan diagnostic utility not found" "[ vulkaninfo ]"
	echo
else
	if ! vulkaninfo --summary 2>"${sink}" | grep -q "AMD Radeon RX Vega M"
	then
		frobulator.wrn "Expected Radeon RX Vega M Vulkan device not detected"
		echo
	fi
fi

# process install

url_install root "${label}" "${process}" "${model_url}"

if [ "${?}" -ne 0 ]
then
	exit 1
fi

# models directory

frobulator.inf "Configuring models directory" "[ ${models_directory} ]"
echo

frobulator.directory "$(dirname "${models_directory}")" "$(basename "${models_directory}")"

chown -R "${process}:${process}" "${models_directory}"

# gpu permissions

if id "${process}" > "${sink}" 2>&1
then
	if getent group render > "${sink}" 2>&1
	then
		usermod --append --groups render "${process}"
	fi

	if getent group video > "${sink}" 2>&1
	then
		usermod --append --groups video "${process}"
	fi
fi

# local vulkan configuration

frobulator.inf "Configuring Vulkan GPU" "[ Vulkan${vulkan_device} ]"
echo

frobulator.directory /etc/systemd/system "${service}".d

cat <<- FILE > /etc/systemd/system/"${service}".d/"${process}"-override.conf
[Service]
Environment="OLLAMA_VULKAN=1"
Environment="GGML_VK_VISIBLE_DEVICES=${vulkan_device}"
Environment="OLLAMA_MODELS=${models_directory}"
Environment="OLLAMA_HOST=127.0.0.1:11434"
Environment="OLLAMA_NO_CLOUD=true"
FILE

# service

frobulator.service reload

frobulator.service status "${service}"

frobulator.service activate "${service}"

# model

frobulator.silence "ollama pull ${model}" &

frobulator.progress pull

if [ "${?}" -ne 0 ]
then
	frobulator.err "Unable to pull model" "[ ${model} ]"
	echo

	exit 1
fi

# verification

ollama show "${model}" > "${sink}" 2>&1

if [ "${?}" -ne 0 ]
then
	frobulator.err "Local model verification failed" "[ ${model} ]"
	echo

	exit 1
fi

frobulator.ntf inf "Offline local ${label} [ '${model}' ]" "Model name:            ${model_name}
Model version:         ${model_version}
Model size:            ${model_size}
Model directory:       ${models_directory}

API:                   http://127.0.0.1:11434

Run:                   'ollama run ${model} --think=false'

Verify GPU offload:    'ollama ps'.

Note:

Internet access is only required for installation, updates and pulling new models.
The installed model can be used locally with networking disabled."

frobulator.result "${script}"

frobulator.scs "Done"
echo
