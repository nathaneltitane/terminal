#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-m|--model)
			name_model="${2}"

			shift
		;;

		-e|--model-version)
			version_model="${2}"

			shift
		;;

		-s|--size)
			size_model="${2}"

			shift
		;;

		-v|--vulkan-device)
			index_device_vulkan="${2}"

			shift
		;;

		-d|--directory)
			directory="${2}"

			shift
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -m [Model] -e [Version] -s [Size] -v [Vulkan device] -d [Directory] | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-m, --model            Specify [m]odel name."
			echo
			echo -e "                       [ qwen ] [ Default ]"
			echo
			echo -e "-e, --model-version    Specify mod[e]l version."
			echo
			echo -e "                       [ 3.6 ] [ Default ]"
			echo
			echo -e "-s, --size             Specify model [s]ize."
			echo
			echo -e "                       [ 27b ] [ Default ]"
			echo
			echo -e "-v, --vulkan-device    Specify [v]ulkan GPU device index."
			echo
			echo -e "                       [ 0 ] [ Default ]"
			echo
			echo -e "-d, --directory        Specify base [d]irectory for model storage."
			echo
			echo -e "                       [ /language/model/directory/label ]"
			echo
			echo -e "-h, --help             Show [h]elp and usage information."
			echo
			echo -e "'${script}'            [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -m [Model] -e [Version] -s [Size] -v [Vulkan device] -d [Directory] | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

label="LLM"

process="ollama"
service="${process}.service"

name_model="${name_model:-qwen}"
version_model="${version_model:-3.5}"
size_model="${size_model:-2b}"
model="${name_model}${version_model}:${size_model}"
url_model="https://ollama.com/install.sh"

# path to a separate mount so models survive a system reinstall/format

directory="${directory:-/media/internal}"
directory_models="${directory}/${label}/${process}"

# defaults ─────────────────────────────────────────────────────────────────────

# hades canyon nuc (nuc8i7hvk / nuc8i7hnk) ships radeon rx vega m gh/gl.
# current ollama builds support vulkan directly, so no rocm gfx spoof is needed.
# vulkan0 corresponds to the discrete radeon rx vega m gh on this system.

index_device_vulkan="${index_device_vulkan:-0}"

# functions ────────────────────────────────────────────────────────────────────

url_install () {

	local mode_run="${1}"
	local label="${2}"
	local command_name="${3}"
	local url="${4}"

	local command_path
	local installer

	local -a list_paths_ownership=("${@:5}")

	# ${command_name} command path - empty if not installed

	command_path="$(command -v "${command_name}")"

	if [ -n "${command_path}" ]
	then
		frobulator.wrn "Already installed" "[ ${label} ]"

		return 0
	fi

	frobulator.inf "Installing" "[ ${label} ]"

	installer="$(mktemp)"

	curl						\
		--fail					\
		--silent				\
		--show-error			\
		--location				\
		--output "${installer}"	\
								"${url}"

	if [ "${?}" -ne 0 ] || [ ! -s "${installer}" ]
	then
		frobulator.err "Unable to fetch installer" "[ ${label} ]"

		rm -f "${installer}"

		return 1
	fi

	chmod +r "${installer}"

	if [ "${mode_run}" = "user" ] && [ -n "${SUDO_USER}" ]
	then
		sudo -u "${SUDO_USER}" bash "${installer}"
	else
		bash "${installer}"
	fi

	if [ "${?}" -ne 0 ]
	then
		frobulator.err "Installation failed" "[ ${label} ]"

		rm -f "${installer}"

		return 1
	fi

	rm -f "${installer}"

	if [ "${USER}" != "root" ] && [ "${#list_paths_ownership[@]}" -gt 0 ]
	then
		chown -R "${USER}:$(id -g "${USER}")" "${list_paths_ownership[@]}" > "${sink}" 2>&1
	fi

	frobulator.scs "Installed" "[ ${label} ]"

	return 0
}

# requirements ─────────────────────────────────────────────────────────────────

list=(
	curl
)

frobulator.require "${list[@]}"

list=()

# vulkan readiness

if [ ! -e /dev/dri/renderD128 ]
then
	frobulator.wrn "GPU render device not found" "[ /dev/dri/renderD128 ]"
fi

# 'vulkaninfo' path - empty if not installed

command_vulkaninfo="$(command -v vulkaninfo)"

if [ -z "${command_vulkaninfo}" ]
then
	frobulator.wrn "Vulkan diagnostic utility not found" "[ vulkaninfo ]"
else
	if ! vulkaninfo --summary 2>"${sink}" | grep -q "AMD Radeon RX Vega M"
	then
		frobulator.wrn "Expected Radeon RX Vega M Vulkan device not detected"
	fi
fi

# process install

url_install root "${label}" "${process}" "${url_model}"

frobulator.complete halt

# models directory

frobulator.inf "Configuring models directory" "[ ${directory_models} ]"

frobulator.directory "$(dirname "${directory_models}")" "$(basename "${directory_models}")"

chown -R "${process}:${process}" "${directory_models}"

# gpu permissions

if id "${process}" > "${sink}" 2>&1
then
	if getent group render > "${sink}" 2>&1
	then
		usermod --append --groups render "${process}"
	fi

	if getent group video > "${sink}" 2>&1
	then
		usermod --append --groups video "${process}"
	fi
fi

# local vulkan configuration

frobulator.inf "Configuring Vulkan GPU" "[ Vulkan${index_device_vulkan} ]"

frobulator.directory /etc/systemd/system "${service}".d

cat <<- FILE > /etc/systemd/system/"${service}".d/"${process}"-override.conf
[Service]
Environment="OLLAMA_VULKAN=1"
Environment="GGML_VK_VISIBLE_DEVICES=${index_device_vulkan}"
Environment="OLLAMA_MODELS=${directory_models}"
Environment="OLLAMA_HOST=127.0.0.1:11434"
Environment="OLLAMA_NO_CLOUD=true"
FILE

# service

frobulator.service reload

frobulator.service status "${service}"

frobulator.service activate "${service}"

# model

frobulator.silence "ollama pull ${model}" &

frobulator.progress pull

frobulator.complete halt "Unable to pull model" "[ ${model} ]"

# verification

ollama show "${model}" > "${sink}" 2>&1

frobulator.complete halt "Local model verification failed" "[ ${model} ]"

frobulator.ntf inf "Offline local ${label} [ '${model}' ]" inf "Model name:            ${name_model}
Model version:         ${version_model}
Model size:            ${size_model}
Model directory:       ${directory_models}

API:                   http://127.0.0.1:11434

Run:                   'ollama run ${model} --think=false'

Verify GPU offload:    'ollama ps'.

Note:

Internet access is only required for installation, updates and pulling new models.
The installed model can be used locally with networking disabled."

frobulator.result "${script}"

frobulator.scs "Done"
