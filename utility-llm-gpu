#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-11-26"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-m|--model)
			name_model="${2}"

			shift
		;;

		-e|--model-version)
			version_model="${2}"

			shift
		;;

		-s|--size)
			size_model="${2}"

			shift
		;;

		-v|--vulkan-device)
			index_device_vulkan="${2}"

			shift
		;;

		-d|--directory)
			directory="${2}"

			shift
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -m [Model] -e [Version] -s [Size] -v [Vulkan device] -d [Directory] | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-m, --model            Specify [m]odel name."
			echo
			echo -e "                       [ qwen3-coder ] [ Default ]"
			echo
			echo -e "-e, --model-version    Specify mod[e]l version."
			echo
			echo -e "                       [ none ] [ Default ]"
			echo
			echo -e "-s, --size             Specify model [s]ize."
			echo
			echo -e "                       [ 30b ] [ Default ]"
			echo
			echo -e "-v, --vulkan-device    Specify [v]ulkan GPU device index."
			echo
			echo -e "                       [ 0 ] [ Default ]"
			echo
			echo -e "-d, --directory        Specify base [d]irectory for model storage."
			echo
			echo -e "                       [ /language/model/directory/label ]"
			echo
			echo -e "-h, --help             Show [h]elp and usage information."
			echo
			echo -e "'${script}'            [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -m [Model] -e [Version] -s [Size] -v [Vulkan device] -d [Directory] | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

label="LLM"

process="ollama"
service="${process}.service"

name_model="${name_model:-qwen3-coder}"
version_model="${version_model-}"
size_model="${size_model:-30b}"
model="${name_model}${version_model}:${size_model}"

# assistant model built on the pulled one - benchmarked fastest on 8 threads with the graphics chip on auto

name_assistant="ada"
count_threads="8"
size_context="16384"
url_model="https://ollama.com/install.sh"

# path to a separate mount so models survive a system reinstall/format

directory="${directory:-/media/internal}"
directory_models="${directory}/${label}/${process}"

# service runs as models owner

user_service="${USER}"

if [ "${user_service}" = "root" ]
then
	user_service="${process}"
fi

group_service="$(id -gn "${user_service}" 2> "${sink}" || echo "${process}")"

# defaults ─────────────────────────────────────────────────────────────────────

# hades canyon nuc (nuc8i7hvk / nuc8i7hnk) ships radeon rx vega m gh/gl.
# current ollama builds support vulkan directly, so no rocm gfx spoof is needed.
# vulkan0 corresponds to the discrete radeon rx vega m gh on this system.

index_device_vulkan="${index_device_vulkan:-0}"

# functions ────────────────────────────────────────────────────────────────────

url_install () {

	local mode_run="${1}"
	local label="${2}"
	local command_name="${3}"
	local url="${4}"

	local command_path
	local installer

	local -a list_paths_ownership=("${@:5}")

	# ${command_name} command path - empty if not installed

	command_path="$(command -v "${command_name}")"

	if [ -n "${command_path}" ]
	then
		frobulator.wrn "Already installed" "[ ${label} ]"

		return 0
	fi

	frobulator.inf "Installing" "[ ${label} ]"

	installer="$(mktemp)"

	curl						\
		--fail					\
		--silent				\
		--show-error			\
		--location				\
		--output "${installer}"	\
								"${url}"

	if [ "${?}" -ne 0 ] || [ ! -s "${installer}" ]
	then
		frobulator.err "Unable to fetch installer" "[ ${label} ]"

		rm -f "${installer}"

		return 1
	fi

	chmod +r "${installer}"

	if [ "${mode_run}" = "user" ] && [ -n "${SUDO_USER}" ]
	then
		sudo -u "${SUDO_USER}" bash "${installer}"
	else
		bash "${installer}"
	fi

	if [ "${?}" -ne 0 ]
	then
		frobulator.err "Installation failed" "[ ${label} ]"

		rm -f "${installer}"

		return 1
	fi

	rm -f "${installer}"

	if [ "${USER}" != "root" ] && [ "${#list_paths_ownership[@]}" -gt 0 ]
	then
		chown -R "${USER}:$(id -g "${USER}")" "${list_paths_ownership[@]}" > "${sink}" 2>&1
	fi

	frobulator.scs "Installed" "[ ${label} ]"

	return 0
}

# requirements ─────────────────────────────────────────────────────────────────

list=(
	curl
)

frobulator.require "${list[@]}"

list=()

# vulkan readiness

if [ ! -e /dev/dri/renderD128 ]
then
	frobulator.wrn "GPU render device not found" "[ /dev/dri/renderD128 ]"
fi

# 'vulkaninfo' path - empty if not installed

command_vulkaninfo="$(command -v vulkaninfo)"

if [ -z "${command_vulkaninfo}" ]
then
	frobulator.wrn "Vulkan diagnostic utility not found" "[ vulkaninfo ]"
else
	text_vulkan_summary="$(vulkaninfo --summary 2> "${sink}")"

	if [[ "${text_vulkan_summary}" != *"AMD Radeon RX Vega M"* ]]
	then
		frobulator.wrn "Expected Radeon RX Vega M Vulkan device not detected"
	fi
fi

# process install

url_install root "${label}" "${process}" "${url_model}"

frobulator.complete halt

# models directory

frobulator.inf "Configuring models directory" "[ ${directory_models} ]"

frobulator.directory "$(dirname "${directory_models}")" "$(basename "${directory_models}")"

chown -R "${user_service}:${group_service}" "${directory_models}"

# client settings directory - kept with the models so it survives a system reinstall/format

directory_settings="${directory_models}/.${process}"

if [ "${user_service}" != "${process}" ]
then
	frobulator.inf "Configuring settings directory" "[ ${directory_settings} ]"

	# first run moves existing settings - stored settings win, home copy kept aside

	if [ -d "${HOME}/.${process}" ] && [ ! -L "${HOME}/.${process}" ]
	then
		if [ ! -e "${directory_settings}" ]
		then
			mv "${HOME}/.${process}" "${directory_settings}"
		else
			mv "${HOME}/.${process}" "${HOME}/.${process}.backup-$(date +%Y%m%d-%H%M%S)"
		fi
	fi

	frobulator.directory "${directory_models}" ".${process}"

	frobulator.link "${directory_models}" "${HOME}" ".${process}"

	chown -R "${user_service}:${group_service}" "${directory_settings}"
	chown -h "${user_service}:${group_service}" "${HOME}/.${process}"
fi

# gpu permissions

if [ -n "$(id -u "${user_service}" 2> "${sink}")" ]
then
	if [ -n "$(getent group render)" ]
	then
		usermod --append --groups render "${user_service}"
	fi

	if [ -n "$(getent group video)" ]
	then
		usermod --append --groups video "${user_service}"
	fi
fi

# local vulkan configuration

frobulator.inf "Configuring Vulkan GPU" "[ Vulkan${index_device_vulkan} ]"

frobulator.directory /etc/systemd/system "${service}".d

cat <<- FILE > /etc/systemd/system/"${service}".d/"${process}"-override.conf
[Service]
User=${user_service}
Group=${group_service}
Environment="OLLAMA_VULKAN=1"
Environment="GGML_VK_VISIBLE_DEVICES=${index_device_vulkan}"
Environment="OLLAMA_MODELS=${directory_models}"
Environment="OLLAMA_HOST=127.0.0.1:11434"
Environment="OLLAMA_NO_CLOUD=true"
Environment="OLLAMA_KEEP_ALIVE=-1"
FILE

# service

frobulator.service reload

frobulator.service status "${service}"

frobulator.service activate "${service}"

# model

frobulator.background pull -- frobulator.silence "ollama pull ${model}"

frobulator.complete halt "Unable to pull model" "[ ${model} ]"

# verification

ollama show "${model}" > "${sink}" 2>&1

frobulator.complete halt "Local model verification failed" "[ ${model} ]"

# assistant model - same weights, tuned options, kept in memory - settings file kept with the models

frobulator.inf "Creating assistant model" "[ ${name_assistant} // ${model} ]"

file_model="${directory_models}/modelfile-${name_assistant}"

cat <<- FILE > "${file_model}"
FROM ${model}
PARAMETER num_thread ${count_threads}
PARAMETER num_ctx ${size_context}
FILE

frobulator.silence "ollama create ${name_assistant} -f ${file_model}"

frobulator.complete halt "Unable to create assistant model" "[ ${name_assistant} ]"

curl -s http://127.0.0.1:11434/api/generate -d "{\"model\":\"${name_assistant}\"}" > "${sink}"

frobulator.ntf inf "Offline local ${label} [ '${model}' ]" inf "Model name:            ${name_model}
Model version:         ${version_model}
Model size:            ${size_model}
Assistant model:       ${name_assistant} [ ${count_threads} threads // ${size_context} context ]
Model directory:       ${directory_models}
Settings directory:    ${directory_settings}

API:                   http://127.0.0.1:11434

Run:                   'ada' or 'ollama run ${name_assistant}'

Verify GPU offload:    'ollama ps'.

Unload from memory:    'ollama stop ${model}'

Note:

Internet access is only required for installation, updates and pulling new models.
The installed model can be used locally with networking disabled."

frobulator.result "${script}"

frobulator.scs "Done"
