#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

directory_binaries="${HOME}/.local/bin"
name_frobulator="frobulator"

frobulator="${directory_binaries}/${name_frobulator}"

# frobulator next to linked files

file_profile="$(readlink --canonicalize -- "${BASH_SOURCE[0]}")"
directory_shell="$(dirname -- "${file_profile}")"

if [ -f "${directory_shell}/${name_frobulator}" ]
then
	frobulator="${directory_shell}/${name_frobulator}"
fi

source "${frobulator}"

# superuser ────────────────────────────────────────────────────────────────────

# script ───────────────────────────────────────────────────────────────────────

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-21"

# variables ────────────────────────────────────────────────────────────────────

option_install="install"
directory_aliases="${HOME}/.bash-aliases"
file_aliases="${HOME}/.bash_aliases"
directory_functions="${HOME}/.bash-functions"
file_functions="${HOME}/.bash_functions"
directory_dextop="${HOME}/.dextop"
file_ticker="${directory_dextop}/dextop-ticker"
file_login="${directory_dextop}/dextop-login"
value_login_enabled="login"
separator_path=":"
name_termux="termux"
name_user_root="root"
name_process_proot="proot"
name_level_container="container"
display_default=":0"
delay_session="1"
sequence_prompt_start="\001"
sequence_prompt_end="\002"
text_prompt_open="[ "
text_prompt_close=" ]"
text_prompt_symbol=">_"
text_prompt_root="#"
text_prompt_user="$"
code_black="0"
code_red="1"
code_green="2"
code_yellow="3"
code_blue="4"
code_magenta="5"
code_cyan="6"
code_white="7"
code_reset="0"

list_path_container=(
	/usr/local/sbin
	/usr/local/bin
	/usr/sbin
	/usr/bin
	/sbin
	/bin
)

list_path_termux=(
	"${HOME}/.local/sbin"
	"${directory_binaries}"
	"${HOME}/.sbin"
	"${HOME}/.bin"
)

list_directories_prefix=(
	sbin
	bin
)

list_path_android=(
	/system/sbin
	/system/bin
)

# defaults ─────────────────────────────────────────────────────────────────────

self="${BASH_SOURCE[0]}"

# usage ────────────────────────────────────────────────────────────────────────

# executed directly: install only

if [[ "${self}" = "${0}" ]]
then
	script="$(basename -- "${self}")"

	directory_install="${directory_binaries}"

	while (( $# ))
	do
		case "${1}"
		in
			-i|--install)
				option="${option_install}"
			;;

			-h|--help)
				echo
				echo -e "Usage: ./${script} -i | -h"
				echo
				echo -e "Options:"
				echo
				echo -e "-i, --install    Run [i]nstallation of ${script} to ${directory_install}."
				echo
				echo -e "-h, --help       Show [h]elp and usage information."
				echo
				echo -e "'${script}'      [ Version // ${version} ]"
				echo

				exit
			;;

			"")
				# handle empty argument:
				# use default values specified in script

				:
			;;

			*)
				echo
				echo -e "Usage: ./${script} -i | -h"
				echo
				echo -e "Unknown option: '${script} ${1}':"
				echo -e "Type './${script} -h' for help and usage information."
				echo

				exit 1

			;;

			esac

		shift

	done

	# default to install

	if [ -z "${option}" ]
	then
		option="${option_install}"
	fi

	# install

	if [ "${option}" = "${option_install}" ]
	then
		# blank line - output separated from the shell prompt

		echo

		file_script="$(realpath "${self}")"

		directory_script="$(dirname "${file_script}")"

		if [ "${directory_script}" -ef "${directory_install}" ]
		then
			frobulator.inf "Already installed" "[ ${directory_install}/${script} ]"
		else
			frobulator.copy "${directory_script}" "${directory_install}" "${script}"

			frobulator.permissions public execute "${directory_install}/${script}"

			frobulator.scs "Installed" "[ ${directory_install}/${script} ]"
		fi
	fi

	exit
fi

# shell ────────────────────────────────────────────────────────────────────────

# loading order - login shell:

# system profile
# system bash configuration
# home bash configuration

# loading order - non-login shell:

# system bash configuration
# home bash configuration

# non-login shell requires 'bashrc'

# profile ──────────────────────────────────────────────────────────────────────

if [ -n "${TERMUX_VERSION}" ]
then
	frobulator.fwd "Loading profile..."

	frobulator.clear
fi

# bash ─────────────────────────────────────────────────────────────────────────

if [ -n "${BASH_VERSION}" ]
then

	# aliases ──────────────────────────────────────────────────────────────────

	if [ -d "${directory_aliases}" ]
	then
		for alias in "${directory_aliases}"/*
		do
			if [ -x "${alias}" ]
			then
				. "${alias}"
			fi
		done
	fi

	if [ -f "${file_aliases}" ]
	then
		. "${file_aliases}"
	fi

	# functions ────────────────────────────────────────────────────────────────

	if [ -d "${directory_functions}" ]
	then
		for function in "${directory_functions}"/*
		do
			if [ -x "${function}" ]
			then
				. "${function}"
			fi
		done
	fi

	if [ -f "${file_functions}" ]
	then
		. "${file_functions}"
	fi
fi

# path ─────────────────────────────────────────────────────────────────────────

PATH=""

# container

for directory_path in "${list_path_container[@]}"
do
	if [ -d "${directory_path}" ]
	then
		PATH+="${directory_path}${separator_path}"
	fi
done

# termux

for directory_path in "${list_path_termux[@]}"
do
	if [ -d "${directory_path}" ]
	then
		PATH+="${directory_path}${separator_path}"
	fi
done

# linked files directory for root shells

if [ "${directory_shell}" != "${directory_binaries}" ]
then
	PATH+="${directory_shell}${separator_path}"
fi

# termux prefix

if [ -n "${PREFIX}" ]
then
	for name_directory_prefix in "${list_directories_prefix[@]}"
	do
		if [ -d "${PREFIX}/${name_directory_prefix}" ]
		then
			PATH+="${PREFIX}/${name_directory_prefix}${separator_path}"
		fi
	done
fi

# android

for directory_path in "${list_path_android[@]}"
do
	if [ -d "${directory_path}" ]
	then
		PATH+="${directory_path}${separator_path}"
	fi
done

PATH="${PATH}"

# user  ────────────────────────────────────────────────────────────────────────

if [ -n "${TERMUX_VERSION}" ]
then
	if [ -z "${USER}" ]
	then
		USER="${name_termux}"
	fi
fi

# colors ───────────────────────────────────────────────────────────────────────

black="${sequence_prompt_start}$(tput setaf "${code_black}")${sequence_prompt_end}"
red="${sequence_prompt_start}$(tput setaf "${code_red}")${sequence_prompt_end}"
green="${sequence_prompt_start}$(tput setaf "${code_green}")${sequence_prompt_end}"
yellow="${sequence_prompt_start}$(tput setaf "${code_yellow}")${sequence_prompt_end}"
blue="${sequence_prompt_start}$(tput setaf "${code_blue}")${sequence_prompt_end}"
magenta="${sequence_prompt_start}$(tput setaf "${code_magenta}")${sequence_prompt_end}"
cyan="${sequence_prompt_start}$(tput setaf "${code_cyan}")${sequence_prompt_end}"
white="${sequence_prompt_start}$(tput setaf "${code_white}")${sequence_prompt_end}"

reset="${sequence_prompt_start}$(tput sgr "${code_reset}")${sequence_prompt_end}"

# prompt ───────────────────────────────────────────────────────────────────────

unset PS1

# logged in user name and running proot container process ids - empty outside one

name_user="$(id --user --name)"
id_process_proot="$(pidof "${name_process_proot}")"

if [ "${name_user}" = "${name_user_root}" ]
then
	color_prompt="${red}"

elif [ -n "${id_process_proot}" ]
then
	color_prompt="${magenta}"
else
	color_prompt="${green}"
fi

PS1+="${reset}${text_prompt_open}"
PS1+="${color_prompt}${USER}"
PS1+="${reset}${text_prompt_close}"

if [ "${name_user}" = "${name_user_root}" ]
then
	PS1+="${white} ${text_prompt_symbol} ${text_prompt_root} ${reset}"
else
	PS1+="${white} ${text_prompt_symbol} ${text_prompt_user} ${reset}"
fi

unset name_user

unset color_prompt

# display ──────────────────────────────────────────────────────────────────────

if [ -n "${TERMUX_VERSION}" ]
then
	TERMUX_X11_APPLICATION="com.termux.x11"
	TERMUX_X11_SERVER="termux-x11"
	TERMUX_X11_DRIVER="virpipe"
	TERMUX_X11_ACCELERATOR="virgl_test_server"

	if [ -z "${DISPLAY}" ]
	then
		DISPLAY="${display_default}"
	fi

	# running graphics accelerator and termux x11 application process ids - empty if stopped

	id_process_accelerator="$(pgrep --full "${TERMUX_X11_ACCELERATOR}")"
	id_process_x11_application="$(pgrep --full "${TERMUX_X11_APPLICATION}")"

	if [ -n "${id_process_accelerator}" ]
	then
		:
	else
		"${TERMUX_X11_ACCELERATOR}" &
	fi

	if [ -n "${id_process_x11_application}" ]
	then
		:
	else
		"${TERMUX_X11_SERVER}" "${DISPLAY}" &
	fi

	# export variables

	export DISPLAY="${DISPLAY}"

	export TERMUX_X11_APPLICATION="${TERMUX_X11_APPLICATION}"
	export TERMUX_X11_SERVER="${TERMUX_X11_SERVER}"
	export TERMUX_X11_DRIVER="${TERMUX_X11_DRIVER}"
	export TERMUX_X11_ACCELERATOR="${TERMUX_X11_ACCELERATOR}"
fi

unset id_process_accelerator id_process_x11_application

# dextop ───────────────────────────────────────────────────────────────────────

if [ -n "${TERMUX_VERSION}" ]
then
	# get session login count

	ticker="$(cat "${file_ticker}")"

	title_session="${name_termux}"

	# load welcome message

	# proot container processes matching by command line - empty outside a container

	id_process_proot="$(pgrep --full "${name_process_proot}")"

	if [ -n "${id_process_proot}" ]
	then
		title_session="${distribution}"
	fi

	title_session="${title_session^}"

	frobulator.fwd "Login count" "[ ${ticker} ]" ">"

	frobulator.fwd "Welcome to Dextop" "[ ${title_session} ]"

	frobulator.inf "Graphical session:"

	frobulator.inf "'container-session -o | -x'"
	frobulator.nul "'container-session -u [User Name] | -d [Directory] | -f [Application]'"

	frobulator.inf "Update utilities:"

	frobulator.nul "'dextop -u shell [Shell Name | all] | utility [Utility Name | all]'"

	# increment session login count

	ticker=$(( ticker + 1 ))

	echo "${ticker}" > "${file_ticker}"

	sleep "${delay_session}"

	# automatic session start

	# automatic session start selection: 'login' when enabled

	content_login_dextop="$(cat "${file_login}")"

	if [ "${content_login_dextop}" = "${value_login_enabled}" ]
	then
		frobulator.wrn "Automatic session start enabled"

		level_session="${name_termux}"

		if [ -n "${id_process_proot}" ]
		then
			level_session="${name_level_container}"
		fi

		# load session interface

		level_session="${level_session^}"

		frobulator.cpt "Loading ${level_session} level session" "[ ${interface_session} ]"

		container-session -o
	fi
fi

unset id_process_proot content_login_dextop
