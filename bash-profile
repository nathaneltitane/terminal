#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

frobulator="${HOME}"/.local/bin/frobulator

source "${frobulator}"

# superuser ────────────────────────────────────────────────────────────────────

# script ───────────────────────────────────────────────────────────────────────

# version ──────────────────────────────────────────────────────────────────────

version="2026-09-20"

# defaults ─────────────────────────────────────────────────────────────────────

self="${BASH_SOURCE[0]}"

# usage ────────────────────────────────────────────────────────────────────────

# executed directly: install only

if [[ "${self}" = "${0}" ]]
then
	script="$(basename -- "${self}")"

	directory_install="${HOME}"/.local/bin

	while (($#))
	do
		case "${1}"
		in
			-i|--install)
				option="install"
			;;

			-h|--help)
				echo
				echo -e "Usage: ./${script} -i | -h"
				echo
				echo -e "Options:"
				echo
				echo -e "-i, --install    Run [i]nstallation of ${script} to ${directory_install}."
				echo
				echo -e "-h, --help       Show [h]elp and usage information."
				echo
				echo -e "'${script}'      [ Version // ${version} ]"
				echo

				exit
			;;

			"")
				# handle empty argument:
				# use default values specified in script

				:
			;;

			*)
				echo
				echo -e "Usage: ./${script} -i | -h"
				echo
				echo -e "Unknown option: '${script} ${1}':"
				echo -e "Type './${script} -h' for help and usage information."
				echo

				exit 1

			;;

			esac

		shift

	done

	# default to install

	if [ -z "${option}" ]
	then
		option="install"
	fi

	# install

	if [ "${option}" = "install" ]
	then
		file_script="$(realpath "${self}")"

		directory_script="$(dirname "${file_script}")"

		if [ "${directory_script}" -ef "${directory_install}" ]
		then
			frobulator.inf "Already installed" "[ ${directory_install}/${script} ]"
		else
			frobulator.copy "${directory_script}" "${directory_install}" "${script}"

			frobulator.permissions public execute "${directory_install}/${script}"

			frobulator.scs "Installed" "[ ${directory_install}/${script} ]"
		fi
	fi

	exit
fi

# shell ────────────────────────────────────────────────────────────────────────

# loading order - login shell:

# system profile
# system bash configuration
# home bash configuration

# loading order - non-login shell:

# system bash configuration
# home bash configuration

# non-login shell requires 'bashrc'

# profile ──────────────────────────────────────────────────────────────────────

if [ -n "${TERMUX_VERSION}" ]
then
	frobulator.fwd "Loading profile..."

	frobulator.clear
fi

# bash ─────────────────────────────────────────────────────────────────────────

if [ -n "${BASH_VERSION}" ]
then

	# aliases ──────────────────────────────────────────────────────────────────

	if [ -d "${HOME}"/.bash-aliases ]
	then
		for alias in "${HOME}"/.bash-aliases/*
		do
			if [ -x "${alias}" ]
			then
				. "${alias}"
			fi
		done
	fi

	if [ -f "${HOME}"/.bash_aliases ]
	then
		. "${HOME}"/.bash_aliases
	fi

	# functions ────────────────────────────────────────────────────────────────

	if [ -d "${HOME}"/.bash-functions ]
	then
		for function in "${HOME}"/.bash-functions/*
		do
			if [ -x "${function}" ]
			then
				. "${function}"
			fi
		done
	fi

	if [ -f "${HOME}"/.bash_functions ]
	then
		. "${HOME}"/.bash_functions
	fi
fi

# path ─────────────────────────────────────────────────────────────────────────

PATH=""

# container

[ -d /usr/local/sbin ]       && PATH+="/usr/local/sbin:"
[ -d /usr/local/bin ]        && PATH+="/usr/local/bin:"
[ -d /usr/sbin ]             && PATH+="/usr/sbin:"
[ -d /usr/bin ]              && PATH+="/usr/bin:"
[ -d /sbin ]                 && PATH+="/sbin:"
[ -d /bin ]                  && PATH+="/bin:"

# termux

[ -d "${HOME}"/.local/sbin ] && PATH+="${HOME}/.local/sbin:"
[ -d "${HOME}"/.local/bin ]  && PATH+="${HOME}/.local/bin:"
[ -d "${HOME}"/.sbin ]       && PATH+="${HOME}/.sbin:"
[ -d "${HOME}"/.bin ]        && PATH+="${HOME}/.bin:"

[ -d "${PREFIX}"/sbin ]      && PATH+="${PREFIX}/sbin:"
[ -d "${PREFIX}"/bin ]       && PATH+="${PREFIX}/bin:"

# android

[ -d /system/sbin ]          && PATH+="/system/sbin:"
[ -d /system/bin ]           && PATH+="/system/bin:"

PATH="${PATH}"

# user  ────────────────────────────────────────────────────────────────────────

if [ -n "${TERMUX_VERSION}" ]
then
	if [ -z "${USER}" ]
	then
		USER="termux"
	fi
fi

# colors ───────────────────────────────────────────────────────────────────────

black="\001$(tput setaf 0)\002"
red="\001$(tput setaf 1)\002"
green="\001$(tput setaf 2)\002"
yellow="\001$(tput setaf 3)\002"
blue="\001$(tput setaf 4)\002"
magenta="\001$(tput setaf 5)\002"
cyan="\001$(tput setaf 6)\002"
white="\001$(tput setaf 7)\002"

reset="\001$(tput sgr 0)\002"

# prompt ───────────────────────────────────────────────────────────────────────

unset PS1

# logged in user name and running proot container process ids - empty outside one

user_name="$(id -u -n)"
process_proot="$(pidof proot)"

if [ "${user_name}" = "root" ]
then
	prompt_color="${red}"

elif [ -n "${process_proot}" ]
then
	prompt_color="${magenta}"
else
	prompt_color="${green}"
fi

PS1+="${reset}[ "
PS1+="${prompt_color}${USER}"
PS1+="${reset} ]"

if [ "${user_name}" = "root" ]
then
	PS1+="${white} >_ # ${reset}"
else
	PS1+="${white} >_ $ ${reset}"
fi

unset user_name

unset prompt_color

# display ──────────────────────────────────────────────────────────────────────

if [ -n "${TERMUX_VERSION}" ]
then
	TERMUX_X11_APPLICATION="com.termux.x11"
	TERMUX_X11_SERVER="termux-x11"
	TERMUX_X11_DRIVER="virpipe"
	TERMUX_X11_ACCELERATOR="virgl_test_server"

	if [ -z "${DISPLAY}" ]
	then
		DISPLAY=":0"
	fi

	# running graphics accelerator and termux x11 application process ids - empty if stopped

	process_accelerator="$(pgrep -f "${TERMUX_X11_ACCELERATOR}")"
	process_x11_application="$(pgrep -f "${TERMUX_X11_APPLICATION}")"

	if [ -n "${process_accelerator}" ]
	then
		:
	else
		"${TERMUX_X11_ACCELERATOR}" &
	fi

	if [ -n "${process_x11_application}" ]
	then
		:
	else
		"${TERMUX_X11_SERVER}" "${DISPLAY}" &
	fi

	# export variables

	export DISPLAY="${DISPLAY}"

	export TERMUX_X11_APPLICATION="${TERMUX_X11_APPLICATION}"
	export TERMUX_X11_SERVER="${TERMUX_X11_SERVER}"
	export TERMUX_X11_DRIVER="${TERMUX_X11_DRIVER}"
	export TERMUX_X11_ACCELERATOR="${TERMUX_X11_ACCELERATOR}"
fi

unset process_accelerator process_x11_application

# dextop ───────────────────────────────────────────────────────────────────────

if [ -n "${TERMUX_VERSION}" ]
then
	# get session login count

	ticker=$(cat "${HOME}"/.dextop/dextop-ticker)

	session_title="termux"

	# load welcome message

	# proot container processes matching by command line - empty outside a container

	process_proot="$(pgrep -f proot)"

	if [ -n "${process_proot}" ]
	then
		session_title="${distribution}"
	fi

	session_title="${session_title^}"

	frobulator.fwd "Login count" "[ ${ticker} ]" ">"

	frobulator.fwd "Welcome to Dextop" "[ ${session_title} ]"

	frobulator.inf "Graphical session:"

	frobulator.inf "'container-session -o | -x'"
	frobulator.nul "'container-session -u [User Name] | -d [Directory] | -f [Application]'"

	frobulator.inf "Update utilities:"

	frobulator.nul "'dextop -u shell [Shell Name | all] | utility [Utility Name | all]'"

	# increment session login count

	ticker=$(( ${ticker} + 1 ))

	echo ${ticker} > "${HOME}"/.dextop/dextop-ticker

	sleep 1

	# automatic session start

	# automatic session start selection: 'login' when enabled

	dextop_login="$(cat "${HOME}"/.dextop/dextop-login)"

	if [ "${dextop_login}" = "login" ]
	then
		frobulator.wrn "Automatic session start enabled"

		session_level="termux"

		if [ -n "${process_proot}" ]
		then
			session_level="container"
		fi

		# load session interface

		session_level="${session_level^}"

		frobulator.cpt "Loading ${session_level} level session" "[ ${session_interface} ]"

		container-session -o
	fi
fi

unset process_proot dextop_login
