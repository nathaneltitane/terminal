#!/bin/bash

# loaded by "${HOME}"/.local/bin/bash-functions

# dimensions ───────────────────────────────────────────────────────────────────

dimensions () {

	local columns
	local lines

	# output starts one line below the command

	echo

	columns=$(tput cols)
	lines=$(tput lines)

	echo "Terminal size:"
	echo "W: ${columns} x H: ${lines}"
}
