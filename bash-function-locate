#!/bin/bash

# loaded by "${HOME}"/.local/bin/bash-functions

# locate ───────────────────────────────────────────────────────────────────────

locate () {

	local name_command="find"
	local pattern_directory="^(d|dir|directory)$"
	local pattern_file="^(f|file)$"
	local type_directory="d"
	local type_file="f"
	local wildcard_any="*"
	local text_unsupported="unsupported type"
	local command_find
	local type_find
	local query
	local pattern_name

	# output starts one line below the command

	echo

	type_find="${1}"

	query="${2}"

	if [[ "${type_find}" =~ ${pattern_directory} ]]
	then
		type_find="${type_directory}"

	elif [[ "${type_find}" =~ ${pattern_file} ]]
	then
		type_find="${type_file}"
	else
		echo "${text_unsupported}"
		echo

		return 1
	fi

	# 'find' path - empty if not installed

	command_find="$(command -v "${name_command}")"

	if [ -n "${command_find}" ]
	then
		pattern_name="${wildcard_any}${query}${wildcard_any}"

		"${command_find}"			\
			"${PWD}"				\
				-type	"${type_find}"	\
				-iname	"${pattern_name}"
	fi

}
