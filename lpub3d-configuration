#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (($#))
do
	case "${1}"
	in
		-h|--help)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-h, --help    Show [h]elp and usage information."
			echo
			echo -e "'${script}'   [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

# defaults ─────────────────────────────────────────────────────────────────────

# functions ────────────────────────────────────────────────────────────────────

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(

)

frobulator.require ${list[@]}

list=()

# configuration ────────────────────────────────────────────────────────────────

# 'lpub3d24' path - empty if not installed

command_lpub3d24="$(command -v lpub3d24)"

if [ -n "${command_lpub3d24}" ]
then
    frobulator.link /usr/bin /usr/bin lpub3d24 lpub3d
fi

if [ -d /media/[iI]nternal/[lL]ego ]
then
	if [ -d /media/[iI]nternal/[lL]ego/lpub3d ]
	then
		if [ -f /media/[iI]nternal/[lL]ego/lpub3d/lpub3d.conf ]
		then
			frobulator.inf "Linking configuration"

			frobulator.directory "${HOME}" .config/"LPub3D Software"

			frobulator.link /media/[iI]nternal/[lL]ego/lpub3d "${HOME}"/.config/"LPub3D Software" lpub3d.conf
		fi

		if [ -f /media/[iI]nternal/[lL]ego/ldraw.zip ]
		then
			frobulator.inf "Generating library setup"

			frobulator.directory "${HOME}"/.local/share/"LPub3D Software" lpub3d/libraries

			# official parts archive

			frobulator.extract /media/[iI]nternal/[lL]ego/ldraw.zip "${HOME}"/.local/share/"LPub3D Software"/lpub3d

			frobulator.link /media/[iI]nternal/[lL]ego "${HOME}"/.local/share/"LPub3D Software"/lpub3d/libraries ldraw.zip complete.zip

			# unofficial parts archive

			frobulator.extract /media/[iI]nternal/[lL]ego/ldrawunf.zip "${HOME}"/.local/share/"LPub3D Software"/lpub3d/ldraw

			frobulator.link /media/[iI]nternal/[lL]ego "${HOME}"/.local/share/"LPub3D Software"/lpub3d/libraries ldrawunf.zip lpub3dldrawunf.zip

			chmod -R 777 "${HOME}"/.local/share/"LPub3D Software"
		fi

	fi
fi

# generate launcher

cat <<- 'FILE' > /usr/share/applications/lpub3d.desktop
[Desktop Entry]
Version=1.0
Name=LPub3D
GenericName=LDraw Editor
Comment=An LDraw Building Instruction Editor
Exec=lpub3d %f
Terminal=false
Type=Application
Icon=lpub3d
MimeType=application/x-ldraw;application/x-multi-part-ldraw;application/x-multipart-ldraw;
Categories=Graphics;3DGraphics;Publishing;Engineering;
Keywords=;Building;CAD;CAI;Editor;Education;Instructions;LDraw;LEGO;Publishing;Renderer;Viewer;
FILE

frobulator.scs "Done"
