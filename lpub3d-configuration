#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-h|--help)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-h, --help    Show [h]elp and usage information."
			echo
			echo -e "'${script}'   [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

name_command="lpub3d24"
name_link="lpub3d"
name_software="LPub3D Software"
name_configuration="lpub3d.conf"
name_archive_official="ldraw.zip"
name_archive_official_link="complete.zip"
name_archive_unofficial="ldrawunf.zip"
name_archive_unofficial_link="lpub3dldrawunf.zip"
mode_permissions="777"
file_launcher="/usr/share/applications/lpub3d.desktop"
directory_binaries="/usr/bin"
directory_config_relative=".config/${name_software}"
directory_libraries_relative="${name_link}/libraries"
directory_config="${HOME}/${directory_config_relative}"
directory_share="${HOME}/.local/share/${name_software}"
directory_share_lpub3d="${directory_share}/${name_link}"
directory_share_ldraw="${directory_share_lpub3d}/ldraw"
directory_share_libraries="${directory_share_lpub3d}/libraries"
pattern_lego="/media/[iI]nternal/[lL]ego"
pattern_lpub3d="${pattern_lego}/${name_link}"
pattern_configuration="${pattern_lpub3d}/${name_configuration}"
pattern_archive_official="${pattern_lego}/${name_archive_official}"
pattern_archive_unofficial="${pattern_lego}/${name_archive_unofficial}"

# defaults ─────────────────────────────────────────────────────────────────────

# functions ────────────────────────────────────────────────────────────────────

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(

)

frobulator.require ${list[@]}

list=()

# configuration ────────────────────────────────────────────────────────────────

# 'lpub3d24' path - empty if not installed

command_lpub3d24="$(command -v "${name_command}")"

if [ -n "${command_lpub3d24}" ]
then
	frobulator.link "${directory_binaries}" "${directory_binaries}" "${name_command}" "${name_link}"
fi

# patterns stay unquoted

if [ -d ${pattern_lego} ]
then
	if [ -d ${pattern_lpub3d} ]
	then
		if [ -f ${pattern_configuration} ]
		then
			frobulator.inf "Linking configuration"

			frobulator.directory "${HOME}" "${directory_config_relative}"

			frobulator.link ${pattern_lpub3d} "${directory_config}" "${name_configuration}"
		fi

		if [ -f ${pattern_archive_official} ]
		then
			frobulator.inf "Generating library setup"

			frobulator.directory "${directory_share}" "${directory_libraries_relative}"

			# official parts archive

			frobulator.extract ${pattern_archive_official} "${directory_share_lpub3d}"

			frobulator.link ${pattern_lego} "${directory_share_libraries}" "${name_archive_official}" "${name_archive_official_link}"

			# unofficial parts archive

			frobulator.extract ${pattern_archive_unofficial} "${directory_share_ldraw}"

			frobulator.link ${pattern_lego} "${directory_share_libraries}" "${name_archive_unofficial}" "${name_archive_unofficial_link}"

			chmod --recursive "${mode_permissions}" "${directory_share}"
		fi

	fi
fi

# generate launcher

cat <<- 'FILE' > "${file_launcher}"
[Desktop Entry]
Version=1.0
Name=LPub3D
GenericName=LDraw Editor
Comment=An LDraw Building Instruction Editor
Exec=lpub3d %f
Terminal=false
Type=Application
Icon=lpub3d
MimeType=application/x-ldraw;application/x-multi-part-ldraw;application/x-multipart-ldraw;
Categories=Graphics;3DGraphics;Publishing;Engineering;
Keywords=;Building;CAD;CAI;Editor;Education;Instructions;LDraw;LEGO;Publishing;Renderer;Viewer;
FILE

frobulator.scs "Done"
