#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (($#))
do
	case "${1}"
	in
		-p|--project)
			project="${2}"

			shift
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -p [Project] | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-p, --project    Specify [p]roject to clone."
			echo
			echo -e "                 [ (empty) ] [ Default - all projects ]"
			echo
			echo -e "-h, --help       Show [h]elp and usage information."
			echo
			echo -e "'${script}'      [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -p [Project] | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

# defaults ─────────────────────────────────────────────────────────────────────

# validate arguments

if [[ "${project}" = -* ]]
then
	frobulator.err "Missing argument for '--project'."

	exit 1
fi

url="https://github.com/"
username="nathaneltitane"

depth=1

# functions ────────────────────────────────────────────────────────────────────

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(

)

frobulator.require ${list[@]}

list=()

# configuration ────────────────────────────────────────────────────────────────

list+=(
	chatty
	dextop
	frobulator
	gutengrab
	l2cu
	mechablocks
	nathaneltitane
	pewpewprints
	terminal
)

if [ -n "${project}" ]
then
	list=(
		"${project}"
	)
fi

for project in ${list[@]}
do
	if [[ -d "${project}" ]]
	then
		frobulator.wrn "Project directory exists" "[ ${project} ]"

		frobulator.delete "${project}"
	fi

	git clone				\
		--quiet				\
		--depth "${depth}"	\
							"${url}"/"${username}"/"${project}" &

	frobulator.progress "clone" "[ ${project} ]"

done

list=()
