#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-m|--module)
			module="${2}"

			shift
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -m [Module] | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-m, --module    Blacklist specified [m]odule: do not rely on auto-detection."
			echo
			echo -e "-h, --help      Show [h]elp and usage information."
			echo
			echo -e "'${script}'     [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -m [Module] | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

directory_blacklist="/etc/modprobe.d"

# defaults ─────────────────────────────────────────────────────────────────────

# functions ────────────────────────────────────────────────────────────────────

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(
	awk
	grep
	lsmod
	update-initramfs
)

frobulator.require ${list[@]}

frobulator.complete

list=()

# configuration ────────────────────────────────────────────────────────────────

# extract loaded watchdog module

if [ -z "${module}" ]
then
	module=$(

		lsmod |
		awk '
			tolower($1) ~ /(wdt$|tco$|^softdog$|watchdog)/ &&
			tolower($1) != "watchdog" {
				print $1
				exit
			}
		'

	)
fi

frobulator.complete

# validate module

if [ -z "${module}" ]
then
	frobulator.err "No watchdog module found."

	exit 1
fi

label_module="${module,,}"

label_module="${label_module//_/-}"

name_file_blacklist="${label_module}-blacklist.conf"

path_blacklist="${directory_blacklist}/${name_file_blacklist}"

# display the detected module

frobulator.inf "Watchdog module" "[ ${label_module} ]"

# avoid duplicate blacklist entries

# existing module blacklist line - empty if not blacklisted yet

line_blacklist="$(grep -F -x "blacklist ${module}" "${path_blacklist}" 2> "${sink}")"

if [ -n "${line_blacklist}" ]
then
	frobulator.fwd "Module already blacklisted" "[ ${label_module} ]"

	exit 0
fi

# blacklist module

frobulator.write "append" "blacklist ${module}" "${directory_blacklist}" "${name_file_blacklist}"

frobulator.complete halt "Failed to write blacklist entry" "[ ${path_blacklist} ]"

frobulator.complete

frobulator.inf "Module blacklisted" "[ ${label_module} ]"

# rebuild the initramfs

frobulator.silence "update-initramfs -u" &

frobulator.progress rebuild "[ initramfs ]"

frobulator.complete halt "Failed to rebuild initramfs."

frobulator.complete

frobulator.inf "Watchdog disabled."

frobulator.wrn "Change takes effect after next reboot."

frobulator.scs "Done"
