#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-b|--backup)
			option="backup"
		;;

		-r|--restore)
			option="restore"
		;;

		-c|--commands)
			option="commands"
		;;

		-d|--directory)
			directory="${2}"

			shift
		;;

		-k|--key)
			file_identity_key="${2}"

			shift
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -b | -r | -c [-d [Directory]] [-k [File]] | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-b, --backup       Run [b]ackup of paired devices into the directory."
			echo
			echo -e "-r, --restore      Run [r]estore of paired devices from the directory."
			echo
			echo -e "-c, --commands     Apply the run [c]ommands list to every paired device."
			echo
			echo -e "-d, --directory    Specify device files [d]irectory."
			echo
			echo -e "                   [ script directory ] [ Default ]"
			echo
			echo -e "-k, --key          Specify this computer's private [k]ey file."
			echo
			echo -e "                   [ /media/internal/.kde-connect-key ] [ Default ]"
			echo -e "                   [ private - never a public repository ]"
			echo
			echo -e "-h, --help         Show [h]elp and usage information."
			echo
			echo -e "'${script}'     [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -b | -r | -c [-d [Directory]] [-k [File]] | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

directory_kde_connect="${HOME}/.config/kdeconnect"

file_trusted_devices="${directory_kde_connect}/trusted_devices"

# dolphin places: one kdeconnect bookmark per device

file_places="${HOME}/.local/share/user-places.xbel"

# this computer's identity: private key kept out of the repository

file_identity_key_default="/media/internal/.kde-connect-key"

# plugin configuration for devices restored without one

list_config_default=(
	"[Plugins]"
	"kdeconnect_notificationsEnabled=false"
	"kdeconnect_telephonyEnabled=false"
)

declare -A list_names_device
declare -A list_types_device
declare -A list_certificates_device

list_order_device=()

# defaults ─────────────────────────────────────────────────────────────────────

if [ -z "${option}" ]
then
	frobulator.err "Missing operation."
	frobulator.nul "Specify '--backup' / '--restore' or '--commands'."

	exit 1

elif [[ "${directory}" = -* ]]
then
	frobulator.err "Missing argument for '--directory'."

	exit 1

elif [[ "${file_identity_key}" = -* ]]
then
	frobulator.err "Missing argument for '--key'."

	exit 1
fi

# device files are kept in the repository holding this script

if [ -z "${directory}" ]
then
	file_script="$(readlink -f -- "${BASH_SOURCE[0]}")"

	directory="$(dirname -- "${file_script}")"
fi

directory="${directory%/}"

file_device_index="${directory}/kde-connect-devices-list"

# run commands offered to every paired device: name and command - tab separated

file_commands_list="${directory}/kde-connect-commands-list"

file_identity_certificate="${directory}/kde-connect-certificate.pem"
file_identity_config="${directory}/kde-connect-config"

file_identity_key="${file_identity_key:-${file_identity_key_default}}"

# functions ────────────────────────────────────────────────────────────────────

device_file_name () {

	# device name as file name part: lowercase - spaces as '-' - safe characters only

	local name_device="${1,,}"

	name_device="${name_device// /-}"
	name_device="${name_device//[^a-z0-9_-]/}"

	echo "${name_device:-device}"
}

devices_read () {

	# trusted devices from kde connect configuration

	local line_device
	local id_device
	local certificate_device

	if [ ! -f "${file_trusted_devices}" ]
	then
		frobulator.err "Backup failure - no paired devices" "[ '${file_trusted_devices}'${marker_spc}${marker_hnt}${marker_spc}none ]"

		return 1
	fi

	while IFS= read -r line_device
	do
		if [[ "${line_device}" =~ ^\[(.+)\]$ ]]
		then
			id_device="${BASH_REMATCH[1]}"

			list_order_device+=("${id_device}")

		elif [[ "${line_device}" = name=* ]]
		then
			list_names_device["${id_device}"]="${line_device#name=}"

		elif [[ "${line_device}" = type=* ]]
		then
			list_types_device["${id_device}"]="${line_device#type=}"

		elif [[ "${line_device}" = certificate=* ]]
		then
			# stored on one line: quoted if padded - newlines escaped as '\n'

			certificate_device="${line_device#certificate=}"
			certificate_device="${certificate_device#\"}"
			certificate_device="${certificate_device%\"}"

			list_certificates_device["${id_device}"]="${certificate_device//\\n/${NLN}}"
		fi
	done < "${file_trusted_devices}"
}

index_tabs () {

	# tabs from a text position to a column - tab width 4

	local position_index="${1}"
	local column_index="${2}"
	local count_tabs_index=$(( ( column_index - position_index / 4 * 4 ) / 4 ))

	while [ "${count_tabs_index}" -gt 0 ]
	do
		printf '\t'

		count_tabs_index=$(( count_tabs_index - 1 ))
	done
}

devices_backup () {

	local status_backup=0

	local width_label_index
	local column_label_index
	local id_device
	local name_device
	local file_device
	local name_certificate_device

	devices_read || return

	# index columns aligned on tab stops (tab width 4):
	# label column one tab wider than the longest label: label / id / type

	width_label_index=0

	for id_device in "${list_order_device[@]}"
	do
		name_device="$(device_file_name "${list_names_device[${id_device}]}")"

		if [ "${#name_device}" -gt "${width_label_index}" ]
		then
			width_label_index="${#name_device}"
		fi
	done

	column_label_index=$(( ( width_label_index / 4 + 2 ) * 4 ))

	: > "${file_device_index}"

	for id_device in "${list_order_device[@]}"
	do
		name_device="$(device_file_name "${list_names_device[${id_device}]}")"

		name_certificate_device="kde-connect-device-${name_device}.pem"

		# certificate: public key the device paired with

		file_device="${directory}/${name_certificate_device}"

		printf '%s\n' "${list_certificates_device[${id_device}]%${NLN}}" > "${file_device}"

		if [ "${?}" -ne 0 ]
		then
			frobulator.err "Backup failure - certificate" "[ '${name_certificate_device}'${marker_spc}${marker_hnt}${marker_spc}${id_device:0:8} ]"

			status_backup=1

			continue
		fi

		# plugin settings: run commands / clipboard / enabled plugins
		# archive holds the device id directory itself

		if [ -d "${directory_kde_connect}/${id_device}" ]
		then
			frobulator.archive "${directory}/kde-connect-settings-${name_device}" "tar.gz" "${directory_kde_connect}/${id_device}"

			if [ "${?}" -ne 0 ]
			then
				frobulator.err "Backup failure - settings" "[ '${name_device}'${marker_spc}${marker_hnt}${marker_spc}${id_device:0:8} ]"

				status_backup=1
			fi
		fi

		printf '%s%s%s\t%s\n' "${name_device}" "$(index_tabs "${#name_device}" "${column_label_index}")" "${id_device}" "${list_types_device[${id_device}]}" >> "${file_device_index}"

		frobulator.scs "Backup success - device" "[ '${list_names_device[${id_device}]}'${marker_spc}${marker_hnt}${marker_spc}${id_device:0:8} ]"
	done

	return "${status_backup}"
}

identity_backup () {

	# certificate and name into the directory - private key to its private file

	frobulator.directory "$(dirname -- "${file_identity_key}")"

	cp -f "${directory_kde_connect}/privateKey.pem" "${file_identity_key}" &&
	cp -f "${directory_kde_connect}/certificate.pem" "${file_identity_certificate}" &&
	cp -f "${directory_kde_connect}/config" "${file_identity_config}"

	if [ "${?}" -ne 0 ]
	then
		frobulator.err "Backup failure - identity" "[ '${file_identity_key##*/}'${marker_spc}${marker_hnt}${marker_spc}private ]"

		return 1
	fi

	frobulator.permissions private "${file_identity_key}" > "${sink}"

	frobulator.scs "Backup success - identity" "[ '${file_identity_key##*/}'${marker_spc}${marker_hnt}${marker_spc}private ]"
}

service_stop () {

	# this user's kde connect service process id - empty if not running

	local id_process_service

	id_process_service="$(pgrep -x -u "${USER}" kdeconnectd)"

	if [ -n "${id_process_service}" ]
	then
		frobulator.stp "Stopping" "[ kdeconnectd ]"

		pkill -x -u "${USER}" kdeconnectd

		sleep 2
	fi
}

service_start () {

	# kde connect service starts on demand through its command line client

	frobulator.fwd "Starting" "[ kdeconnectd ]"

	kdeconnect-cli --refresh > "${sink}" 2>&1

	sleep 3
}

devices_restore () {

	local status_restore=0

	local name_device
	local id_device
	local type_device
	local file_device
	local certificate_device

	if [ ! -f "${file_device_index}" ]
	then
		frobulator.err "Restore failure - no device index" "[ '${file_device_index}'${marker_spc}${marker_hnt}${marker_spc}none ]"

		return 1
	fi

	# keep devices already paired on this computer - replace those being restored

	if [ -f "${file_trusted_devices}" ]
	then
		devices_read
	fi

	while IFS=$'\t' read -r name_device id_device type_device
	do
		file_device="${directory}/kde-connect-device-${name_device}.pem"

		if [ ! -f "${file_device}" ]
		then
			frobulator.err "Restore failure - certificate" "[ 'kde-connect-device-${name_device}.pem'${marker_spc}${marker_hnt}${marker_spc}missing ]"

			status_restore=1

			continue
		fi

		certificate_device="$(< "${file_device}")"

		if [ -z "${list_certificates_device[${id_device}]+set}" ]
		then
			list_order_device+=("${id_device}")
		fi

		list_names_device["${id_device}"]="${name_device}"
		list_types_device["${id_device}"]="${type_device}"
		list_certificates_device["${id_device}"]="${certificate_device}${NLN}"

		# plugin settings

		if [ -f "${directory}/kde-connect-settings-${name_device}.tar.gz" ]
		then
			frobulator.extract "${directory}/kde-connect-settings-${name_device}.tar.gz" "${directory_kde_connect}"

			if [ "${?}" -ne 0 ]
			then
				frobulator.err "Restore failure - settings" "[ '${name_device}'${marker_spc}${marker_hnt}${marker_spc}${id_device:0:8} ]"

				status_restore=1
			fi
		fi

		# default plugin configuration when the device has none

		if [ ! -f "${directory_kde_connect}/${id_device}/config" ]
		then
			mkdir -p "${directory_kde_connect}/${id_device}"

			printf '%s\n' "${list_config_default[@]}" > "${directory_kde_connect}/${id_device}/config"
		fi

		frobulator.scs "Restore success - device" "[ '${list_names_device[${id_device}]}'${marker_spc}${marker_hnt}${marker_spc}${id_device:0:8} ]"
	done < "${file_device_index}"

	# trusted devices written back in kde connect format

	for id_device in "${list_order_device[@]}"
	do
		certificate_device="${list_certificates_device[${id_device}]}"

		echo "[${id_device}]"
		echo "certificate=${certificate_device//${NLN}/\\n}"
		echo "name=${list_names_device[${id_device}]}"
		echo "type=${list_types_device[${id_device}]}"
		echo
	done > "${file_trusted_devices}"

	return "${status_restore}"
}

identity_restore () {

	if [ ! -f "${file_identity_key}" ] || [ ! -f "${file_identity_certificate}" ]
	then
		frobulator.wrn "Identity not restored - key or certificate missing" "[ '${file_identity_key##*/}'${marker_spc}${marker_hnt}${marker_spc}missing ]"
		frobulator.nul "Devices will need to pair again with this computer."

		return 0
	fi

	cp -f "${file_identity_key}" "${directory_kde_connect}/privateKey.pem" &&
	cp -f "${file_identity_certificate}" "${directory_kde_connect}/certificate.pem"

	if [ "${?}" -ne 0 ]
	then
		frobulator.err "Restore failure - identity" "[ '${file_identity_key##*/}'${marker_spc}${marker_hnt}${marker_spc}private ]"

		return 1
	fi

	if [ -f "${file_identity_config}" ]
	then
		cp -f "${file_identity_config}" "${directory_kde_connect}/config"
	fi

	frobulator.permissions private "${directory_kde_connect}/privateKey.pem" "${directory_kde_connect}/certificate.pem" > "${sink}"

	frobulator.scs "Restore success - identity" "[ '${file_identity_key##*/}'${marker_spc}${marker_hnt}${marker_spc}private ]"
}

places_update () {

	# add a dolphin place for every paired device that has none

	local status=0
	local index_places=0

	local content_places
	local list_entries_places
	local stamp_places
	local id_device
	local title_device

	if [ ! -f "${file_places}" ]
	then
		frobulator.wrn "Places not updated - no dolphin places file" "[ '${file_places##*/}'${marker_spc}${marker_hnt}${marker_spc}missing ]"
		frobulator.nul "Open dolphin once, then run the restore again."

		return 0
	fi

	content_places="$(< "${file_places}")"
	stamp_places="$(date +%s)"

	for id_device in "${list_order_device[@]}"
	do
		if [[ "${content_places}" = *"href=\"kdeconnect://${id_device}/\""* ]]
		then
			frobulator.inf "Place present - device" "[ '${list_names_device[${id_device}]}'${marker_spc}${marker_hnt}${marker_spc}${id_device:0:8} ]"

			continue
		fi

		# title escaped for xml

		title_device="${list_names_device[${id_device}]//&/&amp;}"
		title_device="${title_device//</&lt;}"
		title_device="${title_device//>/&gt;}"

		list_entries_places+=" <bookmark href=\"kdeconnect://${id_device}/\">${NLN}"
		list_entries_places+="  <title>${title_device}</title>${NLN}"
		list_entries_places+="  <info>${NLN}"
		list_entries_places+="   <metadata owner=\"http://freedesktop.org\">${NLN}"
		list_entries_places+="    <bookmark:icon name=\"kdeconnect\"/>${NLN}"
		list_entries_places+="   </metadata>${NLN}"
		list_entries_places+="   <metadata owner=\"http://www.kde.org\">${NLN}"
		list_entries_places+="    <ID>${stamp_places}/${index_places}</ID>${NLN}"
		list_entries_places+="   </metadata>${NLN}"
		list_entries_places+="  </info>${NLN}"
		list_entries_places+=" </bookmark>${NLN}"

		index_places=$(( index_places + 1 ))

		frobulator.add "Place added - device" "[ '${list_names_device[${id_device}]}'${marker_spc}${marker_hnt}${marker_spc}${id_device:0:8} ]"
	done

	if [ -z "${list_entries_places}" ]
	then
		return 0
	fi

	# new entries go right before the closing tag

	if [[ "${content_places}" != *"</xbel>"* ]]
	then
		frobulator.err "Places failure - unexpected file format" "[ '${file_places##*/}'${marker_spc}${marker_hnt}${marker_spc}xbel ]"

		return 1
	fi

	printf '%s%s</xbel>\n' "${content_places%</xbel>*}" "${list_entries_places}" > "${file_places}"

	frobulator.track

	return "${status}"
}

commands_apply () {

	# same run commands on every paired device - written as kde connect stores them:
	# json object of '_uuid_' keys inside @ByteArray - keys derived from the command name

	local status=0

	local name_command
	local line_command
	local hash_command
	local key_command
	local json_commands
	local value_commands
	local id_device
	local directory_run_command

	if [ ! -f "${file_commands_list}" ]
	then
		frobulator.wrn "Run commands not applied - no commands list" "[ '${file_commands_list##*/}'${marker_spc}${marker_hnt}${marker_spc}missing ]"

		return 0
	fi

	json_commands="{"

	while IFS=$'\t' read -r name_command line_command
	do
		if [ -z "${name_command}" ] || [[ "${name_command}" = \#* ]]
		then
			continue
		fi

		# stable key from the name - unchanged commands keep their key

		hash_command="$(printf '%s' "${name_command}" | md5sum)"
		key_command="_${hash_command:0:8}_${hash_command:8:4}_${hash_command:12:4}_${hash_command:16:4}_${hash_command:20:12}_"

		# json string escaping: backslash then quote

		name_command="${name_command//\\/\\\\}"
		name_command="${name_command//\"/\\\"}"
		line_command="${line_command//\\/\\\\}"
		line_command="${line_command//\"/\\\"}"

		if [ "${json_commands}" != "{" ]
		then
			json_commands+=","
		fi

		json_commands+="\"${key_command}\":{\"command\":\"${line_command}\",\"name\":\"${name_command}\"}"
	done < "${file_commands_list}"

	json_commands+="}"

	# kde config value: quoted - backslashes and quotes escaped again

	value_commands="${json_commands//\\/\\\\}"
	value_commands="${value_commands//\"/\\\"}"

	for id_device in "${list_order_device[@]}"
	do
		directory_run_command="${directory_kde_connect}/${id_device}/kdeconnect_runcommand"

		mkdir -p "${directory_run_command}"

		printf '[General]\ncommands="@ByteArray(%s)"\n' "${value_commands}" > "${directory_run_command}/config"

		frobulator.track || continue

		frobulator.scs "Run commands applied - device" "[ '${list_names_device[${id_device}]}'${marker_spc}${marker_hnt}${marker_spc}${id_device:0:8} ]"
	done

	return "${status}"
}

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(

)

frobulator.require ${list[@]}

list=()

# configuration ────────────────────────────────────────────────────────────────

# kde connect command line client - empty if not installed

command_kde_connect="$(command -v kdeconnect-cli)"

if [ -z "${command_kde_connect}" ]
then
	frobulator.err "KDE Connect not installed" "[ kdeconnect-cli ]"

	exit 1
fi

if [ ! -d "${directory}" ]
then
	frobulator.err "Directory not found" "[ ${directory} ]"

	exit 1
fi

frobulator.inf "Device files directory" "[ ${directory} ]"

if [ "${option}" = "backup" ]
then
	devices_backup

	frobulator.complete continue "Backup failure - devices"

	identity_backup

	frobulator.complete continue "Backup failure - identity"

elif [ "${option}" = "restore" ]
then
	frobulator.directory "${directory_kde_connect}"

	service_stop

	identity_restore

	frobulator.complete continue "Restore failure - identity"

	devices_restore

	frobulator.complete continue "Restore failure - devices"

	commands_apply

	frobulator.complete continue "Run commands failure - devices"

	frobulator.ownership "${directory_kde_connect}"

	service_start

	places_update

	frobulator.complete continue "Places failure - devices"

	frobulator.inf "Paired devices"

	kdeconnect-cli --list-devices 2> "${sink}"

elif [ "${option}" = "commands" ]
then
	service_stop

	devices_read

	frobulator.complete halt "Run commands failure - no paired devices"

	commands_apply

	frobulator.complete continue "Run commands failure - devices"

	frobulator.ownership "${directory_kde_connect}" > "${sink}"

	service_start
fi

frobulator.result "${script}"
