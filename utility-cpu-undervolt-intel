#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-11"

# usage ────────────────────────────────────────────────────────────────────────

# voltage offsets per plane - name=millivolts - applied in the order given

declare -A offsets_plane=()

list_planes_order=()

while (( $# ))
do
	case "${1}"
	in
		-r|--read)
			option_read="true"
		;;

		-c|--core|-g|--gpu|-k|--cache|-u|--uncore|-a|--analogio)
			case "${1}"
			in
				-c|--core)		name_plane="core" ;;
				-g|--gpu)		name_plane="gpu" ;;
				-k|--cache)		name_plane="cache" ;;
				-u|--uncore)	name_plane="uncore" ;;
				-a|--analogio)	name_plane="analogio" ;;
			esac

			offsets_plane["${name_plane}"]="${2}"
			list_planes_order+=("${name_plane}")

			shift
		;;

		-f|--force)
			option_force="true"
		;;

		-t|--temperature)
			temperature_target="${2}"

			shift
		;;

		-l|--power-long)
			power_long="${2}"
			seconds_long="${3}"

			shift 2
		;;

		-s|--power-short)
			power_short="${2}"
			seconds_short="${3}"

			shift 2
		;;

		-L|--lock-power)
			option_lock_power="true"
		;;

		-b|--turbo)
			state_turbo="${2}"

			shift
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -r | [-c mV] [-g mV] [-k mV] [-u mV] [-a mV] [-f] [-t Celsius] [-l Watts Seconds] [-s Watts Seconds] [-L] [-b on|off] | -h"
			echo
			echo -e "Note:                 Settings last until the next reboot. Intel core processors 6th to 10th generation."
			echo -e "                      Voltage changes are refused while SGX is enabled in the bios."
			echo
			echo -e "                      1. Disable SGX in the bios."
			echo -e "                      2. Run '${script} -r' - offsets read back as numbers: voltage interface open."
			echo -e "                      3. Step down gradually - '-c -50 -k -50' then '-c -80 -k -80' - stress test after each step."
			echo
			echo -e "Options:"
			echo
			echo -e "-r, --read            [R]ead temperature target, voltage offsets, power limits and turbo state."
			echo
			echo -e "-c, --core            Voltage offset of the processor [c]ores - millivolts - negative to undervolt."
			echo
			echo -e "-g, --gpu             Voltage offset of the integrated [g]raphics - millivolts."
			echo
			echo -e "-k, --cache           Voltage offset of the [k]ache - millivolts - keep equal to the core offset."
			echo
			echo -e "-u, --uncore          Voltage offset of the [u]ncore - system agent - millivolts."
			echo
			echo -e "-a, --analogio        Voltage offset of the [a]nalog input / output - millivolts."
			echo
			echo -e "-f, --force           [F]orce positive voltage offsets - overvolting."
			echo
			echo -e "-t, --temperature     Processor [t]emperature target - degrees celsius - throttling starts there."
			echo
			echo -e "-l, --power-long      Sustained power [l]imit - watts and time window in seconds."
			echo
			echo -e "-s, --power-short     [S]hort term power limit - watts and time window in seconds."
			echo
			echo -e "-L, --lock-power      [L]ock the power limits until the next reboot."
			echo
			echo -e "-b, --turbo           Turbo [b]oost on or off."
			echo
			echo -e "                      [ on | off ]"
			echo
			echo -e "-h, --help            Show [h]elp and usage information."
			echo
			echo -e "'${script}'           [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -r | [-c mV] [-g mV] [-k mV] [-u mV] [-a mV] [-f] [-t Celsius] [-l Watts Seconds] [-s Watts Seconds] [-L] [-b on|off] | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

# model specific registers - intel core 6th to 10th generation

address_voltage=0x150
address_units=0x606
address_power=0x610
address_temperature=0x1a2

file_turbo=/sys/devices/system/cpu/intel_pstate/no_turbo

directory_cpu="/dev/cpu"
name_msr="msr"
index_processor_first="0"
prefix_hexadecimal="0x"
format_register="0x%016x"
format_offset="%s%d.%02d"
format_seconds="%d.%03d"
format_padding="%-3.3s"
digits_padding="000"
separator_values=" // "
text_locked=" // locked"
text_enabled="enabled"
text_disabled="disabled"
unit_voltage="mV"
unit_watts="W"
unit_seconds="s"
unit_celsius="C"
state_on="on"
state_off="off"
value_turbo_enabled="0"
value_turbo_disabled="1"
pattern_integer_signed='^-?[0-9]+$'
pattern_integer='^[0-9]+$'
pattern_seconds='^[0-9]+(\.[0-9]{1,3})?$'
limit_millivolts_minimum="-500"
limit_millivolts_maximum="500"
limit_temperature_offset="63"
limit_power_raw="0x7FFF"

# register fields - bit positions, shifts and masks

position_bit_request="63"
position_bit_command_read="36"
position_bit_command_write="32"
position_bit_long_enable="15"
position_bit_short_enable="47"
position_bit_lock="63"
shift_plane="40"
shift_offset="21"
shift_unit_time="16"
shift_time_long="17"
shift_power_short="32"
shift_time_short="49"
shift_fraction="5"
shift_temperature_maximum="16"
shift_temperature_offset="24"
mask_steps=0xFFF
mask_offset=0xFFE00000
mask_word=0xFFFFFFFF
mask_exponent=0x1F
mask_fraction=0x3
mask_unit=0xF
mask_power_limit=0x7FFF
mask_power_window=0xFFFFFF
mask_time=0x7F
mask_byte=0xFF
mask_temperature_offset=0x7F

# offset and time window math

count_steps_half="1024"
count_steps_full="2048"
count_steps_scale="1024"
count_rounding="500"
count_thousand="1000"
count_hundred="100"
count_hundredths_scale="100000"
count_fraction_base="4"
count_exponent_maximum="31"
count_fraction_maximum="3"

# voltage plane indexes in the voltage mailbox

declare -A index_plane=(
	[core]=0
	[gpu]=1
	[cache]=2
	[uncore]=3
	[analogio]=4
)

list_planes=(
	core
	gpu
	cache
	uncore
	analogio
)

# defaults ─────────────────────────────────────────────────────────────────────

# functions ────────────────────────────────────────────────────────────────────

msr_read () {

	# register value on the first processor - 16 hex digits

	local address_register="${1}"
	local value_register

	value_register="$(rdmsr --processor "${index_processor_first}" --zero-pad "${address_register}" 2> "${sink}")"

	echo "${prefix_hexadecimal}${value_register}"
}

msr_write () {

	# register value written on every processor

	local address_register="${1}"
	local value_register="${2}"
	local text_value

	printf -v text_value "${format_register}" "${value_register}"

	wrmsr --all "${address_register}" "${text_value}" 2> "${sink}"
}

offset_encode () {

	# millivolts to the 11 bit offset field - steps of 1/1.024 millivolt - bits 21 to 31

	local millivolts="${1}"
	local steps
	local scaled=$(( millivolts * count_steps_scale ))

	if [ "${scaled}" -ge 0 ]
	then
		steps=$(( (scaled + count_rounding) / count_thousand ))
	else
		steps=$(( - ((- scaled + count_rounding) / count_thousand) ))
	fi

	echo $(( ((steps & mask_steps) << shift_offset) & mask_offset ))
}

offset_decode () {

	# offset field to millivolts - two decimals

	local value_offset="${1}"
	local steps=$(( (value_offset & mask_word) >> shift_offset ))
	local hundredths
	local sign=""
	local sign_negative="-"
	local whole
	local fraction

	if [ "${steps}" -gt "${count_steps_half}" ]
	then
		steps=$(( - (count_steps_full - steps) ))
	fi

	hundredths=$(( steps * count_hundredths_scale / count_steps_scale ))

	if [ "${hundredths}" -lt 0 ]
	then
		sign="${sign_negative}"
		hundredths=$(( - hundredths ))
	fi

	whole=$(( hundredths / count_hundred ))
	fraction=$(( hundredths % count_hundred ))

	printf "${format_offset}" "${sign}" "${whole}" "${fraction}"
}

offset_read () {

	# read request written to the mailbox - answer read back

	local name_plane="${1}"
	local value_request=$(( (1 << position_bit_request) | (index_plane[${name_plane}] << shift_plane) | (1 << position_bit_command_read) ))
	local value_answer

	msr_write "${address_voltage}" "${value_request}"

	value_answer="$(msr_read "${address_voltage}")"

	offset_decode "${value_answer}"
}

offset_write () {

	# write request with the offset - read back to confirm

	local name_plane="${1}"
	local millivolts="${2}"
	local value_offset
	local value_request
	local millivolts_wanted
	local millivolts_read

	value_offset="$(offset_encode "${millivolts}")"
	value_request=$(( (1 << position_bit_request) | (index_plane[${name_plane}] << shift_plane) | (1 << position_bit_command_read) | (1 << position_bit_command_write) | value_offset ))

	msr_write "${address_voltage}" "${value_request}"

	millivolts_wanted="$(offset_decode "${value_offset}")"
	millivolts_read="$(offset_read "${name_plane}")"

	if [ "${millivolts_wanted}" != "${millivolts_read}" ]
	then
		frobulator.err "Voltage offset refused - SGX enabled or interface locked" "[ ${name_plane}${separator_values}set ${millivolts_wanted} ${unit_voltage}${separator_values}read ${millivolts_read} ${unit_voltage} ]"

		return 1
	fi

	frobulator.scs "Voltage offset applied" "[ ${name_plane}${separator_values}${millivolts_read} ${unit_voltage} ]"
}

seconds_format () {

	# time window field to seconds - 2^y * (1 + z/4) / time unit - three decimals

	local field_time="${1}"
	local unit_time="${2}"
	local exponent=$(( field_time & mask_exponent ))
	local fraction=$(( (field_time >> shift_fraction) & mask_fraction ))
	local milliseconds=$(( (1 << exponent) * (count_fraction_base + fraction) * count_thousand / (count_fraction_base * unit_time) ))
	local whole
	local remainder

	whole=$(( milliseconds / count_thousand ))
	remainder=$(( milliseconds % count_thousand ))

	printf "${format_seconds}" "${whole}" "${remainder}"
}

seconds_encode () {

	# seconds to the closest 2^y * (1 + z/4) time window field - y up to 31 - z up to 3

	local seconds="${1}"
	local unit_time="${2}"
	local milliseconds
	local target
	local exponent
	local fraction
	local candidate
	local error
	local decimals
	local error_best=-1
	local field_best=0

	# whole seconds or up to three decimals

	if [[ "${seconds}" = *.* ]]
	then
		decimals="${seconds#*.}${digits_padding}"
		decimals="${decimals:0:3}"

		milliseconds=$(( 10#${seconds%%.*} * count_thousand + 10#${decimals} ))
	else
		milliseconds=$(( 10#${seconds} * count_thousand ))
	fi

	# compared in quarters - 2^y * (4 + z)

	target=$(( milliseconds * unit_time * count_fraction_base / count_thousand ))

	for (( exponent = 0 ; exponent <= count_exponent_maximum ; exponent ++ ))
	do
		for (( fraction = 0 ; fraction <= count_fraction_maximum ; fraction ++ ))
		do
			candidate=$(( (1 << exponent) * (count_fraction_base + fraction) ))
			error=$(( candidate - target ))
			error=$(( error < 0 ? - error : error ))

			if [ "${error_best}" -lt 0 ] || [ "${error}" -lt "${error_best}" ]
			then
				error_best="${error}"
				field_best=$(( (fraction << shift_fraction) | exponent ))
			fi
		done
	done

	echo "${field_best}"
}

power_read () {

	# power limit register - long term bits 0 to 23 - short term bits 32 to 55 - lock bit 63

	local value_units
	local value_power
	local unit_power
	local unit_time
	local text_lock=""
	local text_long_state="${text_disabled}"
	local text_short_state="${text_disabled}"
	local bit_long
	local bit_short
	local bit_lock
	local watts_long
	local watts_short
	local field_time_long
	local field_time_short
	local text_seconds_long
	local text_seconds_short

	value_units="$(msr_read "${address_units}")"
	value_power="$(msr_read "${address_power}")"

	unit_power=$(( 1 << (value_units & mask_unit) ))
	unit_time=$(( 1 << ((value_units >> shift_unit_time) & mask_unit) ))

	bit_long=$(( (value_power >> position_bit_long_enable) & 1 ))
	bit_short=$(( (value_power >> position_bit_short_enable) & 1 ))
	bit_lock=$(( (value_power >> position_bit_lock) & 1 ))

	if [ "${bit_long}" -eq 1 ]
	then
		text_long_state="${text_enabled}"
	fi

	if [ "${bit_short}" -eq 1 ]
	then
		text_short_state="${text_enabled}"
	fi

	if [ "${bit_lock}" -eq 1 ]
	then
		text_lock="${text_locked}"
	fi

	watts_long=$(( (value_power & mask_power_limit) / unit_power ))
	field_time_long=$(( (value_power >> shift_time_long) & mask_time ))
	text_seconds_long="$(seconds_format "${field_time_long}" "${unit_time}")"

	watts_short=$(( ((value_power >> shift_power_short) & mask_power_limit) / unit_power ))
	field_time_short=$(( (value_power >> shift_time_short) & mask_time ))
	text_seconds_short="$(seconds_format "${field_time_short}" "${unit_time}")"

	frobulator.inf "Power limit - sustained" "[ ${watts_long} ${unit_watts}${separator_values}${text_seconds_long} ${unit_seconds}${separator_values}${text_long_state}${text_lock} ]"
	frobulator.inf "Power limit - short term" "[ ${watts_short} ${unit_watts}${separator_values}${text_seconds_short} ${unit_seconds}${separator_values}${text_short_state}${text_lock} ]"
}

power_write () {

	# limits not given keep their current values - reserved bits kept

	local value_units
	local value_power
	local value_written
	local value_check
	local unit_power
	local unit_time
	local raw_power
	local field_time
	local bit_lock

	value_units="$(msr_read "${address_units}")"
	value_power="$(msr_read "${address_power}")"

	bit_lock=$(( (value_power >> position_bit_lock) & 1 ))

	if [ "${bit_lock}" -eq 1 ]
	then
		frobulator.err "Power limits locked until the next reboot"

		return 1
	fi

	unit_power=$(( 1 << (value_units & mask_unit) ))
	unit_time=$(( 1 << ((value_units >> shift_unit_time) & mask_unit) ))

	value_written=$(( value_power ))

	if [ -n "${power_long}" ]
	then
		raw_power=$(( power_long * unit_power ))

		if [ "${raw_power}" -le 0 ] || [ "${raw_power}" -gt "${limit_power_raw}" ]
		then
			frobulator.err "Sustained power limit out of range" "[ ${power_long} ${unit_watts} ]"

			return 1
		fi

		field_time="$(seconds_encode "${seconds_long}" "${unit_time}")"

		value_written=$(( (value_written & ~mask_power_window) | raw_power | (1 << position_bit_long_enable) | (field_time << shift_time_long) ))
	fi

	if [ -n "${power_short}" ]
	then
		raw_power=$(( power_short * unit_power ))

		if [ "${raw_power}" -le 0 ] || [ "${raw_power}" -gt "${limit_power_raw}" ]
		then
			frobulator.err "Short term power limit out of range" "[ ${power_short} ${unit_watts} ]"

			return 1
		fi

		field_time="$(seconds_encode "${seconds_short}" "${unit_time}")"

		value_written=$(( (value_written & ~(mask_power_window << shift_power_short)) | (raw_power << shift_power_short) | (1 << position_bit_short_enable) | (field_time << shift_time_short) ))
	fi

	if [ "${option_lock_power}" = "true" ]
	then
		value_written=$(( value_written | (1 << position_bit_lock) ))
	fi

	msr_write "${address_power}" "${value_written}"

	value_check="$(msr_read "${address_power}")"
	value_check=$(( value_check ))

	if [ "${value_check}" -ne "${value_written}" ]
	then
		frobulator.err "Power limit refused"

		return 1
	fi

	frobulator.scs "Power limit applied"

	power_read
}

temperature_read () {

	# maximum junction temperature in bits 16 to 23 - target offset below it in bits 24 to 30

	local value_temperature
	local maximum
	local offset
	local target

	value_temperature="$(msr_read "${address_temperature}")"

	maximum=$(( (value_temperature >> shift_temperature_maximum) & mask_byte ))
	offset=$(( (value_temperature >> shift_temperature_offset) & mask_temperature_offset ))
	target=$(( maximum - offset ))

	frobulator.inf "Temperature target" "[ ${target} ${unit_celsius}${separator_values}maximum ${maximum} ${unit_celsius} ]"
}

temperature_write () {

	local value_temperature
	local value_written
	local value_check
	local maximum
	local offset

	value_temperature="$(msr_read "${address_temperature}")"

	maximum=$(( (value_temperature >> shift_temperature_maximum) & mask_byte ))
	offset=$(( maximum - temperature_target ))

	if [ "${offset}" -lt 0 ] || [ "${offset}" -gt "${limit_temperature_offset}" ]
	then
		frobulator.err "Temperature target out of range" "[ ${temperature_target} ${unit_celsius}${separator_values}maximum ${maximum} ${unit_celsius} ]"

		return 1
	fi

	value_written=$(( (value_temperature & ~(mask_temperature_offset << shift_temperature_offset)) | (offset << shift_temperature_offset) ))

	msr_write "${address_temperature}" "${value_written}"

	value_check="$(msr_read "${address_temperature}")"
	value_check=$(( (value_check >> shift_temperature_offset) & mask_temperature_offset ))

	if [ "${value_check}" -ne "${offset}" ]
	then
		frobulator.err "Temperature target refused"

		return 1
	fi

	frobulator.scs "Temperature target applied" "[ ${temperature_target} ${unit_celsius} ]"
}

turbo_read () {

	local state_turbo_current="${state_on}"
	local value_turbo

	value_turbo="$(cat "${file_turbo}" 2> "${sink}")"

	if [ "${value_turbo}" = "${value_turbo_disabled}" ]
	then
		state_turbo_current="${state_off}"
	fi

	frobulator.inf "Turbo boost" "[ ${state_turbo_current} ]"
}

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(
	msr-tools
)

frobulator.require ${list[@]}

frobulator.complete

list=()

# validation ───────────────────────────────────────────────────────────────────

count_actions=$(( ${#list_planes_order[@]} ))

for value_check in "${option_read}" "${temperature_target}" "${power_long}" "${power_short}" "${option_lock_power}" "${state_turbo}"
do
	if [ -n "${value_check}" ]
	then
		count_actions=$(( count_actions + 1 ))
	fi
done

if [ "${count_actions}" -eq 0 ]
then
	frobulator.err "Missing operation."
	frobulator.nul "Type './${script} -h' for help and usage information."

	exit 1
fi

for name_plane in "${list_planes_order[@]}"
do
	millivolts="${offsets_plane[${name_plane}]}"

	if [[ ! "${millivolts}" =~ ${pattern_integer_signed} ]]
	then
		frobulator.err "Offset in whole millivolts" "[ ${name_plane}${separator_values}${millivolts} ]"

		exit 1
	fi

	if [ "${millivolts}" -gt 0 ] && [ "${option_force}" != "true" ]
	then
		frobulator.err "Positive offset needs --force" "[ ${name_plane}${separator_values}${millivolts} ${unit_voltage} ]"

		exit 1
	fi

	if [ "${millivolts}" -lt "${limit_millivolts_minimum}" ] || [ "${millivolts}" -gt "${limit_millivolts_maximum}" ]
	then
		frobulator.err "Offset out of range - ${limit_millivolts_minimum} to ${limit_millivolts_maximum} ${unit_voltage}" "[ ${name_plane}${separator_values}${millivolts} ${unit_voltage} ]"

		exit 1
	fi
done

for value_check in "${temperature_target}" "${power_long}" "${power_short}"
do
	if [ -n "${value_check}" ] && [[ ! "${value_check}" =~ ${pattern_integer} ]]
	then
		frobulator.err "Whole number expected" "[ ${value_check} ]"

		exit 1
	fi
done

for value_check in "${seconds_long}" "${seconds_short}"
do
	if [ -n "${value_check}" ] && [[ ! "${value_check}" =~ ${pattern_seconds} ]]
	then
		frobulator.err "Time window in seconds - up to three decimals" "[ ${value_check} ]"

		exit 1
	fi
done

if [ -n "${power_long}" ] && [ -z "${seconds_long}" ]
then
	frobulator.err "Missing time window for '--power-long'."

	exit 1
fi

if [ -n "${power_short}" ] && [ -z "${seconds_short}" ]
then
	frobulator.err "Missing time window for '--power-short'."

	exit 1
fi

if [ -n "${state_turbo}" ] && [ "${state_turbo}" != "${state_on}" ] && [ "${state_turbo}" != "${state_off}" ]
then
	frobulator.err "Turbo state - on or off" "[ ${state_turbo} ]"

	exit 1
fi

# core and cache share one voltage on these processors - the higher offset is applied to both

if [ -n "${offsets_plane[core]}" ] || [ -n "${offsets_plane[cache]}" ]
then
	if [ "${offsets_plane[core]}" != "${offsets_plane[cache]}" ]
	then
		frobulator.wrn "Core and cache offsets differ - the smaller one is applied to both"
	fi
fi

# configuration ────────────────────────────────────────────────────────────────

# register access through the msr kernel module

list_msr=("${directory_cpu}"/*/"${name_msr}")

if [ ! -e "${list_msr[0]}" ]
then
	modprobe "${name_msr}"

	frobulator.complete
fi

for name_plane in "${list_planes_order[@]}"
do
	offset_write "${name_plane}" "${offsets_plane[${name_plane}]}"

	frobulator.complete
done

if [ -n "${temperature_target}" ]
then
	temperature_write

	frobulator.complete
fi

if [ -n "${power_long}" ] || [ -n "${power_short}" ] || [ "${option_lock_power}" = "true" ]
then
	power_write

	frobulator.complete
fi

if [ -n "${state_turbo}" ]
then
	value_turbo="${value_turbo_enabled}"

	if [ "${state_turbo}" = "${state_off}" ]
	then
		value_turbo="${value_turbo_disabled}"
	fi

	echo "${value_turbo}" > "${file_turbo}"

	frobulator.complete

	frobulator.scs "Turbo boost" "[ ${state_turbo} ]"
fi

if [ "${option_read}" = "true" ]
then
	temperature_read

	for name_plane in "${list_planes[@]}"
	do
		millivolts_read="$(offset_read "${name_plane}")"

		frobulator.inf "Voltage offset - ${name_plane}" "[ ${millivolts_read} ${unit_voltage} ]"
	done

	power_read

	turbo_read
fi

frobulator.result "${script}"
