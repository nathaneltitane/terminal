book_details () {

	frobulator.ipt "Enter book identifier:"

	frobulator.read id_book

	while [[ ! "${id_book}" =~ ${pattern_identifier} ]]
	do
		echo

		frobulator.err "Invalid input type:"

		frobulator.wrn "Numeric characters only"

		frobulator.ipt "Enter book identifier:"

		frobulator.read id_book

	done

	echo

	frobulator.sep

	text_formats="$(curl --silent "${url_api}/${id_book}/" | jq --raw-output "${filter_formats}")"

	# details fetched in the background to a file - shown once they arrive

	frobulator.background process "Fetching details" -- curl --silent --output "${file_json_book}" "${url_api}/${id_book}/"

	jq --raw-output "${filter_details}" "${file_json_book}" | fold --spaces --width="${count_columns_fold}"

	echo "${text_formats}"

	echo

}

book_download () {

	frobulator.ipt "Enter Book identifier(s) separated by spaces - Type 'all' to download last query results:"
	echo

	frobulator.read -a list_ids_book

	if [ "${list_ids_book[0]}" = "${keyword_all}" ]
	then
		count_ids_last="${#list_ids_search_last[@]}"

		if [ "${count_ids_last}" -eq 0 ]
		then
			frobulator.err "No previous search results stored or found."

			return
		fi

		list_ids_book=("${list_ids_search_last[@]}")
	fi

	for id_book in "${list_ids_book[@]}"
	do
		frobulator.inf "Fetching book information" " [ ${id_book} ]"

		frobulator.background process "Fetching book information" " [ ${id_book} ]" -- curl --silent --output "${file_json_book}" "${url_api}/${id_book}/"

		json_book="$(< "${file_json_book}")"
		echo

		url_epub="$(jq --raw-output --arg format "${format_epub}" "${filter_epub}" <<< "${json_book}")"

		title="$(jq --raw-output "${filter_title}" <<< "${json_book}")"
		author="$(jq --raw-output "${filter_author}" <<< "${json_book}")"

		if [ "${url_epub}" = "${value_null}" ]
		then
			frobulator.err "No EPUB version available for book" "[ ${id_book} ]"

			continue
		fi

		author="$(string_sanitize "${author}")"
		title="$(string_sanitize "${title}")"

		extension="${extension_book}"

		file_book="${author}${separator_title}${title}${separator_extension}${extension}"

		frobulator.background "Downloading" "[ ${file_book} ]" -- curl --silent --location --output "${file_book}" "${url_epub}"
		echo

		frobulator.inf "Download complete" "[ ${file_book} ]"
	done

}

while true
do
	selections

	if [[ "${selection}" =~ ${pattern_selection_search} ]]
	then
		book_query

	elif [[ "${selection}" =~ ${pattern_selection_details} ]]
	then
		book_details

	elif [[ "${selection}" =~ ${pattern_selection_download} ]]
	then
		book_download

	elif [[ "${selection}" =~ ${pattern_selection_exit} ]]
	then
		exit
	else
		frobulator.wrn "Invalid selection. Use selection numbers or [b]racketed pointers to access features."
	fi
done
