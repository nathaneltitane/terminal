book_details () {

	frobulator.ipt "Enter book identifier:"

	frobulator.read id_book

	while [[ ! "${id_book}" =~ ^[0-9]+$ ]]
	do
		echo
		frobulator.err "Invalid input type:"

		frobulator.wrn "Numeric characters only"

		frobulator.ipt "Enter book identifier:"

		frobulator.read id_book

	done

	echo

	frobulator.sep

	text_formats=$(curl -s "${url_api}/${id_book}/" | jq -r '
															.formats | to_entries[] |
															"    - "
															+ (.key | sub("^application/"; ""))
															+ ":"
															+ "\n"
															+ "      [ " + .value + " ]"
															+ "\n"
														'
			)

	# details fetched in the background to a file - shown once they arrive

	frobulator.background process "Fetching details" -- curl -s -o "${file_json_book}" "${url_api}/${id_book}/"

	jq -r '
													"\n"
													+ "\n"
													+ "Title:"
													+ "\n"
													+ "\n"
													+ .title
													+ "\n"
													+ "\n"
													+ "Author:"
													+ "\n"
													+ "\n"
													+ (.authors[].name // "Unknown")
													+ "\n"
													+ "\n"
													+ "Subjects:"
													+ "\n"
													+ "\n"
													+ "    - "
													+ (.subjects | join("\n    - "))
													+ "\n"
													+ "\n"
													+ "Formats:"
													+ "\n"
												' "${file_json_book}" | fold -s -w 80

	echo "${text_formats}"

	echo

}

book_download () {

	frobulator.ipt "Enter Book identifier(s) separated by spaces - Type 'all' to download last query results:"
	echo

	frobulator.read -a list_ids_book

	if [ "${list_ids_book[0]}" = "all" ]
	then
		if [ ${#list_ids_search_last[@]} -eq 0 ]
		then
			frobulator.err "No previous search results stored or found."

			return
		fi

		list_ids_book=("${list_ids_search_last[@]}")
	fi

	for id_book in "${list_ids_book[@]}"
	do
		frobulator.inf "Fetching book information" " [ ${id_book} ]"

		frobulator.background process "Fetching book information" " [ ${id_book} ]" -- curl -s -o "${file_json_book}" "${url_api}/${id_book}/"

		json_book="$(< "${file_json_book}")"
		echo

		url_epub=$(echo "${json_book}" | jq -r '.formats."application/epub+zip"')

		title=$(echo "${json_book}" | jq -r '.title')
		author=$(echo "${json_book}" | jq -r '.authors[0].name')

		if [ "${url_epub}" = "null" ]
		then
			frobulator.err "No EPUB version available for book" "[ ${id_book} ]"

			continue
		fi

		author=$(string_sanitize "${author}")
		title=$(string_sanitize  "${title}")

		extension="epub"

		file_book="${author} - ${title}.${extension}"

		frobulator.background "Downloading" "[ ${file_book} ]" -- curl -s -L -o "${file_book}" "${url_epub}"
		echo

		frobulator.inf "Download complete" "[ ${file_book} ]"
	done
}

