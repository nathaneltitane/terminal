#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-u|--uninstall)
			option="uninstall"
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -u | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-u, --uninstall    Run [u]ninstallation of ${script} - installed copies removed."
			echo
			echo -e "-h, --help         Show [h]elp and usage information."
			echo
			echo -e "'${script}'        [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -u | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# uninstall ────────────────────────────────────────────────────────────────────

# remove installed copies

if [ "${option}" = "uninstall" ]
then
	count_removed=0

	# installed copies

	mapfile -t list_paths_installed < <(type -a -P "${script}")

	for path_installed in "${list_paths_installed[@]}"
	do
		directory_installed="${path_installed%/*}"

		if [ -w "${directory_installed}" ]
		then
			frobulator.delete "${directory_installed}" "${script}"

			count_removed=$(( count_removed + 1 ))
		else
			frobulator.wrn "Superuser needed to remove" "[ sudo rm ${path_installed} ]"
		fi
	done

	if [ "${count_removed}" -eq 0 ]
	then
		frobulator.inf "No installed copy found" "[ ${script} ]"
	else
		frobulator.scs "Uninstalled" "[ ${script} ]"
	fi

	exit
fi

# prompt ───────────────────────────────────────────────────────────────────────

frobulator.script "Welcome to the Gutendex teminal library!"

# variables ────────────────────────────────────────────────────────────────────

url_api="${marker_hts}gutendex.com/books"

# api responses - temporary - removed on exit

frobulator.temporary directory_temporary

frobulator.trap "${directory_temporary}"

file_json_search="${directory_temporary}/search.json"
file_json_book="${directory_temporary}/book.json"

# functions ────────────────────────────────────────────────────────────────────

languages_list () {

	echo

	frobulator.fwd "Listing known languages${marker_elp}"

	frobulator.timeout

	IFS=$'\n'

	# get all language names as an indexed array

	list_names_language=("${!list_languages[@]}")
	count_languages=${#list_names_language[@]}

	# find longest langauge string

	length_language_longest=0

	for name_language in "${list_names_language[@]}"
	do
		if [[ ${#name_language} -gt ${length_language_longest} ]]
		then
			length_language_longest=${#name_language}
		fi
	done

	# calculate half of the array length and round up

	count_rows=$(( ( count_languages + 1 ) / 2 ))

	for (( i = 0 ; i < count_rows ; i ++ ))
	do
		name_language_left="${list_names_language[i]}"

		# avoid out-of-bounds error

		name_language_right="${list_names_language[i+count_rows]:-}"

		printf "%-*s %-4s    |    %-*s %-4s\n"																	\
		"$(( length_language_longest + 4 ))" "$name_language_left" "${list_languages[$name_language_left]}"		\
		"$(( length_language_longest + 4 ))" "$name_language_right" "${list_languages[$name_language_right]}"
	done

	echo

	IFS=''

	unset code_language
	}

selections () {

	frobulator.sep

	frobulator.inf "Selections"

	echo "    [ 1 ] [S]earch for a book           [ author | title | subject ]"
	echo "    [ 2 ] [G]et book details            [ id ]"
	echo "    [ 3 ] [D]ownload book(s) (epub)     [ id | all ]"
	echo
	echo "    [ 4 ] [E]xit"
	echo

	frobulator.sep

	frobulator.ipt "Selection:"

	frobulator.read selection

	echo
}

string_sanitize () {

	string="${1}"

	echo "${string}" | tr -d '"|/\:;,!?*<>{}_' | sed 's/  */ /g' | sed 's/^ *//;s/ *$//'
}

