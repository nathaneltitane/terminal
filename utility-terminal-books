#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

# set before the help text

option_uninstall="uninstall"

while (( $# ))
do
	case "${1}"
	in
		-u|--uninstall)
			option="${option_uninstall}"
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -u | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-u, --uninstall    Run [u]ninstallation of ${script} - installed copies removed."
			echo
			echo -e "-h, --help         Show [h]elp and usage information."
			echo
			echo -e "'${script}'        [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -u | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# uninstall ────────────────────────────────────────────────────────────────────

# remove installed copies

if [ "${option}" = "${option_uninstall}" ]
then
	count_removed=0

	# installed copies

	mapfile -t list_paths_installed < <(type -a -P "${script}")

	for path_installed in "${list_paths_installed[@]}"
	do
		directory_installed="${path_installed%/*}"

		if [ -w "${directory_installed}" ]
		then
			frobulator.delete "${directory_installed}" "${script}"

			count_removed=$(( count_removed + 1 ))
		else
			frobulator.wrn "Superuser needed to remove" "[ sudo rm ${path_installed} ]"
		fi
	done

	if [ "${count_removed}" -eq 0 ]
	then
		frobulator.inf "No installed copy found" "[ ${script} ]"
	else
		frobulator.scs "Uninstalled" "[ ${script} ]"
	fi

	exit
fi

# prompt ───────────────────────────────────────────────────────────────────────

frobulator.script "Welcome to the Gutendex teminal library!"

# variables ────────────────────────────────────────────────────────────────────

host_api="gutendex.com"
path_api="books"
url_api="${marker_hts}${host_api}/${path_api}"

name_file_search="search.json"
name_file_book="book.json"
extension_book="epub"
format_epub="application/epub+zip"
characters_remove='"|/\:;,!?*<>{}_'
expression_squeeze='s/  */ /g'
expression_trim='s/^ *//;s/ *$//'
encoded_space="%20"
separator_space=" "
separator_title=" - "
separator_extension="."
value_null="null"
keyword_all="all"
pattern_query="^[A-Za-z0-9]+$"
pattern_language="^[A-Za-z]+$"
pattern_language_numeric="^[0-90-9]+$"
pattern_identifier="^[0-9]+$"
pattern_selection_search="^(1|s|S)$"
pattern_selection_details="^(2|g|G)$"
pattern_selection_download="^(3|d|D)$"
pattern_selection_exit="^(4|e|E)$"
format_language_row="%-*s %-4s    |    %-*s %-4s\n"
width_padding="4"
count_columns_table="2"
count_columns_fold="80"

# json filters with arguments

filter_ids_language='
	.results[] |
	select(.languages[] |
	contains($language)) |
	.id
'

filter_ids_all='
	.results[].id
'

filter_count='.count'

filter_results='
	.results[] |
	select(.languages[] |
	contains($language)) |
	"Identifier:"
	+ " "
	+ (.id|tostring)
	+ "\n"
	+ "\n"
	+ "    "
	+ "Title:"
	+ "   "
	+ "    "
	+ .title
	+ "\n"
	+ "    "
	+ "Author:"
	+ "  "
	+ "    "
	+ (.authors[].name // "N/A")
	+ "\n"
	+ "    "
	+ "Language:"
	+ "    "
	+ (.languages | join(", "))
	+ "\n"
	+ "    "
	+ "Download:"
	+ "    "
	+ (.formats[$format] // "N/A")
	+ "\n"
'

filter_formats='
	.formats | to_entries[] |
	"    - "
	+ (.key | sub("^application/"; ""))
	+ ":"
	+ "\n"
	+ "      [ " + .value + " ]"
	+ "\n"
'

filter_details='
	"\n"
	+ "\n"
	+ "Title:"
	+ "\n"
	+ "\n"
	+ .title
	+ "\n"
	+ "\n"
	+ "Author:"
	+ "\n"
	+ "\n"
	+ (.authors[].name // "Unknown")
	+ "\n"
	+ "\n"
	+ "Subjects:"
	+ "\n"
	+ "\n"
	+ "    - "
	+ (.subjects | join("\n    - "))
	+ "\n"
	+ "\n"
	+ "Formats:"
	+ "\n"
'

filter_epub='.formats[$format]'
filter_title='.title'
filter_author='.authors[0].name'

# api responses - temporary - removed on exit

frobulator.temporary directory_temporary

frobulator.trap "${directory_temporary}"

file_json_search="${directory_temporary}/${name_file_search}"
file_json_book="${directory_temporary}/${name_file_book}"

# functions ────────────────────────────────────────────────────────────────────

languages_list () {

	echo

	frobulator.fwd "Listing known languages${marker_elp}"

	frobulator.timeout

	IFS=$'\n'

	# get all language names as an indexed array

	list_names_language=("${!list_languages[@]}")
	count_languages="${#list_names_language[@]}"

	# find longest langauge string

	length_language_longest=0

	for name_language in "${list_names_language[@]}"
	do
		if [ "${#name_language}" -gt "${length_language_longest}" ]
		then
			length_language_longest="${#name_language}"
		fi
	done

	# calculate half of the array length and round up

	count_rows=$(( ( count_languages + 1 ) / count_columns_table ))
	width_column=$(( length_language_longest + width_padding ))

	for (( index_row = 0 ; index_row < count_rows ; index_row ++ ))
	do
		name_language_left="${list_names_language[index_row]}"

		# avoid out-of-bounds error

		name_language_right="${list_names_language[index_row + count_rows]:-}"

		printf "${format_language_row}"																\
			"${width_column}" "${name_language_left}" "${list_languages[${name_language_left}]}"	\
			"${width_column}" "${name_language_right}" "${list_languages[${name_language_right}]}"
	done

	echo

	IFS=''

	unset code_language

}

selections () {

	frobulator.sep

	frobulator.inf "Selections"

	echo "    [ 1 ] [S]earch for a book           [ author | title | subject ]"
	echo "    [ 2 ] [G]et book details            [ id ]"
	echo "    [ 3 ] [D]ownload book(s) (epub)     [ id | all ]"
	echo
	echo "    [ 4 ] [E]xit"
	echo

	frobulator.sep

	frobulator.ipt "Selection:"

	frobulator.read selection

	echo

}

string_sanitize () {

	string="${1}"

	echo "${string}" | tr --delete "${characters_remove}" | sed --expression="${expression_squeeze}" | sed --expression="${expression_trim}"

}

