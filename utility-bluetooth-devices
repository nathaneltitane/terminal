#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-b|--backup)
			option="backup"
		;;

		-r|--restore)
			option="restore"
		;;

		-d|--directory)
			directory="${2}"

			shift
		;;

		-k|--key)
			file_bluetooth_keys="${2}"

			shift
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -b | -r [-d [Directory]] [-k [File]] | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-b, --backup       Run [b]ackup of bluetooth devices and audio settings."
			echo
			echo -e "-r, --restore      Run [r]estore of bluetooth devices and audio settings."
			echo
			echo -e "-d, --directory    Specify device files [d]irectory."
			echo
			echo -e "                   [ script directory ] [ Default ]"
			echo
			echo -e "-k, --key          Specify the private bluetooth [k]eys file."
			echo
			echo -e "                   [ /media/internal/.bluetooth-keys ] [ Default ]"
			echo -e "                   [ private - never a public repository ]"
			echo
			echo -e "-h, --help         Show [h]elp and usage information."
			echo
			echo -e "'${script}'        [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -b | -r [-d [Directory]] [-k [File]] | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

# bluez device store: pairing keys / names / aliases / trust - root only

directory_bluetooth="/var/lib/bluetooth"

# audio settings per device as plain text - applied through pulseaudio on restore

file_bluetooth_keys_default="/media/internal/.bluetooth-keys"

# paired devices and list column - shared by the device and audio backups

list_labels_device=()
list_addresses_device=()
list_names_device=()
column_label_index=0

# defaults ─────────────────────────────────────────────────────────────────────

if [ -z "${option}" ]
then
	frobulator.err "Missing operation."
	frobulator.nul "Specify either '--backup' or '--restore'."

	exit 1

elif [[ "${directory}" = -* ]]
then
	frobulator.err "Missing argument for '--directory'."

	exit 1

elif [[ "${file_bluetooth_keys}" = -* ]]
then
	frobulator.err "Missing argument for '--key'."

	exit 1
fi

# device files are kept in the repository holding this script

if [ -z "${directory}" ]
then
	file_script="$(readlink -f -- "${BASH_SOURCE[0]}")"

	directory="$(dirname -- "${file_script}")"
fi

directory="${directory%/}"

file_device_index="${directory}/bluetooth-devices-list"
file_audio_settings="${directory}/bluetooth-audio-settings"

file_bluetooth_keys="${file_bluetooth_keys:-${file_bluetooth_keys_default}}"

# functions ────────────────────────────────────────────────────────────────────

adapter_address () {

	# default bluetooth adapter address - or the only one already stored

	local line_adapter
	local directory_adapter

	local -a list_directories_adapter=()

	line_adapter="$(bluetoothctl list 2> "${sink}" | grep -m 1 '^Controller')"

	if [ -n "${line_adapter}" ]
	then
		line_adapter="${line_adapter#Controller }"

		echo "${line_adapter%% *}"

		return 0
	fi

	for directory_adapter in "${directory_bluetooth}"/??:??:??:??:??:??
	do
		if [ -d "${directory_adapter}" ]
		then
			list_directories_adapter+=("${directory_adapter##*/}")
		fi
	done

	if [ "${#list_directories_adapter[@]}" -eq 1 ]
	then
		echo "${list_directories_adapter[0]}"

		return 0
	fi

	return 1
}

device_label () {

	# device name as label: lowercase - spaces as '-' - safe characters only

	local name_device="${1,,}"

	name_device="${name_device// /-}"
	name_device="${name_device//[^a-z0-9_-]/}"

	echo "${name_device:-device}"
}

info_value () {

	# value of a key in the [General] section of a bluez info file

	local file_info="${1}"
	local key_info="${2}"

	local line_info
	local section_info

	while IFS= read -r line_info
	do
		if [[ "${line_info}" =~ ^\[(.+)\]$ ]]
		then
			section_info="${BASH_REMATCH[1]}"

		elif [ "${section_info}" = "General" ] && [[ "${line_info}" = "${key_info}="* ]]
		then
			echo "${line_info#*=}"

			return 0
		fi
	done < "${file_info}"
}

index_tabs () {

	# tabs from a text position to a column - tab width 4

	local position_index="${1}"
	local column_index="${2}"
	local count_tabs_index=$(( ( column_index - position_index / 4 * 4 ) / 4 ))

	while [ "${count_tabs_index}" -gt 0 ]
	do
		printf '\t'

		count_tabs_index=$(( count_tabs_index - 1 ))
	done
}

devices_backup () {

	local status=0
	local width_label_index=0

	local adapter
	local directory_device
	local address_device
	local name_device
	local alias_device
	local name_device_reported
	local label_list_device
	local index_device
	local file_keys_archive

	adapter="$(adapter_address)"

	if [ -z "${adapter}" ] || [ ! -d "${directory_bluetooth}/${adapter}" ]
	then
		frobulator.err "Backup failure - no bluetooth adapter" "[ ${directory_bluetooth}${marker_spc}${marker_hnt}${marker_spc}none ]"

		return 1
	fi

	# device list: label / address / name

	for directory_device in "${directory_bluetooth}/${adapter}"/??:??:??:??:??:??
	do
		if [ ! -f "${directory_device}/info" ]
		then
			continue
		fi

		address_device="${directory_device##*/}"

		# alias set on this computer - otherwise the name the device reports

		alias_device="$(info_value "${directory_device}/info" Alias)"
		name_device_reported="$(info_value "${directory_device}/info" Name)"

		name_device="${alias_device:-${name_device_reported}}"

		label_list_device="$(device_label "${name_device}")"

		list_labels_device+=("${label_list_device}")
		list_addresses_device+=("${address_device}")
		list_names_device+=("${name_device}")
	done

	for index_device in "${!list_labels_device[@]}"
	do
		if [ "${#list_labels_device[${index_device}]}" -gt "${width_label_index}" ]
		then
			width_label_index="${#list_labels_device[${index_device}]}"
		fi
	done

	# columns aligned on tab stops (tab width 4): label column one tab wider than the longest label

	column_label_index=$(( ( width_label_index / 4 + 2 ) * 4 ))

	: > "${file_device_index}"

	for index_device in "${!list_labels_device[@]}"
	do
		printf '%s%s%s\t%s\n'																				\
			"${list_labels_device[${index_device}]}"																\
			"$(index_tabs "${#list_labels_device[${index_device}]}" "${column_label_index}")"					\
			"${list_addresses_device[${index_device}]}"															\
			"${list_names_device[${index_device}]}"	>> "${file_device_index}"

		frobulator.scs "Backup success - device" "[ '${list_labels_device[${index_device}]}'${marker_spc}${marker_hnt}${marker_spc}${list_addresses_device[${index_device}]} ]"
	done

	# full bluez store with pairing keys: private file only

	frobulator.temporary directory_keys_temporary

	frobulator.trap "${directory_keys_temporary}"

	file_keys_archive="${directory_keys_temporary}/bluetooth-keys"

	frobulator.archive "${file_keys_archive}" "tar.gz" "${directory_bluetooth}" > "${sink}"

	frobulator.track || return 1

	frobulator.directory "$(dirname -- "${file_bluetooth_keys}")" > "${sink}"

	mv -f "${file_keys_archive}.tar.gz" "${file_bluetooth_keys}"

	frobulator.track || return 1

	frobulator.permissions private "${file_bluetooth_keys}" > "${sink}"

	frobulator.ownership "${file_bluetooth_keys}" > "${sink}"

	frobulator.scs "Backup success - keys" "[ '${file_bluetooth_keys##*/}'${marker_spc}${marker_hnt}${marker_spc}private ]"

	return "${status}"
}

audio_user () {

	# run a command as the desktop user - inside their session

	local name_user_audio="${SUDO_USER:-${USER}}"

	sudo -u "${name_user_audio}" XDG_RUNTIME_DIR="/run/user/$(id -u "${name_user_audio}")" "${@}"
}

audio_sink_name () {

	# bluetooth device pulseaudio sink - whatever its profile

	local address_audio="${1//:/_}"

	local index_sink_audio
	local name_sink_entry

	while IFS=$'\t' read -r index_sink_audio name_sink_entry _
	do
		if [[ "${name_sink_entry}" = "bluez_sink.${address_audio}."* ]]
		then
			echo "${name_sink_entry}"

			return 0
		fi
	done < <(audio_user pactl list short sinks 2> "${sink}")

	return 1
}

audio_card_profile () {

	# active profile of a bluetooth device's pulseaudio card

	local card_audio="bluez_card.${1//:/_}"
	local state_in_card=false

	local line_audio

	while IFS= read -r line_audio
	do
		if [[ "${line_audio}" =~ ^[[:space:]]*Name:[[:space:]]*(.+)$ ]]
		then
			if [ "${BASH_REMATCH[1]}" = "${card_audio}" ]
			then
				state_in_card=true
			else
				state_in_card=false
			fi

		elif [ "${state_in_card}" = true ] && [[ "${line_audio}" =~ ^[[:space:]]*Active\ Profile:[[:space:]]*(.+)$ ]]
		then
			echo "${BASH_REMATCH[1]}"

			return 0
		fi
	done < <(audio_user pactl list cards 2> "${sink}")

	return 1
}

audio_backup () {

	# profile / volume / mute / default output of each connected device - as plain text

	local status=0
	local count_lines_audio=0

	local index_audio
	local name_sink
	local profile_audio
	local volume_audio
	local state_mute
	local label_default
	local name_sink_default
	local line_saved_audio
	local address_saved_audio

	local -A list_lines_saved_audio=()

	name_sink_default="$(audio_user pactl get-default-sink 2> "${sink}")"

	# previous settings - kept for devices not connected now

	if [ -f "${file_audio_settings}" ]
	then
		while IFS= read -r line_saved_audio
		do
			IFS=$'\t' read -r _ address_saved_audio _ <<< "${line_saved_audio}"

			list_lines_saved_audio["${address_saved_audio}"]="${line_saved_audio}"
		done < "${file_audio_settings}"
	fi

	: > "${file_audio_settings}"

	for index_audio in "${!list_addresses_device[@]}"
	do
		name_sink="$(audio_sink_name "${list_addresses_device[${index_audio}]}")"

		if [ -z "${name_sink}" ]
		then
			line_saved_audio="${list_lines_saved_audio[${list_addresses_device[${index_audio}]}]}"

			if [ -n "${line_saved_audio}" ]
			then
				echo "${line_saved_audio}" >> "${file_audio_settings}"

				count_lines_audio=$(( count_lines_audio + 1 ))

				frobulator.wrn "Audio settings kept - not connected" "[ '${list_labels_device[${index_audio}]}'${marker_spc}${marker_hnt}${marker_spc}${list_addresses_device[${index_audio}]} ]"
			else
				frobulator.wrn "Audio settings skipped - not connected" "[ '${list_labels_device[${index_audio}]}'${marker_spc}${marker_hnt}${marker_spc}${list_addresses_device[${index_audio}]} ]"
			fi

			continue
		fi

		profile_audio="$(audio_card_profile "${list_addresses_device[${index_audio}]}")"

		volume_audio="$(audio_user pactl get-sink-volume "${name_sink}" 2> "${sink}")"
		volume_audio="${volume_audio#*/ }"
		volume_audio="${volume_audio%%%*}%"
		volume_audio="${volume_audio// /}"

		state_mute="$(audio_user pactl get-sink-mute "${name_sink}" 2> "${sink}")"
		state_mute="${state_mute#Mute: }"

		unset label_default

		if [ "${name_sink}" = "${name_sink_default}" ]
		then
			label_default="default"
		fi

		printf '%s%s%s\t%s\t%s\t%s%s\n'																	\
			"${list_labels_device[${index_audio}]}"																\
			"$(index_tabs "${#list_labels_device[${index_audio}]}" "${column_label_index}")"					\
			"${list_addresses_device[${index_audio}]}"															\
			"${profile_audio}"																				\
			"${volume_audio}"																				\
			"${state_mute}"																					\
			"${label_default:+$'\t'${label_default}}"	>> "${file_audio_settings}"

		count_lines_audio=$(( count_lines_audio + 1 ))
	done

	frobulator.scs "Backup success - audio settings" "[ '${file_audio_settings##*/}'${marker_spc}${marker_hnt}${marker_spc}${count_lines_audio} ]"

	return "${status}"
}

devices_restore () {

	local status=0

	local adapter
	local directory_adapter_archived
	local directory_device
	local address_device
	local name_device
	local alias_device
	local name_device_reported
	local label_list_device
	local file_keys_archive

	if [ ! -f "${file_bluetooth_keys}" ]
	then
		frobulator.err "Restore failure - no keys file" "[ '${file_bluetooth_keys##*/}'${marker_spc}${marker_hnt}${marker_spc}missing ]"

		return 1
	fi

	adapter="$(adapter_address)"

	if [ -z "${adapter}" ]
	then
		frobulator.err "Restore failure - no bluetooth adapter" "[ bluetoothctl${marker_spc}${marker_hnt}${marker_spc}none ]"

		return 1
	fi

	# keys file is a tar.gz archive holding the bluetooth directory

	frobulator.temporary directory_keys_temporary

	frobulator.trap "${directory_keys_temporary}"

	file_keys_archive="${directory_keys_temporary}/bluetooth-keys.tar.gz"

	cp -f "${file_bluetooth_keys}" "${file_keys_archive}"

	frobulator.extract "${file_keys_archive}" "${directory_keys_temporary}" > "${sink}"

	frobulator.track || return 1

	frobulator.stp "Stopping" "[ bluetooth ]"

	systemctl stop bluetooth

	# devices go under the current adapter - even if it changed

	mkdir -p "${directory_bluetooth}/${adapter}"

	for directory_adapter_archived in "${directory_keys_temporary}"/bluetooth/??:??:??:??:??:??
	do
		for directory_device in "${directory_adapter_archived}"/??:??:??:??:??:??
		do
			if [ ! -f "${directory_device}/info" ]
			then
				continue
			fi

			address_device="${directory_device##*/}"

			cp -a "${directory_device}" "${directory_bluetooth}/${adapter}/"

			frobulator.track

			# alias set on this computer - otherwise the name the device reports

			alias_device="$(info_value "${directory_device}/info" Alias)"
			name_device_reported="$(info_value "${directory_device}/info" Name)"

			name_device="${alias_device:-${name_device_reported}}"

			label_list_device="$(device_label "${name_device}")"

			frobulator.scs "Restore success - device" "[ '${label_list_device}'${marker_spc}${marker_hnt}${marker_spc}${address_device} ]"
		done

		# adapter settings (name / discoverable) only for the same adapter

		if [ "${directory_adapter_archived##*/}" = "${adapter}" ] && [ -f "${directory_adapter_archived}/settings" ]
		then
			cp -f "${directory_adapter_archived}/settings" "${directory_bluetooth}/${adapter}/settings"
		fi
	done

	chmod -R go-rwx "${directory_bluetooth}"

	frobulator.fwd "Starting" "[ bluetooth ]"

	systemctl start bluetooth

	frobulator.track

	return "${status}"
}

audio_restore () {

	# connect each device - then apply its saved profile / volume / mute / default output

	local status=0

	local label_audio
	local address_audio
	local profile_audio
	local volume_audio
	local state_mute
	local label_default
	local name_sink
	local index_attempt_audio
	local index_second_audio
	local information_device_audio

	if [ ! -f "${file_audio_settings}" ]
	then
		frobulator.wrn "Audio settings not restored - none saved" "[ '${file_audio_settings##*/}'${marker_spc}${marker_hnt}${marker_spc}missing ]"

		return 0
	fi

	while IFS=$'\t' read -r label_audio address_audio profile_audio volume_audio state_mute label_default
	do
		# speakers often answer only after a few page timeouts

		for index_attempt_audio in {1..6}
		do
			# bluez device details - including its 'Connected: yes / no' line

			information_device_audio="$(bluetoothctl info "${address_audio}" 2> "${sink}")"

			if [[ "${information_device_audio}" = *"Connected: yes"* ]]
			then
				break
			fi

			bluetoothctl connect "${address_audio}" > "${sink}" 2>&1

			sleep 2
		done

		unset name_sink

		for index_second_audio in {1..15}
		do
			name_sink="$(audio_sink_name "${address_audio}")"

			if [ -n "${name_sink}" ]
			then
				break
			fi

			sleep 1
		done

		if [ -z "${name_sink}" ]
		then
			frobulator.wrn "Audio settings skipped - not connected" "[ '${label_audio}'${marker_spc}${marker_hnt}${marker_spc}${address_audio} ]"

			status=1

			continue
		fi

		if [ -n "${profile_audio}" ]
		then
			audio_user pactl set-card-profile "bluez_card.${address_audio//:/_}" "${profile_audio}" 2> "${sink}"

			frobulator.track

			# the sink name follows the profile

			sleep 2

			name_sink="$(audio_sink_name "${address_audio}")"
		fi

		audio_user pactl set-sink-volume "${name_sink}" "${volume_audio}"

		frobulator.track

		audio_user pactl set-sink-mute "${name_sink}" "${state_mute}"

		frobulator.track

		if [ "${label_default}" = "default" ]
		then
			audio_user pactl set-default-sink "${name_sink}"

			frobulator.track
		fi

		frobulator.scs "Restore success - audio settings" "[ '${label_audio}'${marker_spc}${marker_hnt}${marker_spc}${volume_audio} ]"
	done < "${file_audio_settings}"

	return "${status}"
}

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(

)

frobulator.require ${list[@]}

list=()

# configuration ────────────────────────────────────────────────────────────────

# bluez command line client - empty if not installed

command_bluetooth="$(command -v bluetoothctl)"

if [ -z "${command_bluetooth}" ]
then
	frobulator.err "BlueZ not installed" "[ bluetoothctl ]"

	exit 1
fi

if [ ! -d "${directory}" ]
then
	frobulator.err "Directory not found" "[ ${directory} ]"

	exit 1
fi

frobulator.inf "Device files directory" "[ ${directory} ]"

if [ "${option}" = "backup" ]
then
	devices_backup

	frobulator.complete continue "Backup failure - devices"

	audio_backup

	frobulator.complete continue "Backup failure - audio settings"

	frobulator.ownership "${file_device_index}" "${file_audio_settings}" > "${sink}"

elif [ "${option}" = "restore" ]
then
	devices_restore

	frobulator.complete continue "Restore failure - devices"

	audio_restore

	frobulator.complete continue "Restore failure - audio settings"

	sleep 3

	frobulator.inf "Paired devices"

	bluetoothctl devices Paired 2> "${sink}"
fi

frobulator.result "${script}"
