#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- ${BASH_SOURCE[0]})"

if [[ "${frobulator_loaded}" != "true" ]]
then
	echo

	ticker () {

		for ticker in '>  ' '>> ' '>>>'
		do
			echo -n -e "\r[  ${ticker}  ] ${1^}..."

			sleep 0.5
		done

		echo

		echo

	}

	if [[ $(id -u -n) = "root" ]]
	then
		USER="${SUDO_USER:-root}"

		if [ "${USER}" = "root" ]
		then
			HOME=/root
		else
			HOME="/home/${USER}"
		fi
	fi

	ticker checking

	package_managers_list=(
		"apt-get --quiet --quiet update > /dev/null 2>&1; apt-get --quiet --quiet install --yes"
		"dnf --quiet install --assumeyes"
		"yum --quiet install --assumeyes"
		"apk add --quiet"
		"pacman --sync --refresh --noconfirm --noprogressbar"
		"zypper --quiet --non-interactive install"
	)

	package="curl"

	if [[ -z $(command -v "${package}") ]]
	then
		for package_manager in "${package_managers_list[@]}"
		do
			entry="${package_manager%% *}"

			if [[ -n $(command -v "${entry}") ]]
			then
				eval "${package_manager} ${package} > /dev/null 2>&1"

				break
			fi
		done

		if [[ -z $(command -v "${package}") ]]
		then
			echo "[  !  ] Unable to install or binary not found ─────────────────────── [ '${package}' ]"
			echo

			exit 1
		fi
	fi

	mkdir -p "${HOME}"/.local/bin

	frobulator="${HOME}"/.local/bin/frobulator

	version_online=$(curl -s -L get.frbltr.app | grep -m 1 '^update=' | cut -d '"' -f 2)

	version_local=$(grep -m 1 '^update=' "${frobulator}" 2>/dev/null | cut -d '"' -f 2)

	version_local="${version_local:-1970-01-01}"

	if [ ! -f "${frobulator}" ] || [[ "${version_online}" > "${version_local}" ]]
	then
		curl -s -L get.frbltr.app > "${frobulator}"

		chmod +x "${frobulator}"
	fi

	ticker initializing

	source "${frobulator}"

	# script arguments for escalation

	self_arguments=("${@}")
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-03"

# usage ────────────────────────────────────────────────────────────────────────

while (($#))
do
	case "${1}"
	in
		-b|--backup)
			option="backup"
		;;

		-r|--restore)
			option="restore"
		;;

		-d|--directory)
			directory="${2}"

			shift
		;;

		-k|--key)
			file_bluetooth_keys="${2}"

			shift
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -b | -r [-d [Directory]] [-k [File]] | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-b, --backup       Run [b]ackup of bluetooth devices and audio settings."
			echo
			echo -e "-r, --restore      Run [r]estore of bluetooth devices and audio settings."
			echo
			echo -e "-d, --directory    Specify device files [d]irectory."
			echo
			echo -e "                   [ script directory ] [ Default ]"
			echo
			echo -e "-k, --key          Specify the private bluetooth [k]eys file."
			echo
			echo -e "                   [ /media/internal/.bluetooth-keys ] [ Default ]"
			echo -e "                   [ private - never a public repository ]"
			echo
			echo -e "-h, --help         Show [h]elp and usage information."
			echo
			echo -e "'${script}'     [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -b | -r [-d [Directory]] [-k [File]] | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

# bluez device store: pairing keys / names / aliases / trust - root only

directory_bluetooth="/var/lib/bluetooth"

# audio settings per device as plain text - applied through pulseaudio on restore

file_bluetooth_keys_default="/media/internal/.bluetooth-keys"

# paired devices and list column - shared by the device and audio backups

device_labels=()
device_addresses=()
device_names=()
index_label_column=0

# defaults ─────────────────────────────────────────────────────────────────────

if [ -z "${option}" ]
then
	frobulator.err "Missing operation."
	frobulator.nul "Specify either '--backup' or '--restore'."

	exit 1

elif [[ "${directory}" = -* ]]
then
	frobulator.err "Missing argument for '--directory'."

	exit 1

elif [[ "${file_bluetooth_keys}" = -* ]]
then
	frobulator.err "Missing argument for '--key'."

	exit 1
fi

# device files are kept in the repository holding this script

if [ -z "${directory}" ]
then
	file_script="$(readlink -f -- "${BASH_SOURCE[0]}")"

	directory="$(dirname -- "${file_script}")"
fi

directory="${directory%/}"

file_device_index="${directory}/bluetooth-devices-list"
file_audio_settings="${directory}/bluetooth-audio-settings"

file_bluetooth_keys="${file_bluetooth_keys:-${file_bluetooth_keys_default}}"

# functions ────────────────────────────────────────────────────────────────────

adapter_address () {

	# default bluetooth adapter address - or the only one already stored

	local adapter_line
	local adapter_directory

	local -a adapter_directories=()

	adapter_line="$(bluetoothctl list 2> "${sink}" | grep -m 1 '^Controller')"

	if [ -n "${adapter_line}" ]
	then
		adapter_line="${adapter_line#Controller }"

		echo "${adapter_line%% *}"

		return 0
	fi

	for adapter_directory in "${directory_bluetooth}"/??:??:??:??:??:??
	do
		if [ -d "${adapter_directory}" ]
		then
			adapter_directories+=("${adapter_directory##*/}")
		fi
	done

	if [ "${#adapter_directories[@]}" -eq 1 ]
	then
		echo "${adapter_directories[0]}"

		return 0
	fi

	return 1
}

device_label () {

	# device name as label: lowercase - spaces as '-' - safe characters only

	local device_name="${1,,}"

	device_name="${device_name// /-}"
	device_name="${device_name//[^a-z0-9_-]/}"

	echo "${device_name:-device}"
}

info_value () {

	# value of a key in the [General] section of a bluez info file

	local info_file="${1}"
	local info_key="${2}"

	local info_line
	local info_section

	while IFS= read -r info_line
	do
		if [[ "${info_line}" =~ ^\[(.+)\]$ ]]
		then
			info_section="${BASH_REMATCH[1]}"

		elif [ "${info_section}" = "General" ] && [[ "${info_line}" = "${info_key}="* ]]
		then
			echo "${info_line#*=}"

			return 0
		fi
	done < "${info_file}"
}

index_tabs () {

	# tabs from a text position to a column - tab width 4

	local index_position="${1}"
	local index_column="${2}"
	local index_tab_count=$(( (index_column - index_position / 4 * 4) / 4 ))

	while [ "${index_tab_count}" -gt 0 ]
	do
		printf '\t'

		index_tab_count=$(( index_tab_count - 1 ))
	done
}

devices_backup () {

	local status=0
	local index_label_width=0

	local adapter
	local device_directory
	local device_address
	local device_name
	local device_alias
	local device_reported_name
	local device_list_label
	local device_index
	local file_keys_archive

	adapter="$(adapter_address)"

	if [ -z "${adapter}" ] || [ ! -d "${directory_bluetooth}/${adapter}" ]
	then
		frobulator.err "Backup failure - no bluetooth adapter" "[ ${directory_bluetooth}${marker_spc}${marker_hnt}${marker_spc}none ]"

		return 1
	fi

	# device list: label / address / name

	for device_directory in "${directory_bluetooth}/${adapter}"/??:??:??:??:??:??
	do
		if [ ! -f "${device_directory}/info" ]
		then
			continue
		fi

		device_address="${device_directory##*/}"

		# alias set on this computer - otherwise the name the device reports

		device_alias="$(info_value "${device_directory}/info" Alias)"
		device_reported_name="$(info_value "${device_directory}/info" Name)"

		device_name="${device_alias:-${device_reported_name}}"

		device_list_label="$(device_label "${device_name}")"

		device_labels+=("${device_list_label}")
		device_addresses+=("${device_address}")
		device_names+=("${device_name}")
	done

	for device_index in "${!device_labels[@]}"
	do
		if [ "${#device_labels[${device_index}]}" -gt "${index_label_width}" ]
		then
			index_label_width="${#device_labels[${device_index}]}"
		fi
	done

	# columns aligned on tab stops (tab width 4): label column one tab wider than the longest label

	index_label_column=$(( (index_label_width / 4 + 2) * 4 ))

	: > "${file_device_index}"

	for device_index in "${!device_labels[@]}"
	do
		printf '%s%s%s\t%s\n'																				\
			"${device_labels[${device_index}]}"																\
			"$(index_tabs "${#device_labels[${device_index}]}" "${index_label_column}")"					\
			"${device_addresses[${device_index}]}"															\
			"${device_names[${device_index}]}"	>> "${file_device_index}"

		frobulator.scs "Backup success - device" "[ '${device_labels[${device_index}]}'${marker_spc}${marker_hnt}${marker_spc}${device_addresses[${device_index}]} ]"
	done

	# full bluez store with pairing keys: private file only

	frobulator.temporary directory_keys_temporary

	frobulator.trap "${directory_keys_temporary}"

	file_keys_archive="${directory_keys_temporary}/bluetooth-keys"

	frobulator.archive "${file_keys_archive}" "tar.gz" "${directory_bluetooth}" > "${sink}"

	frobulator.track || return 1

	frobulator.directory "$(dirname -- "${file_bluetooth_keys}")" > "${sink}"

	mv -f "${file_keys_archive}.tar.gz" "${file_bluetooth_keys}"

	frobulator.track || return 1

	frobulator.permissions private "${file_bluetooth_keys}" > "${sink}"

	frobulator.ownership "${file_bluetooth_keys}" > "${sink}"

	frobulator.scs "Backup success - keys" "[ '${file_bluetooth_keys##*/}'${marker_spc}${marker_hnt}${marker_spc}private ]"

	return "${status}"
}

audio_user () {

	# run a command as the desktop user - inside their session

	local audio_user_name="${SUDO_USER:-${USER}}"

	sudo -u "${audio_user_name}" XDG_RUNTIME_DIR="/run/user/$(id -u "${audio_user_name}")" "${@}"
}

audio_sink_name () {

	# bluetooth device pulseaudio sink - whatever its profile

	local audio_address="${1//:/_}"

	local audio_sink_index
	local audio_sink_name

	while IFS=$'\t' read -r audio_sink_index audio_sink_name _
	do
		if [[ "${audio_sink_name}" = "bluez_sink.${audio_address}."* ]]
		then
			echo "${audio_sink_name}"

			return 0
		fi
	done < <(audio_user pactl list short sinks 2> "${sink}")

	return 1
}

audio_card_profile () {

	# active profile of a bluetooth device's pulseaudio card

	local audio_card="bluez_card.${1//:/_}"
	local audio_in_card=false

	local audio_line

	while IFS= read -r audio_line
	do
		if [[ "${audio_line}" =~ ^[[:space:]]*Name:[[:space:]]*(.+)$ ]]
		then
			if [ "${BASH_REMATCH[1]}" = "${audio_card}" ]
			then
				audio_in_card=true
			else
				audio_in_card=false
			fi

		elif [ "${audio_in_card}" = true ] && [[ "${audio_line}" =~ ^[[:space:]]*Active\ Profile:[[:space:]]*(.+)$ ]]
		then
			echo "${BASH_REMATCH[1]}"

			return 0
		fi
	done < <(audio_user pactl list cards 2> "${sink}")

	return 1
}

audio_backup () {

	# profile / volume / mute / default output of each connected device - as plain text

	local status=0
	local audio_line_count=0

	local audio_index
	local audio_sink
	local audio_profile
	local audio_volume
	local audio_mute
	local audio_default
	local audio_default_sink
	local audio_saved_line
	local audio_saved_address

	local -A audio_saved_lines=()

	audio_default_sink="$(audio_user pactl get-default-sink 2> "${sink}")"

	# previous settings - kept for devices not connected now

	if [ -f "${file_audio_settings}" ]
	then
		while IFS= read -r audio_saved_line
		do
			IFS=$'\t' read -r _ audio_saved_address _ <<< "${audio_saved_line}"

			audio_saved_lines["${audio_saved_address}"]="${audio_saved_line}"
		done < "${file_audio_settings}"
	fi

	: > "${file_audio_settings}"

	for audio_index in "${!device_addresses[@]}"
	do
		audio_sink="$(audio_sink_name "${device_addresses[${audio_index}]}")"

		if [ -z "${audio_sink}" ]
		then
			audio_saved_line="${audio_saved_lines[${device_addresses[${audio_index}]}]}"

			if [ -n "${audio_saved_line}" ]
			then
				echo "${audio_saved_line}" >> "${file_audio_settings}"

				audio_line_count=$(( audio_line_count + 1 ))

				frobulator.wrn "Audio settings kept - not connected" "[ '${device_labels[${audio_index}]}'${marker_spc}${marker_hnt}${marker_spc}${device_addresses[${audio_index}]} ]"
			else
				frobulator.wrn "Audio settings skipped - not connected" "[ '${device_labels[${audio_index}]}'${marker_spc}${marker_hnt}${marker_spc}${device_addresses[${audio_index}]} ]"
			fi

			continue
		fi

		audio_profile="$(audio_card_profile "${device_addresses[${audio_index}]}")"

		audio_volume="$(audio_user pactl get-sink-volume "${audio_sink}" 2> "${sink}")"
		audio_volume="${audio_volume#*/ }"
		audio_volume="${audio_volume%%%*}%"
		audio_volume="${audio_volume// /}"

		audio_mute="$(audio_user pactl get-sink-mute "${audio_sink}" 2> "${sink}")"
		audio_mute="${audio_mute#Mute: }"

		unset audio_default

		if [ "${audio_sink}" = "${audio_default_sink}" ]
		then
			audio_default="default"
		fi

		printf '%s%s%s\t%s\t%s\t%s%s\n'																	\
			"${device_labels[${audio_index}]}"																\
			"$(index_tabs "${#device_labels[${audio_index}]}" "${index_label_column}")"					\
			"${device_addresses[${audio_index}]}"															\
			"${audio_profile}"																				\
			"${audio_volume}"																				\
			"${audio_mute}"																					\
			"${audio_default:+$'\t'${audio_default}}"	>> "${file_audio_settings}"

		audio_line_count=$(( audio_line_count + 1 ))
	done

	frobulator.scs "Backup success - audio settings" "[ '${file_audio_settings##*/}'${marker_spc}${marker_hnt}${marker_spc}${audio_line_count} ]"

	return "${status}"
}

devices_restore () {

	local status=0

	local adapter
	local adapter_archived
	local device_directory
	local device_address
	local device_name
	local device_alias
	local device_reported_name
	local device_list_label
	local file_keys_archive

	if [ ! -f "${file_bluetooth_keys}" ]
	then
		frobulator.err "Restore failure - no keys file" "[ '${file_bluetooth_keys##*/}'${marker_spc}${marker_hnt}${marker_spc}missing ]"

		return 1
	fi

	adapter="$(adapter_address)"

	if [ -z "${adapter}" ]
	then
		frobulator.err "Restore failure - no bluetooth adapter" "[ bluetoothctl${marker_spc}${marker_hnt}${marker_spc}none ]"

		return 1
	fi

	# keys file is a tar.gz archive holding the bluetooth directory

	frobulator.temporary directory_keys_temporary

	frobulator.trap "${directory_keys_temporary}"

	file_keys_archive="${directory_keys_temporary}/bluetooth-keys.tar.gz"

	cp -f "${file_bluetooth_keys}" "${file_keys_archive}"

	frobulator.extract "${file_keys_archive}" "${directory_keys_temporary}" > "${sink}"

	frobulator.track || return 1

	frobulator.stp "Stopping" "[ bluetooth ]"

	systemctl stop bluetooth

	# devices go under the current adapter - even if it changed

	mkdir -p "${directory_bluetooth}/${adapter}"

	for adapter_archived in "${directory_keys_temporary}"/bluetooth/??:??:??:??:??:??
	do
		for device_directory in "${adapter_archived}"/??:??:??:??:??:??
		do
			if [ ! -f "${device_directory}/info" ]
			then
				continue
			fi

			device_address="${device_directory##*/}"

			cp -a "${device_directory}" "${directory_bluetooth}/${adapter}/"

			frobulator.track

			# alias set on this computer - otherwise the name the device reports

			device_alias="$(info_value "${device_directory}/info" Alias)"
			device_reported_name="$(info_value "${device_directory}/info" Name)"

			device_name="${device_alias:-${device_reported_name}}"

			device_list_label="$(device_label "${device_name}")"

			frobulator.scs "Restore success - device" "[ '${device_list_label}'${marker_spc}${marker_hnt}${marker_spc}${device_address} ]"
		done

		# adapter settings (name / discoverable) only for the same adapter

		if [ "${adapter_archived##*/}" = "${adapter}" ] && [ -f "${adapter_archived}/settings" ]
		then
			cp -f "${adapter_archived}/settings" "${directory_bluetooth}/${adapter}/settings"
		fi
	done

	chmod -R go-rwx "${directory_bluetooth}"

	frobulator.fwd "Starting" "[ bluetooth ]"

	systemctl start bluetooth

	frobulator.track

	return "${status}"
}

audio_restore () {

	# connect each device - then apply its saved profile / volume / mute / default output

	local status=0

	local audio_label
	local audio_address
	local audio_profile
	local audio_volume
	local audio_mute
	local audio_default
	local audio_sink
	local audio_attempt
	local audio_second
	local audio_device_information

	if [ ! -f "${file_audio_settings}" ]
	then
		frobulator.wrn "Audio settings not restored - none saved" "[ '${file_audio_settings##*/}'${marker_spc}${marker_hnt}${marker_spc}missing ]"

		return 0
	fi

	while IFS=$'\t' read -r audio_label audio_address audio_profile audio_volume audio_mute audio_default
	do
		# speakers often answer only after a few page timeouts

		for audio_attempt in {1..6}
		do
			# bluez device details - including its 'Connected: yes / no' line

			audio_device_information="$(bluetoothctl info "${audio_address}" 2> "${sink}")"

			if [[ "${audio_device_information}" = *"Connected: yes"* ]]
			then
				break
			fi

			bluetoothctl connect "${audio_address}" > "${sink}" 2>&1

			sleep 2
		done

		unset audio_sink

		for audio_second in {1..15}
		do
			audio_sink="$(audio_sink_name "${audio_address}")"

			if [ -n "${audio_sink}" ]
			then
				break
			fi

			sleep 1
		done

		if [ -z "${audio_sink}" ]
		then
			frobulator.wrn "Audio settings skipped - not connected" "[ '${audio_label}'${marker_spc}${marker_hnt}${marker_spc}${audio_address} ]"

			status=1

			continue
		fi

		if [ -n "${audio_profile}" ]
		then
			audio_user pactl set-card-profile "bluez_card.${audio_address//:/_}" "${audio_profile}" 2> "${sink}"

			frobulator.track

			# the sink name follows the profile

			sleep 2

			audio_sink="$(audio_sink_name "${audio_address}")"
		fi

		audio_user pactl set-sink-volume "${audio_sink}" "${audio_volume}"

		frobulator.track

		audio_user pactl set-sink-mute "${audio_sink}" "${audio_mute}"

		frobulator.track

		if [ "${audio_default}" = "default" ]
		then
			audio_user pactl set-default-sink "${audio_sink}"

			frobulator.track
		fi

		frobulator.scs "Restore success - audio settings" "[ '${audio_label}'${marker_spc}${marker_hnt}${marker_spc}${audio_volume} ]"
	done < "${file_audio_settings}"

	return "${status}"
}

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(

)

frobulator.require ${list[@]}

list=()

# configuration ────────────────────────────────────────────────────────────────

# bluez command line client - empty if not installed

bluetooth_client="$(command -v bluetoothctl)"

if [ -z "${bluetooth_client}" ]
then
	frobulator.err "BlueZ not installed" "[ bluetoothctl ]"

	exit 1
fi

if [ ! -d "${directory}" ]
then
	frobulator.err "Directory not found" "[ ${directory} ]"

	exit 1
fi

frobulator.inf "Device files directory" "[ ${directory} ]"

if [ "${option}" = "backup" ]
then
	devices_backup

	frobulator.complete continue "Backup failure - devices"

	audio_backup

	frobulator.complete continue "Backup failure - audio settings"

	frobulator.ownership "${file_device_index}" "${file_audio_settings}" > "${sink}"

elif [ "${option}" = "restore" ]
then
	devices_restore

	frobulator.complete continue "Restore failure - devices"

	audio_restore

	frobulator.complete continue "Restore failure - audio settings"

	sleep 3

	frobulator.inf "Paired devices"

	bluetoothctl devices Paired 2> "${sink}"
fi

frobulator.result "${script}"
