#!/bin/bash

# loaded by "${HOME}"/.local/bin/bash-functions

# audio control ────────────────────────────────────────────────────────────────

audio_combine_connect () {

	# connect a bluetooth device unless already connected - wait for each attempt:
	# speakers often answer only after a few page timeouts

	local bluetooth_address="${1}"

	local connect_attempt
	local connect_second
	local bluetooth_information

	for connect_attempt in {1..6}
	do
		# bluez device details - including its 'Connected: yes / no' line

		bluetooth_information="$(bluetoothctl info "${bluetooth_address}" 2> "${sink}")"

		if [[ "${bluetooth_information}" = *"Connected: yes"* ]]
		then
			return 0
		fi

		bluetoothctl connect "${bluetooth_address}" > "${sink}" 2>&1

		for connect_second in {1..10}
		do
			bluetooth_information="$(bluetoothctl info "${bluetooth_address}" 2> "${sink}")"

			if [[ "${bluetooth_information}" = *"Connected: yes"* ]]
			then
				return 0
			fi

			sleep 1
		done
	done

	return 1
}

audio_combine_sink_wait () {

	# wait for a sink to appear

	local sink_name="${1}"
	local sink_timeout="${2:-15}"

	local sink_second
	local sink_list

	for (( sink_second=0 ; sink_second<sink_timeout ; sink_second++ ))
	do
		# one line per sink: index / name / driver / format / state - tab separated

		sink_list="$(pactl list short sinks)"

		if [[ "${sink_list}" = *"	${sink_name}	"* ]]
		then
			return 0
		fi

		sleep 1
	done

	return 1
}

audio_combine_outputs () {

	# number of outputs the combined sink currently plays to

	local sink_input_count=0

	local sink_input_line

	while IFS= read -r sink_input_line
	do
		if [[ "${sink_input_line}" = *module-combine-sink* ]]
		then
			sink_input_count=$(( sink_input_count + 1 ))
		fi
	done < <(pactl list short sink-inputs)

	echo "${sink_input_count}"
}

audio_combine_load () {

	# (re)create the combined sink - make it default - move playing streams to it

	local sink_combined="${1}"

	local sink_slave
	local sink_input_index
	local sink_input_sink
	local sink_input_client
	local sink_input_driver
	local slaves_joined

	local -a sink_slaves=("${@:2}")

	audio_combine_unload "${sink_combined}"

	slaves_joined="${sink_slaves[*]}"

	# adjust_time=0: no rate adjustment timer - pulseaudio 16.1 aborts in its callback
	# ('u->time_event == e' in module-combine-sink time_callback) - dropping both speakers

	pactl load-module module-combine-sink sink_name="${sink_combined}" slaves="${slaves_joined// /,}" adjust_time=0 > "${sink}" || return

	pactl set-default-sink "${sink_combined}"

	while IFS=$'\t' read -r sink_input_index sink_input_sink sink_input_client sink_input_driver
	do
		if [[ "${sink_input_driver}" != module-combine-sink* ]]
		then
			pactl move-sink-input "${sink_input_index}" "${sink_combined}" 2> "${sink}"
		fi
	done < <(pactl list short sink-inputs)

	for sink_slave in "${sink_slaves[@]}"
	do
		pactl set-sink-volume "${sink_slave}" 100%
	done

	pactl set-sink-volume "${sink_combined}" 75%
}

audio_combine_watch () {

	# background watcher: reconnect dropped speakers - rebuild the combined sink once they return

	local file_watch_pid="${1}"
	local sink_combined="${2}"

	local -a bluetooth_addresses=(${3})
	local -a sink_slaves=("${@:4}")

	(
		pactl subscribe | while IFS= read -r audio_event
		do
			if [[ "${audio_event}" = *"'remove' on sink"* ]]
			then
				# bluetooth still reports the device connected while it drops

				sleep 5

				for bluetooth_address in "${bluetooth_addresses[@]}"
				do
					audio_combine_connect "${bluetooth_address}" &
				done

			elif [[ "${audio_event}" = *"'new' on sink"* ]]
			then
				sleep 2

				sink_list="$(pactl list short sinks)"

				for sink_slave in "${sink_slaves[@]}"
				do
					if [[ "${sink_list}" != *"	${sink_slave}	"* ]]
					then
						continue 2
					fi
				done

				# speakers the combined sink plays to

				sink_outputs="$(audio_combine_outputs)"

				if [ "${sink_outputs}" -lt "${#sink_slaves[@]}" ]
				then
					audio_combine_load "${sink_combined}" "${sink_slaves[@]}"
				fi
			fi
		done
	) > "${sink}" 2>&1 &

	echo "${!}" > "${file_watch_pid}"

	disown
}

audio_combine_watch_stop () {

	# stop the background watcher

	local file_watch_pid="${1}"

	if [ -f "${file_watch_pid}" ]
	then
		pkill -P "$(< "${file_watch_pid}")" 2> "${sink}"
		kill "$(< "${file_watch_pid}")" 2> "${sink}"

		rm -f "${file_watch_pid}"
	fi
}

audio_combine_unload () {

	# remove the combined sink

	local sink_combined="${1}"

	local module_index
	local module_line

	while IFS=$'\t' read -r module_index module_line
	do
		if [[ "${module_line}" = module-combine-sink*"sink_name=${sink_combined}"* ]]
		then
			pactl unload-module "${module_index}"
		fi
	done < <(pactl list short modules)
}

audio-combine () {

	# combine two bluetooth speakers into one output - kept alive across dropouts
	# usage: audio-combine [stop]

	local sink_combined="bluez_sink_combined"

	local -a bluetooth_addresses=(

		"FC:E8:06:19:8E:9C"
		"FC:E8:06:19:77:00"
	)
	local bluetooth_address
	local -a sink_slaves=()
	local sink_slave
	local file_watch_pid="${XDG_RUNTIME_DIR:-/tmp}/audio-combine.pid"

	for bluetooth_address in "${bluetooth_addresses[@]}"
	do
		sink_slaves+=("bluez_sink.${bluetooth_address//:/_}.a2dp_sink")
	done

	if [ "${1}" = "stop" ]
	then
		audio_combine_watch_stop "${file_watch_pid}"
		audio_combine_unload "${sink_combined}"

		frobulator.inf "Combined audio stopped" "[ ${sink_combined} ]"

		return 0
	fi

	# connect bluetooth devices

	for bluetooth_address in "${bluetooth_addresses[@]}"
	do
		if ! audio_combine_connect "${bluetooth_address}"
		then
			frobulator.err "Unable to connect" "[ ${bluetooth_address} ]"
			frobulator.nul "Make sure the device is powered on, paired and trusted."

			return 1
		fi
	done

	for sink_slave in "${sink_slaves[@]}"
	do
		if ! audio_combine_sink_wait "${sink_slave}" 15
		then
			frobulator.err "Sink not found after connecting" "[ ${sink_slave} ]"
			frobulator.nul "Run 'pactl list short sinks' for details."

			return 1
		fi
	done

	audio_combine_load "${sink_combined}" "${sink_slaves[@]}" || return

	# one watcher at a time

	audio_combine_watch_stop "${file_watch_pid}"

	audio_combine_watch "${file_watch_pid}" "${sink_combined}" "${bluetooth_addresses[*]}" "${sink_slaves[@]}"

	frobulator.scs "Combined audio active" "[ ${sink_combined} ]"
}
