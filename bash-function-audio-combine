#!/bin/bash

# loaded by "${HOME}"/.local/bin/bash-functions

# audio control ────────────────────────────────────────────────────────────────

audio_combine_connect () {

	# connect a bluetooth device unless already connected - wait for each attempt:
	# speakers often answer only after a few page timeouts

	local address_bluetooth="${1}"

	local index_attempt
	local index_second_connect
	local information_bluetooth

	for index_attempt in {1..6}
	do
		# bluez device details - including its 'Connected: yes / no' line

		information_bluetooth="$(bluetoothctl info "${address_bluetooth}" 2> "${sink}")"

		if [[ "${information_bluetooth}" = *"Connected: yes"* ]]
		then
			return 0
		fi

		bluetoothctl connect "${address_bluetooth}" > "${sink}" 2>&1

		for index_second_connect in {1..10}
		do
			information_bluetooth="$(bluetoothctl info "${address_bluetooth}" 2> "${sink}")"

			if [[ "${information_bluetooth}" = *"Connected: yes"* ]]
			then
				return 0
			fi

			sleep 1
		done
	done

	return 1
}

audio_combine_sink_wait () {

	# wait for a sink to appear

	local name_sink="${1}"
	local timeout_sink="${2:-15}"

	local index_second_wait
	local list_sinks

	for (( index_second_wait = 0 ; index_second_wait < timeout_sink ; index_second_wait ++ ))
	do
		# one line per sink: index / name / driver / format / state - tab separated

		list_sinks="$(pactl list short sinks)"

		if [[ "${list_sinks}" = *"	${name_sink}	"* ]]
		then
			return 0
		fi

		sleep 1
	done

	return 1
}

audio_combine_outputs () {

	# number of outputs the combined sink currently plays to

	local count_inputs_combined=0

	local line_input_sink

	while IFS= read -r line_input_sink
	do
		if [[ "${line_input_sink}" = *module-combine-sink* ]]
		then
			count_inputs_combined=$(( count_inputs_combined + 1 ))
		fi
	done < <(pactl list short sink-inputs)

	echo "${count_inputs_combined}"
}

audio_combine_load () {

	# (re)create the combined sink - make it default - move playing streams to it

	local name_sink_combined="${1}"

	local name_sink_slave
	local index_input
	local name_sink_input
	local client_input
	local driver_input
	local text_slaves_joined

	local -a list_sinks_slave=("${@:2}")

	audio_combine_unload "${name_sink_combined}"

	text_slaves_joined="${list_sinks_slave[*]}"

	# adjust_time=0: no rate adjustment timer - pulseaudio 16.1 aborts in its callback
	# ('u->time_event == e' in module-combine-sink time_callback) - dropping both speakers

	pactl load-module module-combine-sink sink_name="${name_sink_combined}" slaves="${text_slaves_joined// /,}" adjust_time=0 > "${sink}" || return

	pactl set-default-sink "${name_sink_combined}"

	while IFS=$'\t' read -r index_input name_sink_input client_input driver_input
	do
		if [[ "${driver_input}" != module-combine-sink* ]]
		then
			pactl move-sink-input "${index_input}" "${name_sink_combined}" 2> "${sink}"
		fi
	done < <(pactl list short sink-inputs)

	for name_sink_slave in "${list_sinks_slave[@]}"
	do
		pactl set-sink-volume "${name_sink_slave}" 100%
	done

	pactl set-sink-volume "${name_sink_combined}" 75%
}

audio_combine_watch () {

	local line_event_audio
	local count_outputs_combined

	# background watcher: reconnect dropped speakers - rebuild the combined sink once they return

	local file_pid_watch="${1}"
	local name_sink_combined="${2}"

	local -a list_addresses_bluetooth=(${3})
	local -a list_sinks_slave=("${@:4}")
	local address_bluetooth
	local list_sinks
	local name_sink_slave

	(
		pactl subscribe | while IFS= read -r line_event_audio
		do
			if [[ "${line_event_audio}" = *"'remove' on sink"* ]]
			then
				# bluetooth still reports the device connected while it drops

				sleep 5

				for address_bluetooth in "${list_addresses_bluetooth[@]}"
				do
					audio_combine_connect "${address_bluetooth}" &
				done

			elif [[ "${line_event_audio}" = *"'new' on sink"* ]]
			then
				sleep 2

				list_sinks="$(pactl list short sinks)"

				for name_sink_slave in "${list_sinks_slave[@]}"
				do
					if [[ "${list_sinks}" != *"	${name_sink_slave}	"* ]]
					then
						continue 2
					fi
				done

				# speakers the combined sink plays to

				count_outputs_combined="$(audio_combine_outputs)"

				if [ "${count_outputs_combined}" -lt "${#list_sinks_slave[@]}" ]
				then
					audio_combine_load "${name_sink_combined}" "${list_sinks_slave[@]}"
				fi
			fi
		done
	) > "${sink}" 2>&1 &

	echo "${!}" > "${file_pid_watch}"

	disown
}

audio_combine_watch_stop () {

	# stop the background watcher

	local file_pid_watch="${1}"

	if [ -f "${file_pid_watch}" ]
	then
		pkill -P "$(< "${file_pid_watch}")" 2> "${sink}"
		kill "$(< "${file_pid_watch}")" 2> "${sink}"

		rm -f "${file_pid_watch}"
	fi
}

audio_combine_unload () {

	# remove the combined sink

	local name_sink_combined="${1}"

	local index_module
	local line_module

	while IFS=$'\t' read -r index_module line_module
	do
		if [[ "${line_module}" = module-combine-sink*"sink_name=${name_sink_combined}"* ]]
		then
			pactl unload-module "${index_module}"
		fi
	done < <(pactl list short modules)
}

audio-combine () {

	# combine two bluetooth speakers into one output - kept alive across dropouts
	# usage: audio-combine [stop]

	local name_sink_combined="bluez_sink_combined"

	local -a list_addresses_bluetooth=(

		"FC:E8:06:19:8E:9C"
		"FC:E8:06:19:77:00"
	)
	local address_bluetooth
	local -a list_sinks_slave=()
	local name_sink_slave
	local file_pid_watch="${XDG_RUNTIME_DIR:-/tmp}/audio-combine.pid"
	local status_connect
	local status_wait

	for address_bluetooth in "${list_addresses_bluetooth[@]}"
	do
		list_sinks_slave+=("bluez_sink.${address_bluetooth//:/_}.a2dp_sink")
	done

	if [ "${1}" = "stop" ]
	then
		audio_combine_watch_stop "${file_pid_watch}"
		audio_combine_unload "${name_sink_combined}"

		frobulator.inf "Combined audio stopped" "[ ${name_sink_combined} ]"

		return 0
	fi

	# connect bluetooth devices

	for address_bluetooth in "${list_addresses_bluetooth[@]}"
	do
		audio_combine_connect "${address_bluetooth}"

		status_connect="${?}"

		if [ "${status_connect}" -ne 0 ]
		then
			frobulator.err "Unable to connect" "[ ${address_bluetooth} ]"
			frobulator.nul "Make sure the device is powered on, paired and trusted."

			return 1
		fi
	done

	for name_sink_slave in "${list_sinks_slave[@]}"
	do
		audio_combine_sink_wait "${name_sink_slave}" 15

		status_wait="${?}"

		if [ "${status_wait}" -ne 0 ]
		then
			frobulator.err "Sink not found after connecting" "[ ${name_sink_slave} ]"
			frobulator.nul "Run 'pactl list short sinks' for details."

			return 1
		fi
	done

	audio_combine_load "${name_sink_combined}" "${list_sinks_slave[@]}" || return

	# one watcher at a time

	audio_combine_watch_stop "${file_pid_watch}"

	audio_combine_watch "${file_pid_watch}" "${name_sink_combined}" "${list_addresses_bluetooth[*]}" "${list_sinks_slave[@]}"

	frobulator.scs "Combined audio active" "[ ${name_sink_combined} ]"
}
