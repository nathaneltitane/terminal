#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

frobulator="${HOME}"/.local/bin/frobulator

source "${frobulator}"

# superuser ────────────────────────────────────────────────────────────────────

# script ───────────────────────────────────────────────────────────────────────

# version ──────────────────────────────────────────────────────────────────────

version="2026-09-20"

# defaults ─────────────────────────────────────────────────────────────────────

self="${BASH_SOURCE[0]}"

# usage ────────────────────────────────────────────────────────────────────────

# executed directly: install only

if [[ "${self}" = "${0}" ]]
then
	script="$(basename -- "${self}")"

	directory_install="${HOME}"/.local/bin

	while (($#))
	do
		case "${1}"
		in
			-i|--install)
				option="install"
			;;

			-h|--help)
				echo
				echo -e "Usage: ./${script} -i | -h"
				echo
				echo -e "Options:"
				echo
				echo -e "-i, --install    Run [i]nstallation of ${script} to ${directory_install}."
				echo
				echo -e "-h, --help       Show [h]elp and usage information."
				echo
				echo -e "'${script}'      [ Version // ${version} ]"
				echo

				exit
			;;

			"")
				# handle empty argument:
				# use default values specified in script

				:
			;;

			*)
				echo
				echo -e "Usage: ./${script} -i | -h"
				echo
				echo -e "Unknown option: '${script} ${1}':"
				echo -e "Type './${script} -h' for help and usage information."
				echo

				exit 1

			;;

			esac

		shift

	done

	# default to install

	if [ -z "${option}" ]
	then
		option="install"
	fi

	# install

	if [ "${option}" = "install" ]
	then
		file_script="$(realpath "${self}")"

		directory_script="$(dirname "${file_script}")"

		if [ "${directory_script}" -ef "${directory_install}" ]
		then
			frobulator.inf "Already installed" "[ ${directory_install}/${script} ]"
		else
			frobulator.copy "${directory_script}" "${directory_install}" "${script}"

			frobulator.permissions public execute "${directory_install}/${script}"

			frobulator.scs "Installed" "[ ${directory_install}/${script} ]"
		fi
	fi

	exit
fi

# adb ──────────────────────────────────────────────────────────────────────────

adb_download () {

	local directory_temporary
	local archive
	local path_extracted

	frobulator.temporary directory_temporary

	if [ -z "${directory_temporary}" ] || [ ! -d "${directory_temporary}" ]
	then
		frobulator.err "Unable to create temporary directory"

		exit 1
	fi

	archive="${directory_temporary}/platform-tools.zip"
	path_extracted="${directory_temporary}/platform-tools"

	frobulator.inf "Fetching latest" "[ Android Platform Tools ]"

	curl						\
		--silent				\
		--fail					\
		--location				\
		--output "${archive}"	\
								"${url_android_platform_tools}"

	if [ "${?}" -ne 0 ]
	then
		frobulator.delete "${directory_temporary}"

		frobulator.err "Unable to fetch" "[ Android Platform Tools ]"

		exit 1
	fi

	unzip -q "${archive}" -d "${directory_temporary}"

	if [ "${?}" -ne 0 ]
	then
		frobulator.delete "${directory_temporary}"

		frobulator.err "Unable to extract" "[ Android Platform Tools ]"

		exit 1
	fi

	if [ ! -x "${path_extracted}/adb" ] || [ ! -x "${path_extracted}/fastboot" ]
	then
		frobulator.delete "${directory_temporary}"

		frobulator.err "Invalid archive" "[ Android Platform Tools ]"

		exit 1
	fi

	frobulator.terminate "adb"

	frobulator.directory "${path_android}"

	frobulator.directory "${HOME}/.local/bin"

	frobulator.delete "${path_android_platform_tools}"

	mv "${path_extracted}" "${path_android_platform_tools}"

	list=(
		adb
		fastboot
	)

	for item in "${list[@]}"
	do
		frobulator.link "${path_android_platform_tools}" "${HOME}/.local/bin" "${item}"
	done

	list=()

	if [ "${USER}" != "root" ]
	then
		chown -R "${USER}:$(id -g "${USER}")" "${path_android}" "${HOME}/.local/bin/adb" "${HOME}/.local/bin/fastboot"
	fi

	frobulator.delete "${directory_temporary}"

	export PATH="${HOME}/.local/bin:${path_android_platform_tools}:${PATH}"

	hash -r

	frobulator.fwd "Utilities version: $(adb version | head -n 1)"

	frobulator.scs "Utilities deployment ready" "[ Android Platform Tools ]"

}

adb_set_environment () {

	if [[ $(command -v adb) ]]
	then
		export ANDROID_NO_USE_FWMARK=1

		if [ ! -d "${HOME}"/.adb ]
		then
			mkdir -p "${HOME}"/.adb
		fi

		export ADB_SERVER_SOCKET=localfilesystem:"${HOME}"/.adb/adb_server_socket
	fi
}

adb_screenshot () {

	adb_download

	adb_set_environment

	adb shell screencap -p /sdcard/"${screenshot}"

	adb pull /sdcard/"${screenshot}" screenshot/"${screenshot}"

	adb shell rm /sdcard/"${screenshot}"
}

adb_record () {

	adb_download

	adb_set_environment

	adb shell screenrecord /storage/emulated/0/Videos/"${recording}" &

	adb_record_PID=$!

	read -r -p 'Press enter to stop recording...'

	kill ${adb_record_PID} > "${sink}" 2>&1

	sleep 0.5

	adb pull /sdcard/"${recording}" screenrecord/"${recording}"

	adb shell rm /sdcard/"${recording}"
}

adb_pull_package () {

	adb_download

	adb_set_environment

	if [[ ! -d ./apk ]]
	then
		mkdir -p "${HOME}"/Android

		cd "${HOME}"/Android
	fi

	for package in $(adb shell pm list packages | sed -n 's/^package://p')
	do
		adb pull "$(adb shell pm path "${package}" | grep /data/app | sed -n "s/^package://p")"

		mv base.apk "${package}".apk
	done
}

adb_install_package () {

	adb_download

	adb_set_environment

	package="${1}"

	adb install "${package}"
}

adb_remove_package () {

	adb_download

	adb_set_environment

	package="${1}"

	adb uninstall --user 0 "${package}"
}

adb_settings_get () {

	adb_download

	adb_set_environment

	setting="${1}"

	adb shell settings get "${setting}"
}

adb_settings_put () {

	adb_download

	adb_set_environment

	setting="${1}"

