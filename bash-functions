#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

frobulator="${HOME}"/.local/bin/frobulator

source "${frobulator}"

# superuser ────────────────────────────────────────────────────────────────────

# script ───────────────────────────────────────────────────────────────────────

# version ──────────────────────────────────────────────────────────────────────

version="2026-09-20"

# defaults ─────────────────────────────────────────────────────────────────────

self="${BASH_SOURCE[0]}"

# usage ────────────────────────────────────────────────────────────────────────

# executed directly: install only

if [[ "${self}" = "${0}" ]]
then
	script="$(basename -- "${self}")"

	directory_install="${HOME}"/.local/bin

	while (( $# ))
	do
		case "${1}"
		in
			-i|--install)
				option="install"
			;;

			-h|--help)
				echo
				echo -e "Usage: ./${script} -i | -h"
				echo
				echo -e "Options:"
				echo
				echo -e "-i, --install    Run [i]nstallation of ${script} to ${directory_install}."
				echo
				echo -e "-h, --help       Show [h]elp and usage information."
				echo
				echo -e "'${script}'      [ Version // ${version} ]"
				echo

				exit
			;;

			"")
				# handle empty argument:
				# use default values specified in script

				:
			;;

			*)
				echo
				echo -e "Usage: ./${script} -i | -h"
				echo
				echo -e "Unknown option: '${script} ${1}':"
				echo -e "Type './${script} -h' for help and usage information."
				echo

				exit 1

			;;

			esac

		shift

	done

	# default to install

	if [ -z "${option}" ]
	then
		option="install"
	fi

	# install

	if [ "${option}" = "install" ]
	then
		# blank line - output separated from the shell prompt

		echo

		file_script="$(realpath "${self}")"

		directory_script="$(dirname "${file_script}")"

		# script - copied unless already in place

		if [ "${directory_script}" -ef "${directory_install}" ]
		then
			frobulator.inf "Already installed" "[ ${directory_install}/${script} ]"
		else
			frobulator.copy "${directory_script}" "${directory_install}" "${script}"

			frobulator.permissions public execute "${directory_install}/${script}"
		fi

		# one file per function - copied from beside this script - downloaded from the repository otherwise

		list_functions=()

		for file_function in "${directory_script}"/bash-function-*
		do
			if [ -f "${file_function}" ]
			then
				list_functions+=("$(basename -- "${file_function}")")
			fi
		done

		if [ "${#list_functions[@]}" -gt 0 ] && [ ! "${directory_script}" -ef "${directory_install}" ]
		then
			for name_function in "${list_functions[@]}"
			do
				frobulator.copy "${directory_script}" "${directory_install}" "${name_function}"
			done
		else
			# function names listed from the repository

			list=($(curl --silent --location --connect-timeout 30 "${marker_hts}api.github.com/repos/nathaneltitane/terminal/contents" | jq -r '.[].name | select(startswith("bash-function-"))'))

			if [ "${#list[@]}" -eq 0 ]
			then
				frobulator.err "Unable to list function files" "[ github.com/nathaneltitane/terminal ]"

				exit 1
			fi

			frobulator.download get.trmnl.me "${directory_install}" ${list[@]}

			list=()
		fi

		frobulator.scs "Installed" "[ ${directory_install}/${script} ]"
	fi

	exit
fi

# functions ────────────────────────────────────────────────────────────────────

# each function file next to this one holds one function and its helpers

for file_function in "${HOME}"/.local/bin/bash-function-*
do
	if [ -f "${file_function}" ]
	then
		source "${file_function}"
	fi
done

unset file_function
