# system ───────────────────────────────────────────────────────────────────────

temperature () {

	if [[ -d /sys/class/thermal ]]
	then
		acpitz_count=0
		cpu_label=""
		cpu_degrees=""
		lines=()
		max_length=0

		for zone in /sys/class/thermal/thermal_zone*
		do
			label=$(cat "${zone}"/type)

			if [ "${label}" = "acpitz" ]
			then
				acpitz_count=$(( acpitz_count + 1 ))

				label="System ${acpitz_count}"

			elif [[ "${label}" = pch_* ]]
			then
				label="Chipset"

			elif [[ "${label}" = iwlwifi_* ]]
			then
				label="WiFi"

			elif [ "${label}" = "x86_pkg_temp" ]
			then
				label="CPU"

			else
				label="${label//_/ }"
			fi

			degrees=$(cat "${zone}"/temp)
			degrees=$(( degrees / 1000 ))

			if [ "${#label}" -gt "${max_length}" ]
			then
				max_length="${#label}"
			fi

			if [ "${label}" = "CPU" ]
			then
				cpu_label="${label}"
				cpu_degrees="${degrees}"
			else
				lines+=("${label}|${degrees}")
			fi
		done

		pad=$(( max_length + 4 ))

		if [ -n "${cpu_label}" ]
		then
			printf "%-${pad}s%s°C\n" "${cpu_label}:" "${cpu_degrees}"
		fi

		printf '%s\n' "${lines[@]}" | sort |
		while IFS='|' read -r label degrees
		do
			printf "%-${pad}s%s°C\n" "${label}:" "${degrees}"
		done

		unset acpitz_count cpu_label cpu_degrees lines max_length pad
	fi

}

# llm ──────────────────────────────────────────────────────────────────────────

clo () {

	local command

	command="claude"

	if [[ -z $(command -v "${command}") ]]
	then
		frobulator.err "Command not found" "[ ${command} ]"

		return 1
	fi

	directory_projects="${HOME}/.${command}/projects"

	if [ ! -d "${directory_projects}" ]
	then
		frobulator.wrn "No session history found."

		return 1
	fi

	file_search=(find "${directory_projects}" -name '*.jsonl' -printf '%T@ %p\n')

	file_session=$("${file_search[@]}" 2>"${sink}" | sort -r -n | head -n 1 | cut -d ' ' -f 2-)

	if [ -z "${file_session}" ]
	then
		frobulator.wrn "No saved session(s) found."

		return 1
	fi

	echo

	id_session="$(basename "${file_session}" .jsonl)"

	frobulator.scs "Session found."

	frobulator.inf "Resuming session" "[ ${id_session} ]"

	claude --resume "${id_session}"

	unset command

}
