# media ────────────────────────────────────────────────────────────────────────

media () {

	local type="${1}"
	local source="${2}"
	local path="${3}"
	local directory_binary="${HOME}/.local/bin"
	local archive
	local file
	local files
	local directory
	local name_source
	local name_target
	local browser
	local duration_sleep
	local format
	local format_media
	local -a options_type=()
	local -a options_url=()
	local -a options_site=()

	if [ -z "${type}" ]
	then
		frobulator.err "No type specified" "[ audio | video ]"

		return 1
	fi

	if [ "${type}" != "audio" ] && [ "${type}" != "video" ]
	then
		frobulator.err "Invalid type" "[ ${type} ]"

		return 1
	fi

	if [ -z "${source}" ]
	then
		frobulator.err "No source specified"

		return 1
	fi

	if [ -z "${path}" ]
	then
		path="${PWD}"
	fi

	if [ ! -d "${path}" ]
	then
		path="${PWD}"
	fi

	if [ ! -f "${directory_binary}/yt-dlp" ]
	then
		frobulator.download "https://github.com/yt-dlp/yt-dlp/releases/latest/download" "${directory_binary}" "yt-dlp"
	else
		frobulator.silence "${directory_binary}/yt-dlp --update"
	fi

	if [ ! -x "${directory_binary}/yt-dlp" ]
	then
		frobulator.err "Downloader unavailable" "[ yt-dlp ]"

		return 1
	fi

	if [ ! -f "${directory_binary}/deno" ]
	then
		archive="deno-x86_64-unknown-linux-gnu.zip"

		frobulator.download "https://github.com/denoland/deno/releases/latest/download" "${directory_binary}" "${archive}"

		unzip -o -q "${directory_binary}/${archive}" -d "${directory_binary}"

		rm -f "${directory_binary}/${archive}"

		chmod +x "${directory_binary}/deno"
	else
		frobulator.silence "${directory_binary}/deno upgrade"
	fi

	if [ ! -x "${directory_binary}/deno" ]
	then
		frobulator.err "Solver unavailable" "[ deno ]"

		return 1
	fi

	if [ "${type}" = "audio" ]
	then
		format="bestaudio"
		format_media="mp3"

		options_type+=( --extract-audio )
		options_type+=( --audio-format "${format_media}" )
		options_type+=( --audio-quality best )
		options_type+=( --output '%(uploader)s - %(title)s.%(ext)s' )

	elif [ "${type}" = "video" ]
	then
		format="bestvideo+bestaudio"
		format_media="mp4"

		options_type+=( --merge-output-format "${format_media}" )
		options_type+=( --output '%(uploader)s/%(playlist)s/%(playlist_index)s - %(title)s.%(ext)s' )
	fi

	if [ -f "${source}" ]
	then
		options_url+=( --batch-file )
	fi

	if [ "${source#*soundcloud.com}" = "${source}" ]
	then
		browser="$(xdg-settings get default-web-browser 2>"${sink}")"

		browser="${browser%.desktop}"

		if [[ "${browser}" = firefox* ]] ||
		[[ "${browser}" = librewolf*  ]] ||
		[[ "${browser}" = waterfox*   ]]
		then
			browser="firefox"

		elif [[ "${browser}" = chrome*       ]] ||
			[[ "${browser}" = google-chrome* ]] ||
			[[ "${browser}" = chromium*      ]] ||
			[[ "${browser}" = brave*         ]] ||
			[[ "${browser}" = vivaldi*       ]] ||
			[[ "${browser}" = opera*         ]]
		then
			browser="chrome"

		else
			frobulator.err "No compatible browser found on system"

			return 1
		fi

		options_site+=( --cookies-from-browser "${browser}" )
	fi

	cd "${path}"

	duration_sleep=$(( RANDOM % 5 + 1 ))

	"${directory_binary}/yt-dlp"									\
		--remote-components		"ejs:github"				\
		--js-runtimes			"deno:${directory_binary}/deno"	\
		--ffmpeg-location		"/usr/bin/ffmpeg"			\
		--quiet												\
		--no-update											\
		--ignore-errors										\
		--no-overwrites										\
		--sleep-requests		"${duration_sleep}"			\
		--yes-playlist										\
		--format				"${format}"					\
		"${options_site[@]}"								\
		"${options_type[@]}"								\
		"${options_url[@]}"									\
		"${source}" &

	frobulator.progress download

	files="$(find "${PWD}" -type f -iname "*.${format_media}")"

	IFS=$'\n'

	for file in ${files}
	do
		directory="${file%/*}"
		name_source="${file##*/}"

		name_target="${name_source// - Topic/}"

		if [ "${name_source}" != "${name_target}" ]
		then
			mv -- "${file}" "${directory}/${name_target}"
		fi
	done

	unset IFS
}

# find ─────────────────────────────────────────────────────────────────────────

locate () {

	type="${1}"

	query="${2}"

	if [[ "${type}" =~ ^(d|dir|directory)$ ]]
	then
		type='d'

	elif [[ "${type}" =~ ^(f|file)$ ]]
	then
		type='f'
	else
		echo "unsupported type"
		echo

		exit 1
	fi

	if [[ $(command -v find) ]]
	then
		find								\
			"${PWD}"						\
				-type			"${type}"	\
				-iname 			"*${query}*"
	fi

}

# secure shell ─────────────────────────────────────────────────────────────────

ssh () {

	# destination is always the last argument

	destination=${!#}

	echo -n -e "[  $(tput setaf 3)${destination}$(tput sgr 0)  ] >_ ? "

	read -r -s password

	echo

	sshpass					\
		-p "${password}"	\
							ssh -X "${@}"

	unset destination

	unset password

}

ssh-check () {

timeout="0.5"

lan="${1}"

if [ -z "${lan}" ]
then
    echo "Usage: ${0} <LAN_PREFIX> (e.g., ${0} 192.168.0 or 192.168.0.1)"
    echo

    exit 1
fi

# extract the first 3 octets from user input:
# sanitize to nnn.nnn.nnn.

lan=$(
		echo "${lan}" | grep -oE '^([0-9]{1,3}\.){2}[0-9]{1,3}' | awk -F. '{print $1"."$2"."$3"."}'
	)

	for i in {1..255}
	do
		ip="${lan}${i}"

		timeout "${timeout}" "${SHELL}" -c "echo > /dev/tcp/${ip}/22" 2> "${sink}"

		if [ ${?} -eq 0 ]
		then
			frobulator.scs "SSH open" "[ ${ip} ]"
		else
			frobulator.err "${ip}" &
		fi

	done | grep "open"

}

# music mirror ─────────────────────────────────────────────────────────────────

music-mirror () {

	# mirror external drive music to the phone, folder by folder, for the folders the phone keeps:
	# a folder's subfolders on the phone are each mirrored, or the folder itself when it has none
	# usage: music-mirror [utility-add-remove options: -e execute, -y skip confirmation]
	# without options every folder is a dry run

	local music_external="/media/${USER}/external/Music"
	local music_phone
	local music_utility
	local music_candidate
	local music_folder
	local music_subfolder
	local music_subfolders=()
	local music_relative
	local music_list=()
	local music_options=("${@}")

	# phone storage mounted by kde connect

	for music_candidate in /run/user/"$(id -u)"/*/storage/emulated/0/Music
	do
		if [ -d "${music_candidate}" ]
		then
			music_phone="${music_candidate}"

			break
		fi
	done

	if [ -z "${music_phone}" ]
	then
		frobulator.err "Phone music folder not mounted" "[ kde connect ]"
		frobulator.nul "Open the phone in dolphin or browse it through kde connect first."

		return 1
	fi

	if [ ! -d "${music_external}" ]
	then
		frobulator.err "External music folder not found" "[ ${music_external} ]"

		return 1
	fi

	music_utility="$(command -v utility-add-remove)"

	if [ -z "${music_utility}" ]
	then
		frobulator.download get.trmnl.me "${HOME}/.local/bin" utility-add-remove || return

		music_utility="${HOME}/.local/bin/utility-add-remove"
	fi

	# folder list: subfolders kept on the phone or the folder itself when it has none

	for music_folder in "${music_phone}"/*/
	do
		music_subfolders=("${music_folder}"*/)

		if [ -d "${music_subfolders[0]}" ]
		then
			for music_subfolder in "${music_subfolders[@]}"
			do
				music_list+=("$(basename -- "${music_folder}")/$(basename -- "${music_subfolder}")")
			done
		else
			music_list+=("$(basename -- "${music_folder}")")
		fi
	done

	# each folder mirrored on its own from the external drive

	for music_relative in "${music_list[@]}"
	do
		if [ ! -d "${music_external}/${music_relative}" ]
		then
			frobulator.wrn "Skipped - not on external drive" "[ '${music_relative}' ]"

			continue
		fi

		frobulator.fwd "Mirroring" "[ '${music_relative}' ]"

		bash "${music_utility}" -f "${music_external}/${music_relative}" -t "${music_phone}/${music_relative}" -m "${music_options[@]}"
	done
}

# audio control ────────────────────────────────────────────────────────────────

audio_combine_connect () {

	# connect a bluetooth device unless already connected - wait for each attempt:
	# speakers often answer only after a few page timeouts

	local bluetooth_address="${1}"
	local connect_attempt
	local connect_second

	for connect_attempt in {1..6}
	do
		if [[ "$(bluetoothctl info "${bluetooth_address}" 2> "${sink}")" = *"Connected: yes"* ]]
		then
			return 0
		fi

		bluetoothctl connect "${bluetooth_address}" > "${sink}" 2>&1

		for connect_second in {1..10}
		do
			if [[ "$(bluetoothctl info "${bluetooth_address}" 2> "${sink}")" = *"Connected: yes"* ]]
			then
				return 0
			fi

			sleep 1
		done
	done

	return 1
}

audio_combine_sink_wait () {

	# wait for a sink to appear

	local sink_name="${1}"
	local sink_timeout="${2:-15}"
	local sink_second

	for (( sink_second=0 ; sink_second<sink_timeout ; sink_second++ ))
	do
		if [[ "$(pactl list short sinks)" = *"	${sink_name}	"* ]]
		then
			return 0
		fi

		sleep 1
	done

	return 1
}

audio_combine_outputs () {

	# number of outputs the combined sink currently plays to

	local sink_input_line
	local sink_input_count=0

	while IFS= read -r sink_input_line
	do
		if [[ "${sink_input_line}" = *module-combine-sink* ]]
		then
			sink_input_count=$(( sink_input_count + 1 ))
		fi
	done < <(pactl list short sink-inputs)

	echo "${sink_input_count}"
}

audio_combine_load () {

	# (re)create the combined sink, make it default and move playing streams to it

	local sink_combined="${1}"
	local sink_slaves=("${@:2}")
	local sink_slave
	local sink_input_index
	local sink_input_sink
	local sink_input_client
	local sink_input_driver
	local slaves_joined

	audio_combine_unload "${sink_combined}"

	slaves_joined="${sink_slaves[*]}"

	# adjust_time=0: no rate adjustment timer - pulseaudio 16.1 aborts in its callback
	# ('u->time_event == e' in module-combine-sink time_callback), dropping both speakers

	pactl load-module module-combine-sink sink_name="${sink_combined}" slaves="${slaves_joined// /,}" adjust_time=0 > "${sink}" || return

	pactl set-default-sink "${sink_combined}"

	while IFS=$'\t' read -r sink_input_index sink_input_sink sink_input_client sink_input_driver
	do
		if [[ "${sink_input_driver}" != module-combine-sink* ]]
		then
			pactl move-sink-input "${sink_input_index}" "${sink_combined}" 2> "${sink}"
		fi
	done < <(pactl list short sink-inputs)

	for sink_slave in "${sink_slaves[@]}"
	do
		pactl set-sink-volume "${sink_slave}" 100%
	done

	pactl set-sink-volume "${sink_combined}" 75%
}

audio_combine_watch () {

	# background watcher: reconnect dropped speakers, rebuild the combined sink when they return

	local file_watch_pid="${1}"
	local sink_combined="${2}"
	local bluetooth_addresses=(${3})
	local sink_slaves=("${@:4}")

	(
		pactl subscribe | while IFS= read -r audio_event
		do
			if [[ "${audio_event}" = *"'remove' on sink"* ]]
			then
				# bluetooth still reports the device connected while it drops

				sleep 5

				for bluetooth_address in "${bluetooth_addresses[@]}"
				do
					audio_combine_connect "${bluetooth_address}" &
				done

			elif [[ "${audio_event}" = *"'new' on sink"* ]]
			then
				sleep 2

				sink_list="$(pactl list short sinks)"

				for sink_slave in "${sink_slaves[@]}"
				do
					if [[ "${sink_list}" != *"	${sink_slave}	"* ]]
					then
						continue 2
					fi
				done

				if [ "$(audio_combine_outputs)" -lt "${#sink_slaves[@]}" ]
				then
					audio_combine_load "${sink_combined}" "${sink_slaves[@]}"
				fi
			fi
		done
	) > "${sink}" 2>&1 &

	echo "${!}" > "${file_watch_pid}"

	disown
}

audio_combine_watch_stop () {

	# stop the background watcher

	local file_watch_pid="${1}"

	if [ -f "${file_watch_pid}" ]
	then
		pkill -P "$(< "${file_watch_pid}")" 2> "${sink}"
		kill "$(< "${file_watch_pid}")" 2> "${sink}"

		rm -f "${file_watch_pid}"
	fi
}

audio_combine_unload () {

	# remove the combined sink

	local sink_combined="${1}"
	local module_index
	local module_line

	while IFS=$'\t' read -r module_index module_line
	do
		if [[ "${module_line}" = module-combine-sink*"sink_name=${sink_combined}"* ]]
		then
			pactl unload-module "${module_index}"
		fi
	done < <(pactl list short modules)
}

audio-combine () {

	# combine two bluetooth speakers into one output, kept alive across dropouts
	# usage: audio-combine [stop]

	local sink_combined="bluez_sink_combined"
	local bluetooth_addresses=(
		"FC:E8:06:19:8E:9C"
		"FC:E8:06:19:77:00"
	)
	local bluetooth_address
	local sink_slaves=()
	local sink_slave
	local file_watch_pid="${XDG_RUNTIME_DIR:-/tmp}/audio-combine.pid"

	for bluetooth_address in "${bluetooth_addresses[@]}"
	do
		sink_slaves+=("bluez_sink.${bluetooth_address//:/_}.a2dp_sink")
	done

	if [ "${1}" = "stop" ]
	then
		audio_combine_watch_stop "${file_watch_pid}"
		audio_combine_unload "${sink_combined}"

		frobulator.inf "Combined audio stopped" "[ ${sink_combined} ]"

		return 0
	fi

	# connect bluetooth devices

	for bluetooth_address in "${bluetooth_addresses[@]}"
	do
		if ! audio_combine_connect "${bluetooth_address}"
		then
			frobulator.err "Unable to connect" "[ ${bluetooth_address} ]"
			frobulator.nul "Make sure the device is powered on, paired and trusted."

			return 1
		fi
	done

	for sink_slave in "${sink_slaves[@]}"
	do
		if ! audio_combine_sink_wait "${sink_slave}" 15
		then
			frobulator.err "Sink not found after connecting" "[ ${sink_slave} ]"
			frobulator.nul "Run 'pactl list short sinks' for details."

			return 1
		fi
	done

	audio_combine_load "${sink_combined}" "${sink_slaves[@]}" || return

	# one watcher at a time

	audio_combine_watch_stop "${file_watch_pid}"

	audio_combine_watch "${file_watch_pid}" "${sink_combined}" "${bluetooth_addresses[*]}" "${sink_slaves[@]}"

	frobulator.scs "Combined audio active" "[ ${sink_combined} ]"
}

