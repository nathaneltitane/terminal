#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

name_frobulator="frobulator"
directory_binaries="${HOME}"/.local/bin
frobulator="${directory_binaries}"/"${name_frobulator}"

# frobulator next to linked files

file_shell="$(readlink -f -- "${BASH_SOURCE[0]}")"
directory_shell="$(dirname -- "${file_shell}")"

if [ -f "${directory_shell}"/"${name_frobulator}" ]
then
	frobulator="${directory_shell}"/"${name_frobulator}"
fi

source "${frobulator}"

# superuser ────────────────────────────────────────────────────────────────────

# script ───────────────────────────────────────────────────────────────────────

# version ──────────────────────────────────────────────────────────────────────

version="2026-11-19"

# defaults ─────────────────────────────────────────────────────────────────────

self="${BASH_SOURCE[0]}"

# variables ────────────────────────────────────────────────────────────────────

mode_install="install"
prefix_function="bash-function-"
pattern_function="${prefix_function}*"
name_repository="nathaneltitane/terminal"
host_download="get.trmnl.me"
name_correction="command-correct"
key_correct='\C-x\C-c'
key_accept='\C-x\C-a'
key_exchange='\C-x\C-x'
key_alt_enter='\e\C-m'
sequence_region_start='\e[1;33m'
sequence_region_end='\e[0m'

# usage ────────────────────────────────────────────────────────────────────────

# executed directly: install only

if [[ "${self}" = "${0}" ]]
then
	script="$(basename -- "${self}")"

	directory_install="${directory_binaries}"

	file_installed="${directory_install}/${script}"

	while (( $# ))
	do
		case "${1}"
		in
			-i|--install)
				option="${mode_install}"
			;;

			-h|--help)
				echo
				echo -e "Usage: ./${script} -i | -h"
				echo
				echo -e "Options:"
				echo
				echo -e "-i, --install    Run [i]nstallation of ${script} to ${directory_install}."
				echo
				echo -e "-h, --help       Show [h]elp and usage information."
				echo
				echo -e "'${script}'      [ Version // ${version} ]"
				echo

				exit
			;;

			"")
				# handle empty argument:
				# use default values specified in script

				:
			;;

			*)
				echo
				echo -e "Usage: ./${script} -i | -h"
				echo
				echo -e "Unknown option: '${script} ${1}':"
				echo -e "Type './${script} -h' for help and usage information."
				echo

				exit 1

			;;

			esac

		shift

	done

	# default to install

	if [ -z "${option}" ]
	then
		option="${mode_install}"
	fi

	# install

	if [ "${option}" = "${mode_install}" ]
	then
		# blank line - output separated from the shell prompt

		echo

		file_script="$(realpath "${self}")"

		directory_script="$(dirname "${file_script}")"

		# script - copied unless already in place

		if [ "${directory_script}" -ef "${directory_install}" ]
		then
			frobulator.inf "Already installed" "[ ${file_installed} ]"
		else
			frobulator.copy "${directory_script}" "${directory_install}" "${script}"

			frobulator.permissions public execute "${file_installed}"
		fi

		# one file per function - copied from beside this script - downloaded from the repository otherwise

		list_functions=()

		for file_function in "${directory_script}"/${pattern_function}
		do
			if [ -f "${file_function}" ]
			then
				list_functions+=("$(basename -- "${file_function}")")
			fi
		done

		if [ "${#list_functions[@]}" -gt 0 ] && [ ! "${directory_script}" -ef "${directory_install}" ]
		then
			for name_function in "${list_functions[@]}"
			do
				frobulator.copy "${directory_script}" "${directory_install}" "${name_function}"
			done
		else
			# function names listed from the repository

			frobulator.repository "${name_repository}" "${prefix_function}"

			status_repository="${?}"

			if [ "${status_repository}" -ne 0 ]
			then
				exit 1
			fi

			list=("${frobulator_return[@]}")

			frobulator.download "${host_download}" "${directory_install}" ${list[@]}

			list=()
		fi

		frobulator.scs "Installed" "[ ${file_installed} ]"
	fi

	exit
fi

# functions ────────────────────────────────────────────────────────────────────

# each function file next to this one holds one function and its helpers

for file_function in "${directory_shell}"/${pattern_function}
do
	if [ -f "${file_function}" ]
	then
		source "${file_function}"
	fi
done

unset file_function

# correction ───────────────────────────────────────────────────────────────────

# alt enter checks the line first - enter runs it as typed

declare -F "${name_correction}" > "${sink}" 2>&1

status_correction="${?}"

if [[ "${-}" == *i* ]] && [ "${status_correction}" -eq 0 ]
then
	bind -x "\"${key_correct}\": ${name_correction}"
	bind "\"${key_accept}\": accept-line"
	bind "\"${key_exchange}\": exchange-point-and-mark"
	bind "\"${key_alt_enter}\": \"${key_correct}${key_accept}\""

	# corrected words in bold yellow

	bind "set active-region-start-color \"${sequence_region_start}\""
	bind "set active-region-end-color \"${sequence_region_end}\""
fi

unset status_correction
unset name_frobulator
unset directory_binaries
unset file_shell
unset mode_install
unset prefix_function
unset pattern_function
unset name_repository
unset host_download
unset name_correction
unset key_correct
unset key_accept
unset key_exchange
unset key_alt_enter
unset sequence_region_start
unset sequence_region_end
