# extract ──────────────────────────────────────────────────────────────────────

extract () {

	list+=(
		7zip
		bunzip2
		gunzip
		tar
		unrar
		unzip
	)

	frobulator.require ${list[@]}

	# unset array

	list=()

	file="${1}"
	directory="${2}"
	extension="${3}"

	archive="${file##*/}"

	if [ -z "${directory}" ]
	then
		directory="${PWD}"
	fi

	if [ -z "${extension}" ]
	then
		extension="${file##*.}"
	fi

	if [ ! -d "${directory}" ]
	then
		mkdir -p "${directory}"
	fi

	case "${extension}"
	in
		tar.bz2|tbz2)
			tar								\
				--extract					\
				--bzip2						\
				--file="${file}" 			\
				--directory="${directory}"

				frobulator.inf "Extracting" "[ ${archive} ]"
		;;

		tar.gz|tgz)
			tar								\
				--extract					\
				--gzip						\
				--file="${file}" 			\
				--directory="${directory}"

				frobulator.inf "Extracting" "[ ${archive} ]"
		;;

		tar)
			tar								\
				--extract					\
				--file="${file}" 			\
				--directory="${directory}"

				frobulator.inf "Extracting" "[ ${archive} ]"

		;;

		7z)
			7z								\
				x "${file}" 				\
				-o							"${directory}"

				frobulator.inf "Extracting" "[ ${archive} ]"
		;;

		rar)
			unrar e "${file}" "${directory}"

				frobulator.inf "Extracting" "[ ${archive} ]"
		;;

		zip)
			unzip							\
				-o							\
				-qq "${file}"				\
				-d							"${directory}"

				frobulator.inf "Extracting" "[ ${archive} ]"
		;;

		*)
			frobulator.err "Unsupported archive type" "[ '${archive}' ]"

			exit 1
		;;

	esac
}

# icons ────────────────────────────────────────────────────────────────────────

icons () {

	frobulator.require gtk-update-icon-cache

	icons_directory_list=(
		"${HOME}"/.icons
		"${PREFIX}"/share/icons
		/usr/share/icons
	)

	for icons_directory in ${icons_directory_list[@]}
	do
		if [ -d "${icons_directory}" ]
		then
			cd "${icons_directory}"
		fi

		if [ -d "${icons_directory}" ]
		then
			find "${icons_directory}" -mindepth 1 -maxdepth 1 -type d | while read -r theme
			do
				if [ -f "${theme}"/index.theme ]
				then
					theme_name="${theme##*/}"

					gtk-update-icon-cache -f -q "${theme}"

					frobulator.scs "Cache update success" "[ ${theme_name} ]"
				else
					frobulator.wrn "Skipping" "[ ${theme_name} ]"
				fi
			done
		fi
	done
}

# inkscape ─────────────────────────────────────────────────────────────────────

vector-export () {

	frobulator.require inkscape

	export_type="${1}"

	if [ -z "${export_type}" ]
	then
		export_type="png"
	fi

	for file in *.svg
	do
		if [ -f "${file}" ]
		then
			file_name="${file%.*}"

			inkscape "${file}"						\
				--batch-process						\
				--export-width=4096					\
				--export-area-page					\
				--export-type="${export_type}"		\
				--export-filename="${file_name}"."${export_type}"
		fi
	done
}

# preview ──────────────────────────────────────────────────────────────────────

preview () {

	count="${1}"

	file="${2}"

	if [[ $(command -v cat) ]] &&
	   [[ $(command -v head) ]]
	then
		frobulator.inf "Previewing file" "[ ${count} lines // ${file} ]"

		frobulator.separate

		cat "${file}" | head -n "${count}"

		echo

		frobulator.separate

	fi
}

# record ───────────────────────────────────────────────────────────────────────

record () {

	list=(
		recordmydesktop
		wmctrl
	)

	(frobulator.require ${list[@]})

	list=()

	if [ -f "${HOME}"/Videos ]
	then
		path="${HOME}"/Videos
	else
		path="${HOME}"
	fi

	stamp="$(date +"%m-%d-%Y-%H-%M-%S")"
	window_id="$(xwininfo | grep "Window id" | cut -d ' ' -f 4)"

	wmctrl		\
		-i		\
		-R		"${window_id}"

	frobulator.wait 1

	recordmydesktop								\
		--no-cursor								\
		--no-wm-check							\
		--no-sound								\
		--overwrite								\
		--windowid "${window_id}"				\
		--output="${path}"/clip-"${stamp}".ogv
}

# list ─────────────────────────────────────────────────────────────────────────

list () {

	directory="${1}"

	if [ -z "${directory}" ]
	then
		directory="${PWD}"
	fi

	if [ ! -d "${directory}" ]
	then
		frobulator.err "Directory not found" "[ ${directory} ]"

		return 1
	fi

	ls								\
		-a							\
		-h							\
		-l							\
		--group-directories-first	\
									"${directory}"

	echo
	echo "$(find "${directory}" -type d | wc -l) directories"
	echo
	echo "$(find "${directory}" -type f | wc -l) files"
	echo
}

