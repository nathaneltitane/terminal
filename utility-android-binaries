#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

selection=()

while (( $# ))
do
	case "${1}"
	in
		-a|--all)
			selection+=(all)
		;;

		-b|--adb)
			selection+=(adb)
		;;

		-e|--e2fsdroid)
			selection+=(e2fsdroid)
		;;

		-s|--f2fs-sload)
			selection+=(f2fs-sload)
		;;

		-f|--fastboot)
			selection+=(fastboot)
		;;

		-m|--make-f2fs)
			selection+=(make-f2fs)
		;;

		-z|--zipalign)
			selection+=(zipalign)
		;;

		-p|--aapt)
			selection+=(aapt)
		;;

		-t|--aapt2)
			selection+=(aapt2)
		;;

		-i|--aidl)
			selection+=(aidl)
		;;

		-x|--dexdump)
			selection+=(dexdump)
		;;

		-l|--split-select)
			selection+=(split-select)
		;;

		-r|--veridex)
			selection+=(veridex)
		;;

		-d|--deploy)
			deploy=true
		;;

		-o|--force)
			force=true
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -a | -b -e -s -f -m -z -p -t -i -x -l -r [-d] [-o] | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-a, --all             Update [a]ll binaries - default without selection."
			echo
			echo -e "-b, --adb             Update the ad[b] binary."
			echo
			echo -e "-e, --e2fsdroid       Update the [e]2fsdroid binary."
			echo
			echo -e "-s, --f2fs-sload      Update the f2fs-[s]load binary."
			echo
			echo -e "-f, --fastboot        Update the [f]astboot binary."
			echo
			echo -e "-m, --make-f2fs       Update the [m]ake-f2fs binary."
			echo
			echo -e "-z, --zipalign        Update the [z]ipalign binary."
			echo
			echo -e "-p, --aapt            Update the aa[p]t binary."
			echo
			echo -e "-t, --aapt2           Update the aap[t]2 binary."
			echo
			echo -e "-i, --aidl            Update the a[i]dl binary."
			echo
			echo -e "-x, --dexdump         Update the de[x]dump binary."
			echo
			echo -e "-l, --split-select    Update the sp[l]it-select binary."
			echo
			echo -e "-r, --veridex         Update the ve[r]idex binary."
			echo
			echo -e "-d, --deploy          Run [d]eployment to \${HOME}/.local/bin - this architecture, no suffix."
			echo
			echo -e "                      [ repository - both architectures, -arm64 suffix ] [ Default ]"
			echo
			echo -e "-o, --force           Allow f[o]rced update of unchanged binaries."
			echo
			echo -e "-h, --help            Show [h]elp and usage information."
			echo
			echo -e "'${script}'           [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -a | -b -e -s -f -m -z -p -t -i -x -l -r [-d] [-o] | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

# static android sdk tools builds - per architecture

url_binaries_release="${marker_hts}api.github.com/repos/lzhiyong/android-sdk-tools/releases/latest"

# architectures: release archive name ending | file name ending
# x86_64 is the plain name - arm64 (termux) carries a suffix - as binary-leocad / binary-leocad-arm64

list_architectures_binary=(
	"-static-x86_64.zip|"
	"-static-aarch64.zip|-arm64"
)

# binaries: name | path inside the release archive | file

list_sources_binary=(
	"adb|platform-tools/adb|binary-android-adb"
	"e2fsdroid|platform-tools/e2fsdroid|binary-android-e2fsdroid"
	"f2fs-sload|platform-tools/sload_f2fs|binary-android-f2fs-sload"
	"fastboot|platform-tools/fastboot|binary-android-fastboot"
	"make-f2fs|platform-tools/make_f2fs|binary-android-make-f2fs"
	"zipalign|build-tools/zipalign|binary-android-zipalign"
	"aapt|build-tools/aapt|binary-android-aapt"
	"aapt2|build-tools/aapt2|binary-android-aapt2"
	"aidl|build-tools/aidl|binary-android-aidl"
	"dexdump|build-tools/dexdump|binary-android-dexdump"
	"split-select|build-tools/split-select|binary-android-split-select"
	"veridex|others/veridex|binary-android-veridex"
)

declare -A list_assets_binary

# defaults ─────────────────────────────────────────────────────────────────────

if [ "${#selection[@]}" -eq 0 ] || [[ " ${selection[*]} " = *" all "* ]]
then
	selection=(adb e2fsdroid f2fs-sload fastboot make-f2fs zipalign aapt aapt2 aidl dexdump split-select veridex)
fi

if [ "${deploy}" = true ]
then
	# this computer only: its architecture - no suffix

	directory="${HOME}/.local/bin"

	file_list="${directory}/.binary-android-list"

	# machine architecture reported by the kernel: x86_64 / aarch64 ...

	architecture_machine="$(uname -m)"

	case "${architecture_machine}"
	in
		x86_64)
			list_architectures_binary=("-static-x86_64.zip|")
		;;

		aarch64|arm64)
			list_architectures_binary=("-static-aarch64.zip|")
		;;

		*)
			frobulator.err "Unsupported architecture" "[ ${architecture_machine} ]"

			exit 1
		;;
	esac
else
	# repository: both architectures - served to dextop and termux

	file_script="$(readlink -f -- "${BASH_SOURCE[0]}")"

	directory="$(dirname -- "${file_script}")"

	file_list="${directory}/binary-android-list"
fi

# release asset id of each binary is kept in the list file - unchanged ones are skipped

# functions ────────────────────────────────────────────────────────────────────

list_load () {

	local name_file_entry
	local name_original
	local id_asset_entry

	if [ ! -f "${file_list}" ]
	then
		return 0
	fi

	# file / original binary name / release asset id

	while IFS=$'\t' read -r name_file_entry name_original id_asset_entry
	do
		if [ -n "${name_file_entry}" ]
		then
			list_assets_binary["${name_file_entry}"]="${id_asset_entry}"
		fi
	done < "${file_list}"
}

list_original () {

	# original binary name inside the release archive for a list file name

	local name_file_entry="${1%-arm64}"

	local entry_list
	local name_binary_entry
	local path_entry
	local file_source_entry

	for entry_list in "${list_sources_binary[@]}"
	do
		IFS='|' read -r name_binary_entry path_entry file_source_entry <<< "${entry_list}"

		if [ "${file_source_entry}" = "${name_file_entry}" ]
		then
			echo "${path_entry##*/}"

			return 0
		fi
	done

	echo "-"
}

list_tabs () {

	# tabs from a text length to a column - tab width 4

	local length_text="${1}"
	local column_target="${2}"
	local count_tabs=$(( ( column_target - length_text / 4 * 4 ) / 4 ))

	while [ "${count_tabs}" -gt 0 ]
	do
		printf '\t'

		count_tabs=$(( count_tabs - 1 ))
	done
}

list_save () {

	# file / original binary name / release asset id - columns aligned on tab stops (tab width 4):
	# each text column one tab wider than its longest entry

	local width_file=0
	local width_original=0

	local name_file_entry
	local name_original
	local column_file
	local column_original
	local position_original

	local -A list_originals=()

	for name_file_entry in "${!list_assets_binary[@]}"
	do
		list_originals["${name_file_entry}"]="$(list_original "${name_file_entry}")"

		if [ "${#name_file_entry}" -gt "${width_file}" ]
		then
			width_file="${#name_file_entry}"
		fi

		if [ "${#list_originals[${name_file_entry}]}" -gt "${width_original}" ]
		then
			width_original="${#list_originals[${name_file_entry}]}"
		fi
	done

	column_file=$(( ( width_file / 4 + 2 ) * 4 ))
	column_original=$(( column_file + ( width_original / 4 + 2 ) * 4 ))

	for name_file_entry in "${!list_assets_binary[@]}"
	do
		name_original="${list_originals[${name_file_entry}]}"
		position_original=$(( column_file + ${#name_original} ))

		printf '%s%s%s%s%s\n'																\
			"${name_file_entry}"																	\
			"$(list_tabs "${#name_file_entry}" "${column_file}")"							\
			"${name_original}"															\
			"$(list_tabs "${position_original}" "${column_original}")"			\
			"${list_assets_binary[${name_file_entry}]}"
	done | LC_ALL=C sort > "${file_list}"
}

binaries_update () {

	# for each architecture: download its release archive once - then replace each selected binary that changed

	local status=0

	local json_release
	local tag_release
	local entry_architecture
	local suffix_archive
	local suffix_architecture
	local name_architecture
	local id_asset
	local url_asset
	local entry_binary
	local name_binary
	local path_binary
	local file_binary
	local file_archive
	local directory_architecture

	local -a list_binaries_pending=()

	json_release="$(curl --silent --fail --location --connect-timeout 30 "${url_binaries_release}" 2> "${sink}")"

	tag_release="$(jq -r '.tag_name // empty' <<< "${json_release}" 2> "${sink}")"

	frobulator.temporary directory_binaries_temporary

	frobulator.trap "${directory_binaries_temporary}"

	for entry_architecture in "${list_architectures_binary[@]}"
	do
		IFS='|' read -r suffix_archive suffix_architecture <<< "${entry_architecture}"

		name_architecture="${suffix_archive#-static-}"
		name_architecture="${name_architecture%.zip}"

		unset id_asset
		unset url_asset

		read -r id_asset url_asset < <(
			jq -r --arg suffix "${suffix_archive}" \
				'[.assets[]? | select(.name | endswith($suffix))][0] // empty | "\(.id) \(.browser_download_url)"' \
				<<< "${json_release}" 2> "${sink}"
		)

		if [ -z "${url_asset}" ]
		then
			frobulator.err "Release unavailable - ${name_architecture}" "[ 'android-sdk-tools'${marker_spc}${marker_hnt}${marker_spc}000 ]"

			status=1

			continue
		fi

		list_binaries_pending=()

		for entry_binary in "${list_sources_binary[@]}"
		do
			IFS='|' read -r name_binary path_binary file_binary <<< "${entry_binary}"

			file_binary="${file_binary}${suffix_architecture}"

			if [[ " ${selection[*]} " != *" ${name_binary} "* ]]
			then
				continue
			fi

			if [ "${force}" != true ] && [ -f "${directory}/${file_binary}" ] &&
			   [ "${list_assets_binary[${file_binary}]}" = "${id_asset}" ]
			then
				frobulator.inf "Up to date - ${name_binary}" "[ '${file_binary}'${marker_spc}${marker_hnt}${marker_spc}${tag_release} ]"

				continue
			fi

			list_binaries_pending+=("${name_binary}|${path_binary}|${file_binary}")
		done

		if [ "${#list_binaries_pending[@]}" -eq 0 ]
		then
			continue
		fi

		directory_architecture="${directory_binaries_temporary}/${name_architecture}"

		mkdir -p "${directory_architecture}"

		file_archive="${directory_architecture}/android-sdk-tools-${name_architecture}.zip"

		frobulator.download "${url_asset}" "${file_archive}"

		frobulator.track || continue

		frobulator.extract "${file_archive}" "${directory_architecture}" > "${sink}"

		frobulator.track || continue

		for entry_binary in "${list_binaries_pending[@]}"
		do
			IFS='|' read -r name_binary path_binary file_binary <<< "${entry_binary}"

			if [ ! -f "${directory_architecture}/${path_binary}" ]
			then
				frobulator.err "Update failure - ${name_binary}" "[ '${file_binary}'${marker_spc}${marker_hnt}${marker_spc}missing ]"

				status=1

				continue
			fi

			cp -f "${directory_architecture}/${path_binary}" "${directory}/${file_binary}"

			frobulator.track || continue

			frobulator.permissions public execute "${directory}/${file_binary}" > "${sink}"

			list_assets_binary["${file_binary}"]="${id_asset}"

			frobulator.scs "Update success - ${name_binary}" "[ '${file_binary}'${marker_spc}${marker_hnt}${marker_spc}${tag_release} ]"
		done
	done

	return "${status}"
}

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(
	curl
	jq
	unzip
)

frobulator.require ${list[@]}

list=()

# configuration ────────────────────────────────────────────────────────────────

if [ "${deploy}" = true ] && [ ! -d "${directory}" ]
then
	frobulator.directory "${directory}" > "${sink}"
fi

if [ ! -d "${directory}" ]
then
	frobulator.err "Directory not found" "[ ${directory} ]"

	exit 1
fi

frobulator.inf "Target directory" "[ ${directory} ]"

list_load

binaries_update

frobulator.complete continue "Update failure - binaries"

list_save

frobulator.ownership "${directory}" > "${sink}"

frobulator.result "${script}"
