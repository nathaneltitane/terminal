#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-d|--decode)
			option="decode"
			input="${2}"

			shift
		;;

		-b|--build)
			option="build"
			input="${2}"

			shift
		;;

		-o|--output)
			output="${2}"

			shift
		;;

		-f|--force)
			force=true
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -d [File] | -b [Directory] -o [Path] -f | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-d, --decode    Specify apk file to [d]ecode into a directory."
			echo
			echo -e "-b, --build     Specify decoded directory to re[b]uild into an installable apk."
			echo
			echo -e "-o, --output    Specify [o]utput path."
			echo
			echo -e "                [ file name without .apk ] [ Default - decode ]"
			echo -e "                [ directory name.apk ]     [ Default - build  ]"
			echo
			echo -e "-f, --force     Allow [f]orced overwrite of existing output."
			echo
			echo -e "-h, --help      Show [h]elp and usage information."
			echo
			echo -e "'${script}'     [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -d [File] | -b [Directory] -o [Path] -f | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

directory_android="${HOME}/.local/lib/android"

file_apk_tool="${directory_android}/apk-tool.jar"
file_apk_tool_version="${directory_android}/apk-tool.version"

file_keystore="${HOME}/.android/debug.keystore"

url_apk_tool_release="https://api.github.com/repos/iBotPeaches/Apktool/releases/latest"

# defaults ─────────────────────────────────────────────────────────────────────

# validate arguments

if [ -z "${option}" ]
then
	frobulator.err "Missing operation."
	frobulator.nul "Specify either '--decode' or '--build'."

	exit 1

elif [ -z "${input}" ] || [[ "${input}" = -* ]]
then
	frobulator.err "Missing argument for '--${option}'."

	exit 1

elif [[ "${output}" = -* ]]
then
	frobulator.err "Missing argument for '--output'."

	exit 1

elif [ "${option}" = "decode" ] && [ ! -f "${input}" ]
then
	frobulator.err "Apk file not found" "[ ${input} ]"

	exit 1

elif [ "${option}" = "build" ] && [ ! -d "${input}" ]
then
	frobulator.err "Directory not found" "[ ${input} ]"

	exit 1
fi

# default output next to input

input="${input%/}"

if [ -z "${output}" ]
then
	if [ "${option}" = "decode" ]
	then
		output="${input%.apk}"
	else
		output="${input}.apk"
	fi
fi

if [ -e "${output}" ] && [ "${force}" != true ]
then
	frobulator.err "Output exists - use '--force' to overwrite" "[ ${output} ]"

	exit 1
fi

# functions ────────────────────────────────────────────────────────────────────

apk_tool_update () {

	local release
	local tag
	local url
	local version_installed

	release="$(curl -fsSL "${url_apk_tool_release}" 2> "${sink}")"

	tag="$(jq -r '.tag_name // empty' <<< "${release}" 2> "${sink}")"

	url="$(jq -r '.assets[] | select(.name | endswith(".jar")) | .browser_download_url' <<< "${release}" 2> "${sink}")"

	if [ -f "${file_apk_tool_version}" ]
	then
		version_installed="$(< "${file_apk_tool_version}")"
	fi

	# offline: keep the installed jar

	if [ -z "${tag}" ] || [ -z "${url}" ]
	then
		if [ -f "${file_apk_tool}" ]
		then
			frobulator.wrn "Release check unavailable - using installed" "[ apk-tool ${version_installed} ]"

			return 0
		fi

		frobulator.err "Unable to fetch" "[ apk-tool ]"

		return 1
	fi

	if [ -f "${file_apk_tool}" ] && [ "${version_installed}" = "${tag}" ]
	then
		frobulator.inf "Latest version installed" "[ apk-tool ${tag} ]"

		return 0
	fi

	frobulator.directory "${directory_android}"

	frobulator.dwl "Fetching" "[ apk-tool ${tag} ]"

	curl									\
		--silent							\
		--fail								\
		--location							\
		--output "${file_apk_tool}.part"		\
											"${url}"

	if [ "${?}" -ne 0 ] || [ ! -s "${file_apk_tool}.part" ]
	then
		frobulator.err "Unable to fetch" "[ apk-tool ${tag} ]"

		return 1
	fi

	mv -- "${file_apk_tool}.part" "${file_apk_tool}"

	echo "${tag}" > "${file_apk_tool_version}"

	frobulator.ownership "${directory_android}"

	frobulator.scs "Installed" "[ apk-tool ${tag} ]"
}

apk_tool_decode () {

	local -a arguments=()

	if [ "${force}" = true ]
	then
		arguments+=(-f)
	fi

	frobulator.fwd "Decoding" "[ ${input} ]"

	java -jar "${file_apk_tool}" d "${input}" -o "${output}" "${arguments[@]}"

	frobulator.fail "Decode failed" "[ ${input} ]" || return
}

keystore_create () {

	if [ -f "${file_keystore}" ]
	then
		return 0
	fi

	frobulator.inf "Creating debug signing key" "[ ${file_keystore} ]"

	frobulator.directory "$(dirname -- "${file_keystore}")"

	keytool										\
		-genkeypair								\
		-keystore "${file_keystore}"			\
		-storepass android						\
		-alias androiddebugkey					\
		-keypass android						\
		-keyalg RSA								\
		-keysize 2048							\
		-validity 10000							\
		-dname "CN=Android Debug,O=Android,C=US"	> "${sink}" 2>&1

	frobulator.fail "Unable to create signing key." || return

	frobulator.ownership "$(dirname -- "${file_keystore}")"
}

apk_tool_build () {

	local file_unsigned="${directory_temporary}/unsigned.apk"
	local file_aligned="${directory_temporary}/aligned.apk"

	frobulator.fwd "Building" "[ ${input} ]"

	java -jar "${file_apk_tool}" b "${input}" -o "${file_unsigned}" -f

	frobulator.fail "Build failed" "[ ${input} ]" || return

	# align before signing

	frobulator.fwd "Aligning" "[ ${output##*/} ]"

	zipalign -p -f 4 "${file_unsigned}" "${file_aligned}"

	frobulator.fail "Align failed" "[ ${output##*/} ]" || return

	keystore_create

	frobulator.fail || return

	frobulator.fwd "Signing" "[ ${output##*/} ]"

	apksigner sign									\
		--ks "${file_keystore}"						\
		--ks-pass pass:android						\
		--ks-key-alias androiddebugkey				\
		--key-pass pass:android						\
		--out "${output}"							\
												"${file_aligned}"

	frobulator.fail "Signing failed" "[ ${output##*/} ]" || return

	apksigner verify "${output}" > "${sink}" 2>&1

	frobulator.fail "Signature verification failed" "[ ${output##*/} ]" || return

	# signature file written next to the apk

	if [ -f "${output}.idsig" ]
	then
		mv -- "${output}.idsig" "${directory_temporary}/"
	fi
}

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(
	apksigner
	curl
	jq
	zipalign
)

frobulator.require ${list[@]}

list=()

# configuration ────────────────────────────────────────────────────────────────

frobulator.temporary directory_temporary

frobulator.trap "${directory_temporary}"

apk_tool_update

frobulator.complete halt

if [ "${option}" = "decode" ]
then
	apk_tool_decode

	frobulator.complete halt

elif [ "${option}" = "build" ]
then
	apk_tool_build

	frobulator.complete halt
fi

frobulator.ownership "${output}"

frobulator.scs "Done" "[ ${output} ]"

frobulator.result "${script}"
