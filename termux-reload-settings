#!/bin/bash

# 'Usage: termux-reload-settings'
#
# 'Use without arguments to reload settings after modifying any of:'
# '  ~/.termux/colors.properties'
# '  ~/.termux/font.ttf '
# '  ~/.termux/termux.properties'

action_reload="com.termux.app.reload_style com.termux"
id_user="0"

# reload settings

am broadcast			\
	--user "${id_user}"	\
	-a "${action_reload}"	> /dev/null 2>&1
