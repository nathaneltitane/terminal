#!/bin/bash

# loaded by "${HOME}"/.local/bin/bash-functions

# audio ────────────────────────────────────────────────────────────────────────

audio () {

	local format_output="mp3"
	local extension_lossless="flac"
	local bitrate_lossless="320k"
	local version_id3="3"
	local extension_output="${format_output}"
	local state_found
	local directory
	local extension
	local file

	# output starts one line below the command

	echo

	frobulator.require ffmpeg

	directory="${PWD}"
	extension="${1}"

	state_found="false"

	# default conversion command

	convert_command () {

		ffmpeg								\
			-y								\
			-i "${file}"					\
			-f "${format_output}"			\
			-map_metadata 0					\
			-id3v2_version "${version_id3}"	\
											"${file%.*}.${extension_output}"

	}

	if [ "${extension}" = "${extension_lossless}" ]
	then
		# override for flac files with bitrate

		convert_command () {

			ffmpeg								\
				-y								\
				-i "${file}"					\
				-b:a "${bitrate_lossless}"		\
				-map_metadata 0					\
				-id3v2_version "${version_id3}"	\
												"${file%.*}.${extension_output}"

		}

	fi

	# loop over all files

	for file in *
	do
		if [[ "${file}" == *."${extension}" ]]
		then
			state_found="true"

			convert_command

			rm				\
				--recursive	\
				--force		\
							"${file}"

		fi
	done

	# handle case where no matching files were found

	if [ "${state_found}" = "false" ]
	then
		frobulator.err "No files to convert with specified extension" "[ '${extension}' ]"

		return 1
	fi

}
