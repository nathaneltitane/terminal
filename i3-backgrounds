#!/bin/bash

script=$(basename -- "${BASH_SOURCE[0]}")

separator=" // "
name_font="Monospace"
size_font=10
font="${name_font}:size=${size_font}"

lines=60
prompt="CHANGE BACKGROUND IMAGE${separator}"

images="$(find "${HOME}"						\
			-maxdepth 2							\
			-type f								\
			-iname "*.jpg"						\
			-o -iname "*.png"					\
			-o -iname "*.svg"					\
				-not -path "*.cache*"			\
				-not -path "*.config*"			\
				-not -path "*thumbnails*" | sort
		)"

list_options_display=(
	center
	fill
	scale
	tile
	zoom
)

selection="$(echo "${images}" | dmenu -i -l "${lines}" -p "${prompt}" -fn "${font}" -nb '#000000' -nf '#FFFFFF' -sb '#666666' -sf '#000000')"

lines=${#list_options_display[@]}
prompt="SELECT DISPLAY METHOD${separator}"

display="$(printf '%s\n' "${list_options_display[@]}" | dmenu -i -l "${lines}" -p "${prompt}" -fn "${font}" -nb '#000000' -nf '#FFFFFF' -sb '#666666' -sf '#000000')"

feh --no-fehbg --bg-"${display}" "${selection}"
