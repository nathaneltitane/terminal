#!/bin/bash

# loaded by "${HOME}"/.local/bin/bash-functions

# ollama ───────────────────────────────────────────────────────────────────────

ollama () {

	# readable names for the short commands and flags

	local -A list_names=(
		[copy]="cp"
		[details]="show"
		[download]="pull"
		[loaded]="ps"
		[nowordwrap]="--nowordwrap"
		[remove]="rm"
		[unload]="stop"
		[upload]="push"
		[verbose]="--verbose"
		[version]="--version"
	)

	local list_arguments=("${@}")

	# first word swapped when it is a readable name

	if [ -n "${1}" ] && [ -n "${list_names[${1}]}" ]
	then
		list_arguments[0]="${list_names[${1}]}"
	fi

	command ollama "${list_arguments[@]}"

}

# tab completion ───────────────────────────────────────────────────────────────

ollama_complete () {

	# line up to the cursor - model names hold colons that split bash words

	local text_line="${COMP_LINE:0:COMP_POINT}"
	local word_current="${text_line##* }"
	local prefix_colon="${word_current%"${word_current##*:}"}"
	local index_word
	local index_command
	local index_model
	local name_model
	local text_rest
	local character_space
	local count_lines_header

	local list_words=()
	local list_models=()

	local list_commands=(
		copy
		create
		details
		download
		help
		launch
		list
		loaded
		nowordwrap
		remove
		run
		serve
		signin
		signout
		unload
		upload
		verbose
		version
	)

	local list_commands_model=(
		copy
		details
		download
		remove
		run
		unload
		upload
		cp
		pull
		push
		rm
		show
		stop
	)

	index_command="1"
	index_model="2"
	character_space=" "
	count_lines_header="+2"

	read -r -a list_words <<< "${text_line}"

	index_word=$(( ${#list_words[@]} - 1 ))

	# a trailing space starts a new word

	if [ "${text_line: -1}" = "${character_space}" ]
	then
		index_word=$(( index_word + 1 ))
	fi

	COMPREPLY=()

	# commands first - local model names after a model command

	if [ "${index_word}" -eq "${index_command}" ]
	then
		mapfile -t COMPREPLY < <(compgen -W "${list_commands[*]}" -- "${word_current}")
	elif [ "${index_word}" -eq "${index_model}" ] && [[ " ${list_commands_model[*]} " == *" ${list_words[index_command]} "* ]]
	then
		while read -r name_model text_rest
		do
			list_models+=("${name_model}")
		done < <(command ollama list 2> "${sink}" | tail --lines="${count_lines_header}")

		mapfile -t COMPREPLY < <(compgen -W "${list_models[*]}" -- "${word_current}")

		# bash completes only the part after the last colon

		COMPREPLY=("${COMPREPLY[@]#"${prefix_colon}"}")
	fi

}

complete -F ollama_complete ollama
