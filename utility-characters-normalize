#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-d|--directory)
			directory="${2}"

			shift
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -d [Directory] | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-d, --directory    Specify [d]irectory of files to normalize."
			echo
			echo -e "                   [ /path/to/directory ]"
			echo -e "                   [ current directory ]  [ Default ]"
			echo
			echo -e "-h, --help         Show [h]elp and usage information."
			echo
			echo -e "'${script}'        [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -d [Directory] | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

directory="${directory:-${PWD}}"

name_source=""

name_target=""

character=""

name=""

extension=""

number=0

count_renamed=0

count_unchanged=0

# defaults ─────────────────────────────────────────────────────────────────────

export LANG=C.UTF-8

export LC_ALL=C.UTF-8

# functions ────────────────────────────────────────────────────────────────────

name_normalize () {

	local name_source="${1}"
	local name_target=""
	local character=""
	local index=0

	for (( index = 0 ; index < ${#name_source} ; index ++ ))
	do
		character="${name_source:index:1}"

		if [ "${character}" = "【" ] ||
		   [ "${character}" = "『" ] ||
		   [ "${character}" = "「" ] ||
		   [ "${character}" = "［" ]
		then
			character="["

		elif [ "${character}" = "】" ] ||
		     [ "${character}" = "』" ] ||
		     [ "${character}" = "」" ] ||
		     [ "${character}" = "］" ]
		then
			character="]"

		elif [ "${character}" = "（" ]
		then
			character="("

		elif [ "${character}" = "）" ]
		then
			character=")"

		elif [ "${character}" = "｛" ]
		then
			character="{"

		elif [ "${character}" = "｝" ]
		then
			character="}"

		elif [ "${character}" = "〈" ] ||
		     [ "${character}" = "《"  ]
		then
			character="<"

		elif [ "${character}" = "〉" ] ||
		     [ "${character}" = "》"  ]
		then
			character=">"

		elif [ "${character}" = "！" ]
		then
			character="!"

		elif [ "${character}" = "？" ]
		then
			character="?"

		elif [ "${character}" = "：" ]
		then
			character=":"

		elif [ "${character}" = "；" ]
		then
			character=";"

		elif [ "${character}" = "，" ]
		then
			character=","

		elif [ "${character}" = "．" ]
		then
			character="."

		elif [ "${character}" = "％" ]
		then
			character="%"

		elif [ "${character}" = "＆" ]
		then
			character="&"

		elif [ "${character}" = "＋" ]
		then
			character="+"

		elif [ "${character}" = "＝" ]
		then
			character="="

		elif [ "${character}" = "＊" ]
		then
			character="*"

		elif [ "${character}" = "＃" ]
		then
			character="#"

		elif [ "${character}" = "＠" ]
		then
			character="@"

		elif [ "${character}" = "＄" ]
		then
			character="$"

		elif [ "${character}" = "＾" ]
		then
			character="^"

		elif [ "${character}" = "＿" ]
		then
			character="_"

		elif [ "${character}" = "｜" ]
		then
			character="-"

		elif [ "${character}" = "／" ] ||
		     [ "${character}" = "⧸"  ] ||
		     [ "${character}" = "＼" ]
		then
			character="-"

		elif [ "${character}" = "～" ] ||
		     [ "${character}" = "〜" ]
		then
			character="~"

		elif [ "${character}" = "’" ] ||
		     [ "${character}" = "‘" ]
		then
			character="'"

		elif [ "${character}" = "“"  ] ||
		     [ "${character}" = "”"  ] ||
		     [ "${character}" = "＂" ]
		then
			character='"'

		elif [ "${character}" = "—" ] ||
		     [ "${character}" = "–" ] ||
		     [ "${character}" = "−" ] ||
		     [ "${character}" = "‐" ] ||
		     [ "${character}" = "―" ]
		then
			character="-"

		elif [ "${character}" = "…" ]
		then
			character="..."

		elif [ "${character}" = "・" ] ||
		     [ "${character}" = "･"  ]
		then
			character="-"

		elif [ "${character}" = "　" ]
		then
			character=" "
		fi

		name_target+="${character}"
	done

	while [[ "${name_target}" = *"  "* ]]
	do
		name_target="${name_target//  / }"
	done

	while [[ "${name_target}" = " "* ]]
	do
		name_target="${name_target# }"
	done

	while [[ "${name_target}" = *" " ]]
	do
		name_target="${name_target% }"
	done

	if [ -z "${name_target}" ]
	then
		name_target="unnamed"
	fi

	echo "${name_target}"
}

path_unique () {

	local path_source="${1}"
	local path_target="${2}"
	local name_target="${path_target##*/}"
	local directory_target="${path_target%/*}"
	local name=""
	local extension=""
	local number=1

	if [ ! -e "${path_target}" ] ||
	   [ "${path_source}" = "${path_target}" ]
	then
		echo "${path_target}"

		return 0
	fi

	if [ -f "${path_source}" ] && [[ "${name_target}" = *.* ]]
	then
		name="${name_target%.*}"
		extension=".${name_target##*.}"
	else
		name="${name_target}"
		extension=""
	fi

	while [ -e "${directory_target}/${name}-${number}${extension}" ]
	do
		(( number ++ ))
	done

	echo "${directory_target}/${name}-${number}${extension}"
}

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(

)

frobulator.require ${list[@]}

frobulator.complete

list=()

# configuration ────────────────────────────────────────────────────────────────

# current locale character encoding - e.g. UTF-8

name_charmap_locale="$(locale charmap 2> "${sink}")"

if [ "${name_charmap_locale}" != "UTF-8" ]
then
	frobulator.err "UTF-8 locale unavailable"

	exit 1
fi

frobulator.complete

# process ──────────────────────────────────────────────────────────────────────

while IFS= read -r -d '' path_source
do
	name_source="${path_source##*/}"

	name_target=$(name_normalize "${name_source}")

	path_target="${directory}/${name_target}"

	if [ "${path_source}" = "${path_target}" ]
	then
		(( count_unchanged ++ ))

		continue
	fi

	path_target=$(path_unique "${path_source}" "${path_target}")

	frobulator.inf "Renaming" "[ ${name_source} ]"
	frobulator.inf "To" "[ ${path_target##*/} ]"

	mv -- "${path_source}" "${path_target}"

	status_move="${?}"

	if [ "${status_move}" -ne 0 ]
	then
		frobulator.err "Unable to rename" "[ ${name_source} ]"

		continue
	fi

	(( count_renamed ++ ))

done < <(find "${directory}" -mindepth 1 -maxdepth 1 -print0)

# result ───────────────────────────────────────────────────────────────────────

if [ "${count_renamed}" -gt 0 ]
then
	frobulator.scs "Renamed" "[ ${count_renamed} ]"
else
	frobulator.inf "No filenames required normalization"
fi

if [ "${count_unchanged}" -gt 0 ]
then
	frobulator.inf "Unchanged" "[ ${count_unchanged} ]"
fi
