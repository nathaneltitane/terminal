#!/bin/bash

# dependencies /////////////////////////////////////////////////////////////////

ticker () {

	echo

	for ticker in '>  ' '>> ' '>>>'
	do
		echo -n -e "\r[  ${ticker}  ] ${1^}..."

		sleep 0.5
	done

	echo

	echo

}

if [[ $(id -u -n) = "root" ]]
then
	USER="${SUDO_USER:-root}"

	if [ "${USER}" = "root" ]
	then
		HOME=/root
	else
		HOME="/home/${USER}"
	fi
fi

ticker checking

package_managers_list=(
	"apt-get --quiet --quiet update > /dev/null 2>&1; apt-get --quiet --quiet install --yes"
	"dnf --quiet install --assumeyes"
	"yum --quiet install --assumeyes"
	"apk add --quiet"
	"pacman --sync --refresh --noconfirm --noprogressbar"
	"zypper --quiet --non-interactive install"
)

package="curl"

if [[ -z $(command -v "${package}") ]]
then
	for package_manager in "${package_managers_list[@]}"
	do
		entry="${package_manager%% *}"

		if [[ -n $(command -v "${entry}") ]]
		then
			eval "${package_manager} ${package} > /dev/null 2>&1"

			break
		fi
	done

	if [[ -z $(command -v "${package}") ]]
	then
		echo "[  !  ] Unable to install or binary not found /////////////////////// [ '${package}' ]"
		echo

		exit 1
	fi
fi

mkdir -p "${HOME}"/.local/bin

frobulator="${HOME}"/.local/bin/frobulator

version_online=$(curl -s -L get.frbltr.app | grep -m 1 '^# version=' | cut -d '"' -f 2)
version_local=$(grep -m 1 '^# version=' "${frobulator}" 2>/dev/null | cut -d '"' -f 2)

version_local="${version_local:-1970-01-01}"

if [ ! -f "${frobulator}" ] || [[ "${version_online}" > "${version_local}" ]]
then
	curl -s -L get.frbltr.app > "${frobulator}"

	chmod +x "${frobulator}"
fi

ticker initializing

source "${frobulator}"

# script ///////////////////////////////////////////////////////////////////////

script="$(basename -- ${BASH_SOURCE[0]})"

# version //////////////////////////////////////////////////////////////////////

version="2026-07-30"

# usage ////////////////////////////////////////////////////////////////////////

if [[ "${self}" = "${0}" ]]
then
	# implement from local version

	if [ $# -eq 0 ]
	then
		source "${self}"

		return 0 2> "${sink}"

		if [ "${?}" -ne 0 ]
		then
			frobulator.scs "Implemented" "[ ${PWD}/${self} ]"
			echo
		fi
	fi

	file_source="${self}"

	file_install="${file_source}"

	directory_install="${HOME}"/.local/bin

	file_target="${directory_install}/${file_install}"

	while (($#))
	do
		case "${1}" in

			-i|--install)

				if [ ! -d "${directory_install}" ]
				then
					mkdir -p "${directory_install}"
				fi

				if [ "${file_source}" != "${file_target}" ]
				then
					cp "${file_source}" "${file_target}"

					chmod a+rx "${file_target}"

					source "${file_target}"

					frobulator.scs "Installed" "[ ${file_target} ]"

					echo
				fi
			;;

			-h|--help)

				echo
				echo -e "Usage: ./${script} | [OPTION]"
				echo
				echo "Options:"
				echo
				echo "	-i, --install    [I]nstall ${script} to ${directory_install}"
				echo "	-h, --help       Show this [h]elp menu"
				echo

				exit
			;;

			*)

				echo
				echo "${script}: Unknown option '${1}'"
				echo "Type './${script} --help' for help and usage information."
				echo

				exit 1
			;;

		esac

		shift
	done
fi

# prompt ///////////////////////////////////////////////////////////////////////

frobulator.script "Setting up ${script#*-}"

# variables ////////////////////////////////////////////////////////////////////

directory="${PWD}"

source_name=""

target_name=""

character=""

name=""

extension=""

number=0

count_renamed=0

count_unchanged=0

# defaults /////////////////////////////////////////////////////////////////////

export LANG=C.UTF-8

export LC_ALL=C.UTF-8

# functions ////////////////////////////////////////////////////////////////////

name_normalize () {

	local source_name="${1}"
	local target_name=""
	local character=""
	local index=0

	for (( index = 0; index < ${#source_name}; index++ ))
	do
		character="${source_name:index:1}"

		if [ "${character}" = "【" ] ||
		   [ "${character}" = "『" ] ||
		   [ "${character}" = "「" ] ||
		   [ "${character}" = "［" ]
		then
			character="["

		elif [ "${character}" = "】" ] ||
		     [ "${character}" = "』" ] ||
		     [ "${character}" = "」" ] ||
		     [ "${character}" = "］" ]
		then
			character="]"

		elif [ "${character}" = "（" ]
		then
			character="("

		elif [ "${character}" = "）" ]
		then
			character=")"

		elif [ "${character}" = "｛" ]
		then
			character="{"

		elif [ "${character}" = "｝" ]
		then
			character="}"

		elif [ "${character}" = "〈" ] ||
		     [ "${character}" = "《" ]
		then
			character="<"

		elif [ "${character}" = "〉" ] ||
		     [ "${character}" = "》" ]
		then
			character=">"

		elif [ "${character}" = "！" ]
		then
			character="!"

		elif [ "${character}" = "？" ]
		then
			character="?"

		elif [ "${character}" = "：" ]
		then
			character=":"

		elif [ "${character}" = "；" ]
		then
			character=";"

		elif [ "${character}" = "，" ]
		then
			character=","

		elif [ "${character}" = "．" ]
		then
			character="."

		elif [ "${character}" = "％" ]
		then
			character="%"

		elif [ "${character}" = "＆" ]
		then
			character="&"

		elif [ "${character}" = "＋" ]
		then
			character="+"

		elif [ "${character}" = "＝" ]
		then
			character="="

		elif [ "${character}" = "＊" ]
		then
			character="*"

		elif [ "${character}" = "＃" ]
		then
			character="#"

		elif [ "${character}" = "＠" ]
		then
			character="@"

		elif [ "${character}" = "＄" ]
		then
			character="$"

		elif [ "${character}" = "＾" ]
		then
			character="^"

		elif [ "${character}" = "＿" ]
		then
			character="_"

		elif [ "${character}" = "｜" ]
		then
			character="-"

		elif [ "${character}" = "／" ] ||
		     [ "${character}" = "⧸" ] ||
		     [ "${character}" = "＼" ]
		then
			character="-"

		elif [ "${character}" = "～" ] ||
		     [ "${character}" = "〜" ]
		then
			character="~"

		elif [ "${character}" = "’" ] ||
		     [ "${character}" = "‘" ]
		then
			character="'"

		elif [ "${character}" = "“" ] ||
		     [ "${character}" = "”" ] ||
		     [ "${character}" = "＂" ]
		then
			character='"'

		elif [ "${character}" = "—" ] ||
		     [ "${character}" = "–" ] ||
		     [ "${character}" = "−" ] ||
		     [ "${character}" = "‐" ] ||
		     [ "${character}" = "―" ]
		then
			character="-"

		elif [ "${character}" = "…" ]
		then
			character="..."

		elif [ "${character}" = "・" ] ||
		     [ "${character}" = "･" ]
		then
			character="-"

		elif [ "${character}" = "　" ]
		then
			character=" "
		fi

		target_name+="${character}"
	done

	while [[ "${target_name}" = *"  "* ]]
	do
		target_name="${target_name//  / }"
	done

	while [[ "${target_name}" = " "* ]]
	do
		target_name="${target_name# }"
	done

	while [[ "${target_name}" = *" " ]]
	do
		target_name="${target_name% }"
	done

	if [ -z "${target_name}" ]
	then
		target_name="unnamed"
	fi

	echo "${target_name}"
}

path_unique () {

	local source_path="${1}"
	local target_path="${2}"
	local target_name="${target_path##*/}"
	local target_directory="${target_path%/*}"
	local name=""
	local extension=""
	local number=1

	if [ ! -e "${target_path}" ] ||
	   [ "${source_path}" = "${target_path}" ]
	then
		echo "${target_path}"

		return 0
	fi

	if [ -f "${source_path}" ] &&
	   [[ "${target_name}" = *.* ]]
	then
		name="${target_name%.*}"
		extension=".${target_name##*.}"
	else
		name="${target_name}"
		extension=""
	fi

	while [ -e "${target_directory}/${name}-${number}${extension}" ]
	do
		(( number++ ))
	done

	echo "${target_directory}/${name}-${number}${extension}"
}

# update ///////////////////////////////////////////////////////////////////////

# frobulator.update

# frobulator.upgrade

# requirements /////////////////////////////////////////////////////////////////

list=(

)

frobulator.require ${list[@]}

list=()

# configuration ////////////////////////////////////////////////////////////////

if [[ $(locale charmap 2> "${sink}") != "UTF-8" ]]
then
	frobulator.err "UTF-8 locale unavailable"
	echo

	return 1
fi

shopt -s nullglob dotglob

# process //////////////////////////////////////////////////////////////////////

for source_path in "${directory}"/*
do
	if [ ! -e "${source_path}" ]
	then
		continue
	fi

	source_name="${source_path##*/}"

	if [ "${source_name}" = "." ] ||
	   [ "${source_name}" = ".." ]
	then
		continue
	fi

	target_name=$(name_normalize "${source_name}")

	target_path="${directory}/${target_name}"

	if [ "${source_path}" = "${target_path}" ]
	then
		(( count_unchanged++ ))

		continue
	fi

	target_path=$(path_unique "${source_path}" "${target_path}")

	frobulator.inf "Renaming" "[ ${source_name} ]"
	frobulator.inf "To" "[ ${target_path##*/} ]"
	echo

	if ! mv -- "${source_path}" "${target_path}"
	then
		frobulator.err "Unable to rename" "[ ${source_name} ]"
		echo

		continue
	fi

	(( count_renamed++ ))
done

# result ///////////////////////////////////////////////////////////////////////

if [ "${count_renamed}" -gt 0 ]
then
	frobulator.scs "Renamed" "[ ${count_renamed} ]"
	echo
else
	frobulator.inf "No filenames required normalization"
	echo
fi

if [ "${count_unchanged}" -gt 0 ]
then
	frobulator.inf "Unchanged" "[ ${count_unchanged} ]"
	echo
fi
