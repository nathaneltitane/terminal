#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (($#))
do
	case "${1}"
	in
		-d|--directory)
			directory="${2}"

			shift
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -d [Directory] | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-d, --directory    Specify [d]irectory of files to normalize."
			echo
			echo -e "                   [ /path/to/directory ]"
			echo -e "                   [ current directory ]  [ Default ]"
			echo
			echo -e "-h, --help         Show [h]elp and usage information."
			echo
			echo -e "'${script}'        [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -d [Directory] | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

directory="${directory:-${PWD}}"

source_name=""

target_name=""

character=""

name=""

extension=""

number=0

count_renamed=0

count_unchanged=0

# defaults ─────────────────────────────────────────────────────────────────────

export LANG=C.UTF-8

export LC_ALL=C.UTF-8

# functions ────────────────────────────────────────────────────────────────────

name_normalize () {

	local source_name="${1}"
	local target_name=""
	local character=""
	local index=0

	for (( index = 0; index < ${#source_name}; index++ ))
	do
		character="${source_name:index:1}"

		if [ "${character}" = "【" ] ||
		   [ "${character}" = "『" ] ||
		   [ "${character}" = "「" ] ||
		   [ "${character}" = "［" ]
		then
			character="["

		elif [ "${character}" = "】" ] ||
		     [ "${character}" = "』" ] ||
		     [ "${character}" = "」" ] ||
		     [ "${character}" = "］" ]
		then
			character="]"

		elif [ "${character}" = "（" ]
		then
			character="("

		elif [ "${character}" = "）" ]
		then
			character=")"

		elif [ "${character}" = "｛" ]
		then
			character="{"

		elif [ "${character}" = "｝" ]
		then
			character="}"

		elif [ "${character}" = "〈" ] ||
		     [ "${character}" = "《"  ]
		then
			character="<"

		elif [ "${character}" = "〉" ] ||
		     [ "${character}" = "》"  ]
		then
			character=">"

		elif [ "${character}" = "！" ]
		then
			character="!"

		elif [ "${character}" = "？" ]
		then
			character="?"

		elif [ "${character}" = "：" ]
		then
			character=":"

		elif [ "${character}" = "；" ]
		then
			character=";"

		elif [ "${character}" = "，" ]
		then
			character=","

		elif [ "${character}" = "．" ]
		then
			character="."

		elif [ "${character}" = "％" ]
		then
			character="%"

		elif [ "${character}" = "＆" ]
		then
			character="&"

		elif [ "${character}" = "＋" ]
		then
			character="+"

		elif [ "${character}" = "＝" ]
		then
			character="="

		elif [ "${character}" = "＊" ]
		then
			character="*"

		elif [ "${character}" = "＃" ]
		then
			character="#"

		elif [ "${character}" = "＠" ]
		then
			character="@"

		elif [ "${character}" = "＄" ]
		then
			character="$"

		elif [ "${character}" = "＾" ]
		then
			character="^"

		elif [ "${character}" = "＿" ]
		then
			character="_"

		elif [ "${character}" = "｜" ]
		then
			character="-"

		elif [ "${character}" = "／" ] ||
		     [ "${character}" = "⧸"  ] ||
		     [ "${character}" = "＼" ]
		then
			character="-"

		elif [ "${character}" = "～" ] ||
		     [ "${character}" = "〜" ]
		then
			character="~"

		elif [ "${character}" = "’" ] ||
		     [ "${character}" = "‘" ]
		then
			character="'"

		elif [ "${character}" = "“"  ] ||
		     [ "${character}" = "”"  ] ||
		     [ "${character}" = "＂" ]
		then
			character='"'

		elif [ "${character}" = "—" ] ||
		     [ "${character}" = "–" ] ||
		     [ "${character}" = "−" ] ||
		     [ "${character}" = "‐" ] ||
		     [ "${character}" = "―" ]
		then
			character="-"

		elif [ "${character}" = "…" ]
		then
			character="..."

		elif [ "${character}" = "・" ] ||
		     [ "${character}" = "･"  ]
		then
			character="-"

		elif [ "${character}" = "　" ]
		then
			character=" "
		fi

		target_name+="${character}"
	done

	while [[ "${target_name}" = *"  "* ]]
	do
		target_name="${target_name//  / }"
	done

	while [[ "${target_name}" = " "* ]]
	do
		target_name="${target_name# }"
	done

	while [[ "${target_name}" = *" " ]]
	do
		target_name="${target_name% }"
	done

	if [ -z "${target_name}" ]
	then
		target_name="unnamed"
	fi

	echo "${target_name}"
}

path_unique () {

	local source_path="${1}"
	local target_path="${2}"
	local target_name="${target_path##*/}"
	local target_directory="${target_path%/*}"
	local name=""
	local extension=""
	local number=1

	if [ ! -e "${target_path}" ] ||
	   [ "${source_path}" = "${target_path}" ]
	then
		echo "${target_path}"

		return 0
	fi

	if [ -f "${source_path}" ] && [[ "${target_name}" = *.* ]]
	then
		name="${target_name%.*}"
		extension=".${target_name##*.}"
	else
		name="${target_name}"
		extension=""
	fi

	while [ -e "${target_directory}/${name}-${number}${extension}" ]
	do
		(( number++ ))
	done

	echo "${target_directory}/${name}-${number}${extension}"
}

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(

)

frobulator.require ${list[@]}

frobulator.complete

list=()

# configuration ────────────────────────────────────────────────────────────────

# current locale character encoding - e.g. UTF-8

locale_charmap="$(locale charmap 2> "${sink}")"

if [ "${locale_charmap}" != "UTF-8" ]
then
	frobulator.err "UTF-8 locale unavailable"

	exit 1
fi

frobulator.complete

# process ──────────────────────────────────────────────────────────────────────

while IFS= read -r -d '' source_path
do
	source_name="${source_path##*/}"

	target_name=$(name_normalize "${source_name}")

	target_path="${directory}/${target_name}"

	if [ "${source_path}" = "${target_path}" ]
	then
		(( count_unchanged++ ))

		continue
	fi

	target_path=$(path_unique "${source_path}" "${target_path}")

	frobulator.inf "Renaming" "[ ${source_name} ]"
	frobulator.inf "To" "[ ${target_path##*/} ]"

	if ! mv -- "${source_path}" "${target_path}"
	then
		frobulator.err "Unable to rename" "[ ${source_name} ]"

		continue
	fi

	(( count_renamed++ ))

done < <(find "${directory}" -mindepth 1 -maxdepth 1 -print0)

# result ───────────────────────────────────────────────────────────────────────

if [ "${count_renamed}" -gt 0 ]
then
	frobulator.scs "Renamed" "[ ${count_renamed} ]"
else
	frobulator.inf "No filenames required normalization"
fi

if [ "${count_unchanged}" -gt 0 ]
then
	frobulator.inf "Unchanged" "[ ${count_unchanged} ]"
fi
