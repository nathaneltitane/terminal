	["）"]=")"
	["｛"]="{"
	["｝"]="}"
	["〈"]="<"
	["《"]="<"
	["〉"]=">"
	["》"]=">"
	["！"]="!"
	["？"]="?"
	["："]=":"
	["；"]=";"
	["，"]=","
	["．"]="."
	["％"]="%"
	["＆"]="&"
	["＋"]="+"
	["＝"]="="
	["＊"]="*"
	["＃"]="#"
	["＠"]="@"
	["＄"]="$"
	["＾"]="^"
	["＿"]="_"
	["｜"]="-"
	["／"]="-"
	["⧸"]="-"
	["＼"]="-"
	["～"]="~"
	["〜"]="~"
	["’"]="'"
	["‘"]="'"
	["“"]='"'
	["”"]='"'
	["＂"]='"'
	["—"]="-"
	["–"]="-"
	["−"]="-"
	["‐"]="-"
	["―"]="-"
	["…"]="..."
	["・"]="-"
	["･"]="-"
	["　"]=" "
)

# defaults ─────────────────────────────────────────────────────────────────────

export LANG="${locale_setup}"

export LC_ALL="${locale_setup}"

# functions ────────────────────────────────────────────────────────────────────

name_normalize () {

	local name_source="${1}"
	local name_target=""
	local character=""
	local index=0
	local character_mapped=""

	for (( index = 0 ; index < ${#name_source} ; index ++ ))
	do
		character="${name_source:index:1}"
		character_mapped="${map_characters[${character}]}"

		if [ -n "${character_mapped}" ]
		then
			character="${character_mapped}"
		fi

		name_target+="${character}"
	done

	while [[ "${name_target}" = *"${separator_space_double}"* ]]
	do
		name_target="${name_target//"${separator_space_double}"/"${character_space}"}"
	done

	while [[ "${name_target}" = "${character_space}"* ]]
	do
		name_target="${name_target#"${character_space}"}"
	done

	while [[ "${name_target}" = *"${character_space}" ]]
	do
		name_target="${name_target%"${character_space}"}"
	done

	if [ -z "${name_target}" ]
	then
		name_target="${name_unnamed}"
	fi

	echo "${name_target}"
}

path_unique () {

	local path_source="${1}"
	local path_target="${2}"
	local name_target="${path_target##*/}"
	local directory_target="${path_target%/*}"
	local name=""
	local extension=""
	local number=1

	if [ ! -e "${path_target}" ] ||
	   [ "${path_source}" = "${path_target}" ]
	then
		echo "${path_target}"

		return 0
	fi

	if [ -f "${path_source}" ] && [[ "${name_target}" = *"${character_dot}"* ]]
	then
		name="${name_target%"${character_dot}"*}"
		extension="${character_dot}${name_target##*"${character_dot}"}"
	else
		name="${name_target}"
		extension=""
	fi

	while [ -e "${directory_target}/${name}${separator_number}${number}${extension}" ]
	do
		(( number ++ ))
	done

	echo "${directory_target}/${name}${separator_number}${number}${extension}"
}

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(

)

frobulator.require ${list[@]}

frobulator.complete

list=()

# configuration ────────────────────────────────────────────────────────────────

# current locale character encoding - e.g. UTF-8

name_charmap_locale="$(locale charmap 2> "${sink}")"

if [ "${name_charmap_locale}" != "${name_charmap_expected}" ]
then
	frobulator.err "UTF-8 locale unavailable"

	exit 1
fi

frobulator.complete

# process ──────────────────────────────────────────────────────────────────────

while IFS= read -r -d '' path_source
do
	name_source="${path_source##*/}"

	name_target="$(name_normalize "${name_source}")"

	path_target="${directory}/${name_target}"

	if [ "${path_source}" = "${path_target}" ]
	then
		(( count_unchanged ++ ))

		continue
	fi

	path_target="$(path_unique "${path_source}" "${path_target}")"

	frobulator.inf "Renaming" "[ ${name_source} ]"
	frobulator.inf "To" "[ ${path_target##*/} ]"

	mv -- "${path_source}" "${path_target}"

	status_move="${?}"

	if [ "${status_move}" -ne 0 ]
	then
		frobulator.err "Unable to rename" "[ ${name_source} ]"

		continue
	fi

	(( count_renamed ++ ))

done < <(find "${directory}" -mindepth "${depth_minimum}" -maxdepth "${depth_maximum}" -print0)

# result ───────────────────────────────────────────────────────────────────────

if [ "${count_renamed}" -gt 0 ]
then
	frobulator.scs "Renamed" "[ ${count_renamed} ]"
else
	frobulator.inf "No filenames required normalization"
fi

if [ "${count_unchanged}" -gt 0 ]
then
	frobulator.inf "Unchanged" "[ ${count_unchanged} ]"
fi
