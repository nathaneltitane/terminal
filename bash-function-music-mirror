#!/bin/bash

# loaded by "${HOME}"/.local/bin/bash-functions

# music mirror ─────────────────────────────────────────────────────────────────

music_mirror_match () {

	# renamed folder on the external drive - new name of a device folder - empty when none
	# 1 - CD NN and DISC NN alike - same number
	# 2 - parent folder name in front of the old name
	# 3 - a single folder whose name starts or ends with the old name

	local directory_external="${1}"
	local name_folder="${2}"
	local name_parent="${3}"
	local pattern_disc="^(CD|DISC)[[:space:]]*0*([0-9]+)$"
	local separator_name=" "

	local number_disc
	local name_candidate
	local directory_candidate

	local -a list_candidates=()

	if [[ "${name_folder}" =~ ${pattern_disc} ]]
	then
		number_disc="${BASH_REMATCH[2]}"

		for directory_candidate in "${directory_external}"/*/
		do
			name_candidate="$(basename -- "${directory_candidate}")"

			if [[ "${name_candidate}" =~ ${pattern_disc} ]] && [ "${BASH_REMATCH[2]}" = "${number_disc}" ]
			then
				list_candidates+=("${name_candidate}")
			fi
		done

		if [ "${#list_candidates[@]}" -eq 1 ]
		then
			echo "${list_candidates[0]}"

			return 0
		fi
	fi

	if [ -n "${name_parent}" ] && [ -d "${directory_external}/${name_parent}${separator_name}${name_folder}" ]
	then
		echo "${name_parent}${separator_name}${name_folder}"

		return 0
	fi

	list_candidates=()

	for directory_candidate in "${directory_external}/${name_folder}${separator_name}"*/ "${directory_external}/"*"${separator_name}${name_folder}"/
	do
		if [ -d "${directory_candidate}" ]
		then
			list_candidates+=("$(basename -- "${directory_candidate}")")
		fi
	done

	if [ "${#list_candidates[@]}" -eq 1 ]
	then
		echo "${list_candidates[0]}"
	fi
}

music_mirror_rename () {

	# device folders renamed to their external drive names - top down - every depth
	# executing: renamed on the device - files kept - only differences copied by the mirror afterwards
	# dry run: renames listed - deeper folders checked under their future name
	# runs from music-mirror - uses its option_execute and list_paths_renamed

	local directory_external="${1}"
	local directory_device="${2}"
	local path_relative="${3}"

	local directory_folder
	local name_folder
	local name_parent
	local name_renamed
	local path_folder
	local path_renamed

	name_parent="$(basename -- "${directory_external}")"

	for directory_folder in "${directory_device}"/*/
	do
		if [ ! -d "${directory_folder}" ]
		then
			continue
		fi

		name_folder="$(basename -- "${directory_folder}")"
		path_folder="${path_relative:+${path_relative}/}${name_folder}"

		if [ -d "${directory_external}/${name_folder}" ]
		then
			music_mirror_rename "${directory_external}/${name_folder}" "${directory_device}/${name_folder}" "${path_folder}"

			continue
		fi

		name_renamed="$(music_mirror_match "${directory_external}" "${name_folder}" "${name_parent}")"

		if [ -z "${name_renamed}" ]
		then
			continue
		fi

		path_renamed="${path_relative:+${path_relative}/}${name_renamed}"

		frobulator.inf "Renamed on external drive" "[ '${path_folder}' >> '${name_renamed}' ]"

		if [ "${option_execute}" = "true" ] && [ ! -e "${directory_device}/${name_renamed}" ]
		then
			mv -- "${directory_device}/${name_folder}" "${directory_device}/${name_renamed}"

			music_mirror_rename "${directory_external}/${name_renamed}" "${directory_device}/${name_renamed}" "${path_renamed}"
		else
			list_paths_renamed+=("${path_folder}")

			music_mirror_rename "${directory_external}/${name_renamed}" "${directory_device}/${name_folder}" "${path_folder}"
		fi
	done
}

music-mirror () {

	# mirror external drive music to every reachable kde connect device - priority devices first, then the others
	# folders renamed on the external drive are renamed on the device first - every depth - see music_mirror_match
	# internal and sd card music folders used as one library - internal storage first, then sd cards
	# folder by folder - for the folders each device keeps - mirrored where they are:
	# a folder's subfolders on the device are each mirrored - or the folder itself if it has none
	# usage: music-mirror [-r] [utility-add-remove options: -e execute / -y skip confirmation]
	# -r: full resync - each top folder on the device mirrored whole - subfolders it lacks added too
	# without options every folder is a dry run

	local directory_media="/media"
	local name_external="external"
	local name_music="Music"
	local suffix_music="/${name_music}"
	local directory_music_external="${directory_media}/${USER}/${name_external}/${name_music}"
	local name_utility="utility-add-remove"
	local directory_utility="${HOME}/.local/bin"
	local host_download="get.trmnl.me"
	local name_device_phone="phone"
	local name_device_tablet="tablet"
	local name_device_note="note"
	local flag_resync="-r"
	local flag_execute="-e"
	local directory_runtime="/run/user"
	local service_dbus="org.kde.kdeconnect"
	local path_dbus_devices="/modules/kdeconnect/devices"
	local path_dbus_sftp="/sftp"
	local method_mount="org.kde.kdeconnect.device.sftp.mountAndWait"
	local method_mount_point="org.kde.kdeconnect.device.sftp.mountPoint"
	local method_directories="org.kde.kdeconnect.device.sftp.getDirectories"
	local separator_directory=": "
	local path_storage_internal="/storage/emulated"
	local path_storage_default="${path_storage_internal}/0"
	local separator_path_start=" |"
	local separator_path_end="| "
	local format_path_marker="${separator_path_start}%s${separator_path_end}"

	local directory_music_device
	local directory_mount
	local path_utility
	local directory_candidate
	local directory_folder_device
	local directory_subfolder_device
	local path_relative
	local line_device
	local id_device
	local name_device
	local name_priority
	local path_dbus
	local path_kdeconnect
	local path_qdbus
	local line_directory
	local option_execute="false"
	local option_resync="false"
	local option

	local -a list_names_priority=(
		"${name_device_phone}"
		"${name_device_tablet}"
		"${name_device_note}"
	)

	local -a list_devices=()
	local -a list_devices_ordered=()
	local -a list_entries_candidate=()
	local -a list_subfolders_device=()
	local -a list_paths_relative=()
	local -a list_directories_device=()
	local -a list_directories_ordered=()
	local -a list_options=()
	local -a list_paths_renamed=()
	local text_paths_renamed
	local text_folders_seen
	local name_folder_top
	local index_path
	local id_user
	local directory_mount_default
	local status_download

	local -a list_directories_music_device=()
	local -a list_directories_target=()
	local -a list_paths_candidate=()

	# output starts one line below the command

	echo

	if [ ! -d "${directory_music_external}" ]
	then
		frobulator.err "External music folder not found" "[ ${directory_music_external} ]"

		return 1
	fi

	path_kdeconnect="$(command -v kdeconnect-cli)"

	if [ -z "${path_kdeconnect}" ]
	then
		frobulator.err "KDE Connect not available" "[ kdeconnect-cli ]"

		return 1
	fi

	path_utility="$(command -v "${name_utility}")"

	if [ -z "${path_utility}" ]
	then
		frobulator.download "${host_download}" "${directory_utility}" "${name_utility}"
		status_download="${?}"

		if [ "${status_download}" -ne 0 ]
		then
			return "${status_download}"
		fi

		path_utility="${directory_utility}/${name_utility}"
	fi

	# reachable devices - 'id name' per line

	mapfile -t list_devices < <("${path_kdeconnect}" --list-available --id-name-only 2> "${sink}")

	if [ "${#list_devices[@]}" -eq 0 ]
	then
		frobulator.err "No reachable device" "[ kde connect ]"

		return 1
	fi

	# order: priority device names first - then the others as listed

	for name_priority in "${list_names_priority[@]}"
	do
		for line_device in "${list_devices[@]}"
		do
			if [ "${line_device#* }" = "${name_priority}" ]
			then
				list_devices_ordered+=("${line_device}")
			fi
		done
	done

	for line_device in "${list_devices[@]}"
	do
		name_device="${line_device#* }"

		if [ "${name_device}" != "${name_device_phone}" ] &&
		   [ "${name_device}" != "${name_device_tablet}" ] &&
		   [ "${name_device}" != "${name_device_note}" ]
		then
			list_devices_ordered+=("${line_device}")
		fi
	done

	path_qdbus="$(command -v qdbus)"

	# dry run unless utility-add-remove is told to execute - folder renames on devices follow the same rule

	# -r kept here - every other option passed on to utility-add-remove

	for option in "${@}"
	do
		if [ "${option}" = "${flag_resync}" ]
		then
			option_resync="true"

			continue
		fi

		if [ "${option}" = "${flag_execute}" ]
		then
			option_execute="true"
		fi

		list_options+=("${option}")
	done

	# user id for mounts

	id_user="$(id -u)"

	for line_device in "${list_devices_ordered[@]}"
	do
		id_device="${line_device%% *}"
		name_device="${line_device#* }"

		directory_music_device=""
		list_paths_relative=()
		text_paths_renamed=""

		frobulator.separate

		frobulator.fwd "Device" "[ ${name_device} ]"

		# storage mounted through kde connect - mounted here when not yet

		directory_mount_default="${directory_runtime}/${id_user}/${id_device}"
		directory_mount="${directory_mount_default}"

		if [ -n "${path_qdbus}" ]
		then
			path_dbus="${path_dbus_devices}/${id_device}${path_dbus_sftp}"

			"${path_qdbus}" "${service_dbus}" "${path_dbus}" "${method_mount}" > "${sink}" 2>&1

			directory_mount="$("${path_qdbus}" "${service_dbus}" "${path_dbus}" "${method_mount_point}" 2> "${sink}")"
			directory_mount="${directory_mount:-${directory_mount_default}}"
		fi

		# storage places reported by kde connect - 'path: name' per line - internal storage and sd cards
		# the storage folder itself cannot be listed on the device - places taken from kde connect instead

		list_directories_device=()

		if [ -n "${path_qdbus}" ]
		then
			while IFS= read -r line_directory
			do
				list_directories_device+=("${line_directory%%${separator_directory}*}")
			done < <("${path_qdbus}" "${service_dbus}" "${path_dbus}" "${method_directories}" 2> "${sink}")
		fi

		if [ "${#list_directories_device[@]}" -eq 0 ]
		then
			list_directories_device=("${directory_mount}${path_storage_default}")
		fi

		# internal storage first - sd cards after

		list_directories_ordered=()

		for directory_candidate in "${list_directories_device[@]}"
		do
			if [[ "${directory_candidate}" = *${path_storage_internal}/* ]]
			then
				list_directories_ordered=("${directory_candidate}" "${list_directories_ordered[@]}")
			else
				list_directories_ordered+=("${directory_candidate}")
			fi
		done

		# every music folder holding anything is used - internal storage first, then sd cards
		# one library across them: each folder is mirrored where it already is on the device

		list_directories_music_device=()

		for directory_candidate in "${list_directories_ordered[@]/%/${suffix_music}}"
		do
			list_entries_candidate=("${directory_candidate}"/*)

			if [ -d "${directory_candidate}" ] && [ -e "${list_entries_candidate[0]}" ]
			then
				list_directories_music_device+=("${directory_candidate}")
			fi
		done

		if [ "${#list_directories_music_device[@]}" -eq 0 ]
		then
			frobulator.wrn "Skipped - music folder not found or empty" "[ ${name_device} ]"

			continue
		fi

		list_directories_target=()
		text_folders_seen=""

		for directory_music_device in "${list_directories_music_device[@]}"
		do
			frobulator.inf "Music folder" "[ ${directory_music_device#"${directory_mount}"/} ]"

			# renames first - the mirror then finds the device folders under their new names

			list_paths_renamed=()

			music_mirror_rename "${directory_music_external}" "${directory_music_device}" ""

			text_paths_renamed+="$(printf "${format_path_marker}" "${list_paths_renamed[@]}")"

			# folder list: subfolders kept on the device or the folder itself when it has none
			# a folder already found in an earlier music folder is left out - the earlier copy is mirrored
			# a top folder may be split across music folders - each part mirrored where it is

			list_paths_candidate=()

			for directory_folder_device in "${directory_music_device}"/*/
			do
				if [ ! -d "${directory_folder_device}" ]
				then
					continue
				fi

				name_folder_top="$(basename -- "${directory_folder_device}")"

				list_subfolders_device=("${directory_folder_device}"*/)

				if [ "${option_resync}" = "true" ]
				then
					list_paths_candidate+=("${name_folder_top}")
				elif [ -d "${list_subfolders_device[0]}" ]
				then
					for directory_subfolder_device in "${list_subfolders_device[@]}"
					do
						list_paths_candidate+=("${name_folder_top}/$(basename -- "${directory_subfolder_device}")")
					done
				else
					list_paths_candidate+=("${name_folder_top}")
				fi
			done

			for path_relative in "${list_paths_candidate[@]}"
			do
				if [[ "${text_folders_seen}" == *"${separator_path_start}${path_relative}${separator_path_end}"* ]] ||
				   [[ "${text_folders_seen}" == *"${separator_path_start}${path_relative%%/*}${separator_path_end}"* ]] ||
				   [[ "${text_folders_seen}" == *"${separator_path_start}${path_relative}/"* ]]
				then
					frobulator.wrn "Skipped - also in an earlier music folder" "[ '${path_relative}' ]"

					continue
				fi

				list_paths_relative+=("${path_relative}")
				list_directories_target+=("${directory_music_device}")
			done

			for path_relative in "${list_paths_candidate[@]}"
			do
				text_folders_seen+="${separator_path_start}${path_relative}${separator_path_end}"
			done
		done

		# each folder mirrored on its own from the external drive - into the music folder holding it

		for index_path in "${!list_paths_relative[@]}"
		do
			path_relative="${list_paths_relative[${index_path}]}"
			directory_music_device="${list_directories_target[${index_path}]}"

			if [ ! -d "${directory_music_external}/${path_relative}" ]
			then
				# dry run - renamed folders mirrored once the renames are executed

				if [[ "${text_paths_renamed}" == *"${separator_path_start}${path_relative}${separator_path_end}"* ]] ||
				   [[ "${text_paths_renamed}" == *"${separator_path_start}${path_relative%/*}${separator_path_end}"* ]]
				then
					frobulator.inf "Mirrored after the rename" "[ '${path_relative}' ]"
				else
					frobulator.wrn "Skipped - not on external drive" "[ '${path_relative}' ]"
				fi

				continue
			fi

			frobulator.fwd "Mirroring" "[ '${path_relative}' ]"

			bash "${path_utility}" -f "${directory_music_external}/${path_relative}" -t "${directory_music_device}/${path_relative}" -m "${list_options[@]}"
		done
	done
}
