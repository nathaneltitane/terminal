#!/bin/bash

# loaded by "${HOME}"/.local/bin/bash-functions

# music mirror ─────────────────────────────────────────────────────────────────

music_mirror_match () {

	# renamed folder on the external drive - new name of a device folder - empty when none
	# 1 - CD NN and DISC NN alike - same number
	# 2 - parent folder name in front of the old name
	# 3 - a single folder whose name starts or ends with the old name

	local directory_external="${1}"
	local name_folder="${2}"
	local name_parent="${3}"

	local number_disc
	local name_candidate
	local directory_candidate

	local -a list_candidates=()

	if [[ "${name_folder}" =~ ^(CD|DISC)[[:space:]]*0*([0-9]+)$ ]]
	then
		number_disc="${BASH_REMATCH[2]}"

		for directory_candidate in "${directory_external}"/*/
		do
			name_candidate="$(basename -- "${directory_candidate}")"

			if [[ "${name_candidate}" =~ ^(CD|DISC)[[:space:]]*0*([0-9]+)$ ]] && [ "${BASH_REMATCH[2]}" = "${number_disc}" ]
			then
				list_candidates+=("${name_candidate}")
			fi
		done

		if [ "${#list_candidates[@]}" -eq 1 ]
		then
			echo "${list_candidates[0]}"

			return 0
		fi
	fi

	if [ -n "${name_parent}" ] && [ -d "${directory_external}/${name_parent} ${name_folder}" ]
	then
		echo "${name_parent} ${name_folder}"

		return 0
	fi

	list_candidates=()

	for directory_candidate in "${directory_external}/${name_folder} "*/ "${directory_external}/"*" ${name_folder}"/
	do
		if [ -d "${directory_candidate}" ]
		then
			list_candidates+=("$(basename -- "${directory_candidate}")")
		fi
	done

	if [ "${#list_candidates[@]}" -eq 1 ]
	then
		echo "${list_candidates[0]}"
	fi
}

music_mirror_rename () {

	# device folders renamed to their external drive names - top down - every depth
	# executing: renamed on the device - files kept - only differences copied by the mirror afterwards
	# dry run: renames listed - deeper folders checked under their future name
	# runs from music-mirror - uses its option_execute and list_paths_renamed

	local directory_external="${1}"
	local directory_device="${2}"
	local path_relative="${3}"

	local directory_folder
	local name_folder
	local name_parent
	local name_renamed

	name_parent="$(basename -- "${directory_external}")"

	for directory_folder in "${directory_device}"/*/
	do
		if [ ! -d "${directory_folder}" ]
		then
			continue
		fi

		name_folder="$(basename -- "${directory_folder}")"

		if [ -d "${directory_external}/${name_folder}" ]
		then
			music_mirror_rename "${directory_external}/${name_folder}" "${directory_device}/${name_folder}" "${path_relative:+${path_relative}/}${name_folder}"

			continue
		fi

		name_renamed="$(music_mirror_match "${directory_external}" "${name_folder}" "${name_parent}")"

		if [ -z "${name_renamed}" ]
		then
			continue
		fi

		frobulator.inf "Renamed on external drive" "[ '${path_relative:+${path_relative}/}${name_folder}' >> '${name_renamed}' ]"

		if [ "${option_execute}" = "true" ] && [ ! -e "${directory_device}/${name_renamed}" ]
		then
			mv -- "${directory_device}/${name_folder}" "${directory_device}/${name_renamed}"

			music_mirror_rename "${directory_external}/${name_renamed}" "${directory_device}/${name_renamed}" "${path_relative:+${path_relative}/}${name_renamed}"
		else
			list_paths_renamed+=("${path_relative:+${path_relative}/}${name_folder}")

			music_mirror_rename "${directory_external}/${name_renamed}" "${directory_device}/${name_folder}" "${path_relative:+${path_relative}/}${name_folder}"
		fi
	done
}

music-mirror () {

	# mirror external drive music to every reachable kde connect device - priority devices first, then the others
	# folders renamed on the external drive are renamed on the device first - every depth - see music_mirror_match
	# folder by folder - for the folders each device keeps:
	# a folder's subfolders on the device are each mirrored - or the folder itself if it has none
	# usage: music-mirror [utility-add-remove options: -e execute / -y skip confirmation]
	# without options every folder is a dry run

	local directory_music_external="/media/${USER}/external/Music"

	local directory_music_device
	local directory_mount
	local path_utility
	local directory_candidate
	local directory_folder_device
	local directory_subfolder_device
	local path_relative
	local line_device
	local id_device
	local name_device
	local name_priority
	local path_dbus
	local path_kdeconnect
	local path_qdbus
	local line_directory
	local option_execute="false"
	local option

	local -a list_devices=()
	local -a list_devices_ordered=()
	local -a list_entries_candidate=()
	local -a list_subfolders_device=()
	local -a list_paths_relative=()
	local -a list_directories_device=()
	local -a list_directories_ordered=()
	local -a list_options=("${@}")
	local -a list_paths_renamed=()
	local text_paths_renamed

	if [ ! -d "${directory_music_external}" ]
	then
		frobulator.err "External music folder not found" "[ ${directory_music_external} ]"

		return 1
	fi

	path_kdeconnect="$(command -v kdeconnect-cli)"

	if [ -z "${path_kdeconnect}" ]
	then
		frobulator.err "KDE Connect not available" "[ kdeconnect-cli ]"

		return 1
	fi

	path_utility="$(command -v utility-add-remove)"

	if [ -z "${path_utility}" ]
	then
		frobulator.download get.trmnl.me "${HOME}/.local/bin" utility-add-remove || return

		path_utility="${HOME}/.local/bin/utility-add-remove"
	fi

	# reachable devices - 'id name' per line

	mapfile -t list_devices < <("${path_kdeconnect}" --list-available --id-name-only 2> "${sink}")

	if [ "${#list_devices[@]}" -eq 0 ]
	then
		frobulator.err "No reachable device" "[ kde connect ]"

		return 1
	fi

	# order: priority device names first - then the others as listed

	for name_priority in phone tablet note
	do
		for line_device in "${list_devices[@]}"
		do
			if [ "${line_device#* }" = "${name_priority}" ]
			then
				list_devices_ordered+=("${line_device}")
			fi
		done
	done

	for line_device in "${list_devices[@]}"
	do
		name_device="${line_device#* }"

		if [ "${name_device}" != "phone" ] && [ "${name_device}" != "tablet" ] && [ "${name_device}" != "note" ]
		then
			list_devices_ordered+=("${line_device}")
		fi
	done

	path_qdbus="$(command -v qdbus)"

	# dry run unless utility-add-remove is told to execute - folder renames on devices follow the same rule

	for option in "${list_options[@]}"
	do
		if [ "${option}" = "-e" ]
		then
			option_execute="true"
		fi
	done

	for line_device in "${list_devices_ordered[@]}"
	do
		id_device="${line_device%% *}"
		name_device="${line_device#* }"

		directory_music_device=""
		list_paths_relative=()

		frobulator.separate

		frobulator.fwd "Device" "[ ${name_device} ]"

		# storage mounted through kde connect - mounted here when not yet

		directory_mount="/run/user/$(id -u)/${id_device}"

		if [ -n "${path_qdbus}" ]
		then
			path_dbus="/modules/kdeconnect/devices/${id_device}/sftp"

			"${path_qdbus}" org.kde.kdeconnect "${path_dbus}" org.kde.kdeconnect.device.sftp.mountAndWait > "${sink}" 2>&1

			directory_mount="$("${path_qdbus}" org.kde.kdeconnect "${path_dbus}" org.kde.kdeconnect.device.sftp.mountPoint 2> "${sink}")"
			directory_mount="${directory_mount:-/run/user/$(id -u)/${id_device}}"
		fi

		# storage places reported by kde connect - 'path: name' per line - internal storage and sd cards
		# the storage folder itself cannot be listed on the device - places taken from kde connect instead

		list_directories_device=()

		if [ -n "${path_qdbus}" ]
		then
			while IFS= read -r line_directory
			do
				list_directories_device+=("${line_directory%%: *}")
			done < <("${path_qdbus}" org.kde.kdeconnect "${path_dbus}" org.kde.kdeconnect.device.sftp.getDirectories 2> "${sink}")
		fi

		if [ "${#list_directories_device[@]}" -eq 0 ]
		then
			list_directories_device=("${directory_mount}/storage/emulated/0")
		fi

		# internal storage first - sd cards after

		list_directories_ordered=()

		for directory_candidate in "${list_directories_device[@]}"
		do
			if [[ "${directory_candidate}" = */storage/emulated/* ]]
			then
				list_directories_ordered=("${directory_candidate}" "${list_directories_ordered[@]}")
			else
				list_directories_ordered+=("${directory_candidate}")
			fi
		done

		# first music folder holding anything is used

		for directory_candidate in "${list_directories_ordered[@]/%//Music}"
		do
			list_entries_candidate=("${directory_candidate}"/*)

			if [ -d "${directory_candidate}" ] && [ -e "${list_entries_candidate[0]}" ]
			then
				directory_music_device="${directory_candidate}"

				break
			fi
		done

		if [ -z "${directory_music_device}" ]
		then
			frobulator.wrn "Skipped - music folder not found or empty" "[ ${name_device} ]"

			continue
		fi

		frobulator.inf "Music folder" "[ ${directory_music_device#"${directory_mount}"/} ]"

		# renames first - the mirror then finds the device folders under their new names

		list_paths_renamed=()

		music_mirror_rename "${directory_music_external}" "${directory_music_device}" ""

		text_paths_renamed="$(printf ' |%s| ' "${list_paths_renamed[@]}")"

		# folder list: subfolders kept on the device or the folder itself when it has none

		for directory_folder_device in "${directory_music_device}"/*/
		do
			list_subfolders_device=("${directory_folder_device}"*/)

			if [ -d "${list_subfolders_device[0]}" ]
			then
				for directory_subfolder_device in "${list_subfolders_device[@]}"
				do
					list_paths_relative+=("$(basename -- "${directory_folder_device}")/$(basename -- "${directory_subfolder_device}")")
				done
			else
				list_paths_relative+=("$(basename -- "${directory_folder_device}")")
			fi
		done

		# each folder mirrored on its own from the external drive

		for path_relative in "${list_paths_relative[@]}"
		do
			if [ ! -d "${directory_music_external}/${path_relative}" ]
			then
				# dry run - renamed folders mirrored once the renames are executed

				if [[ "${text_paths_renamed}" == *" |${path_relative}| "* ]] || [[ "${text_paths_renamed}" == *" |${path_relative%/*}| "* ]]
				then
					frobulator.inf "Mirrored after the rename" "[ '${path_relative}' ]"
				else
					frobulator.wrn "Skipped - not on external drive" "[ '${path_relative}' ]"
				fi

				continue
			fi

			frobulator.fwd "Mirroring" "[ '${path_relative}' ]"

			bash "${path_utility}" -f "${directory_music_external}/${path_relative}" -t "${directory_music_device}/${path_relative}" -m "${list_options[@]}"
		done
	done
}
