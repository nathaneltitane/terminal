#!/bin/bash

# loaded by "${HOME}"/.local/bin/bash-functions

# music mirror ─────────────────────────────────────────────────────────────────

music-mirror () {

	# mirror external drive music to the phone - folder by folder - for the folders the phone keeps:
	# a folder's subfolders on the phone are each mirrored - or the folder itself if it has none
	# usage: music-mirror [utility-add-remove options: -e execute / -y skip confirmation]
	# without options every folder is a dry run

	local directory_music_external="/media/${USER}/external/Music"

	local directory_music_phone
	local path_utility
	local directory_candidate
	local directory_folder_phone
	local directory_subfolder_phone
	local path_relative

	local -a list_subfolders_phone=()
	local -a list_paths_relative=()
	local -a list_options=("${@}")

	# phone storage mounted by kde connect

	for directory_candidate in /run/user/"$(id -u)"/*/storage/emulated/0/Music
	do
		if [ -d "${directory_candidate}" ]
		then
			directory_music_phone="${directory_candidate}"

			break
		fi
	done

	if [ -z "${directory_music_phone}" ]
	then
		frobulator.err "Phone music folder not mounted" "[ kde connect ]"
		frobulator.nul "Open the phone in dolphin or browse it through kde connect first."

		return 1
	fi

	if [ ! -d "${directory_music_external}" ]
	then
		frobulator.err "External music folder not found" "[ ${directory_music_external} ]"

		return 1
	fi

	path_utility="$(command -v utility-add-remove)"

	if [ -z "${path_utility}" ]
	then
		frobulator.download get.trmnl.me "${HOME}/.local/bin" utility-add-remove || return

		path_utility="${HOME}/.local/bin/utility-add-remove"
	fi

	# folder list: subfolders kept on the phone or the folder itself when it has none

	for directory_folder_phone in "${directory_music_phone}"/*/
	do
		list_subfolders_phone=("${directory_folder_phone}"*/)

		if [ -d "${list_subfolders_phone[0]}" ]
		then
			for directory_subfolder_phone in "${list_subfolders_phone[@]}"
			do
				list_paths_relative+=("$(basename -- "${directory_folder_phone}")/$(basename -- "${directory_subfolder_phone}")")
			done
		else
			list_paths_relative+=("$(basename -- "${directory_folder_phone}")")
		fi
	done

	# each folder mirrored on its own from the external drive

	for path_relative in "${list_paths_relative[@]}"
	do
		if [ ! -d "${directory_music_external}/${path_relative}" ]
		then
			frobulator.wrn "Skipped - not on external drive" "[ '${path_relative}' ]"

			continue
		fi

		frobulator.fwd "Mirroring" "[ '${path_relative}' ]"

		bash "${path_utility}" -f "${directory_music_external}/${path_relative}" -t "${directory_music_phone}/${path_relative}" -m "${list_options[@]}"
	done
}
