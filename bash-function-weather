#!/bin/bash

# loaded by "${HOME}"/.local/bin/bash-functions

# weather ──────────────────────────────────────────────────────────────────────

weather () {

	local url_weather="wttr.in/?format=j1"
	local url_space="https://services.swpc.noaa.gov/json/planetary_k_index_1m.json"
	local number_day=0

	local text_weather
	local name_area
	local name_region
	local temperature_current
	local temperature_feels
	local condition_current
	local code_condition
	local speed_wind
	local degrees_wind
	local direction_wind
	local percent_humidity
	local amount_rain
	local index_uv
	local time_sunrise
	local time_sunset
	local date_forecast
	local temperature_low
	local temperature_high
	local code_day
	local percent_rain
	local label_day
	local color_rain
	local index_kp
	local label_kp
	local color_kp

	local -a list_arrows_wind=( ↑ ↗ → ↘ ↓ ↙ ← ↖ )

	if [ -z "$(command -v jq)" ]
	then
		frobulator.require jq
	fi

	# forecast data - location from this connection

	text_weather="$(curl --silent --fail --max-time 15 "${url_weather}")"

	if [ -z "${text_weather}" ]
	then
		frobulator.err "Weather service unreachable" "[ wttr.in ]"

		return 1
	fi

	IFS='|' read -r name_area name_region < <(
		jq -r '.nearest_area[0] | [.areaName[0].value, .region[0].value] | join("|")' <<< "${text_weather}"
	)

	IFS='|' read -r temperature_current temperature_feels condition_current code_condition speed_wind degrees_wind direction_wind percent_humidity amount_rain index_uv < <(
		jq -r '.current_condition[0] | [.temp_C, .FeelsLikeC, (.weatherDesc[0].value | rtrimstr(" ")), .weatherCode, .windspeedKmph, .winddirDegree, .winddir16Point, .humidity, .precipMM, .uvIndex] | map(tostring) | join("|")' <<< "${text_weather}"
	)

	IFS='|' read -r time_sunrise time_sunset < <(
		jq -r '.weather[0].astronomy[0] | [.sunrise, .sunset] | join("|")' <<< "${text_weather}"
	)

	# current conditions - symbol by weather code - colour by temperature

	frobulator.inf "Location" "[ ${name_area}, ${name_region} ]"

	frobulator.num "$(weather_color "${temperature_current}")" "$(weather_symbol "${code_condition}")" "Condition" "[ ${condition_current} ]"

	frobulator.num "$(weather_color "${temperature_current}")" "🌡" "Temperature" "[ ${temperature_current} °C // feels ${temperature_feels} °C ]"

	# wind arrow - the direction the wind blows towards - opposite of where it comes from

	frobulator.num aqua "${list_arrows_wind[( ( degrees_wind + 180 + 22 ) % 360 ) / 45]}" "Wind" "[ ${direction_wind} // ${speed_wind} km/h ]"

	color_rain="white"

	if [ "${amount_rain%%.*}" -gt 0 ] || [ "${amount_rain#*.}" != "0" ]
	then
		color_rain="blue"
	fi

	frobulator.num "${color_rain}" "☂" "Rain" "[ ${amount_rain} mm ]"

	frobulator.num aqua "🌢" "Humidity" "[ ${percent_humidity} % ]"

	frobulator.num yellow "🌣" "Sun" "[ ${time_sunrise} // ${time_sunset} // uv ${index_uv} ]"

	# space weather - noaa planetary k index - geomagnetic activity - 0 to 9

	index_kp="$(curl --silent --fail --max-time 10 "${url_space}" | jq -r '.[-1].kp_index' 2> "${sink}")"

	if [[ "${index_kp}" =~ ^[0-9]$ ]]
	then
		if [ "${index_kp}" -le 3 ]
		then
			label_kp="quiet"
			color_kp="green"

		elif [ "${index_kp}" -eq 4 ]
		then
			label_kp="active"
			color_kp="yellow"

		elif [ "${index_kp}" -le 6 ]
		then
			label_kp="storm // auroras possible"
			color_kp="orange"
		else
			label_kp="severe storm // auroras possible"
			color_kp="red"
		fi

		frobulator.num "${color_kp}" "☄" "Space" "[ kp ${index_kp} // ${label_kp} ]"
	fi

	# forecast - separated - grey - midday symbol - lowest and highest temperature - highest rain chance of the day

	frobulator.sep

	while IFS='|' read -r date_forecast temperature_low temperature_high code_day percent_rain
	do
		(( number_day ++ ))

		label_day="$(date -d "${date_forecast}" '+%a %d %b')"

		frobulator.num grey "${number_day}" "${label_day} $(weather_symbol "${code_day}")" "[ ${temperature_low} to ${temperature_high} °C // rain ${percent_rain} % ]"
	done < <(
		jq -r '.weather[] | [.date, .mintempC, .maxtempC, .hourly[4].weatherCode, ([.hourly[].chanceofrain | tonumber] | max)] | map(tostring) | join("|")' <<< "${text_weather}"
	)
}

weather_symbol () {

	# weather code - text symbol - no emoji presentation

	case "${1}"
	in
		113)																				echo "🌣" ;;
		116|119|122)																		echo "☁" ;;
		143|248|260)																		echo "🌫" ;;
		389|395)																			echo "⛈" ;;
		200|386|392)																		echo "🌩" ;;
		176|263|266|281|284|293|296|299|302|305|308|311|314|353|356|359)					echo "⛆" ;;
		179|182|185|227|230|317|320|323|326|329|332|335|338|350|362|365|368|371|374|377)	echo "❄" ;;
		*)																					echo "?" ;;
	esac
}

weather_color () {

	# temperature - palette colour - blue cold to red hot

	local temperature="${1}"

	if [ "${temperature}" -le 0 ]
	then
		echo "blue"

	elif [ "${temperature}" -le 10 ]
	then
		echo "aqua"

	elif [ "${temperature}" -le 20 ]
	then
		echo "green"

	elif [ "${temperature}" -le 27 ]
	then
		echo "orange"
	else
		echo "red"
	fi
}
