then
	pkill -f "${compositor}"
else
	compositor_load
fi

# session start

waydroid session stop

waydroid show-full-ui 2>&1 | while read -r message
do
	if echo "${message}" | grep -i 'Android with user 0 is ready'
	then
		sudo chmod --recursive 777 "${android_media}"

		session_start
	fi
done

# session stop

