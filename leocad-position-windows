#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-h|--help)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-h, --help    Show [h]elp and usage information."
			echo
			echo -e "'${script}'   [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

name_application="LeoCAD"
separator_title=" — "
title_main="New Model.ldr${separator_title}${name_application}"
title_colors="Colors${separator_title}${name_application}"
title_preview="Preview${separator_title}${name_application}"
title_properties="Properties${separator_title}${name_application}"
title_parts="Parts${separator_title}${name_application}"
title_timeline="Timeline${separator_title}${name_application}"
gravity_window="0"
separator_geometry=","
position_column_main="0000"
position_column_side="1660"
position_column_far="2110"
position_row_top="0000"
position_row_middle="0350"
position_row_low="0720"
width_main="1660"
height_main="1080"
width_side="0450"
width_parts="0900"
height_side_small="0350"
height_properties="0370"
height_parts="0360"
height_timeline="0720"

# defaults ─────────────────────────────────────────────────────────────────────

# functions ────────────────────────────────────────────────────────────────────

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(
	wmctrl
)

frobulator.require ${list[@]}

list=()

# configuration ────────────────────────────────────────────────────────────────

# set position

# main window

wmctrl -r "${title_main}" -e "${gravity_window}${separator_geometry}${position_column_main}${separator_geometry}${position_row_top}${separator_geometry}${width_main}${separator_geometry}${height_main}"

# color palette

wmctrl -r "${title_colors}" -e "${gravity_window}${separator_geometry}${position_column_side}${separator_geometry}${position_row_top}${separator_geometry}${width_side}${separator_geometry}${height_side_small}"

# preview widget

wmctrl -r "${title_preview}" -e "${gravity_window}${separator_geometry}${position_column_side}${separator_geometry}${position_row_top}${separator_geometry}${width_side}${separator_geometry}${height_side_small}"

# properties widget

wmctrl -r "${title_properties}" -e "${gravity_window}${separator_geometry}${position_column_side}${separator_geometry}${position_row_middle}${separator_geometry}${width_side}${separator_geometry}${height_properties}"

# parts widget

wmctrl -r "${title_parts}" -e "${gravity_window}${separator_geometry}${position_column_side}${separator_geometry}${position_row_low}${separator_geometry}${width_parts}${separator_geometry}${height_parts}"

# parts ordering / timeline widget

wmctrl -r "${title_timeline}" -e "${gravity_window}${separator_geometry}${position_column_far}${separator_geometry}${position_row_top}${separator_geometry}${width_side}${separator_geometry}${height_timeline}"

frobulator.scs "Done"
