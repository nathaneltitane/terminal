#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-d|--directory)
			directory_base="${2}"

			shift
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -d [Directory] | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-d, --directory    Specify base [d]irectory for the clone - 'edl' is appended."
			echo
			echo -e "                   [ \${HOME}/.local/share ] [ Default ]"
			echo
			echo -e "-h, --help         Show [h]elp and usage information."
			echo
			echo -e "'${script}'        [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -d [Directory] | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

process="edl"
service="ModemManager"

url_source="https://github.com/bkerler/edl.git"

directory_base="${directory_base:-${HOME}/.local/share}"
directory_edl="${directory_base}/${process}"

# requirements ─────────────────────────────────────────────────────────────────

list=(
	adb
	fastboot
	python3-dev
	python3-pip
	liblzma-dev
	git
)

frobulator.require ${list[@]}

frobulator.complete

list=()

# configuration ────────────────────────────────────────────────────────────────

# conflicting modem service

frobulator.inf "Removing conflicting service" "[ ${service} ]"

apt-get --assume-yes purge modemmanager > "${sink}" 2>&1

frobulator.complete

# 'systemctl' path - empty if not installed

command_systemctl="$(command -v systemctl)"

if [ -n "${command_systemctl}" ]
then
	frobulator.service stop "${service}"

	frobulator.complete

	frobulator.service disable "${service}"

	frobulator.complete
fi

# source

frobulator.silence "git clone ${url_source} ${directory_edl}" &

frobulator.progress "clone"

frobulator.complete

if [ -d "${directory_edl}" ]
then
	cd "${directory_edl}"

	frobulator.complete
else
	frobulator.err "Directory not found" "[ ${directory_edl} ]"

	exit 1
fi

# loaders submodule

frobulator.silence "git submodule update --init --recursive" &

frobulator.progress "submodules"

frobulator.complete

# usb drivers

chmod a+rx install-linux-edl-drivers.sh

frobulator.log "bash install-linux-edl-drivers.sh" &

frobulator.progress "drivers"

frobulator.complete halt "Unable to install drivers" "[ ${process} ]"

frobulator.complete

# python dependencies

frobulator.log "pip3 install -r requirements.txt --break-system-packages" &

frobulator.progress "dependencies"

frobulator.complete halt "Unable to install dependencies" "[ ${process} ]"

frobulator.complete

# python package

# CFLAGS avoids a build failure against gcc 14 and newer

export CFLAGS="-Wno-int-conversion"

frobulator.log "pip3 install -U . --break-system-packages" &

frobulator.progress "install"

status="${?}"

unset CFLAGS

if [ "${status}" -ne 0 ]
then
	frobulator.err "Unable to install" "[ ${process} ]"

	exit 1
fi

frobulator.complete

# initramfs

# safe to run directly - only the reboot itself is left to the user

frobulator.inf "Rebuilding initramfs"

update-initramfs -u > "${sink}" 2>&1

frobulator.complete

# verification

# ${process} command path - empty if not installed

command_path="$(command -v "${process}")"

if [ -n "${command_path}" ]
then
	frobulator.scs "Verification success" "[ ${process} ]"
else
	frobulator.err "Verification failed" "[ ${process} ]"

	exit 1
fi

frobulator.ntf inf "EDL" inf "Device needs a USB PID of 0x9008 to work.

Run 'edl -h' for the full command reference, or 'edl printgpt' to test."

frobulator.result "${script}"

frobulator.scs "Done"
