#!/bin/bash

# dependencies /////////////////////////////////////////////////////////////////

# script ///////////////////////////////////////////////////////////////////////

script="$(basename -- ${BASH_SOURCE[0]})"

# defaults /////////////////////////////////////////////////////////////////////

self="${BASH_SOURCE[0]}"

# usage ////////////////////////////////////////////////////////////////////////

if [[ "${self}" = "${0}" ]]
then
	# implement from local version

	if [ $# -eq 0 ]
	then
		source "${self}"

		return 0 2> "${sink}"

		if [ "${?}" -ne 0 ]
		then
			frobulator.scs "Implemented" "[ ${PWD}/${self} ]"
			echo
		fi
	fi

	file_source="${self}"

	file_install="${file_source}"

	directory_install="${HOME}"/.local/bin

	file_target="${directory_install}/${file_install}"

	while (($#))
	do
		case "${1}" in

			-i|--install)

				if [ ! -d "${directory_install}" ]
				then
					mkdir -p "${directory_install}"
				fi

				if [ "${file_source}" != "${file_target}" ]
				then
					cp "${file_source}" "${file_target}"

					chmod a+rx "${file_target}"

					source "${file_target}"

					frobulator.scs "Installed" "[ ${file_target} ]"

					echo
				fi
			;;

			-h|--help)

				echo
				echo -e "Usage: ./${script} | [OPTION]"
				echo
				echo "Options:"
				echo
				echo "	-i, --install    [I]nstall "${script}" to ${directory_install}"
				echo "	-h, --help       Show this [h]elp menu"
				echo

				exit
			;;

			*)

				echo
				echo "${script}: Unknown option '${1}'"
				echo "Type './${script} --help' for help and usage information."
				echo

				exit 1
			;;

		esac

		shift

	done
fi

# bash /////////////////////////////////////////////////////////////////////////

if [[ -f "${HOME}"/.bash_aliases ]]
then
	alias 'sa'='. "${HOME}"/.bash_aliases'
fi

if [[ -f "${HOME}"/.bash_funtions ]]
then
	alias 'sf'='. "${HOME}"/.bash_functions'
fi

if [[ -f "${HOME}"/.bashrc ]]
then
	alias 'sc'='. "${HOME}"/.bashrc'
fi

if [[ -f "${HOME}"/.bash_login ]]
then
	alias 'si'='. "${HOME}"/.bash_login'
fi

if [[ -f "${HOME}"/.bash_logout ]]
then
	alias 'so'='. "${HOME}"/.bash_logout'
fi

if [[ -f "${HOME}"/.bash_profile ]]
then
	alias 'sp'='. "${HOME}"/.bash_profile'
fi

# directories //////////////////////////////////////////////////////////////////

if [[ $(command -v cd) ]]
then
	alias '..'='cd ..'
fi

if [[ $(ls -d "${HOME}" 2> /dev/null) ]]
then
	alias 'hd'='cd "${HOME}"'
fi

if [[ $(ls -d /media 2> /dev/null) ]]
then
	alias 'md'='cd /media'
fi

if [[ $(ls -d /media/[eE]xternal 2> /dev/null) ]]
then
	alias 'ex'='cd /media/[eE]xternal'
fi

if [[ $(ls -d /media/[iI]nternal 2> /dev/null) ]]
then
	alias 'in'='cd /media/[iI]nternal'
fi

if [[ $(ls -d /media/[fF]iles 2> /dev/null) ]]
then
	alias 'fl'='cd /media/[fF]iles'
fi

# git  /////////////////////////////////////////////////////////////////////////

if [[ $(command -v git) ]]
then
	alias 'gc'="git clone --depth 1"
	alias 'gi'='git init'
	alias 'gp'='git pull'
	alias 'ga'='git add *'
	alias 'gm'="git commit -a -m ${1}"
	alias 'gs'='git push'
	alias 'gu'='ga && gm "Code & Features Update" && gs'
	alias 'gn'='git ls-files | xargs cat | wc -l'
fi

if [[ $(ls -d "${HOME}"/[gG]it 2> /dev/null) ]]
then
	alias 'gd'='cd "${HOME}"/[gG]it'

elif [[ $(ls -d "${PREFIX}"/media/[eE]xternal/[gG]it 2> /dev/null) ]]
then
	alias 'gd'='cd "${PREFIX}"/media/[eE]xternal/[gG]it'

elif [[ $(ls -d "${PREFIX}"/media/[iI]nternal/[gG]it 2> /dev/null) ]]
then
	alias 'gd'='cd "${PREFIX}"/media/[iI]nternal/[gG]it'
fi

# packages /////////////////////////////////////////////////////////////////////

if [[ $(command -v apt-get) ]]
then
	if [[ $(command -v sudo) ]]
	then
		apt_get_prefix="sudo "
	else
		apt_get_prefix=""
	fi

	alias 'autoclean'="${apt_get_prefix}apt-get autoclean"
	alias 'autoremove'="${apt_get_prefix}apt-get autoremove"
	alias 'check'="${apt_get_prefix}apt-get check"
	alias 'clean'="${apt_get_prefix}apt-get clean"
	alias 'distribution-upgrade'="${apt_get_prefix}apt-get dist-upgrade"
	alias 'download'="${apt_get_prefix}apt-get download"
	alias 'install'="${apt_get_prefix}apt-get install --no-install-recommends --no-upgrade"
	alias 'purge'="${apt_get_prefix}apt-get purge"
	alias 'reinstall'="${apt_get_prefix}apt-get reinstall"
	alias 'repair'="${apt_get_prefix}apt-get -f install"
	alias 'remove'="${apt_get_prefix}apt-get remove"
	alias 'source'="${apt_get_prefix}apt-get source"
	alias 'update'="${apt_get_prefix}apt-get update"
	alias 'upgrade'="${apt_get_prefix}apt-get dist-upgrade"
fi

if [[ $(command -v apt-cache) ]]
then
	if [[ $(command -v sudo) ]]
	then
		apt_cache_prefix="sudo "
	else
		apt_cache_prefix=""
	fi

	alias 'depend'="${apt_cache_prefix}apt-cache depends"
	alias 'reverse'="${apt_cache_prefix}apt-cache rdepends"
	alias 'search'="${apt_cache_prefix}apt-cache search"
	alias 'status'="${apt_cache_prefix}apt-cache stats"
fi

# system ///////////////////////////////////////////////////////////////////////

if [[ $(command -v sudo) && $(command -v systemctl) ]]
then
	alias 'start'='sudo systemctl start'
	alias 'stop'='sudo systemctl stop'
	alias 'enable'='sudo systemctl enable'
	alias 'disable'='sudo systemctl disable'
	alias 'status'='sudo systemctl status'
fi

# filters //////////////////////////////////////////////////////////////////////

if [[ $(command -v grep) ]]
then
	if [[ $(command -v env) ]]
	then
		alias 'efilter'='env | grep -i'
	fi

	if [[ $(command -v ls) ]]
	then
		alias 'ffilter'='ls -a | grep -i'
	fi

	if [[ $(command -v ps) ]]
	then
		alias 'pfilter'='ps -a -u -x | grep -i'
	fi
fi

# session //////////////////////////////////////////////////////////////////////

if [[ $(command -v exit) ]]
then
	alias 'exit'='exit > /dev/null 2>&1'
fi

if [[ $(command -v logout) ]]
then
	alias 'logout'='logout > /dev/null 2>&1'
fi

# commands /////////////////////////////////////////////////////////////////////

if [[ $(command -v chgrp) ]]
then
	alias 'chgrp'='chgrp --preserve-root'
fi

if [[ $(command -v chmod) ]]
then
	alias 'chmod'='chmod --preserve-root'
fi

if [[ $(command -v chown) ]]
then
	alias 'chown'='chown --preserve-root'
fi

if [[ $(command -v command) ]]
then
	alias 'which'='command -v'
fi

if [[ $(command -v curl) ]]
then
	alias 'header'='curl -I'
fi

if [[ $(command -v df) ]]
then
	alias 'df'='df -H'
fi

if [[ $(command -v du) ]]
then
	alias 'du'='du -a -c -h'
	alias 'usage'="du -a -d 1 -h -S --time 2> /dev/null | sed '/total/ [ Total ]/g"
fi

if [[ $(command -v htop) ]]
then
	alias 'top'='htop'
	alias 'process'='htop -s USER -t'
fi

if [[ $(command -v ls) ]]
then
	alias last='echo ; ls -a -h -l -t | head -11 ; echo'
	fi

if [[ $(command -v mount) && $(command -v column) ]]
then
	alias 'mounts'='mount | column -t'
fi

if [[ $(command -v nano) ]]
then
	alias 'edit'='nano -c -g -i -l -m -q -D -F -J 80 -T 4'
fi

if [[ $(command -v netstat) ]]
then
	alias 'ports'='netstat -t -u -l -a -n -p 2> /dev/null'
fi

if [[ $(command -v pgrep) ]]
then
	alias 'pgrep'='pgrep -f'
fi

if [[ $(command -v pstree) ]]
then
	alias 'ptree'='pstree -C age -p'
fi

if [[ $(command -v ping) ]]
then
	alias 'sonar'='ping -c 5'
fi

if [[ $(command -v ps) ]]
then
	alias 'what'='ps -e'
	alias 'how'='ps -u'
fi

if [[ $(command -v rm) ]]
then
	alias 'delete'='rm -r -f'
fi

if [[ $(command -v rsync) ]]
then
	alias 'archive'='rsync -a -r -q --progress -h'
fi
if [[ $(command -v cp) ]]
then
	alias 'copy'='cp -r -f'
fi

if [[ $(command -v shutdown) ]]
then
	alias 'shutdown'='shutdown -h now'
fi

if [[ $(command -v sudo) ]]
then
	alias 'sudo'='sudo -p "[ $(tput setaf 3)${USER}$(tput sgr 0) ] >_ ? "'
fi

if [[ $(command -v wget) ]]
then
	alias 'wget'='wget -c'
fi

if [[ $(command -v tree) ]]
then
	alias 'treed'='tree -a -d -p -L'
	alias 'treef'='tree -a -p -L'
fi

# ai ///////////////////////////////////////////////////////////////////////////

if [ "$(command -v ollama)" ]
then
	model_ollama=$(ollama list | tail -n 1 | cut -d ' ' -f 1)

	if [ -n "${model_ollama}" ]
	then
		alias 'ada'="ollama run ${model_ollama}"
	fi
fi

# dextop ///////////////////////////////////////////////////////////////////////

if [ -n "${TERMUX_VERSION}" ]
then
	if [ "$(command -v dextop)" ]
	then
		alias 'daa'='bash dextop -u additions all'

		alias 'dda'='bash dextop -u all'

		alias 'ddu'='curl -s -L run.dxtp.app > "${HOME}"/.local/bin/dextop'

		alias 'dfa'='curl -s -L run.dxtp.app > "${HOME}"/.local/bin/dextop && bash dextop -u all'

		alias 'dpa'='bash dextop -u preferences all'

		alias 'dsa'='bash dextop -u shell all'

		alias 'dta'='bash dextop -u termux all'

		alias 'dua'='bash dextop -u utility all'
	fi

	if [ "$(command -v am)" ]
	then
		alias {'dextop-mail','email','mail'}='am start --user 0 -a android.intent.action.VIEW -d mailto: > /dev/null 2>&1'

		alias {'dextop-browser','browser','link','web'}='am start --user 0 -a android.intent.action.VIEW -d https: > /dev/null 2>&1'

		alias {'dextop-message','message','text','sms'}='am start --user 0 -a android.intent.action.VIEW -d sms: > /dev/null 2>&1'

		alias {'dextop-files','file'}='am start --user 0 -a android.intent.action.VIEW -d file: > /dev/null 2>&1'
	fi
fi
