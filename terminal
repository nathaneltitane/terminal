#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-21"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-p|--python)
			option="python"
		;;

		-x|--pipx)
			option="pipx"
		;;

		-w|--storage)
			option="storage"

			option_storage="${2}"

			shift
		;;

		-f|--files)
			option="files"
		;;

		-o|--home)
			option="home"
		;;

		-g|--git)
			option="git"
		;;

		-s|--shell)
			option="shell"
		;;

		-u|--superuser)
			option="superuser"
		;;

		-t|--themes)
			option="themes"
		;;

		-l|--applications)
			option="applications"
		;;

		-k|--kde-runner)
			option="kde-runner"
		;;

		-e|--efi)
			option="efi"
		;;

		-a|--all)
			option="all"
		;;

		-n|--uninstall)
			option="uninstall"
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -p | -x | -w [Type] | -f | -o | -g | -s | -u | -t | -l | -k | -e | -a | -n | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-p, --python          Set up [p]ython."
			echo
			echo -e "-x, --pipx            Set up pi[x] packages."
			echo
			echo -e "-w, --storage         Set up [w]indows subsystem for linux, chromeos, chromeos android, or removable storage."
			echo
			echo -e "                      [ wsl ]"
			echo -e "                      [ chromeos ]"
			echo -e "                      [ android ]"
			echo -e "                      [ removable ]"
			echo
			echo -e "-f, --files           Link known [f]iles from storage."
			echo
			echo -e "-o, --home            Set up h[o]me directory structure."
			echo
			echo -e "-g, --git             Set up [g]it configuration and credentials."
			echo
			echo -e "-s, --shell           Set up [s]hell dotfiles."
			echo
			echo -e "-u, --superuser       Set up passwordless s[u]do."
			echo
			echo -e "-t, --themes          Set up [t]hemes."
			echo
			echo -e "-l, --applications    Set up app[l]ications."
			echo
			echo -e "-k, --kde             Set up [k]de runner shortcut."
			echo
			echo -e "-e, --efi             Set up r[e]find and efi boot theme."
			echo
			echo -e "-a, --all             Run [a]ll modules explicitly."
			echo
			echo -e "-n, --uninstall       Run u[n]installation of the ${script} setup - shell files, links and passwordless sudo."
			echo
			echo -e "-h, --help            Show [h]elp and usage information."
			echo
			echo -e "'${script}'           [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -p | -x | -w [Type] | -f | -o | -g | -s | -u | -t | -l | -k | -e | -a | -n | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

architecture="$(dpkg --print-architecture)"

codename="$(lsb_release -c -s)"

# defaults ─────────────────────────────────────────────────────────────────────

if [ -z "${option}" ]
then
	option="all"
fi

if [ "${option}" = "storage" ]
then
	if	[ "${option_storage}" != "wsl"       ] &&
		[ "${option_storage}" != "chromeos"  ] &&
		[ "${option_storage}" != "android"   ] &&
		[ "${option_storage}" != "removable" ]
	then
		frobulator.err "Unrecognized storage type" "[ ${option_storage} ]"

		exit 1
	fi
fi

name_environment="${XDG_CURRENT_DESKTOP}"

# uninstall ────────────────────────────────────────────────────────────────────

# files and links the setup created removed - home directories, themes, boot theme and packages kept

if [ "${option}" = "uninstall" ]
then
	frobulator.qst "Remove the ${script} setup - shell files, links and passwordless sudo? [ y / N ]"

	frobulator.read reply

	if [[ ! "${reply}" =~ ^[yY] ]]
	then
		frobulator.inf "Aborting" "[ ${option} ]"

		exit 1
	fi

	# homes linked by the shell setup - user and superuser

	directory_home_root="$(getent passwd root | cut -d ':' -f 6)"

	list_homes=("${HOME}")

	if [ -n "${directory_home_root}" ] && [ "${directory_home_root}" != "${HOME}" ]
	then
		list_homes+=("${directory_home_root}")
	fi

	# links only - shell dotfiles - git configuration - known files from storage

	list_links=(
		.bash_aliases
		.bashrc
		.bash_configuration
		.bash_functions
		.bash_login
		.bash_logout
		.bash_profile
		.gitconfig
		.git-credentials
		.dns
		.dns-dynamic
		.modem
		.router
		.wifi
	)

	for directory_home in "${list_homes[@]}"
	do
		state_link_shell="false"

		if [ -L "${directory_home}/.bashrc" ]
		then
			state_link_shell="true"
		fi

		for name_link in "${list_links[@]}"
		do
			if [ -L "${directory_home}/${name_link}" ]
			then
				frobulator.delete "${directory_home}" "${name_link}"
			fi
		done

		# default shell configuration in place of the removed link only

		if [ "${state_link_shell}" = "true" ] && [ -f /etc/skel/.bashrc ]
		then
			cp /etc/skel/.bashrc "${directory_home}/.bashrc"

			chown --reference="${directory_home}" "${directory_home}/.bashrc"

			frobulator.inf "Default shell configuration restored" "[ ${directory_home}/.bashrc ]"
		fi
	done

	# shell files in the user's local bin - functions included

	list_files_shell=(
		bash-aliases
		bash-configuration
		bash-functions
		bash-login
		bash-logout
		bash-profile
	)

	for path_function in "${HOME}"/.local/bin/bash-function-*
	do
		if [ -e "${path_function}" ]
		then
			list_files_shell+=("${path_function##*/}")
		fi
	done

	for name_file in "${list_files_shell[@]}"
	do
		if [ -e "${HOME}/.local/bin/${name_file}" ]
		then
			frobulator.delete "${HOME}/.local/bin" "${name_file}"
		fi
	done

	# login notice file - only while still empty as the setup left it

	if [ -f "${HOME}/.hushlogin" ] && [ ! -s "${HOME}/.hushlogin" ]
	then
		frobulator.delete "${HOME}" .hushlogin
	fi

	# storage links - links to mounted storage only - the storage itself untouched

	for path_link in /media/* "${HOME}/Downloads"
	do
		if [ ! -L "${path_link}" ]
		then
			continue
		fi

		target_link="$(readlink "${path_link}")"

		case "${target_link}"
		in
			/mnt/*|/opt/google/*|/media/"${SUDO_USER:-${USER}}"/*)
				frobulator.delete "${path_link%/*}" "${path_link##*/}"
			;;
		esac
	done

	# passwordless sudo line - replaced only when the result passes the sudoers check

	if [ -n "${SUDO_USER}" ]
	then
		line_sudoers="${SUDO_USER} ALL=(ALL) NOPASSWD: ALL"

		count_line="$(grep -c -x -F "${line_sudoers}" /etc/sudoers)"

		if [ "${count_line}" -gt 0 ]
		then
			file_sudoers_temporary="$(mktemp)"

			grep -v -x -F "${line_sudoers}" /etc/sudoers > "${file_sudoers_temporary}"

			visudo -c -q -f "${file_sudoers_temporary}"

			status_sudoers="${?}"

			if [ "${status_sudoers}" -eq 0 ]
			then
				cat "${file_sudoers_temporary}" > /etc/sudoers

				frobulator.scs "Passwordless sudo removed" "[ ${SUDO_USER} ]"
			else
				frobulator.err "Sudoers check failed - left unchanged" "[ /etc/sudoers ]"
			fi

			rm -f "${file_sudoers_temporary}"
		fi
	fi

	frobulator.scs "Uninstalled" "[ ${script} ]"

	frobulator.inf "Kept" "[ home directories // themes // boot theme // packages ]"

	exit
fi

# functions ────────────────────────────────────────────────────────────────────

# update ───────────────────────────────────────────────────────────────────────

frobulator.update

frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(
	docker.io
	git
	htop
	hub
	nano
	openssh*
	pipx
	ssh*
	shellcheck
	tree
)

list_display=(
	cura
	mesa-utils
	puddletag
	vulkan-tools
	wayland-utils
)

list_kde=(
	ark
	breeze
	breeze-cursor-theme
	breeze-gtk-theme
	breeze-icon-theme
	calligra
	cantata
	dolphin
	flatpak
	gwenview
	karbon
	kate
	kcalc
	kcharselect
	kcolorchooser
	kde-config-cron
	kde-config-flatpak
	kde-spectacle
	kdenlive
	kdenetwork-filesharing
	kio-gdrive
	konsole
	kontrast
	krename
	krita
	kup-backup
	mpd
	plasma-discover
	plasma-discover-backend-flatpak
	plasma-discover-backend-fwupd
	samba
	solaar
	sweeper
)

if [ "${name_environment}" = [kK][dD][eE] ]
then
	list+=(
		${list_kde[@]}
	)
fi

if [ ! -z "${DISPLAY}" ]
then
	list+=(
		${list_display[@]}
	)
fi

frobulator.assess ${list[@]}

list=()

# remove

list=(
	htop.desktop
)

frobulator.delete /usr/share/applications ${list[@]}

list=()

# configuration ────────────────────────────────────────────────────────────────

# python

if [ "${option}" = "python" ] || [ "${option}" = "all" ]
then
	if [[ "${HOSTNAME}" = [pP][eE][nN][gG][uU][iI][nN] ]]
	then
		frobulator.inf "Setting up" "[ python ]"

		directory_python="/usr/lib/python3.11"

		rm					\
			--recursive		\
			--force			\
							"${directory_python}"/EXTERNALLY-MANAGED
	fi
fi

# pipx

if [ "${option}" = "pipx" ] || [ "${option}" = "all" ]
then
	list_install_pip=(
		deno
		trimesh
		yt-dlp
		yt-dlp-ejs
	)

	for item in "${list_install_pip[@]}"
	do
		pipx install --global "${item}"
	done

	list_install_pip=()
fi

# storage - windows subsystem for linux

if [ "${option}" = "storage" ] && [ "${option_storage}" = "wsl" ] || [ "${option}" = "all" ]
then
	if [ -n "${WSL_DISTRO_NAME}" ]
	then
		frobulator.link /mnt /media y internal
		frobulator.link /mnt /media z external
	fi
fi

# storage - linux subsystem for chromeos

if [ "${option}" = "storage" ] && [ "${option_storage}" = "chromeos" ] || [ "${option}" = "all" ]
then
	if [ -d /mnt/chromeos ]
	then
		if [ -d /mnt/chromeos/GoogleDrive ]
		then
			frobulator.link /mnt/chromeos /media GoogleDrive Drive
		fi

		if [ -d /mnt/chromeos/MyFiles ]
		then
			frobulator.link /mnt/chromeos/MyFiles "${HOME}" Downloads Downloads
		fi

		if [ -d /mnt/chromeos/removable ]
		then
			frobulator.link /mnt/chromeos/removable /media Internal Internal
			frobulator.link /mnt/chromeos/removable /media External External
		fi

	fi
fi

# storage - android subsystem for chrome os

if [ "${option}" = "storage" ] && [ "${option_storage}" = "android" ] || [ "${option}" = "all" ]
then
	if [ -d /opt/google/containers/android ]
	then
		if [ -d /opt/google/containers/android/rootfs/android-data/data/media ]
		then
			frobulator.link /opt/google/containers/android/rootfs/android-data/data/media /media 0 Android
		fi

	fi
fi

# storage - removable

if [ "${option}" = "storage" ] && [ "${option_storage}" = "removable" ] || [ "${option}" = "all" ]
then
	if [ -d /media/"${USER}"/* ]
	then
		for directory in /media/"${USER}"/*
		do
			frobulator.inf "Removable storage found" "[ ${directory}]"

			list+=(
				"${directory}"
			)
		done

		unset directory

		for item in ${list[@]}
		do
			directory=${item##*/}

			if [ -d /opt/google/containers/android/rootfs/android-data/data/media ]
			then
				frobulator.link /media/"${USER}" /media "${directory}"
			fi
		done
	fi

	list=()
fi

# files

if [ "${option}" = "files" ] || [ "${option}" = "all" ]
then
	list=(
		.dns
		.dns-dynamic
		.modem
		.router
		.wifi
	)

	list_storage=(
		/media/[iI]nternal
	)

	for storage in ${list_storage[@]}
	do
		if [ -d "${storage}" ]
		then
			for item in ${list[@]}
			do
				if [ -e "${storage}"/"${item}" ]
				then
					frobulator.link "${storage}" "${HOME}" "${item}"
				fi
			done
		fi
	done

	list_storage=()

	list=()
fi

# home

if [ "${option}" = "home" ] || [ "${option}" = "all" ]
then
	frobulator.file "${HOME}" .hushlogin

	if [[ "${HOSTNAME}" = [pP][eE][nN][gG][uU][iI][nN] ]]
	then
		# generate home directory structure

		list_directories+=(
			Desktop
			Documents
			Downloads
			Music
			Pictures
			Public
			Templates
			Videos
		)

		frobulator.directory "${HOME}" ${list_directories[@]}

		list_directories=()

	fi
fi

# git

if [ "${option}" = "git" ] || [ "${option}" = "all" ]
then
	frobulator.inf "Setting up" "[ git ]"

	list_storage=(
		/media/[aA]ndroid
		/media/[iI]nternal
	)

	for storage in ${list_storage[@]}
	do
		if [ -d "${storage}" ]
		then
			frobulator.link "${storage}"/Git "${HOME}" git-configuration .gitconfig

			chown "${USER}":"${USER}" "${storage}"/Git/git-configuration

			frobulator.link "${storage}"/Git "${HOME}" git-credentials   .git-credentials

			chown "${USER}":"${USER}" "${storage}"/Git/git-credentials
		fi
	done
fi

# shell

if [ "${option}" = "shell" ] || [ "${option}" = "all" ]
then
	frobulator.inf "Setting up" "[ shell ]"

	frobulator.directory "${HOME}" .local/bin

	list+=(
		bash-aliases
		bash-configuration
		bash-functions
		bash-login
		bash-logout
		bash-profile
	)

	# one file per function - loaded by bash-functions: names listed from the repository

	frobulator.repository "nathaneltitane/terminal" "bash-function-"

	list+=("${frobulator_return[@]}")

	frobulator.download get.trmnl.me "${HOME}"/.local/bin ${list[@]}

	frobulator.link "${HOME}"/.local/bin "${HOME}"                bash-aliases       .bash_aliases
	frobulator.link "${HOME}"/.local/bin "${HOME}"                bash-configuration .bashrc
	frobulator.link "${HOME}"/.local/bin "${HOME}"                bash-configuration .bash_configuration
	frobulator.link "${HOME}"/.local/bin "${HOME}"                bash-functions     .bash_functions
	frobulator.link "${HOME}"/.local/bin "${HOME}"                bash-login         .bash_login
	frobulator.link "${HOME}"/.local/bin "${HOME}"                bash-logout        .bash_logout
	frobulator.link "${HOME}"/.local/bin "${HOME}"                bash-profile       .bash_profile

	# superuser home - root shells load the same files through these links

	directory_home_root="$(getent passwd root | cut -d ':' -f 6)"

	frobulator.link "${HOME}"/.local/bin "${directory_home_root}" bash-aliases       .bash_aliases
	frobulator.link "${HOME}"/.local/bin "${directory_home_root}" bash-configuration .bashrc
	frobulator.link "${HOME}"/.local/bin "${directory_home_root}" bash-configuration .bash_configuration
	frobulator.link "${HOME}"/.local/bin "${directory_home_root}" bash-functions     .bash_functions
	frobulator.link "${HOME}"/.local/bin "${directory_home_root}" bash-login         .bash_login
	frobulator.link "${HOME}"/.local/bin "${directory_home_root}" bash-logout        .bash_logout
	frobulator.link "${HOME}"/.local/bin "${directory_home_root}" bash-profile       .bash_profile

	# user running the script

	name_user="$(id -u -n)"

	if [ "${name_user}" = "root" ]
	then
		for item in ${list[@]}
		do
			chown "${SUDO_USER}":"${SUDO_USER}" "${HOME}"/.local/bin/"${item}"

			chmod 777 "${HOME}"/.local/bin/"${item}"
		done
	fi

	list=()
fi

# superuser

if [ "${option}" = "superuser" ] || [ "${option}" = "all" ]
then
	frobulator.write append "${SUDO_USER} ALL=(ALL) NOPASSWD: ALL" /etc sudoers
fi

# themes

if [ "${option}" = "themes" ] || [ "${option}" = "all" ]
then
	if [[ "${HOSTNAME}" = [pP][eE][nN][gG][uU][iI][nN] ]]
	then
		frobulator.inf "Setting up" "[ themes ]"

		content_gtkrc=$(cat <<- 'FILE'
		gtk-icon-theme-name = "Breeze"
		gtk-theme-name = "Breeze"
		gtk-font-name = "Noto Mono 10"
		FILE
		)

		frobulator.write write "${content_gtkrc}" /etc/gtk-2.0 gtkrc

		content_settings=$(cat <<- 'FILE'
		[Settings]
		gtk-cursor-theme-name = Breeze
		gtk-icon-theme-name = Breeze
		gtk-theme-name = Breeze
		gtk-font-name = Noto Mono 10
		FILE
		)

		frobulator.write write "${content_settings}" /etc/gtk-3.0 settings.ini

		content_trolltech=$(cat <<- 'FILE'
		[Qt]
		style=Breeze
		FILE
		)

		frobulator.write write "${content_trolltech}" /etc/xdg Trolltech.conf

		frobulator.scs 'Done'
	fi
fi

# applications

if [ "${option}" = "applications" ] || [ "${option}" = "all" ]
then
	if [[ "${HOSTNAME}" = [pP][eE][nN][gG][uU][iI][nN] ]]
	then
		frobulator.inf "Setting up" "[ applications ]"

		# install

		list+=(
			${list_kde[@]}
		)

		frobulator.assess ${list[@]}

		list=()

		# remove

		list=(
			org.kde.dolphin.desktop
			org.kde.konsole.desktop
		)

		frobulator.delete /usr/share/applications ${list[@]}

		list=()

		# uninstall

		list=(
			uxterm
			vim
			xterm
		)

		frobulator.purge ${list[@]}

		list=()
	fi
fi

# kde - runner

if [ "${option}" = "kde-runner" ] || [ "${option}" = "all" ]
then
	if [ "${XDG_CURRENT_DESKTOP}" = [kK][dD][eE] ]
	then
		kwriteconfig5						\
			--file	kwinrc					\
			--group	ModifierOnlyShortcuts	\
			--key	Meta					\
											"org.kde.krunner,/App,,toggleDisplay"

		qdbus org.kde.KWin /KWin reconfigure
	fi
fi

# efi

if [ "${option}" = "efi" ] || [ "${option}" = "all" ]
then
	if [ -e /sys/firmware/efi ]
	then

		# install

		list=(
			refind
		)

		frobulator.install ${list[@]}

		list=()

		refind-install --yes > "${sink}" 2>&1

		# purge

		apt purge grub* > "${sink}" 2>&1

		list=(
			grub
		)

		frobulator.delete /boot ${list[@]}

		list=()

		# remove

		list=(
			refind.conf
		)

		frobulator.delete /boot/efi/EFI/refind ${list[@]}

		frobulator.download get.trmnl.me refind-configuration /boot/efi/EFI/refind refind.conf

		frobulator.download get.trmnl.me /boot/efi/EFI/refind/themes archive-refind-theme.tar.gz

		frobulator.extract /boot/efi/EFI/refind/themes/archive-refind-theme.tar.gz /boot/efi/EFI/refind/themes

		list=()

		rm					\
			--recursive		\
			--force			\
							/boot/efi/EFI/refind/themes/archive-refind-theme.tar.gz
	fi
fi

frobulator.scs 'Done'
