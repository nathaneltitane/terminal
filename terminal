	krename
	krita
	kup-backup
	mpd
	plasma-discover
	plasma-discover-backend-flatpak
	plasma-discover-backend-fwupd
	samba
	solaar
	sweeper
)

list_media=(
	gstreamer1.0*
)

if [ "${name_environment}" = ${pattern_desktop_kde} ]
then
	list+=(
		${list_kde[@]}
	)
fi

if [ -n "${DISPLAY}" ]
then
	list+=(
		${list_display[@]}
	)
fi

frobulator.assess ${list[@]}

list=()

# remove

list=(
	htop.desktop
)

frobulator.delete "${directory_applications}" ${list[@]}

list=()

# configuration ────────────────────────────────────────────────────────────────

# python

if [ "${option}" = "${mode_python}" ] ||
   [ "${option}" = "${mode_all}" ]
then
	if [[ "${HOSTNAME}" = ${pattern_hostname} ]]
	then
		frobulator.inf "${label_setting_up}" "[ ${mode_python} ]"

		rm					\
			--recursive		\
			--force			\
							"${directory_python}/${file_externally_managed}"
	fi
fi

# pipx

if [ "${option}" = "${mode_pipx}" ] ||
   [ "${option}" = "${mode_all}" ]
then
	list_install_pip=(
		deno
		trimesh
		yt-dlp
	)

	# libraries added to an app

	list_inject_pip=(
		yt-dlp:yt-dlp-ejs
	)

	# global locations for any pipx version

	list_pipx=(
		env
		"PIPX_HOME=${directory_pipx_home}"
		"PIPX_BIN_DIR=${directory_pipx_bin}"
		"PIPX_MAN_DIR=${directory_pipx_man}"
		pipx
	)

	for item in "${list_install_pip[@]}"
	do
		"${list_pipx[@]}" install "${item}"
	done

	for item in "${list_inject_pip[@]}"
	do
		"${list_pipx[@]}" inject "${item%%"${separator_inject}"*}" "${item#*"${separator_inject}"}"
	done

	list_install_pip=()
	list_inject_pip=()
	list_pipx=()
fi

# storage - windows subsystem for linux

if [ "${option}" = "${mode_storage}" ] &&
   [ "${option_storage}" = "${storage_wsl}" ] ||
   [ "${option}" = "${mode_all}" ]
then
	if [ -n "${WSL_DISTRO_NAME}" ]
	then
		frobulator.link "${directory_mnt}" "${directory_media}" y internal
		frobulator.link "${directory_mnt}" "${directory_media}" z external
	fi
fi

# storage - linux subsystem for chromeos

if [ "${option}" = "${mode_storage}" ] &&
   [ "${option_storage}" = "${storage_chromeos}" ] ||
   [ "${option}" = "${mode_all}" ]
then
	if [ -d "${directory_chromeos}" ]
	then
		if [ -d "${directory_chromeos}/GoogleDrive" ]
		then
			frobulator.link "${directory_chromeos}" "${directory_media}" GoogleDrive Drive
		fi

		if [ -d "${directory_chromeos}/MyFiles" ]
		then
			frobulator.link "${directory_chromeos}/MyFiles" "${HOME}" Downloads Downloads
		fi

		if [ -d "${directory_chromeos}/${storage_removable}" ]
		then
			frobulator.link "${directory_chromeos}/${storage_removable}" "${directory_media}" Internal Internal
			frobulator.link "${directory_chromeos}/${storage_removable}" "${directory_media}" External External
		fi

	fi
fi

# storage - android subsystem for chrome os

if [ "${option}" = "${mode_storage}" ] &&
   [ "${option_storage}" = "${storage_android}" ] ||
   [ "${option}" = "${mode_all}" ]
then
	if [ -d "${directory_android_container}" ]
	then
		if [ -d "${directory_android_media}" ]
		then
			frobulator.link "${directory_android_media}" "${directory_media}" 0 Android
		fi

	fi
fi

# storage - removable

if [ "${option}" = "${mode_storage}" ] &&
   [ "${option_storage}" = "${storage_removable}" ] ||
   [ "${option}" = "${mode_all}" ]
then
	if [ -d "${directory_media}/${USER}"/* ]
	then
		for directory in "${directory_media}/${USER}"/*
		do
			frobulator.inf "Removable storage found" "[ ${directory}]"

			list+=(
				"${directory}"
			)
		done

		unset directory

		for item in ${list[@]}
		do
			directory=${item##*/}

			if [ -d "${directory_android_media}" ]
			then
				frobulator.link "${directory_media}/${USER}" "${directory_media}" "${directory}"
			fi
		done
	fi

	list=()
fi

# mounts

if [ "${option}" = "${mode_mounts}" ] ||
   [ "${option}" = "${mode_all}" ]
then
	if [ -f "${path_fstab}" ] &&
	   [ -d "${directory_udev}" ]
	then
		list_mounts=(
			internal
			/media/internal
			external
			/media/external
		)

		# mount points first for fstab check

		for (( index_mount = 0 ; index_mount < ${#list_mounts[@]} ; index_mount += 2 ))
		do
			directory_mount="${list_mounts[$(( index_mount + 1 ))]}"

			if [ -e "${directory_label}/${list_mounts[${index_mount}]}" ] &&
			   [ ! -d "${directory_mount}" ]
			then
				frobulator.directory "${directory_mount%/*}" "${directory_mount##*/}"
			fi
		done

		for (( index_mount = 0 ; index_mount < ${#list_mounts[@]} ; index_mount += 2 ))
		do
			intent_fstab_entry "${list_mounts[${index_mount}]}" "${list_mounts[$(( index_mount + 1 ))]}"
		done

		# systemctl command path - empty if not installed

		path_systemctl="$(command -v systemctl)"

		if [ -n "${path_systemctl}" ]
		then
			systemctl daemon-reload
		fi

		# mount now if missing

		for (( index_mount = 1 ; index_mount < ${#list_mounts[@]} ; index_mount += 2 ))
		do
			directory_mount="${list_mounts[${index_mount}]}"

			content_mounts="$(< "${path_mounts}")"

			if [[ "${content_mounts}" != *" ${directory_mount} "* ]] &&
			   [ -d "${directory_mount}" ]
			then
				mount "${directory_mount}" > "${sink}" 2>&1
			fi
		done

		unset directory_mount index_mount list_mounts path_systemctl content_mounts
	fi
fi

# files

if [ "${option}" = "${mode_files}" ] ||
   [ "${option}" = "${mode_all}" ]
then
	list=(
		.dns
		.dns-dynamic
		.modem
		.router
		.wifi
	)

	list_storage=(
		/media/[iI]nternal
	)

	for storage in ${list_storage[@]}
	do
		if [ -d "${storage}" ]
		then
			for item in ${list[@]}
			do
				if [ -e "${storage}"/"${item}" ]
				then
					frobulator.link "${storage}" "${HOME}" "${item}"
				fi
			done

			# kde backup plans

			frobulator.link "${storage}/${directory_git}/terminal" "${HOME}/.config" kde-backup-configuration kuprc
		fi
	done

	list_storage=()

	list=()
fi

# home

if [ "${option}" = "${mode_home}" ] ||
   [ "${option}" = "${mode_all}" ]
then
	frobulator.file "${HOME}" .hushlogin

	if [[ "${HOSTNAME}" = ${pattern_hostname} ]]
	then
		# generate home directory structure

		list_directories+=(
			Desktop
			Documents
			Downloads
			Music
			Pictures
			Public
			Templates
			Videos
		)

		frobulator.directory "${HOME}" ${list_directories[@]}

		list_directories=()

	fi
fi

# git

if [ "${option}" = "${mode_git}" ] ||
   [ "${option}" = "${mode_all}" ]
then
	frobulator.inf "${label_setting_up}" "[ ${mode_git} ]"

	list_storage=(
		/media/[aA]ndroid
		/media/[iI]nternal
	)

	for storage in ${list_storage[@]}
	do
		if [ -d "${storage}" ]
		then
			frobulator.link "${storage}/${directory_git}" "${HOME}" git-configuration .gitconfig

			chown "${USER}":"${USER}" "${storage}/${directory_git}/git-configuration"

			frobulator.link "${storage}/${directory_git}" "${HOME}" git-credentials   .git-credentials

			chown "${USER}":"${USER}" "${storage}/${directory_git}/git-credentials"
		fi
	done
fi

# shell

if [ "${option}" = "${mode_shell}" ] ||
   [ "${option}" = "${mode_all}" ]
then
	frobulator.inf "${label_setting_up}" "[ ${mode_shell} ]"

	frobulator.directory "${HOME}" "${name_bin_relative}"

	list+=(
		bash-aliases
		bash-configuration
		bash-functions
		bash-login
		bash-logout
		bash-profile
		utility-command-run
	)

	# one file per function - loaded by bash-functions: names listed from the repository

	frobulator.repository "${repository_terminal}" "${prefix_function_file}"

	list+=("${frobulator_return[@]}")

	# own copy for ownership fix

	list_files_shell=("${list[@]}")

	frobulator.download "${url_terminal}" "${directory_bin}" ${list[@]}

	# run command name

	frobulator.link "${directory_bin}" "${directory_bin}" utility-command-run "${name_run}"

	frobulator.link "${directory_bin}"   "${HOME}"                bash-aliases       .bash_aliases
	frobulator.link "${directory_bin}"   "${HOME}"                bash-configuration .bashrc
	frobulator.link "${directory_bin}"   "${HOME}"                bash-configuration .bash_configuration
	frobulator.link "${directory_bin}"   "${HOME}"                bash-functions     .bash_functions
	frobulator.link "${directory_bin}"   "${HOME}"                bash-login         .bash_login
	frobulator.link "${directory_bin}"   "${HOME}"                bash-logout        .bash_logout
	frobulator.link "${directory_bin}"   "${HOME}"                bash-profile       .bash_profile

	# superuser home

	directory_home_root="$(getent passwd "${name_root}" | cut --delimiter="${delimiter_passwd}" --fields="${field_passwd_home}")"

	frobulator.link "${directory_bin}"   "${directory_home_root}" bash-aliases       .bash_aliases
	frobulator.link "${directory_bin}"   "${directory_home_root}" bash-configuration .bashrc
	frobulator.link "${directory_bin}"   "${directory_home_root}" bash-configuration .bash_configuration
	frobulator.link "${directory_bin}"   "${directory_home_root}" bash-functions     .bash_functions
	frobulator.link "${directory_bin}"   "${directory_home_root}" bash-login         .bash_login
	frobulator.link "${directory_bin}"   "${directory_home_root}" bash-logout        .bash_logout
	frobulator.link "${directory_bin}"   "${directory_home_root}" bash-profile       .bash_profile

	# files back to user

	if [ "${EUID}" -eq 0 ] &&
	   [ -n "${SUDO_USER}" ]
	then
		for item in "${list_files_shell[@]}"
		do
			chown "${SUDO_USER}":"${SUDO_USER}" "${directory_bin}/${item}"

			chmod "${mode_shell_files}" "${directory_bin}/${item}"
		done
	fi

	# function names as links to run

	list_functions_shell=(
		command-correct
	)

	for item in "${list_files_shell[@]}"
	do
		if [[ "${item}" != "${prefix_function_file}"* ]]
		then
			continue
		fi

		name_link="${item#"${prefix_function_file}"}"

		# shell only functions get no link

		if [[ " ${list_functions_shell[*]} " == *" ${name_link} "* ]]
		then
			continue
		fi

		path_command="$(type -P "${name_link}")"

		# real commands keep their name

		if [ -n "${path_command}" ] &&
		   [ "${path_command}" != "${directory_bin}/${name_link}" ]
		then
			continue
		fi

		ln -sfn "${name_run}" "${directory_bin}/${name_link}"

		if [ "${EUID}" -eq 0 ] &&
		   [ -n "${SUDO_USER}" ]
		then
			chown -h "${SUDO_USER}":"${SUDO_USER}" "${directory_bin}/${name_link}"
		fi
	done

	unset name_link path_command list_functions_shell

	list_files_shell=()

	list=()
fi

# superuser

if [ "${option}" = "${mode_superuser}" ] ||
   [ "${option}" = "${mode_all}" ]
then
	if [ -n "${SUDO_USER}" ]
	then
		# passwordless sudo file

		file_sudoers_temporary="$(mktemp)"

		echo "${text_sudoers_rule}" > "${file_sudoers_temporary}"

		visudo -c -q -f "${file_sudoers_temporary}"

		status_sudoers="${?}"

		if [ "${status_sudoers}" -eq 0 ]
		then
			cp "${file_sudoers_temporary}" "${directory_sudoers}/${SUDO_USER}"

			chmod "${mode_sudoers_file}" "${directory_sudoers}/${SUDO_USER}"

			frobulator.scs "Passwordless sudo" "[ ${directory_sudoers}/${SUDO_USER} ]"

			# remove legacy sudoers lines

			intent_sudoers_clean
		else
			frobulator.err "Sudoers check failed - left unchanged" "[ ${directory_sudoers}/${SUDO_USER} ]"
		fi

		rm -f "${file_sudoers_temporary}"
	fi
fi

# themes

if [ "${option}" = "${mode_themes}" ] ||
   [ "${option}" = "${mode_all}" ]
then
	if [[ "${HOSTNAME}" = ${pattern_hostname} ]]
	then
		frobulator.inf "${label_setting_up}" "[ ${mode_themes} ]"

		content_gtkrc=$(cat <<- 'FILE'
		gtk-icon-theme-name = "Breeze"
		gtk-theme-name = "Breeze"
		gtk-font-name = "Noto Mono 10"
		FILE
		)

		frobulator.write write "${content_gtkrc}" "${directory_gtk2}" "${file_gtk2_settings}"

		content_settings=$(cat <<- 'FILE'
		[Settings]
		gtk-cursor-theme-name = Breeze
		gtk-icon-theme-name = Breeze
		gtk-theme-name = Breeze
		gtk-font-name = Noto Mono 10
		FILE
		)

		frobulator.write write "${content_settings}" "${directory_gtk3}" "${file_gtk3_settings}"

		content_trolltech=$(cat <<- 'FILE'
		[Qt]
		style=Breeze
		FILE
		)

		frobulator.write write "${content_trolltech}" "${directory_xdg}" "${file_qt_settings}"

		frobulator.scs 'Done'
	fi
fi

# applications

if [ "${option}" = "${mode_applications}" ] ||
   [ "${option}" = "${mode_all}" ]
then
	if [[ "${HOSTNAME}" = ${pattern_hostname} ]]
	then
		frobulator.inf "${label_setting_up}" "[ ${mode_applications} ]"

		# install

		list+=(
			${list_kde[@]}
		)

		frobulator.assess ${list[@]}

		list=()

		# remove

		list=(
			org.kde.dolphin.desktop
			org.kde.konsole.desktop
		)

		frobulator.delete "${directory_applications}" ${list[@]}

		list=()

		# uninstall

		list=(
			uxterm
			vim
			xterm
		)

		frobulator.purge ${list[@]}

		list=()
	fi
fi

# media

if [ "${option}" = "${mode_media}" ] ||
   [ "${option}" = "${mode_all}" ]
then
	frobulator.inf "${label_setting_up}" "[ ${mode_media} ]"

	list+=(
		${list_media[@]}
	)

	frobulator.assess ${list[@]}

	list=()
fi

# kde - runner

if [ "${option}" = "${mode_kde_runner}" ] ||
   [ "${option}" = "${mode_all}" ]
then
	if [ "${XDG_CURRENT_DESKTOP}" = ${pattern_desktop_kde} ]
	then
		kwriteconfig5						\
			--file	"${file_kwin_configuration}"	\
			--group	"${group_kwin_shortcuts}"		\
			--key	"${key_kwin_meta}"				\
													"${value_kwin_runner}"

		qdbus org.kde.KWin /KWin reconfigure
	fi
fi

# efi

if [ "${option}" = "${mode_efi}" ] ||
   [ "${option}" = "${mode_all}" ]
then
	if [ -e "${path_efi_firmware}" ]
	then

		# install

		list=(
			refind
		)

		frobulator.install ${list[@]}

		list=()

		refind-install --yes > "${sink}" 2>&1

		# purge

		apt purge --yes "${pattern_package_grub}" > "${sink}" 2>&1

		list=(
			grub
		)

		frobulator.delete "${directory_boot}" ${list[@]}

		list=()

		# remove

		list=(
			refind.conf
		)

		frobulator.delete "${directory_refind}" ${list[@]}

		frobulator.download "${url_terminal}" "${file_refind_source}" "${directory_refind}" "${file_refind_configuration}"

		frobulator.download "${url_terminal}" "${directory_refind_themes}" "${file_refind_theme_archive}"

		frobulator.extract "${directory_refind_themes}/${file_refind_theme_archive}" "${directory_refind_themes}"

		list=()

		rm					\
			--recursive		\
			--force			\
							"${directory_refind_themes}/${file_refind_theme_archive}"

		# cleanup

		# remove leftover efi loaders

		name_distribution="$(source "${path_os_release}"; echo "${ID}")"

		if [ -f "${directory_refind}/${file_refind_loader}" ] &&
		   [ -n "${name_distribution}" ]
		then
			list=(
				"${name_distribution}"
			)

			frobulator.delete "${directory_efi_loaders}" ${list[@]}

			list=()
		fi

		# purge shim without secure boot

		state_secure_boot="$(mokutil --sb-state 2> "${sink}")"

		if [[ "${state_secure_boot}" = *"${label_secure_boot_disabled}"* ]]
		then
			apt purge --yes "${pattern_package_shim}" > "${sink}" 2>&1
		fi

		# remove stale firmware boot entries

		partition_efi="$(findmnt --noheadings --output SOURCE "${directory_efi}")"
		number_partition_efi="$(cat /sys/class/block/"${partition_efi##*/}"/partition 2> "${sink}")"
		guid_partition_efi="$(lsblk --noheadings --output PARTUUID "${partition_efi}")"

		mapfile -t list_entries < <(efibootmgr --verbose 2> "${sink}")

		for entry in "${list_entries[@]}"
		do
			if [[ "${entry}" =~ ${pattern_boot_entry} ]]
			then
				number_entry="${BASH_REMATCH[1]}"
				label_entry="${BASH_REMATCH[2]%%"${separator_entry}"*}"
				path_entry="${BASH_REMATCH[2]#*"${separator_entry}"}"

				unset state_entry_remove

				if [ "${label_entry,,}" = "${name_distribution,,}" ]
				then
					state_entry_remove="true"
				fi

				if [[ "${path_entry,,}" =~ ${pattern_entry_path}${guid_partition_efi,,} ]] &&
				   [ "${BASH_REMATCH[1]}" != "${number_partition_efi}" ]
				then
					state_entry_remove="true"
				fi

				if [ "${state_entry_remove}" = "true" ]
				then
					frobulator.rem "Removing boot entry" "[ ${number_entry} // ${label_entry} ]"

					efibootmgr --quiet --bootnum "${number_entry}" --delete-bootnum
				fi
			fi
		done

		unset list_entries state_entry_remove
	fi
fi

frobulator.scs 'Done'
