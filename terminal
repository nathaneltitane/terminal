# use to remove passwordless sudo lines from sudoers

intent_sudoers_clean () {

	local line_sudoers="${text_sudoers_rule}"
	local count_line
	local file_sudoers_temporary
	local status_sudoers

	count_line="$(grep --count --line-regexp --fixed-strings "${line_sudoers}" "${path_sudoers}")"

	if [ "${count_line}" -gt 0 ]
	then
		file_sudoers_temporary="$(mktemp)"

		grep --invert-match --line-regexp --fixed-strings "${line_sudoers}" "${path_sudoers}" > "${file_sudoers_temporary}"

		visudo -c -q -f "${file_sudoers_temporary}"

		status_sudoers="${?}"

		if [ "${status_sudoers}" -eq 0 ]
		then
			cat "${file_sudoers_temporary}" > "${path_sudoers}"

			frobulator.scs "Passwordless sudo line removed" "[ ${path_sudoers} // ${count_line} ]"
		else
			frobulator.err "Sudoers check failed - left unchanged" "[ ${path_sudoers} ]"
		fi

		rm -f "${file_sudoers_temporary}"
	fi

}

# use to align fstab columns

intent_fstab_align () {

	local file_fstab="${1}"
	local index_field
	local line_fstab
	local list_field
	local list_fstab
	local line_aligned
	local pattern_header='^#[[:space:]]*<?file system>?'
	local pattern_skipped='^[[:space:]]*(#|$)'
	local format_header='%-*s   %-*s   %-*s   %-*s   %s'
	local format_entry='%-*s   %-*s   %-*s   %-*s   %s %s'
	local label_dump_pass="dump pass"
	local value_options_default="defaults"
	local state_header="false"

	local list_header=(
		"# file system"
		"mount point"
		"type"
		"options"
	)

	local list_width=(
		0
		0
		0
		0
	)

	mapfile -t list_fstab < "${file_fstab}"

	# longest entry per column

	for line_fstab in "${list_fstab[@]}"
	do
		if [[ "${line_fstab}" =~ ${pattern_header} ]]
		then
			state_header="true"
		fi

		if [[ "${line_fstab}" =~ ${pattern_skipped} ]]
		then
			continue
		fi

		read -r -a list_field <<< "${line_fstab}"

		for index_field in 0 1 2 3
		do
			if [ "${#list_field[${index_field}]}" -gt "${list_width[${index_field}]}" ]
			then
				list_width[${index_field}]="${#list_field[${index_field}]}"
			fi
		done
	done

	# header labels count too

	if [ "${state_header}" = "true" ]
	then
		for index_field in 0 1 2 3
		do
			if [ "${#list_header[${index_field}]}" -gt "${list_width[${index_field}]}" ]
			then
				list_width[${index_field}]="${#list_header[${index_field}]}"
			fi
		done
	fi

	for line_fstab in "${list_fstab[@]}"
	do
		# header to column widths

		if [[ "${line_fstab}" =~ ${pattern_header} ]]
		then
			printf -v line_aligned "${format_header}"	\
				"${list_width[0]}" "${list_header[0]}"	\
				"${list_width[1]}" "${list_header[1]}"	\
				"${list_width[2]}" "${list_header[2]}"	\
				"${list_width[3]}" "${list_header[3]}"	\
				"${label_dump_pass}"

			printf "${format_line}" "${line_aligned}"

			continue
		fi

		# keep comments and blank lines

		if [[ "${line_fstab}" =~ ${pattern_skipped} ]]
		then
			printf "${format_line}" "${line_fstab}"

			continue
		fi

		read -r -a list_field <<< "${line_fstab}"

		printf -v line_aligned "${format_entry}"	\
			"${list_width[0]}" "${list_field[0]}"	\
			"${list_width[1]}" "${list_field[1]}"	\
			"${list_width[2]}" "${list_field[2]}"	\
			"${list_width[3]}" "${list_field[3]:-${value_options_default}}"	\
			"${list_field[4]:-0}" "${list_field[5]:-0}"

		printf "${format_line}" "${line_aligned}"
	done > "${file_fstab}"
}

# use to mount labeled drive at boot

intent_fstab_entry () {

	local label_drive="${1}"
	local directory_mount="${2}"
	local device_drive="${directory_label}/${1}"
	local name_user="${name_user_sudo}"

	local device_block
	local entry_fstab
	local field_device
	local field_mount
	local file_fstab_temporary
	local file_udev
	local id_device
	local id_group
	local id_user
	local line_fstab
	local line_udev
	local list_fstab
	local list_keep=()
	local list_udev
	local name_entry
	local options_mount
	local options_windows
	local state_block
	local status_fstab
	local type_drive
	local uuid_drive
	local prefix_udev_type
	local prefix_udev_uuid
	local prefix_fstab_uuid
	local prefix_fstab_label
	local pattern_type_windows
	local name_device_number

	prefix_udev_type="E:ID_FS_TYPE="
	prefix_udev_uuid="E:ID_FS_UUID="
	prefix_fstab_uuid="UUID="
	prefix_fstab_label="LABEL="
	pattern_type_windows="^(exfat|vfat|ntfs|ntfs3)$"
	name_device_number="dev"
	options_mount="users,exec,nofail,x-mount.mkdir,x-systemd.device-timeout=5s"
	options_windows="fmask=0022,dmask=0022,iocharset=utf8"
	state_block="false"

	if [ ! -e "${device_drive}" ]
	then
		frobulator.wrn "Drive not connected" "[ ${label_drive} ]"

		return
	fi

	# block device behind label

	for device_block in "${directory_block}"/*
	do
		if [ "${directory_device}/${device_block##*/}" -ef "${device_drive}" ]
		then
			state_block="true"

			break
		fi
	done

	if [ "${state_block}" = "true" ]
	then
		id_device="$(< "${device_block}/${name_device_number}")"

		file_udev="${directory_udev}/b${id_device}"
	fi

	if [ "${state_block}" != "true" ] ||
	   [ ! -f "${file_udev}" ]
	then
		frobulator.err "Drive details not found" "[ ${label_drive} ]"

		return 1
	fi

	# filesystem from udev database

	mapfile -t list_udev < "${file_udev}"

	for line_udev in "${list_udev[@]}"
	do
		if [[ "${line_udev}" == "${prefix_udev_type}"* ]]
		then
			type_drive="${line_udev#"${prefix_udev_type}"}"

		elif [[ "${line_udev}" == "${prefix_udev_uuid}"* ]]
		then
			uuid_drive="${line_udev#"${prefix_udev_uuid}"}"
		fi
	done

	# ownership for windows filesystems

	if [[ "${type_drive}" =~ ${pattern_type_windows} ]]
	then
		while IFS="${delimiter_passwd}" read -r name_entry _ id_user id_group _
		do
			if [ "${name_entry}" = "${name_user}" ]
			then
				break
			fi
		done < "${path_passwd}"

		options_mount+=",uid=${id_user},gid=${id_group},${options_windows}"
	fi

	entry_fstab="${prefix_fstab_uuid}${uuid_drive} ${directory_mount} ${type_drive} ${options_mount} 0 0"

	# replace previous entry

	mapfile -t list_fstab < "${path_fstab}"

	for line_fstab in "${list_fstab[@]}"
	do
		read -r field_device field_mount _ <<< "${line_fstab}"

		if [ "${field_mount}" = "${directory_mount}" ] ||
		   [ "${field_device}" = "${prefix_fstab_uuid}${uuid_drive}" ] ||
		   [ "${field_device}" = "${prefix_fstab_label}${label_drive}" ]
		then
			continue
		fi

		list_keep+=("${line_fstab}")
	done

	list_keep+=("${entry_fstab}")

	# new mount point only

	if [ ! -d "${directory_mount}" ]
	then
		frobulator.directory "${directory_mount%/*}" "${directory_mount##*/}"
	fi

	# validate before replacing

	file_fstab_temporary="$(mktemp)"

	printf "${format_line}" "${list_keep[@]}" > "${file_fstab_temporary}"

	intent_fstab_align "${file_fstab_temporary}"

	findmnt --verify --tab-file "${file_fstab_temporary}" > "${sink}" 2>&1

	status_fstab="${?}"

	if [ "${status_fstab}" -eq 0 ]
	then
		# original kept once per run

		if [ "${state_fstab_backup}" != "true" ]
		then
			cp "${path_fstab}" "${path_fstab_backup}"

			state_fstab_backup="true"
		fi

		cat "${file_fstab_temporary}" > "${path_fstab}"

		frobulator.scs "Drive mounted at boot" "[ ${label_drive} // ${directory_mount} ]"
	else
		frobulator.err "Fstab check failed - left unchanged" "[ ${label_drive} ]"
	fi

	rm -f "${file_fstab_temporary}"
}

# uninstall ────────────────────────────────────────────────────────────────────

# remove setup files and links

if [ "${option}" = "${mode_uninstall}" ]
then
	frobulator.qst "Remove the ${script} setup - shell files, links and passwordless sudo? [ y / N ]"

	frobulator.read reply

	if [[ ! "${reply}" =~ ${pattern_reply_yes} ]]
	then
		frobulator.inf "Aborting" "[ ${option} ]"

		exit 1
	fi

	# user and superuser homes

	directory_home_root="$(getent passwd "${name_root}" | cut --delimiter="${delimiter_passwd}" --fields="${field_passwd_home}")"

	list_homes=("${HOME}")

	if [ -n "${directory_home_root}" ] &&
	   [ "${directory_home_root}" != "${HOME}" ]
	then
		list_homes+=("${directory_home_root}")
	fi

	# setup links

	list_links=(
		.bash_aliases
		.bashrc
		.bash_configuration
		.bash_functions
		.bash_login
		.bash_logout
		.bash_profile
		.gitconfig
		.git-credentials
		.dns
		.dns-dynamic
		.modem
		.router
		.wifi
		.config/kuprc
	)

	for directory_home in "${list_homes[@]}"
	do
		state_link_shell="false"

		if [ -L "${directory_home}/${name_bashrc}" ]
		then
			state_link_shell="true"
		fi

		for name_link in "${list_links[@]}"
		do
			if [ -L "${directory_home}/${name_link}" ]
			then
				frobulator.delete "${directory_home}" "${name_link}"
			fi
		done

		# restore default bashrc

		if [ "${state_link_shell}" = "true" ] &&
		   [ -f "${path_skel_bashrc}" ]
		then
			cp "${path_skel_bashrc}" "${directory_home}/${name_bashrc}"

			chown --reference="${directory_home}" "${directory_home}/${name_bashrc}"

			frobulator.inf "Default shell configuration restored" "[ ${directory_home}/${name_bashrc} ]"
		fi
	done

	# shell files and functions

	list_files_shell=(
		bash-aliases
		bash-configuration
		bash-functions
		bash-login
		bash-logout
		bash-profile
		"${name_run}"
		utility-command-run
	)

	# function links to run

	for path_link in "${directory_bin}"/*
	do
		# ahead of run itself

		if [ -L "${path_link}" ] &&
		   [ "${path_link##*/}" != "${name_run}" ] &&
		   [ "${path_link}" -ef "${directory_bin}/${name_run}" ]
		then
			list_files_shell=("${path_link##*/}" "${list_files_shell[@]}")
		fi
	done

	for path_function in "${directory_bin}/${prefix_function_file}"*
	do
		if [ -e "${path_function}" ]
		then
			list_files_shell+=("${path_function##*/}")
		fi
	done

	for name_file in "${list_files_shell[@]}"
	do
		if [ -e "${directory_bin}/${name_file}" ]
		then
			frobulator.delete "${directory_bin}" "${name_file}"
		fi
	done

	# empty login notice file

	if [ -f "${HOME}/${name_hushlogin}" ] &&
	   [ ! -s "${HOME}/${name_hushlogin}" ]
	then
		frobulator.delete "${HOME}" "${name_hushlogin}"
	fi

	# storage links

	for path_link in "${directory_media}"/* "${HOME}/Downloads"
	do
		if [ ! -L "${path_link}" ]
		then
			continue
		fi

		target_link="$(readlink "${path_link}")"

		if [[ "${target_link}" == "${directory_mnt}/"* ]] ||
		   [[ "${target_link}" == "${directory_google}/"* ]] ||
		   [[ "${target_link}" == "${directory_media}/${name_user_sudo}/"* ]]
		then
			frobulator.delete "${path_link%/*}" "${path_link##*/}"
		fi
	done

	# remove passwordless sudo

	if [ -n "${SUDO_USER}" ]
	then
		if [ -f "${directory_sudoers}/${SUDO_USER}" ]
		then
			frobulator.delete "${directory_sudoers}" "${SUDO_USER}"
		fi

		intent_sudoers_clean
	fi

	frobulator.scs "Uninstalled" "[ ${script} ]"

	frobulator.inf "Kept" "[ home directories // themes // boot theme // packages ]"

	exit
fi

