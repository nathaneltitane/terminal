mode_python="python"
mode_pipx="pipx"
mode_mounts="mounts"
mode_files="files"
mode_home="home"
mode_git="git"
mode_shell="shell"
mode_superuser="superuser"
mode_themes="themes"
mode_applications="applications"
mode_media="media"
mode_kde_runner="kde-runner"
mode_efi="efi"
mode_all="all"
mode_uninstall="uninstall"
mode_storage="storage"

while (( $# ))
do
	case "${1}"
	in
		-p|--python)
			option="${mode_python}"
		;;

		-x|--pipx)
			option="${mode_pipx}"
		;;

		-r|--storage)
			option="${mode_storage}"

			option_storage="${2}"

			shift
		;;

		-m|--mounts)
			option="${mode_mounts}"
		;;

		-f|--files)
			option="${mode_files}"
		;;

		-o|--home)
			option="${mode_home}"
		;;

		-g|--git)
			option="${mode_git}"
		;;

		-s|--shell)
			option="${mode_shell}"
		;;

		-u|--superuser)
			option="${mode_superuser}"
		;;

		-t|--themes)
			option="${mode_themes}"
		;;

		-l|--applications)
			option="${mode_applications}"
		;;

		-d|--media)
			option="${mode_media}"
		;;

		-k|--kde-runner)
			option="${mode_kde_runner}"
		;;

		-e|--efi)
			option="${mode_efi}"
		;;

		-a|--all)
			option="${mode_all}"
		;;

		-n|--uninstall)
			option="${mode_uninstall}"
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -p | -x | -r [Type] | -m | -f | -o | -g | -s | -u | -t | -l | -d | -k | -e | -a | -n | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-p, --python          Set up [p]ython."
			echo
			echo -e "-x, --pipx            Set up pi[x] packages."
			echo
			echo -e "-r, --storage         Set up sto[r]age under windows subsystem for linux, chromeos, chromeos android, or removable media."
			echo
			echo -e "                      [ wsl ]"
			echo -e "                      [ chromeos ]"
			echo -e "                      [ android ]"
			echo -e "                      [ removable ]"
			echo
			echo -e "-m, --mounts          Set up drive [m]ounts at boot."
			echo
			echo -e "-f, --files           Link known [f]iles from storage."
			echo
			echo -e "-o, --home            Set up h[o]me directory structure."
			echo
			echo -e "-g, --git             Set up [g]it configuration and credentials."
			echo
			echo -e "-s, --shell           Set up [s]hell dotfiles - [ alt + ↵ ] fixes typos on the line."
			echo
			echo -e "-u, --superuser       Set up passwordless s[u]do."
			echo
			echo -e "-t, --themes          Set up [t]hemes."
			echo
			echo -e "-l, --applications    Set up app[l]ications."
			echo
			echo -e "-d, --media           Set up me[d]ia packages."
			echo
			echo -e "-k, --kde-runner      Set up [k]de runner shortcut."
			echo
			echo -e "-e, --efi             Set up r[e]find and efi boot theme."
			echo
			echo -e "-a, --all             Run [a]ll modules explicitly."
			echo
			echo -e "-n, --uninstall       Run u[n]installation of the ${script} setup - shell files, links and passwordless sudo."
			echo
			echo -e "-h, --help            Show [h]elp and usage information."
			echo
			echo -e "'${script}'           [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -p | -x | -r [Type] | -m | -f | -o | -g | -s | -u | -t | -l | -d | -k | -e | -a | -n | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

