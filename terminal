if [ "${name_environment}" = [kK][dD][eE] ]
then
	list+=(
		${list_kde[@]}
	)
fi

if [ ! -z "${DISPLAY}" ]
then
	list+=(
		${list_display[@]}
	)
fi

frobulator.assess ${list[@]}

list=()

# remove

list=(
	htop.desktop
)

frobulator.delete /usr/share/applications ${list[@]}

list=()

# configuration ────────────────────────────────────────────────────────────────

# python

if [ "${option}" = "python" ] || [ "${option}" = "all" ]
then
	if [[ "${HOSTNAME}" = [pP][eE][nN][gG][uU][iI][nN] ]]
	then
		frobulator.inf "Setting up" "[ python ]"

		directory_python="/usr/lib/python3.11"

		rm					\
			--recursive		\
			--force			\
							"${directory_python}"/EXTERNALLY-MANAGED
	fi
fi

# pipx

if [ "${option}" = "pipx" ] || [ "${option}" = "all" ]
then
	list_install_pip=(
		deno
		trimesh
		yt-dlp
		yt-dlp-ejs
	)

	for item in "${list_install_pip[@]}"
	do
		pipx install --global "${item}"
	done

	list_install_pip=()
fi

# storage - windows subsystem for linux

if [ "${option}" = "storage" ] && [ "${option_storage}" = "wsl" ] || [ "${option}" = "all" ]
then
	if [ -n "${WSL_DISTRO_NAME}" ]
	then
		frobulator.link /mnt /media y internal
		frobulator.link /mnt /media z external
	fi
fi

# storage - linux subsystem for chromeos

if [ "${option}" = "storage" ] && [ "${option_storage}" = "chromeos" ] || [ "${option}" = "all" ]
then
	if [ -d /mnt/chromeos ]
	then
		if [ -d /mnt/chromeos/GoogleDrive ]
		then
			frobulator.link /mnt/chromeos /media GoogleDrive Drive
		fi

		if [ -d /mnt/chromeos/MyFiles ]
		then
			frobulator.link /mnt/chromeos/MyFiles "${HOME}" Downloads Downloads
		fi

		if [ -d /mnt/chromeos/removable ]
		then
			frobulator.link /mnt/chromeos/removable /media Internal Internal
			frobulator.link /mnt/chromeos/removable /media External External
		fi

	fi
fi

# storage - android subsystem for chrome os

if [ "${option}" = "storage" ] && [ "${option_storage}" = "android" ] || [ "${option}" = "all" ]
then
	if [ -d /opt/google/containers/android ]
	then
		if [ -d /opt/google/containers/android/rootfs/android-data/data/media ]
		then
			frobulator.link /opt/google/containers/android/rootfs/android-data/data/media /media 0 Android
		fi

	fi
fi

# storage - removable

if [ "${option}" = "storage" ] && [ "${option_storage}" = "removable" ] || [ "${option}" = "all" ]
then
	if [ -d /media/"${USER}"/* ]
	then
		for directory in /media/"${USER}"/*
		do
			frobulator.inf "Removable storage found" "[ ${directory}]"

			list+=(
				"${directory}"
			)
		done

		unset directory

		for item in ${list[@]}
		do
			directory=${item##*/}

			if [ -d /opt/google/containers/android/rootfs/android-data/data/media ]
			then
				frobulator.link /media/"${USER}" /media "${directory}"
			fi
		done
	fi

	list=()
fi

# mounts

if [ "${option}" = "mounts" ] || [ "${option}" = "all" ]
then
	if [ -f /etc/fstab ] && [ -d /run/udev/data ]
	then
		intent_fstab_entry internal /media/internal
		intent_fstab_entry external /media/"${SUDO_USER:-${USER}}"/external

		if [ -n "$(command -v systemctl)" ]
		then
			systemctl daemon-reload
		fi

		# mount now if missing

		for directory_mount in /media/internal /media/"${SUDO_USER:-${USER}}"/external
		do
			if [[ "$(< /proc/mounts)" != *" ${directory_mount} "* ]] && [ -d "${directory_mount}" ]
			then
				mount "${directory_mount}" > "${sink}" 2>&1
			fi
		done

		unset directory_mount
	fi
fi

# files

if [ "${option}" = "files" ] || [ "${option}" = "all" ]
then
	list=(
		.dns
		.dns-dynamic
		.modem
		.router
		.wifi
	)

	list_storage=(
		/media/[iI]nternal
	)

	for storage in ${list_storage[@]}
	do
		if [ -d "${storage}" ]
		then
			for item in ${list[@]}
			do
				if [ -e "${storage}"/"${item}" ]
				then
					frobulator.link "${storage}" "${HOME}" "${item}"
				fi
			done
		fi
	done

	list_storage=()

	list=()
fi

# home

if [ "${option}" = "home" ] || [ "${option}" = "all" ]
then
	frobulator.file "${HOME}" .hushlogin

	if [[ "${HOSTNAME}" = [pP][eE][nN][gG][uU][iI][nN] ]]
	then
		# generate home directory structure

		list_directories+=(
			Desktop
			Documents
			Downloads
			Music
			Pictures
			Public
			Templates
			Videos
		)

		frobulator.directory "${HOME}" ${list_directories[@]}

		list_directories=()

	fi
fi

# git

if [ "${option}" = "git" ] || [ "${option}" = "all" ]
then
	frobulator.inf "Setting up" "[ git ]"

	list_storage=(
		/media/[aA]ndroid
		/media/[iI]nternal
	)

	for storage in ${list_storage[@]}
	do
		if [ -d "${storage}" ]
		then
			frobulator.link "${storage}"/Git "${HOME}" git-configuration .gitconfig

			chown "${USER}":"${USER}" "${storage}"/Git/git-configuration

			frobulator.link "${storage}"/Git "${HOME}" git-credentials   .git-credentials

			chown "${USER}":"${USER}" "${storage}"/Git/git-credentials
		fi
	done
fi

# shell

if [ "${option}" = "shell" ] || [ "${option}" = "all" ]
then
	frobulator.inf "Setting up" "[ shell ]"

	frobulator.directory "${HOME}" .local/bin

	list+=(
		bash-aliases
		bash-configuration
		bash-functions
		bash-login
		bash-logout
		bash-profile
	)

	# one file per function - loaded by bash-functions: names listed from the repository

	frobulator.repository "nathaneltitane/terminal" "bash-function-"

	list+=("${frobulator_return[@]}")

	frobulator.download get.trmnl.me "${HOME}"/.local/bin ${list[@]}

	frobulator.link "${HOME}"/.local/bin "${HOME}"                bash-aliases       .bash_aliases
	frobulator.link "${HOME}"/.local/bin "${HOME}"                bash-configuration .bashrc
	frobulator.link "${HOME}"/.local/bin "${HOME}"                bash-configuration .bash_configuration
	frobulator.link "${HOME}"/.local/bin "${HOME}"                bash-functions     .bash_functions
	frobulator.link "${HOME}"/.local/bin "${HOME}"                bash-login         .bash_login
	frobulator.link "${HOME}"/.local/bin "${HOME}"                bash-logout        .bash_logout
	frobulator.link "${HOME}"/.local/bin "${HOME}"                bash-profile       .bash_profile

	# superuser home

	directory_home_root="$(getent passwd root | cut -d ':' -f 6)"

	frobulator.link "${HOME}"/.local/bin "${directory_home_root}" bash-aliases       .bash_aliases
	frobulator.link "${HOME}"/.local/bin "${directory_home_root}" bash-configuration .bashrc
	frobulator.link "${HOME}"/.local/bin "${directory_home_root}" bash-configuration .bash_configuration
	frobulator.link "${HOME}"/.local/bin "${directory_home_root}" bash-functions     .bash_functions
	frobulator.link "${HOME}"/.local/bin "${directory_home_root}" bash-login         .bash_login
	frobulator.link "${HOME}"/.local/bin "${directory_home_root}" bash-logout        .bash_logout
	frobulator.link "${HOME}"/.local/bin "${directory_home_root}" bash-profile       .bash_profile

	# user running the script

	name_user="$(id -u -n)"

	if [ "${name_user}" = "root" ]
	then
		for item in ${list[@]}
		do
			chown "${SUDO_USER}":"${SUDO_USER}" "${HOME}"/.local/bin/"${item}"

			chmod 777 "${HOME}"/.local/bin/"${item}"
		done
	fi

	list=()
fi

# superuser

if [ "${option}" = "superuser" ] || [ "${option}" = "all" ]
then
	if [ -n "${SUDO_USER}" ]
	then
		# passwordless sudo file

		file_sudoers_temporary="$(mktemp)"

		echo "${SUDO_USER} ALL=(ALL) NOPASSWD: ALL" > "${file_sudoers_temporary}"

		visudo -c -q -f "${file_sudoers_temporary}"

		status_sudoers="${?}"

		if [ "${status_sudoers}" -eq 0 ]
		then
			cp "${file_sudoers_temporary}" /etc/sudoers.d/"${SUDO_USER}"

			chmod 0440 /etc/sudoers.d/"${SUDO_USER}"

			frobulator.scs "Passwordless sudo" "[ /etc/sudoers.d/${SUDO_USER} ]"

			# remove legacy sudoers lines

			intent_sudoers_clean
		else
			frobulator.err "Sudoers check failed - left unchanged" "[ /etc/sudoers.d/${SUDO_USER} ]"
		fi

		rm -f "${file_sudoers_temporary}"
	fi
fi

# themes

if [ "${option}" = "themes" ] || [ "${option}" = "all" ]
then
	if [[ "${HOSTNAME}" = [pP][eE][nN][gG][uU][iI][nN] ]]
	then
		frobulator.inf "Setting up" "[ themes ]"

		content_gtkrc=$(cat <<- 'FILE'
		gtk-icon-theme-name = "Breeze"
		gtk-theme-name = "Breeze"
		gtk-font-name = "Noto Mono 10"
		FILE
		)

		frobulator.write write "${content_gtkrc}" /etc/gtk-2.0 gtkrc

		content_settings=$(cat <<- 'FILE'
		[Settings]
		gtk-cursor-theme-name = Breeze
		gtk-icon-theme-name = Breeze
		gtk-theme-name = Breeze
		gtk-font-name = Noto Mono 10
		FILE
		)

		frobulator.write write "${content_settings}" /etc/gtk-3.0 settings.ini

		content_trolltech=$(cat <<- 'FILE'
		[Qt]
		style=Breeze
		FILE
		)

		frobulator.write write "${content_trolltech}" /etc/xdg Trolltech.conf

		frobulator.scs 'Done'
	fi
fi

# applications

if [ "${option}" = "applications" ] || [ "${option}" = "all" ]
then
	if [[ "${HOSTNAME}" = [pP][eE][nN][gG][uU][iI][nN] ]]
	then
		frobulator.inf "Setting up" "[ applications ]"

		# install

		list+=(
			${list_kde[@]}
		)

		frobulator.assess ${list[@]}

		list=()

		# remove

		list=(
			org.kde.dolphin.desktop
			org.kde.konsole.desktop
		)

		frobulator.delete /usr/share/applications ${list[@]}

		list=()

		# uninstall

		list=(
			uxterm
			vim
			xterm
		)

		frobulator.purge ${list[@]}

		list=()
	fi
fi

# kde - runner

if [ "${option}" = "kde-runner" ] || [ "${option}" = "all" ]
then
	if [ "${XDG_CURRENT_DESKTOP}" = [kK][dD][eE] ]
	then
		kwriteconfig5						\
			--file	kwinrc					\
			--group	ModifierOnlyShortcuts	\
			--key	Meta					\
											"org.kde.krunner,/App,,toggleDisplay"

		qdbus org.kde.KWin /KWin reconfigure
	fi
fi

# efi

if [ "${option}" = "efi" ] || [ "${option}" = "all" ]
then
	if [ -e /sys/firmware/efi ]
	then

		# install

		list=(
			refind
		)

		frobulator.install ${list[@]}

		list=()

		refind-install --yes > "${sink}" 2>&1

		# purge

		apt purge --yes 'grub*' > "${sink}" 2>&1

		list=(
			grub
		)

		frobulator.delete /boot ${list[@]}

		list=()

		# remove

		list=(
			refind.conf
		)

		frobulator.delete /boot/efi/EFI/refind ${list[@]}

		frobulator.download get.trmnl.me refind-configuration /boot/efi/EFI/refind refind.conf

		frobulator.download get.trmnl.me /boot/efi/EFI/refind/themes archive-refind-theme.tar.gz

		frobulator.extract /boot/efi/EFI/refind/themes/archive-refind-theme.tar.gz /boot/efi/EFI/refind/themes

		list=()

		rm					\
			--recursive		\
			--force			\
							/boot/efi/EFI/refind/themes/archive-refind-theme.tar.gz

		# cleanup

		# remove leftover efi loaders

		name_distribution="$(source /etc/os-release && echo "${ID}")"

		if [ -f /boot/efi/EFI/refind/refind_x64.efi ] && [ -n "${name_distribution}" ]
		then
			list=(
				"${name_distribution}"
			)

			frobulator.delete /boot/efi/EFI ${list[@]}

			list=()
		fi

		# purge shim without secure boot

		state_secure_boot="$(mokutil --sb-state 2> "${sink}")"

		if [[ "${state_secure_boot}" = *disabled* ]]
		then
			apt purge --yes 'shim*' > "${sink}" 2>&1
		fi

		# remove stale firmware boot entries

		partition_efi="$(findmnt --noheadings --output SOURCE /boot/efi)"
		number_partition_efi="$(cat /sys/class/block/"${partition_efi##*/}"/partition 2> "${sink}")"
		guid_partition_efi="$(lsblk --noheadings --output PARTUUID "${partition_efi}")"

		mapfile -t list_entries < <(efibootmgr --verbose 2> "${sink}")

		for entry in "${list_entries[@]}"
		do
			if [[ "${entry}" =~ ^Boot([0-9A-Fa-f]{4})[*[:space:]][[:space:]](.*)$ ]]
			then
				number_entry="${BASH_REMATCH[1]}"
				label_entry="${BASH_REMATCH[2]%%$'\t'*}"
				path_entry="${BASH_REMATCH[2]#*$'\t'}"

				unset state_entry_remove

				if [ "${label_entry,,}" = "${name_distribution,,}" ]
				then
					state_entry_remove="true"
				fi

				if [[ "${path_entry,,}" =~ ^hd\(([0-9]+),gpt,${guid_partition_efi,,} ]] &&
				   [ "${BASH_REMATCH[1]}" != "${number_partition_efi}" ]
				then
					state_entry_remove="true"
				fi

				if [ "${state_entry_remove}" = "true" ]
				then
					frobulator.rem "Removing boot entry" "[ ${number_entry} // ${label_entry} ]"

					efibootmgr --quiet --bootnum "${number_entry}" --delete-bootnum
				fi
			fi
		done

		unset list_entries state_entry_remove
	fi
fi

frobulator.scs 'Done'
