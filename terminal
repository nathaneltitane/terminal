#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (($#))
do
	case "${1}"
	in
		-p|--python)
			option="python"
		;;

		-x|--pipx)
			option="pipx"
		;;

		-w|--storage)
			option="storage"

			option_storage="${2}"

			shift
		;;

		-f|--files)
			option="files"
		;;

		-o|--home)
			option="home"
		;;

		-g|--git)
			option="git"
		;;

		-s|--shell)
			option="shell"
		;;

		-u|--superuser)
			option="superuser"
		;;

		-t|--themes)
			option="themes"
		;;

		-l|--applications)
			option="applications"
		;;

		-k|--kde-runner)
			option="kde-runner"
		;;

		-e|--efi)
			option="efi"
		;;

		-a|--all)
			option="all"
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -p | -x | -w [Type] | -f | -o | -g | -s | -u | -t | -l | -k | -e | -a | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-p, --python          Set up [p]ython."
			echo
			echo -e "-x, --pipx            Set up pi[x] packages."
			echo
			echo -e "-w, --storage         Set up [w]indows subsystem for linux, chromeos, chromeos android, or removable storage."
			echo
			echo -e "                      [ wsl ]"
			echo -e "                      [ chromeos ]"
			echo -e "                      [ android ]"
			echo -e "                      [ removable ]"
			echo
			echo -e "-f, --files           Link known [f]iles from storage."
			echo
			echo -e "-o, --home            Set up h[o]me directory structure."
			echo
			echo -e "-g, --git             Set up [g]it configuration and credentials."
			echo
			echo -e "-s, --shell           Set up [s]hell dotfiles."
			echo
			echo -e "-u, --superuser       Set up passwordless s[u]do."
			echo
			echo -e "-t, --themes          Set up [t]hemes."
			echo
			echo -e "-l, --applications    Set up app[l]ications."
			echo
			echo -e "-k, --kde             Set up [k]de runner shortcut."
			echo
			echo -e "-e, --efi             Set up r[e]find and efi boot theme."
			echo
			echo -e "-a, --all             Run [a]ll modules explicitly."
			echo
			echo -e "-h, --help            Show [h]elp and usage information."
			echo
			echo -e "'${script}'           [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -p | -x | -w [Type] | -f | -o | -g | -s | -u | -t | -l | -k | -e | -a | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

architecture="$(dpkg --print-architecture)"

codename="$(lsb_release -c -s)"

# defaults ─────────────────────────────────────────────────────────────────────

if [ -z "${option}" ]
then
	option="all"
fi

if [ "${option}" = "storage" ]
then
	if	[ "${option_storage}" != "wsl"       ] &&
		[ "${option_storage}" != "chromeos"  ] &&
		[ "${option_storage}" != "android"   ] &&
		[ "${option_storage}" != "removable" ]
	then
		frobulator.err "Unrecognized storage type" "[ ${option_storage} ]"

		exit 1
	fi
fi

desktop_environment="${XDG_CURRENT_DESKTOP}"

# functions ────────────────────────────────────────────────────────────────────

# update ───────────────────────────────────────────────────────────────────────

frobulator.update

frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(
	docker.io
	git
	htop
	hub
	nano
	openssh*
	pipx
	ssh*
	shellcheck
	tree
)

display_list=(
	cura
	mesa-utils
	puddletag
	vulkan-tools
	wayland-utils
)

kde_list=(
	ark
	breeze
	breeze-cursor-theme
	breeze-gtk-theme
	breeze-icon-theme
	calligra
	cantata
	dolphin
	flatpak
	gwenview
	karbon
	kate
	kcalc
	kcharselect
	kcolorchooser
	kde-config-cron
	kde-config-flatpak
	kde-spectacle
	kdenlive
	kdenetwork-filesharing
	kio-gdrive
	konsole
	kontrast
	krename
	krita
	kup-backup
	mpd
	plasma-discover
	plasma-discover-backend-flatpak
	plasma-discover-backend-fwupd
	samba
	solaar
	sweeper
)

if [ "${desktop_environment}" = [kK][dD][eE] ]
then
	list+=(
		${kde_list[@]}
	)
fi

if [ ! -z "${DISPLAY}" ]
then
	list+=(
		${display_list[@]}
	)
fi

frobulator.assess ${list[@]}

list=()

# remove

list=(
	htop.desktop
)

frobulator.delete /usr/share/applications ${list[@]}

list=()

# configuration ────────────────────────────────────────────────────────────────

# python

if [ "${option}" = "python" ] || [ "${option}" = "all" ]
then
	if [[ "${HOSTNAME}" = [pP][eE][nN][gG][uU][iI][nN] ]]
	then
		frobulator.inf "Setting up" "[ python ]"

		python_directory="/usr/lib/python3.11"

		rm					\
			--recursive		\
			--force			\
							"${python_directory}"/EXTERNALLY-MANAGED
	fi
fi

# pipx

if [ "${option}" = "pipx" ] || [ "${option}" = "all" ]
then
	pip_install_list=(
		deno
		trimesh
		yt-dlp
		yt-dlp-ejs
	)

	for item in "${pip_install_list[@]}"
	do
		pipx install --global "${item}"
	done

	pip_install_list=()
fi

# storage - windows subsystem for linux

if [ "${option}" = "storage" ] && [ "${option_storage}" = "wsl" ] || [ "${option}" = "all" ]
then
	if [ -n "${WSL_DISTRO_NAME}" ]
	then
		frobulator.link /mnt /media y internal
		frobulator.link /mnt /media z external
	fi
fi

# storage - linux subsystem for chromeos

if [ "${option}" = "storage" ] && [ "${option_storage}" = "chromeos" ] || [ "${option}" = "all" ]
then
	if [ -d /mnt/chromeos ]
	then
		if [ -d /mnt/chromeos/GoogleDrive ]
		then
			frobulator.link /mnt/chromeos /media GoogleDrive Drive
		fi

		if [ -d /mnt/chromeos/MyFiles ]
		then
			frobulator.link /mnt/chromeos/MyFiles "${HOME}" Downloads Downloads
		fi

		if [ -d /mnt/chromeos/removable ]
		then
			frobulator.link /mnt/chromeos/removable /media Internal Internal
			frobulator.link /mnt/chromeos/removable /media External External
		fi

	fi
fi

# storage - android subsystem for chrome os

if [ "${option}" = "storage" ] && [ "${option_storage}" = "android" ] || [ "${option}" = "all" ]
then
	if [ -d /opt/google/containers/android ]
	then
		if [ -d /opt/google/containers/android/rootfs/android-data/data/media ]
		then
			frobulator.link /opt/google/containers/android/rootfs/android-data/data/media /media 0 Android
		fi

	fi
fi

# storage - removable

if [ "${option}" = "storage" ] && [ "${option_storage}" = "removable" ] || [ "${option}" = "all" ]
then
	if [ -d /media/"${USER}"/* ]
	then
		for directory in /media/"${USER}"/*
		do
			frobulator.inf "Removable storage found" "[ ${directory}]"

			list+=(
				"${directory}"
			)
		done

		unset directory

		for item in ${list[@]}
		do
			directory=${item##*/}

			if [ -d /opt/google/containers/android/rootfs/android-data/data/media ]
			then
				frobulator.link /media/"${USER}" /media "${directory}"
			fi
		done
	fi

	list=()
fi

# files

if [ "${option}" = "files" ] || [ "${option}" = "all" ]
then
	list=(
		.dns
		.dns-dynamic
		.modem
		.router
		.wifi
	)

	storage_list=(
		/media/[iI]nternal
	)

	for storage in ${storage_list[@]}
	do
		if [ -d "${storage}" ]
		then
			for item in ${list[@]}
			do
				if [ -e "${storage}"/"${item}" ]
				then
					frobulator.link "${storage}" "${HOME}" "${item}"
				fi
			done
		fi
	done

	storage_list=()

	list=()
fi

# home

if [ "${option}" = "home" ] || [ "${option}" = "all" ]
then
	frobulator.file "${HOME}" .hushlogin

	if [[ "${HOSTNAME}" = [pP][eE][nN][gG][uU][iI][nN] ]]
	then
		# generate home directory structure

		directories_list+=(
			Desktop
			Documents
			Downloads
			Music
			Pictures
			Public
			Templates
			Videos
		)

		frobulator.directory "${HOME}" ${directories_list[@]}

		directories_list=()

	fi
fi

# git

if [ "${option}" = "git" ] || [ "${option}" = "all" ]
then
	frobulator.inf "Setting up" "[ git ]"

	storage_list=(
		/media/[aA]ndroid
		/media/[iI]nternal
	)

	for storage in ${storage_list[@]}
	do
		if [ -d "${storage}" ]
		then
			frobulator.link "${storage}"/Git "${HOME}" git-configuration .gitconfig

			chown "${USER}":"${USER}" "${storage}"/Git/git-configuration

			frobulator.link "${storage}"/Git "${HOME}" git-credentials   .git-credentials

			chown "${USER}":"${USER}" "${storage}"/Git/git-credentials
		fi
	done
fi

# shell

if [ "${option}" = "shell" ] || [ "${option}" = "all" ]
then
	frobulator.inf "Setting up" "[ shell ]"

	frobulator.directory "${HOME}" .local/bin

	list+=(
		bash-aliases
		bash-configuration
		bash-functions
		bash-login
		bash-logout
		bash-profile
	)

	# one file per function - loaded by bash-functions: names listed from the repository

	list+=($(curl --silent --location --connect-timeout 30 "${marker_hts}api.github.com/repos/nathaneltitane/terminal/contents" | jq -r '.[].name | select(startswith("bash-function-"))'))

	frobulator.download get.trmnl.me "${HOME}"/.local/bin ${list[@]}

	frobulator.link "${HOME}"/.local/bin "${HOME}"      bash-aliases       .bash_aliases
	frobulator.link "${HOME}"/.local/bin "${HOME}"      bash-configuration .bashrc
	frobulator.link "${HOME}"/.local/bin "${HOME}"      bash-configuration .bash_configuration
	frobulator.link "${HOME}"/.local/bin "${HOME}"      bash-functions     .bash_functions
	frobulator.link "${HOME}"/.local/bin "${HOME}"      bash-login         .bash_login
	frobulator.link "${HOME}"/.local/bin "${HOME}"      bash-logout        .bash_logout
	frobulator.link "${HOME}"/.local/bin "${HOME}"      bash-profile       .bash_profile

	frobulator.link "${HOME}"/.local/bin "${SUDO_HOME}" bash-aliases       .bash_aliases
	frobulator.link "${HOME}"/.local/bin "${SUDO_HOME}" bash-configuration .bashrc
	frobulator.link "${HOME}"/.local/bin "${SUDO_HOME}" bash-configuration .bash_configuration
	frobulator.link "${HOME}"/.local/bin "${SUDO_HOME}" bash-functions     .bash_functions
	frobulator.link "${HOME}"/.local/bin "${SUDO_HOME}" bash-login         .bash_login
	frobulator.link "${HOME}"/.local/bin "${SUDO_HOME}" bash-logout        .bash_logout
	frobulator.link "${HOME}"/.local/bin "${SUDO_HOME}" bash-profile       .bash_profile

	# user running the script

	user_name="$(id -u -n)"

	if [ "${user_name}" = "root" ]
	then
		for item in ${list[@]}
		do
			chown "${SUDO_USER}":"${SUDO_USER}" "${HOME}"/.local/bin/"${item}"

			chmod 777 "${HOME}"/.local/bin/"${item}"
		done
	fi

	list=()
fi

# superuser

if [ "${option}" = "superuser" ] || [ "${option}" = "all" ]
then
	frobulator.write "append" "${SUDO_USER} ALL=(ALL) NOPASSWD: ALL" /etc sudoers
fi

# themes

if [ "${option}" = "themes" ] || [ "${option}" = "all" ]
then
	if [[ "${HOSTNAME}" = [pP][eE][nN][gG][uU][iI][nN] ]]
	then
		frobulator.inf "Setting up" "[ themes ]"

		gtkrc_content=$(cat <<- 'FILE'
		gtk-icon-theme-name = "Breeze"
		gtk-theme-name = "Breeze"
		gtk-font-name = "Noto Mono 10"
		FILE
		)

		frobulator.write "write" "${gtkrc_content}" /etc/gtk-2.0 gtkrc

		settings_content=$(cat <<- 'FILE'
		[Settings]
		gtk-cursor-theme-name = Breeze
		gtk-icon-theme-name = Breeze
		gtk-theme-name = Breeze
		gtk-font-name = Noto Mono 10
		FILE
		)

		frobulator.write "write" "${settings_content}" /etc/gtk-3.0 settings.ini

		trolltech_content=$(cat <<- 'FILE'
		[Qt]
		style=Breeze
		FILE
		)

		frobulator.write "write" "${trolltech_content}" /etc/xdg Trolltech.conf

		frobulator.scs 'Done'
	fi
fi

# applications

if [ "${option}" = "applications" ] || [ "${option}" = "all" ]
then
	if [[ "${HOSTNAME}" = [pP][eE][nN][gG][uU][iI][nN] ]]
	then
		frobulator.inf "Setting up" "[ applications ]"

		# install

		list+=(
			${kde_list[@]}
		)

		frobulator.assess ${list[@]}

		list=()

		# remove

		list=(
			org.kde.dolphin.desktop
			org.kde.konsole.desktop
		)

		frobulator.delete /usr/share/applications ${list[@]}

		list=()

		# uninstall

		list=(
			uxterm
			vim
			xterm
		)

		frobulator.purge ${list[@]}

		list=()
	fi
fi

# kde - runner

if [ "${option}" = "kde-runner" ] || [ "${option}" = "all" ]
then
	if [ "${XDG_CURRENT_DESKTOP}" = [kK][dD][eE] ]
	then
		kwriteconfig5						\
			--file	kwinrc					\
			--group	ModifierOnlyShortcuts	\
			--key	Meta					\
											"org.kde.krunner,/App,,toggleDisplay"

		qdbus org.kde.KWin /KWin reconfigure
	fi
fi

# efi

if [ "${option}" = "efi" ] || [ "${option}" = "all" ]
then
	if [ -e /sys/firmware/efi ]
	then

		# install

		list=(
			refind
		)

		frobulator.install ${list[@]}

		list=()

		refind-install --yes > "${sink}" 2>&1

		# purge

		apt purge grub* > "${sink}" 2>&1

		list=(
			grub
		)

		frobulator.delete /boot ${list[@]}

		list=()

		# remove

		list=(
			refind.conf
		)

		frobulator.delete /boot/efi/EFI/refind ${list[@]}

		frobulator.download get.trmnl.me refind-configuration /boot/efi/EFI/refind refind.conf

		frobulator.download get.trmnl.me /boot/efi/EFI/refind/themes archive-refind-theme.tar.gz

		frobulator.extract /boot/efi/EFI/refind/themes/archive-refind-theme.tar.gz /boot/efi/EFI/refind/themes

		list=()

		rm					\
			--recursive		\
			--force			\
							/boot/efi/EFI/refind/themes/archive-refind-theme.tar.gz
	fi
fi

frobulator.scs 'Done'
