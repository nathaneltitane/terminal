#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-22"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-p|--python)
			option="python"
		;;

		-x|--pipx)
			option="pipx"
		;;

		-w|--storage)
			option="storage"

			option_storage="${2}"

			shift
		;;

		-m|--mounts)
			option="mounts"
		;;

		-f|--files)
			option="files"
		;;

		-o|--home)
			option="home"
		;;

		-g|--git)
			option="git"
		;;

		-s|--shell)
			option="shell"
		;;

		-u|--superuser)
			option="superuser"
		;;

		-t|--themes)
			option="themes"
		;;

		-l|--applications)
			option="applications"
		;;

		-k|--kde-runner)
			option="kde-runner"
		;;

		-e|--efi)
			option="efi"
		;;

		-a|--all)
			option="all"
		;;

		-n|--uninstall)
			option="uninstall"
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -p | -x | -w [Type] | -m | -f | -o | -g | -s | -u | -t | -l | -k | -e | -a | -n | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-p, --python          Set up [p]ython."
			echo
			echo -e "-x, --pipx            Set up pi[x] packages."
			echo
			echo -e "-w, --storage         Set up [w]indows subsystem for linux, chromeos, chromeos android, or removable storage."
			echo
			echo -e "                      [ wsl ]"
			echo -e "                      [ chromeos ]"
			echo -e "                      [ android ]"
			echo -e "                      [ removable ]"
			echo
			echo -e "-m, --mounts          Set up drive [m]ounts at boot."
			echo
			echo -e "-f, --files           Link known [f]iles from storage."
			echo
			echo -e "-o, --home            Set up h[o]me directory structure."
			echo
			echo -e "-g, --git             Set up [g]it configuration and credentials."
			echo
			echo -e "-s, --shell           Set up [s]hell dotfiles."
			echo
			echo -e "-u, --superuser       Set up passwordless s[u]do."
			echo
			echo -e "-t, --themes          Set up [t]hemes."
			echo
			echo -e "-l, --applications    Set up app[l]ications."
			echo
			echo -e "-k, --kde             Set up [k]de runner shortcut."
			echo
			echo -e "-e, --efi             Set up r[e]find and efi boot theme."
			echo
			echo -e "-a, --all             Run [a]ll modules explicitly."
			echo
			echo -e "-n, --uninstall       Run u[n]installation of the ${script} setup - shell files, links and passwordless sudo."
			echo
			echo -e "-h, --help            Show [h]elp and usage information."
			echo
			echo -e "'${script}'           [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -p | -x | -w [Type] | -m | -f | -o | -g | -s | -u | -t | -l | -k | -e | -a | -n | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

architecture="$(dpkg --print-architecture)"

codename="$(lsb_release -c -s)"

# defaults ─────────────────────────────────────────────────────────────────────

if [ -z "${option}" ]
then
	option="all"
fi

if [ "${option}" = "storage" ]
then
	if	[ "${option_storage}" != "wsl"       ] &&
		[ "${option_storage}" != "chromeos"  ] &&
		[ "${option_storage}" != "android"   ] &&
		[ "${option_storage}" != "removable" ]
	then
		frobulator.err "Unrecognized storage type" "[ ${option_storage} ]"

		exit 1
	fi
fi

name_environment="${XDG_CURRENT_DESKTOP}"

# functions ────────────────────────────────────────────────────────────────────

# use to remove passwordless sudo lines from sudoers

intent_sudoers_clean () {

	local line_sudoers="${SUDO_USER} ALL=(ALL) NOPASSWD: ALL"
	local count_line
	local file_sudoers_temporary
	local status_sudoers

	count_line="$(grep -c -x -F "${line_sudoers}" /etc/sudoers)"

	if [ "${count_line}" -gt 0 ]
	then
		file_sudoers_temporary="$(mktemp)"

		grep -v -x -F "${line_sudoers}" /etc/sudoers > "${file_sudoers_temporary}"

		visudo -c -q -f "${file_sudoers_temporary}"

		status_sudoers="${?}"

		if [ "${status_sudoers}" -eq 0 ]
		then
			cat "${file_sudoers_temporary}" > /etc/sudoers

			frobulator.scs "Passwordless sudo line removed" "[ /etc/sudoers // ${count_line} ]"
		else
			frobulator.err "Sudoers check failed - left unchanged" "[ /etc/sudoers ]"
		fi

		rm -f "${file_sudoers_temporary}"
	fi

}

# use to align fstab columns

intent_fstab_align () {

	local file_fstab="${1}"
	local index_field
	local line_fstab
	local list_field
	local list_fstab
	local list_width=(0 0 0 0)
	local line_aligned

	mapfile -t list_fstab < "${file_fstab}"

	# longest entry per column

	for line_fstab in "${list_fstab[@]}"
	do
		if [[ "${line_fstab}" =~ ^[[:space:]]*(#|$) ]]
		then
			continue
		fi

		read -r -a list_field <<< "${line_fstab}"

		for index_field in 0 1 2 3
		do
			if [ "${#list_field[${index_field}]}" -gt "${list_width[${index_field}]}" ]
			then
				list_width[${index_field}]="${#list_field[${index_field}]}"
			fi
		done
	done

	for line_fstab in "${list_fstab[@]}"
	do
		# keep comments and blank lines

		if [[ "${line_fstab}" =~ ^[[:space:]]*(#|$) ]]
		then
			printf '%s\n' "${line_fstab}"

			continue
		fi

		read -r -a list_field <<< "${line_fstab}"

		printf -v line_aligned '%-*s   %-*s   %-*s   %-*s   %s %s'	\
			"${list_width[0]}" "${list_field[0]}"						\
			"${list_width[1]}" "${list_field[1]}"						\
			"${list_width[2]}" "${list_field[2]}"						\
			"${list_width[3]}" "${list_field[3]:-defaults}"			\
			"${list_field[4]:-0}" "${list_field[5]:-0}"

		printf '%s\n' "${line_aligned}"
	done > "${file_fstab}"
}

# use to mount labeled drive at boot

intent_fstab_entry () {

	local label_drive="${1}"
	local directory_mount="${2}"
	local device_drive="/dev/disk/by-label/${1}"
	local name_user="${SUDO_USER:-${USER}}"

	local device_block
	local entry_fstab
	local field_device
	local field_mount
	local file_fstab_temporary
	local id_group
	local id_user
	local line_fstab
	local line_udev
	local list_fstab
	local list_keep=()
	local list_udev
	local name_entry
	local options_mount
	local status_block
	local status_fstab
	local type_drive
	local uuid_drive

	if [ ! -e "${device_drive}" ]
	then
		frobulator.wrn "Drive not connected" "[ ${label_drive} ]"

		return
	fi

	# block device behind label

	for device_block in /sys/class/block/*
	do
		if [ /dev/"${device_block##*/}" -ef "${device_drive}" ]
		then
			status_block="found"

			break
		fi
	done

	if [ -z "${status_block}" ] || [ ! -f /run/udev/data/b"$(< "${device_block}"/dev)" ]
	then
		frobulator.err "Drive details not found" "[ ${label_drive} ]"

		return 1
	fi

	# filesystem from udev database

	mapfile -t list_udev < /run/udev/data/b"$(< "${device_block}"/dev)"

	for line_udev in "${list_udev[@]}"
	do
		case "${line_udev}"
		in
			E:ID_FS_TYPE=*)
				type_drive="${line_udev#*=}"
			;;

			E:ID_FS_UUID=*)
				uuid_drive="${line_udev#*=}"
			;;
		esac
	done

	options_mount="users,nofail,x-systemd.device-timeout=5s"

	# ownership for windows filesystems

	case "${type_drive}"
	in
		exfat|vfat|ntfs|ntfs3)
			while IFS=':' read -r name_entry _ id_user id_group _
			do
				if [ "${name_entry}" = "${name_user}" ]
				then
					break
				fi
			done < /etc/passwd

			options_mount+=",exec,uid=${id_user},gid=${id_group},fmask=0022,dmask=0022,iocharset=utf8"
		;;
	esac

	entry_fstab="UUID=${uuid_drive} ${directory_mount} ${type_drive} ${options_mount} 0 0"

	# replace previous entry

	mapfile -t list_fstab < /etc/fstab

	for line_fstab in "${list_fstab[@]}"
	do
		read -r field_device field_mount _ <<< "${line_fstab}"

		if [ "${field_mount}" = "${directory_mount}" ] || [ "${field_device}" = "UUID=${uuid_drive}" ] || [ "${field_device}" = "LABEL=${label_drive}" ]
		then
			continue
		fi

		list_keep+=("${line_fstab}")
	done

	list_keep+=("${entry_fstab}")

	# new mount point only

	if [ ! -d "${directory_mount}" ]
	then
		frobulator.directory "${directory_mount%/*}" "${directory_mount##*/}"
	fi

	# validate before replacing

	file_fstab_temporary="$(mktemp)"

	printf '%s\n' "${list_keep[@]}" > "${file_fstab_temporary}"

	intent_fstab_align "${file_fstab_temporary}"

	findmnt --verify --tab-file "${file_fstab_temporary}" > "${sink}" 2>&1

	status_fstab="${?}"

	if [ "${status_fstab}" -eq 0 ]
	then
		cp /etc/fstab /etc/fstab.backup

		cat "${file_fstab_temporary}" > /etc/fstab

		frobulator.scs "Drive mounted at boot" "[ ${label_drive} // ${directory_mount} ]"
	else
		frobulator.err "Fstab check failed - left unchanged" "[ ${label_drive} ]"
	fi

	rm -f "${file_fstab_temporary}"
}

# uninstall ────────────────────────────────────────────────────────────────────

# remove setup files and links

if [ "${option}" = "uninstall" ]
then
	frobulator.qst "Remove the ${script} setup - shell files, links and passwordless sudo? [ y / N ]"

	frobulator.read reply

	if [[ ! "${reply}" =~ ^[yY] ]]
	then
		frobulator.inf "Aborting" "[ ${option} ]"

		exit 1
	fi

	# user and superuser homes

	directory_home_root="$(getent passwd root | cut -d ':' -f 6)"

	list_homes=("${HOME}")

	if [ -n "${directory_home_root}" ] && [ "${directory_home_root}" != "${HOME}" ]
	then
		list_homes+=("${directory_home_root}")
	fi

	# setup links

	list_links=(
		.bash_aliases
		.bashrc
		.bash_configuration
		.bash_functions
		.bash_login
		.bash_logout
		.bash_profile
		.gitconfig
		.git-credentials
		.dns
		.dns-dynamic
		.modem
		.router
		.wifi
	)

	for directory_home in "${list_homes[@]}"
	do
		state_link_shell="false"

		if [ -L "${directory_home}/.bashrc" ]
		then
			state_link_shell="true"
		fi

		for name_link in "${list_links[@]}"
		do
			if [ -L "${directory_home}/${name_link}" ]
			then
				frobulator.delete "${directory_home}" "${name_link}"
			fi
		done

		# restore default bashrc

		if [ "${state_link_shell}" = "true" ] && [ -f /etc/skel/.bashrc ]
		then
			cp /etc/skel/.bashrc "${directory_home}/.bashrc"

			chown --reference="${directory_home}" "${directory_home}/.bashrc"

			frobulator.inf "Default shell configuration restored" "[ ${directory_home}/.bashrc ]"
		fi
	done

	# shell files and functions

	list_files_shell=(
		bash-aliases
		bash-configuration
		bash-functions
		bash-login
		bash-logout
		bash-profile
	)

	for path_function in "${HOME}"/.local/bin/bash-function-*
	do
		if [ -e "${path_function}" ]
		then
			list_files_shell+=("${path_function##*/}")
		fi
	done

	for name_file in "${list_files_shell[@]}"
	do
		if [ -e "${HOME}/.local/bin/${name_file}" ]
		then
			frobulator.delete "${HOME}/.local/bin" "${name_file}"
		fi
	done

	# empty login notice file

	if [ -f "${HOME}/.hushlogin" ] && [ ! -s "${HOME}/.hushlogin" ]
	then
		frobulator.delete "${HOME}" .hushlogin
	fi

	# storage links

	for path_link in /media/* "${HOME}/Downloads"
	do
		if [ ! -L "${path_link}" ]
		then
			continue
		fi

		target_link="$(readlink "${path_link}")"

		case "${target_link}"
		in
			/mnt/*|/opt/google/*|/media/"${SUDO_USER:-${USER}}"/*)
				frobulator.delete "${path_link%/*}" "${path_link##*/}"
			;;
		esac
	done

	# remove passwordless sudo

	if [ -n "${SUDO_USER}" ]
	then
		if [ -f /etc/sudoers.d/"${SUDO_USER}" ]
		then
			frobulator.delete /etc/sudoers.d "${SUDO_USER}"
		fi

		intent_sudoers_clean
	fi

	frobulator.scs "Uninstalled" "[ ${script} ]"

	frobulator.inf "Kept" "[ home directories // themes // boot theme // packages ]"

	exit
fi

# update ───────────────────────────────────────────────────────────────────────

frobulator.update

frobulator.upgrade

