#!/bin/bash

# loaded by "${HOME}"/.local/bin/bash-functions

# temperature ──────────────────────────────────────────────────────────────────

temperature () {

	local count_acpitz
	local label_cpu
	local degrees_cpu
	local list_lines
	local length_label_longest
	local directory_zone
	local label
	local degrees
	local width_label
	local directory_thermal
	local pattern_zone
	local file_type
	local file_temperature
	local name_acpitz
	local name_package
	local pattern_chipset
	local pattern_wifi
	local label_system
	local label_chipset
	local label_wifi
	local label_package
	local separator_fields
	local format_line
	local unit_temperature
	local divisor_degrees
	local padding_label

	directory_thermal="/sys/class/thermal"
	pattern_zone="thermal_zone*"
	file_type="type"
	file_temperature="temp"
	name_acpitz="acpitz"
	name_package="x86_pkg_temp"
	pattern_chipset="pch_*"
	pattern_wifi="iwlwifi_*"
	label_system="System"
	label_chipset="Chipset"
	label_wifi="WiFi"
	label_package="CPU"
	separator_fields="|"
	format_line='%-*s%s%s\n'
	unit_temperature="°C"
	divisor_degrees="1000"
	padding_label="4"

	# output starts one line below the command

	echo

	if [ -d "${directory_thermal}" ]
	then
		count_acpitz=0
		length_label_longest=0

		unset label_cpu degrees_cpu

		list_lines=()

		for directory_zone in "${directory_thermal}"/${pattern_zone}
		do
			label=$(cat "${directory_zone}/${file_type}")

			if [ "${label}" = "${name_acpitz}" ]
			then
				count_acpitz=$(( count_acpitz + 1 ))

				label="${label_system} ${count_acpitz}"

			elif [[ "${label}" = ${pattern_chipset} ]]
			then
				label="${label_chipset}"

			elif [[ "${label}" = ${pattern_wifi} ]]
			then
				label="${label_wifi}"

			elif [ "${label}" = "${name_package}" ]
			then
				label="${label_package}"

			else
				label="${label//_/ }"
			fi

			degrees=$(cat "${directory_zone}/${file_temperature}")
			degrees=$(( degrees / divisor_degrees ))

			if [ "${#label}" -gt "${length_label_longest}" ]
			then
				length_label_longest="${#label}"
			fi

			if [ "${label}" = "${label_package}" ]
			then
				label_cpu="${label}"
				degrees_cpu="${degrees}"
			else
				list_lines+=("${label}${separator_fields}${degrees}")
			fi
		done

		width_label=$(( length_label_longest + padding_label ))

		if [ -n "${label_cpu}" ]
		then
			printf "${format_line}" "${width_label}" "${label_cpu}:" "${degrees_cpu}" "${unit_temperature}"
		fi

		printf '%s\n' "${list_lines[@]}" | sort |
		while IFS="${separator_fields}" read -r label degrees
		do
			printf "${format_line}" "${width_label}" "${label}:" "${degrees}" "${unit_temperature}"
		done

		unset count_acpitz label_cpu degrees_cpu list_lines length_label_longest width_label
	fi

}
