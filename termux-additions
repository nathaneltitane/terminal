#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# set before usage block

name_option_activity="activity"
name_option_handle="handle"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-a|--activity)
			option="${name_option_activity}"
			option_activity="${2}"

			shift
		;;

		-n|--handle)
			option="${name_option_handle}"
			option_handle="${2}"

			shift
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -a [Activity] | -n [Handle] | [OPTION]"
			echo
			echo -e "Options:"
			echo
			echo -e "-a, --activity    Run native Android [a]ctivities via Dextop environment defaults."
			echo
			echo -e "                  [ google-chrome ] | [ chrome ]"
			echo -e "                  [ google-mail ]   | [ gmail ]"
			echo -e "                  [ terminal ]"
			echo
			echo -e "-n, --handle      Run [n]ative desktop environment handles using installed Android applications."
			echo
			echo -e "                  [ email ]   | [ mail ]"
			echo -e "                  [ browser ] | [ link ] | [ web ]"
			echo -e "                  [ message ] | [ text ] | [ sms ]"
			echo
			echo -e "-h, --help        Show [h]elp and usage information."
			echo
			echo -e "'${script}'       [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -a [Activity] | -n [Handle] | [OPTION]"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

echo

# variables ────────────────────────────────────────────────────────────────────

# activities

activity_chrome="com.android.chrome/com.google.android.apps.chrome.Main"
activity_chrome_beta="com.chrome.beta/com.google.android.apps.chrome.Main"
activity_gmail="com.google.android.gm/.GmailActivity"
terminal="com.termux/com.termux.app.TermuxActivity"

# intent action

action_view="android.intent.action.VIEW"

# accepted choices

choice_chrome_full="google-chrome"
choice_chrome_short="chrome"
choice_mail_full="google-mail"
choice_mail_short="gmail"
choice_terminal="terminal"
choice_email_full="email"
choice_email_short="mail"
choice_browser="browser"
choice_link="link"
choice_web="web"
choice_message="message"
choice_text="text"
choice_sms="sms"

# defaults ─────────────────────────────────────────────────────────────────────

email="mailto:"
link="https:"
message="sms:"

# functions ────────────────────────────────────────────────────────────────────

activity_intent () {

	local activity

	activity="${1}"

	am start	\
		-n "${activity}"	> "${sink}" 2>&1

}

handle_intent () {

	local handle

	handle="${1}"

	am start	\
		-a "${action_view}"	\
		-d "${handle}"	> "${sink}" 2>&1

}

# requirements ─────────────────────────────────────────────────────────────────

# configuration ────────────────────────────────────────────────────────────────

if [ "${option}" = "${name_option_activity}" ]
then
	if [ "${option_activity}" = "${choice_chrome_full}" ] ||
	   [ "${option_activity}" = "${choice_chrome_short}" ]
	then
		activity="${activity_chrome}"

	elif [ "${option_activity}" = "${choice_mail_full}" ] ||
	     [ "${option_activity}" = "${choice_mail_short}" ]
	then
		activity="${activity_gmail}"

	elif [ "${option_activity}" = "${choice_terminal}" ]
	then
		activity="${terminal}"

	else
		frobulator.err "Unrecognized activity option" "[ ${option_activity} ]"

		exit 1
	fi

	activity_intent "${activity}"

elif [ "${option}" = "${name_option_handle}" ]
then
	if [ "${option_handle}" = "${choice_email_full}" ] ||
	   [ "${option_handle}" = "${choice_email_short}" ]
	then
		handle="${email}"

	elif [ "${option_handle}" = "${choice_browser}" ] ||
	     [ "${option_handle}" = "${choice_link}" ] ||
	     [ "${option_handle}" = "${choice_web}" ]
	then
		handle="${link}"

	elif [ "${option_handle}" = "${choice_message}" ] ||
	     [ "${option_handle}" = "${choice_text}" ] ||
	     [ "${option_handle}" = "${choice_sms}" ]
	then
		handle="${message}"

	else
		frobulator.err "Unrecognized handle option" "[ ${option_handle} ]"

		exit 1
	fi

	handle_intent "${handle}"
fi
