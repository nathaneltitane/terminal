#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-d|--directory)
			directory="${2}"

			shift
		;;

		-a|--all)
			option_extension="all"

			list_extensions=(
				stl
			)
		;;

		-f|--file)
			file="file"
		;;

			all)
				option_extension="all"

				list_extensions=(
					stl
				)
				;;

			stl)
				option_extension="stl"

				list_extensions=(
					stl
				)
			;;

		-r|--render)
			option="render"
		;;

			full)
				option_render="full"
				preset_render="full"
			;;

			render)
				option_render="render"
				preset_render="render"
			;;

			thumbnail)
				option_render="thumbnail"
				preset_render="thumbnail"
			;;

			1)
				option_render="1"
				preset_render="1"
			;;

			2)
				option_render="2"
				preset_render="2"
			;;

			3)
				option_render="3"
				preset_render="3"
			;;

			4)
				option_render="4"
				preset_render="4"
			;;

			5)
				option_render="5"
				preset_render="5"
			;;

			6)
				option_render="6"
				preset_render="6"
			;;

			7)
				option_render="7"
				preset_render="7"
			;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} [EXTENSION] | [OPTION] [PARAMETER]"
			echo
			echo -e "Options:"
			echo
			echo -e "-directory    Specify [d]irectory to load models from."
			echo
			echo -e "-all          Select [a]ll supported file formats as target."
			echo
			echo -e "-stl          Select [s]tl file format as target."
			echo
			echo -e "-render       Run model file [r]endering using the following parameters:"
			echo
			echo -e "              0            Render image using a quarter-back view preset. [ 0 ] [ Lat.:30, Lon.: 0 ]"
			echo -e "              1            Render image using a quarter-back view preset. [ 1 ] [ Lat.:30, Lon.: 45 ]"
			echo -e "              2            Render image using a quarter-back view preset. [ 2 ] [ Lat.:30, Lon.: 90 ]"
			echo -e "              3            Render image using a quarter-back view preset. [ 3 ] [ Lat.:30, Lon.: 135 ]"
			echo -e "              4            Render image using a quarter-back view preset. [ 4 ] [ Lat.:30, Lon.: 180 ]"
			echo -e "              5            Render image using a quarter-back view preset. [ 5 ] [ Lat.:30, Lon.: 225 ]"
			echo -e "              6            Render image using a quarter-back view preset. [ 6 ] [ Lat.:30, Lon.: 270 ]"
			echo -e "              7            Render image using a quarter-back view preset. [ 7 ] [ Lat.:30, Lon.: 315 ]"
			echo
			echo -e "              full         Render series of images using options 0 to 7."
			echo -e "              render       Render series of images using option 1."
			echo -e "              thumbnail    Render image using option 0 without edges or shading at 25% of the original size."
			echo
			echo -e "-h, --help    Show [h]elp and usage information."
			echo
			echo -e "'${script}'   [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} [EXTENSION] | [OPTION] [PARAMETER]"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

stamp=$(date +"%m-%d-%Y-%H-%M-%S")

# defaults ─────────────────────────────────────────────────────────────────────

if [ -z "${directory}" ]
then
	frobulator.qst "Specify directory?"
	echo

	read reply

	if [[ "${reply}" = [yY] || "${reply}" = [yY][eE][sS] ]]
	then
		# specify directory location or exit on 'cancel'

		directory=$(frobulator.dialog "Directory")
	else
		frobulator.err "No directory specified."

		frobulator.fwd "Assuming defaults..."

		directory="${PWD}"
	fi
fi

if [ -z "${file}" ]
then
	frobulator.qst "Specify model file type? [ simple / multipart ]"

	frobulator.read reply

	if [[ "${reply}" = [yY] || "${reply}" = [yY][eE][sS] ]]
	then
		# specify directory location or exit on 'cancel'

		frobulator.ipt "Specify model file extension [ all / stl ]"

		while true
		do
			frobulator.read option_extension

			if [ -z "${option_extension}" ] || [[ ! "${option_extension}" =~ [all|stl] ]]
			then
				frobulator.wrn "Unrecognized model file extension."
				frobulator.wrn "Try again."
			else
				if [[ "${option_extension}" = "all" ]]
				then
					list_extensions=(
						stl
					)
				else
					list_extensions=(
						${option_extension}
					)
				fi

				break
			fi
		done
	else
		# set default to ldr file extension:
		# mpd file extension officially deprecated in favor of ldr

		frobulator.err "No file type specified."

		frobulator.fwd "Assuming defaults..."

		option_extension="mpd"

		list_extensions=(
			stl
		)
	fi
fi


if [ -z "${option_render}" ]
then
	option_render="full"
fi

# functions ────────────────────────────────────────────────────────────────────

f3d_render () {

	# render model

	frobulator.inf "Rendering" "[ ${view[coordinates]} // ${name_model} ]"

	frobulator.fwd "Output" "[ ${file_render} ]"

	path_model="${1}"
	coordinates="${2}"

	up="+Z"

	if [[  -z "${height}" ]]
	then
		height="4096"
	fi

	if [[ -z "${width}" ]]
	then
		width="4096"
	fi

	extension="png"

	f3d																	\
		--up "${up}"													\
		--ssao															\
		--fxaa															\
		--tone-mapping													\
		--resolution "${width}","${height}"								\
		--camera-azimuth-angle=${latitude[$coordinates]}				\
		--camera-elevation-angle=${longitude[$coordinates]}				\
		--no-background													\
		--output="${name_model}-${view[$coordinates]}.${extension}"		\
																		"${path_model}" > "${sink}" 2>&1

		wait
}

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(
	f3d
)

frobulator.assess ${list[@]}

list=()

# configuration ────────────────────────────────────────────────────────────────

if [ "${option}" = "render" ]
then
	for extension in ${list_extensions[@]}
	do
		list_models=( $(find ${directory} -type f -iname "*.${extension}" ! -iname "*instructions*") )

		# set IFS

		IFS=$'\n'

		for path_model in ${list_models[@]}
		do

			# get model file name from path

			file_model="${path_model##*/}"

			# strip extension from model file name

			name_model="${file_model%.*}"

			# define render output directory

			# use model directory as root

			directory_render="${path_model%/*}"/renders

			# use render directory as root

			directory_full="${path_model%/*}"/renders/full

			directory_thumbnail="${path_model%/*}"/renders/thumbnail

			# define coordinate values and labels

			# camera latitude

			latitude=(
				30
				30
				30
				30
				30
				30
				30
				30
			)

			# camera longitude

			longitude=(
				0
				45
				90
				135
				180
				225
				270
				315
			)

			# view labels

			view=(
				"00"
				"01"
				"02"
				"03"
				"04"
				"05"
				"06"
				"07"
			)

			# define camera position presets

			if [[ "${preset_render}" = "0" ]]
			then
				position=(0)
			fi

			if [[ "${preset_render}" = "1" ]]
			then
				position=(1)
			fi

			if [[ "${preset_render}" = "2" ]]
			then
				position=(2)
			fi

			if [[ "${preset_render}" = "3" ]]
			then
				position=(3)
			fi

			if [[ "${preset_render}" = "4" ]]
			then
				position=(4)
			fi

			if [[ "${preset_render}" = "5" ]]
			then
				position=(5)
			fi

			if [[ "${preset_render}" = "6" ]]
			then
				position=(6)
			fi

			if [[ "${preset_render}" = "7" ]]
			then
				position=(7)
			fi

			if [[ "${preset_render}" = "render" ]]
			then
				position=(1)
			fi

			if [[ "${preset_render}" = "thumbnail" ]]
			then
				height=1024
				width=1024

				position=(1)
			fi

			# render

			# prepare base render directory:
			# generate if does not exist

			if [[ ! -d "${directory_render}" ]]
			then
				mkdir -p "${directory_render}"
			fi

			cd "${directory_render}"

			if [[ "${preset_render}" = "thumbnail" ]]
			then
				if [[ -d "${directory_thumbnail}" ]]
				then
					rm					\
						--recursive		\
						--force			 "${directory_thumbnail}"
				fi

				mkdir -p "${directory_thumbnail}"

				cd "${directory_thumbnail}"
			fi

			for coordinates in ${position[@]}
			do
				file_render="${name_model}-${view[$coordinates]}.${extension}"

				f3d_render "${path_model}" "${coordinates}"
			done

			# post rendering

			if [[ "${option_render}" = "render" ]]
			then
				# rename renders to designated splash images

				mv												\
					"${name_model}-${view[1]}.${extension}"		\
					"${directory_render}"/render."${extension}"
			fi

			if [[ "${option_render}" = "thumbnail" ]]
			then
				# rename renders to designated splash images

				mv												\
					"${name_model}-${view[1]}.${extension}"		\
					"${directory_thumbnail}"/thumbnail."${extension}"
			fi

		done

		# reset IFS

		IFS=''

	done
fi

frobulator.scs "Done."
