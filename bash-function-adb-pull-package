#!/bin/bash

# loaded by "${HOME}"/.local/bin/bash-functions

# adb-pull-package ─────────────────────────────────────────────────────────────

adb_pull_package () {

	local package
	local path_package
	local directory_apk
	local directory_android
	local file_base
	local extension_package
	local expression_package
	local pattern_data

	local list_packages=()

	directory_apk="./apk"
	directory_android="${HOME}/Android"
	file_base="base.apk"
	extension_package=".apk"
	expression_package='s/^package://p'
	pattern_data="/data/app"

	adb_download

	adb_set_environment

	if [ ! -d "${directory_apk}" ]
	then
		mkdir --parents "${directory_android}"

		cd "${directory_android}"
	fi

	# installed package names

	mapfile -t list_packages < <(adb shell pm list packages | sed --quiet "${expression_package}")

	for package in "${list_packages[@]}"
	do
		if [ -z "${package}" ]
		then
			continue
		fi

		# apk path on the device

		path_package="$(adb shell pm path "${package}" | grep "${pattern_data}" | sed --quiet "${expression_package}")"

		adb pull "${path_package}"

		mv "${file_base}" "${package}${extension_package}"
	done
}
