#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="07-13-2026"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-h|--help)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-h, --help    Show [h]elp and usage information."
			echo
			echo -e "'${script}'   [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

process="rclone-google-drive"
service="${process}.service"
file_count_runs="${HOME}"/.local/bin/rclone-google-drive-run-count

name_service_cloud="google drive"

directory_server_cloud="drive:"
directory_server_local="/media/internal"

# defaults ─────────────────────────────────────────────────────────────────────

# functions ────────────────────────────────────────────────────────────────────

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(
	inotify-tools
)

frobulator.require ${list[@]}

list=()

# configuration ────────────────────────────────────────────────────────────────

list=(
	rclone
	rclone-browser
)

frobulator.require "${list[@]}"

frobulator.complete

list=()

if [ -d /media/[iI]nternal/[rR][cC]lone ]
then
	if [ -f /media/[iI]nternal/[rR][cC]lone/rclone.conf ]
	then
		frobulator.inf "Linking configuration"

		frobulator.directory "${HOME}" .config/rclone

		frobulator.link /media/[iI]nternal/[rR][cC]lone/ "${HOME}"/.config/rclone rclone.conf

		frobulator.complete
	fi
fi

# script

cat <<- FILE > "${HOME}"/.local/bin/"${process}"
#!/bin/bash

directory_server_cloud="drive:"
directory_server_local="/media/internal"

file_count_runs="\${HOME}"/.local/bin/rclone-google-drive-run-count
file_lock_synchronize="\${HOME}"/.local/bin/rclone-google-drive-sync-lock

rclone_transfer () {

${TAB}command_rclone=/usr/bin/rclone

${TAB}count_checkers="64"
${TAB}duration_lock_maximum="120"
${TAB}duration_window_modify="1"
${TAB}count_streams="16"
${TAB}count_transfers="32"
${TAB}file_log="${HOME}/.config/rclone/rclone.log"

${TAB}mode_synchronization="\${1}"

${TAB}path_source="\${2}"
${TAB}path_destination="\${3}"

${TAB}shift 3

${TAB}list_arguments_extra=("\${@}")

${TAB}command_transfer=()

${TAB}command_transfer+=(\${command_rclone})
${TAB}command_transfer+=(\${mode_synchronization})
${TAB}command_transfer+=(\${path_source})
${TAB}command_transfer+=(\${path_destination})
${TAB}command_transfer+=(--compare size,modtime,checksum)
${TAB}command_transfer+=(--checkers \${count_checkers})
${TAB}command_transfer+=(--create-empty-src-dirs)
${TAB}command_transfer+=(--drive-acknowledge-abuse)
${TAB}command_transfer+=(--drive-skip-dangling-shortcuts)
${TAB}command_transfer+=(--drive-skip-gdocs)
${TAB}command_transfer+=(--drive-skip-shortcuts)
${TAB}command_transfer+=(--fix-case)
${TAB}command_transfer+=(--max-lock \${duration_lock_maximum}s)
${TAB}command_transfer+=(--metadata)
${TAB}command_transfer+=(--exclude '.Trash-*/**')
${TAB}command_transfer+=(--modify-window \${duration_window_modify}s)
${TAB}command_transfer+=(--multi-thread-streams \${count_streams})
${TAB}command_transfer+=(--recover)
${TAB}command_transfer+=(--track-renames)
${TAB}command_transfer+=(--transfers \${count_transfers})
${TAB}if (( count_runs == 0 ))
${TAB}then
${TAB}${TAB}echo "Resync triggered - initial run"
${TAB}${TAB}echo

${TAB}${TAB}command_transfer+=(--resync)
${TAB}${TAB}command_transfer+=(--resync-mode newer)
${TAB}fi

${TAB}command_transfer+=(--progress)
${TAB}command_transfer+=(--verbose)
${TAB}command_transfer+=(--log-file \${file_log})

${TAB}command_transfer+=("\${list_arguments_extra[@]}")

${TAB}eval \${command_transfer[@]}
}

# batch directory management

# set IFS

synchronize () {

${TAB}exec 200> "\${file_lock_synchronize}"

${TAB}if ! flock -n 200
${TAB}then
${TAB}${TAB}echo "Synchronize already running - skipping"
${TAB}${TAB}return 0
${TAB}fi

${TAB}if [ -e "\${file_count_runs}" ]
${TAB}then
${TAB}${TAB}count_runs=\$(cat "\${file_count_runs}")
${TAB}else
${TAB}${TAB}count_runs=0
${TAB}fi

${TAB}echo "\${count_runs}" > "\${file_count_runs}"

${TAB}echo
${TAB}echo "Run start - count: \${count_runs}"
${TAB}echo

${TAB}IFS=\$'\n'

${TAB}list_directories_server=(
${TAB}${TAB}\$(find "\${directory_server_local}"	\\
${TAB}${TAB}${TAB}-mindepth 1						\\
${TAB}${TAB}${TAB}-maxdepth 1						\\
${TAB}${TAB}${TAB}-type d							\\
${TAB}${TAB}${TAB}! -iname "*.Trash*"				\\
${TAB}${TAB}${TAB}-print0							|
${TAB}${TAB}${TAB}xargs -0 du -s 2> /dev/null		|
${TAB}${TAB}${TAB}sort -n							|
${TAB}${TAB}${TAB}cut -f 2-
${TAB}${TAB})
${TAB})

${TAB}IFS=''

${TAB}rclone_transfer bisync "\${directory_server_cloud}/" "\${directory_server_local}/" --max-depth 1

${TAB}for name_directory_server in "\${list_directories_server[@]}"
${TAB}do
${TAB}${TAB}name_directory_server=\${name_directory_server##*/}

${TAB}${TAB}rclone_transfer bisync "\${directory_server_cloud}/\${name_directory_server}" "\${directory_server_local}/\${name_directory_server}"

${TAB}${TAB}sleep 1
${TAB}done

${TAB}count_runs=\$(( count_runs + 1 ))

${TAB}echo "\${count_runs}" > "\${file_count_runs}"

${TAB}echo
${TAB}echo "Run end - count: \${count_runs}"
${TAB}echo
}

# unset directory list

list_directories_server=()

# initial sync, then event-driven for local changes, periodic for cloud-side changes

synchronize

interval_periodic="180"

(
${TAB}while true
${TAB}do
${TAB}${TAB}sleep "\${interval_periodic}"

${TAB}${TAB}synchronize
${TAB}done
) &

inotifywait										\
${TAB}--monitor									\
${TAB}--recursive									\
${TAB}--event modify,create,delete,move,attrib	\
${TAB}--exclude '(\.?Trash.*|\.?Git.*/)'			\
${TAB}																	"\${directory_server_local}" |
while read -r directory_event name_event file_event
do
${TAB}state_debounce_pending=true

${TAB}while \${state_debounce_pending}
${TAB}do
${TAB}${TAB}read -t 2 -r directory_event name_event file_event 2> /dev/null
${TAB}${TAB}status_read="\${?}"

${TAB}${TAB}if [ "\${status_read}" -ge 128 ] || [ "\${status_read}" -eq 1 ]
${TAB}${TAB}then
${TAB}${TAB}${TAB}state_debounce_pending=false
${TAB}${TAB}fi
${TAB}done

${TAB}synchronize
done
FILE

frobulator.complete

# permissions

chmod +x "${HOME}"/.local/bin/"${process}"

frobulator.complete

# inotify watch limit - raised for recursive monitoring of large trees - the default is far too low

count_watches_required="524288"

count_watches_current="$(cat /proc/sys/fs/inotify/max_user_watches)"

if [ "${count_watches_current}" -lt "${count_watches_required}" ]
then
	frobulator.inf "Raising inotify watch limit" "[ ${count_watches_required} ]"

	sysctl -w fs.inotify.max_user_watches="${count_watches_required}" > "${sink}"

	frobulator.write write "fs.inotify.max_user_watches=${count_watches_required}" /etc/sysctl.d 99-inotify.conf

	frobulator.complete
fi

# service

frobulator.directory /etc/systemd system

frobulator.complete

# service desciptor

cat <<- FILE > /etc/systemd/system/"${service}"
[Unit]
Description=Synchronize Google Drive using RClone
After=network-online.target
Wants=network-online.target

[Service]
User=${USER}
Group=${USER}
Environment=HOME=${HOME}
ExecStart=${SHELL} ${HOME}/.local/bin/${process}
Restart=always
RestartSec=1s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
FILE

frobulator.complete

# prepare

frobulator.delete "$(dirname "${file_count_runs}")" "$(basename "${file_count_runs}")"

frobulator.delete "${HOME}"/.cache rclone

frobulator.complete

# service activation

frobulator.service activate "${service}"

frobulator.complete

frobulator.result "${script}"

frobulator.scs "Done"
