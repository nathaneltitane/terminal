#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-d|--directory)
			directory_storage="${2}"

			shift
		;;

		-i|--install)
			option="install"
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -d [Directory] -i | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-d, --directory    Specify storage [d]irectory for claude configuration."
			echo
			echo -e "                   [ /media/internal/LLM/claude ] [ Default ]"
			echo
			echo -e "-i, --install      Run [i]nstallation of claude code before linking."
			echo
			echo -e "-h, --help         Show [h]elp and usage information."
			echo
			echo -e "'${script}'        [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -d [Directory] -i | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

list_items=(
	.claude
	.claude.json
)

url_install="https://claude.ai/install.sh"

# defaults ─────────────────────────────────────────────────────────────────────

if [ -z "${directory_storage}" ]
then
	directory_storage="/media/internal/LLM/claude"
fi

# validate arguments

if [[ "${directory_storage}" = -* ]]
then
	frobulator.err "Missing argument for '--directory'."

	exit 1

elif [ ! -d "${directory_storage}/.claude" ]
then
	frobulator.err "Configuration not found" "[ ${directory_storage}/.claude ]"

	exit 1
fi

# claude code must not run while linking

# running claude code process id - empty if not running

ids_process_claude="$(pgrep -x claude)"

if [ -n "${ids_process_claude}" ]
then
	frobulator.wrn "Claude code is running"

	frobulator.qst "Close claude code?"

	frobulator.read reply

	if [[ "${reply}" != [yY]         ]] &&
	   [[ "${reply}" != [yY][eE][sS] ]]
	then
		frobulator.stp "Operation cancelled."

		exit 0
	fi

	# terminate then kill after 5 seconds

	pkill -x claude

	for second in {1..5}
	do
		ids_process_claude="$(pgrep -x claude)"

		if [ -z "${ids_process_claude}" ]
		then
			break
		fi

		sleep 1
	done

	ids_process_claude="$(pgrep -x claude)"

	if [ -n "${ids_process_claude}" ]
	then
		pkill -9 -x claude

		sleep 1
	fi

	ids_process_claude="$(pgrep -x claude)"

	if [ -n "${ids_process_claude}" ]
	then
		frobulator.err "Unable to close claude code."

		exit 1
	fi

	frobulator.scs "Closed" "[ claude code ]"
fi

# functions ────────────────────────────────────────────────────────────────────

claude_install () {

	local list_status

	frobulator.inf "Installing" "[ claude code ]"

	# official installer

	curl -fsSL "${url_install}" | bash

	list_status=("${PIPESTATUS[@]}")

	if [ "${list_status[0]}" -ne 0 ] || [ "${list_status[1]}" -ne 0 ]
	then
		frobulator.err "Unable to install claude code" "[ ${url_install} ]"

		return 1
	fi

	frobulator.scs "Installed" "[ claude code ]"
}

claude_link () {

	local item="${1}"
	local path_item_home="${HOME}/${item}"
	local path_item_storage="${directory_storage}/${item}"

	# already linked

	if [ -L "${path_item_home}" ] && [ "${path_item_home}" -ef "${path_item_storage}" ]
	then
		frobulator.inf "Already linked" "[ ${item} ]"

		return 0
	fi

	if [ -e "${path_item_home}" ] || [ -L "${path_item_home}" ]
	then
		# add missing files to storage: stored files win

		if [ -d "${path_item_home}" ] && [ ! -L "${path_item_home}" ]
		then
			cp -a -n "${path_item_home}/." "${path_item_storage}/" 2> "${sink}"

		elif [ -f "${path_item_home}" ] && [ ! -L "${path_item_home}" ] && [ ! -e "${path_item_storage}" ]
		then
			cp -p "${path_item_home}" "${path_item_storage}"
		fi

		if [ ! -e "${path_item_storage}" ]
		then
			frobulator.err "Unable to merge into storage" "[ ${item} ]"

			return 1
		fi

		# move replaced item to trash

		gio trash "${path_item_home}"

		frobulator.fail "Unable to move to trash" "[ ${path_item_home} ]" || return

		frobulator.inf "Moved to trash" "[ ${path_item_home} ]"
	fi

	frobulator.link "${directory_storage}" "${HOME}" "${item}"
}

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(

)

frobulator.require ${list[@]}

list=()

# configuration ────────────────────────────────────────────────────────────────

if [ "${option}" = "install" ]
then
	claude_install

	frobulator.complete halt
fi

for item in "${list_items[@]}"
do
	claude_link "${item}"
done

frobulator.result "${script}"

frobulator.scs "Done"
