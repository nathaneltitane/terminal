#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

frobulator="${HOME}"/.local/bin/frobulator

# frobulator next to linked files

file_shell="$(readlink --canonicalize -- "${BASH_SOURCE[0]}")"

directory_shell="$(dirname -- "${file_shell}")"

if [ -f "${directory_shell}"/frobulator ]
then
	frobulator="${directory_shell}"/frobulator
fi

source "${frobulator}"

# superuser ────────────────────────────────────────────────────────────────────

# script ───────────────────────────────────────────────────────────────────────

# version ──────────────────────────────────────────────────────────────────────

version="2026-11-19"

# defaults ─────────────────────────────────────────────────────────────────────

self="${BASH_SOURCE[0]}"
value_install="install"
name_root="root"
name_termux="termux"
name_proot="proot"
file_completion_prefix="${PREFIX}/share/bash-completion/bash_completion"
file_completion_system="/usr/share/bash-completion/bash_completion"
file_completion_legacy="/etc/bash_completion"
directory_aliases="${HOME}/.bash-aliases"
file_aliases="${HOME}/.bash_aliases"
directory_functions="${HOME}/.bash-functions"
file_functions="${HOME}/.bash_functions"
file_login="${HOME}/.bash_login"
file_profile="${HOME}/.bash_profile"
format_color_foreground='\e[38;5;%sm'
sequence_color_reset='\e[39m'
prompt_wrap_start='\['
prompt_wrap_end='\]'
prompt_bracket_open="[ "
prompt_bracket_close=" ]"
prompt_symbol=" >_ "
prompt_marker_root="# "
prompt_marker_user='$ '

# usage ────────────────────────────────────────────────────────────────────────

# executed directly: install only

if [[ "${self}" = "${0}" ]]
then
	script="$(basename -- "${self}")"

	directory_install="${HOME}"/.local/bin

	while (( $# ))
	do
		case "${1}"
		in
			-i|--install)
				option="${value_install}"
			;;

			-h|--help)
				echo
				echo -e "Usage: ./${script} -i | -h"
				echo
				echo -e "Options:"
				echo
				echo -e "-i, --install    Run [i]nstallation of ${script} to ${directory_install}."
				echo
				echo -e "-h, --help       Show [h]elp and usage information."
				echo
				echo -e "'${script}'      [ Version // ${version} ]"
				echo

				exit
			;;

			"")
				# handle empty argument:
				# use default values specified in script

				:
			;;

			*)
				echo
				echo -e "Usage: ./${script} -i | -h"
				echo
				echo -e "Unknown option: '${script} ${1}':"
				echo -e "Type './${script} -h' for help and usage information."
				echo

				exit 1

			;;

			esac

		shift

	done

	# default to install

	if [ -z "${option}" ]
	then
		option="${value_install}"
	fi

	# install

	if [ "${option}" = "${value_install}" ]
	then
		# blank line - output separated from the shell prompt

		echo

		file_script="$(realpath "${self}")"

		directory_script="$(dirname "${file_script}")"

		if [ "${directory_script}" -ef "${directory_install}" ]
		then
			frobulator.inf "Already installed" "[ ${directory_install}/${script} ]"
		else
			frobulator.copy "${directory_script}" "${directory_install}" "${script}"

			frobulator.permissions public execute "${directory_install}/${script}"

			frobulator.scs "Installed" "[ ${directory_install}/${script} ]"
		fi
	fi

	exit
fi

# clear ────────────────────────────────────────────────────────────────────────

clear

# configuration ────────────────────────────────────────────────────────────────

if [ -n "${TERMUX_VERSION}" ]
then
	frobulator.fwd "Setting up..."
fi

# session ──────────────────────────────────────────────────────────────────────

if [ -z "${PS1}" ]
then
	return
fi

# options ──────────────────────────────────────────────────────────────────────

shopt -s cdspell
shopt -s checkwinsize
shopt -s dirspell
shopt -s histappend
shopt -s histverify

HISTCONTROL=ignoreboth
HISTSIZE=1000
HISTFILESIZE=2000

# completion ───────────────────────────────────────────────────────────────────

# posix mode check: status 0 in posix mode - completion is not loaded there

shopt -oq posix

status_shell_posix="${?}"

if [ "${status_shell_posix}" -ne 0 ]
then
	if [ -f "${file_completion_prefix}" ]
	then
		. "${file_completion_prefix}"

	elif [ -f "${file_completion_system}" ]
	then
		. "${file_completion_system}"

	elif [ -f "${file_completion_legacy}" ]
	then
		. "${file_completion_legacy}"
	fi
fi

unset status_shell_posix

# upper and lower case alike

bind 'set completion-ignore-case on'

# user  ────────────────────────────────────────────────────────────────────────

if [ -n "${TERMUX_VERSION}" ]
then
	if [ -z "${USER}" ]
	then
		USER="${name_termux}"
	fi
fi

# colors ───────────────────────────────────────────────────────────────────────

colors_selection=(
	white="255"
	silver="248"
	grey="243"
	black="238"

	red="1"
	crimson="88"

	green="2"
	lime="28"

	yellow="11"
	orange="202"

	blue="4"
	navy="26"

	magenta="5"
	purple="53"

	fuschia="126"
	pink="200"

	aqua="6"
	teal="30"
)

# 'tput' path - empty if not installed

command_tput="$(command -v tput)"

if [ -z "${command_tput}" ]
then
	# handle color digit length for ansi fallback method

	for color in ${colors_selection[@]}
	do
		# name and code - split on the equal sign for this read only

		IFS='=' read -r name_color value_color <<< "${color}"

		if [ ${#value_color} = 3 ]
		then
			value_color="${value_color}"
		fi

		if [ ${#value_color} = 2 ]
		then
			value_color="0${value_color}"
		fi

		if [ ${#value_color} = 1 ]
		then
			value_color="00${value_color}"
		fi

		eval "${name_color}=${value_color}"

		unset color
	done

	# ansi color attributes

	if [ -t 1 ]
	then
		# monochromatic colors

		printf -v white "${format_color_foreground}" "${white}"
		printf -v silver "${format_color_foreground}" "${silver}"
		printf -v grey "${format_color_foreground}" "${grey}"
		printf -v black "${format_color_foreground}" "${black}"

		# standard colors by saturation offset

		printf -v red "${format_color_foreground}" "${red}"
		printf -v crimson "${format_color_foreground}" "${crimson}"

		printf -v green "${format_color_foreground}" "${green}"
		printf -v lime "${format_color_foreground}" "${lime}"

		printf -v yellow "${format_color_foreground}" "${yellow}"
		printf -v orange "${format_color_foreground}" "${orange}"

		printf -v blue "${format_color_foreground}" "${blue}"
		printf -v navy "${format_color_foreground}" "${navy}"

		printf -v magenta "${format_color_foreground}" "${magenta}"
		printf -v purple "${format_color_foreground}" "${purple}"

		printf -v aqua "${format_color_foreground}" "${aqua}"
		printf -v teal "${format_color_foreground}" "${teal}"

		# reset all attributes

		printf -v reset "${sequence_color_reset}"
	fi
else
	# handle color selections

	for color in ${colors_selection[@]}
	do
		# name and code - split on the equal sign for this read only

		IFS='=' read -r name_color value_color <<< "${color}"

		eval "${name_color}=${value_color}"

		unset color
	done

	# 'tput' colors and attributes

	if [ -t 1 ]
	then
		# monochromatic colors

		white=$(tput setaf "${white}")
		silver=$(tput setaf "${silver}")
		grey=$(tput setaf "${grey}")
		black=$(tput setaf "${black}")

		# standard colors by saturation offset

		red=$(tput setaf "${red}")
		crimson=$(tput setaf "${crimson}")

		green=$(tput setaf "${green}")
		lime=$(tput setaf "${lime}")

		yellow=$(tput setaf "${yellow}")
		orange=$(tput setaf "${orange}")

		blue=$(tput setaf "${blue}")
		navy=$(tput setaf "${navy}")

		magenta=$(tput setaf "${magenta}")
		purple=$(tput setaf "${purple}")

		fuschia=$(tput setaf "${fuschia}")
		pink=$(tput setaf "${pink}")

		aqua=$(tput setaf "${aqua}")
		teal=$(tput setaf "${teal}")

		# reset all attributes

		reset=$(tput sgr 0)
	fi
fi

unset command_tput

# prompt ───────────────────────────────────────────────────────────────────────

unset PS1

# logged in user name and running proot container process ids - empty outside one

name_user="$(id --user --name)"
id_process_proot="$(pidof "${name_proot}")"

if [ "${name_user}" = "${name_root}" ]
then
	color_prompt="${red}"

elif [ -n "${id_process_proot}" ]
then
	color_prompt="${magenta}"

else
	color_prompt="${green}"
fi

PS1+="${prompt_wrap_start}${reset}${prompt_wrap_end}${prompt_bracket_open}"
PS1+="${prompt_wrap_start}${color_prompt}${prompt_wrap_end}${USER}"
PS1+="${prompt_wrap_start}${reset}${prompt_wrap_end}${prompt_bracket_close}"

if [ "${name_user}" = "${name_root}" ]
then
	PS1+="${prompt_wrap_start}${white}${prompt_wrap_end}${prompt_symbol}${prompt_marker_root}${prompt_wrap_start}${reset}${prompt_wrap_end}"
else
	PS1+="${prompt_wrap_start}${white}${prompt_wrap_end}${prompt_symbol}${prompt_marker_user}${prompt_wrap_start}${reset}${prompt_wrap_end}"
fi

unset name_user

unset color_prompt

unset prompt_wrap_start prompt_wrap_end prompt_bracket_open prompt_bracket_close prompt_symbol prompt_marker_root prompt_marker_user

# path ─────────────────────────────────────────────────────────────────────────

PATH=""

list_path_container=(
	/usr/local/sbin
	/usr/local/bin
	/usr/sbin
	/usr/bin
	/sbin
	/bin
)

list_path_termux=(
	"${HOME}/.local/sbin"
	"${HOME}/.local/bin"
	"${HOME}/.sbin"
	"${HOME}/.bin"
)

list_path_prefix=(
	"${PREFIX}/sbin"
	"${PREFIX}/bin"
)

list_path_android=(
	/system/sbin
	/system/bin
)

# container

for directory_path in "${list_path_container[@]}"
do
	if [ -d "${directory_path}" ]
	then
		PATH+="${directory_path}:"
	fi
done

# termux

for directory_path in "${list_path_termux[@]}"
do
	if [ -d "${directory_path}" ]
	then
		PATH+="${directory_path}:"
	fi
done

# linked files directory for root shells

if [ "${directory_shell}" != "${HOME}/.local/bin" ]
then
	PATH+="${directory_shell}:"
fi

# termux prefix

if [ -n "${PREFIX}" ]
then
	for directory_path in "${list_path_prefix[@]}"
	do
		if [ -d "${directory_path}" ]
		then
			PATH+="${directory_path}:"
		fi
	done
fi

# android

for directory_path in "${list_path_android[@]}"
do
	if [ -d "${directory_path}" ]
	then
		PATH+="${directory_path}:"
	fi
done

unset directory_path

unset list_path_container
unset list_path_termux
unset list_path_prefix
unset list_path_android

PATH="${PATH}"

# aliases ──────────────────────────────────────────────────────────────────────

if [ -d "${directory_aliases}" ]
then
	for alias in "${directory_aliases}"/*
	do
		if [ -x "${alias}" ]
		then
			. "${alias}"
		fi
	done
fi

if [ -f "${file_aliases}" ]
then
	. "${file_aliases}"
fi

# functions ────────────────────────────────────────────────────────────────────

if [ -d "${directory_functions}" ]
then
	for function in "${directory_functions}"/*
	do
		if [ -x "${function}" ]
		then
			. "${function}"
		fi
	done
fi

if [ -f "${file_functions}" ]
then
	. "${file_functions}"
fi

# login ────────────────────────────────────────────────────────────────────────

if [ -f "${file_login}" ]
then
	. "${file_login}"
fi

# profile ──────────────────────────────────────────────────────────────────────

# proot container processes matching by command line - empty outside a container

id_process_proot="$(pgrep -f "${name_proot}")"

if [ -n "${id_process_proot}" ]
then
	if [ -f "${file_profile}" ]
	then
		. "${file_profile}"
	fi
fi

unset id_process_proot
