#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

frobulator="${HOME}"/.local/bin/frobulator

source "${frobulator}"

# superuser ────────────────────────────────────────────────────────────────────

# script ───────────────────────────────────────────────────────────────────────

# version ──────────────────────────────────────────────────────────────────────

version="2026-09-20"

# defaults ─────────────────────────────────────────────────────────────────────

self="${BASH_SOURCE[0]}"

# usage ────────────────────────────────────────────────────────────────────────

# executed directly: install only

if [[ "${self}" = "${0}" ]]
then
	script="$(basename -- "${self}")"

	directory_install="${HOME}"/.local/bin

	while (( $# ))
	do
		case "${1}"
		in
			-i|--install)
				option="install"
			;;

			-h|--help)
				echo
				echo -e "Usage: ./${script} -i | -h"
				echo
				echo -e "Options:"
				echo
				echo -e "-i, --install    Run [i]nstallation of ${script} to ${directory_install}."
				echo
				echo -e "-h, --help       Show [h]elp and usage information."
				echo
				echo -e "'${script}'      [ Version // ${version} ]"
				echo

				exit
			;;

			"")
				# handle empty argument:
				# use default values specified in script

				:
			;;

			*)
				echo
				echo -e "Usage: ./${script} -i | -h"
				echo
				echo -e "Unknown option: '${script} ${1}':"
				echo -e "Type './${script} -h' for help and usage information."
				echo

				exit 1

			;;

			esac

		shift

	done

	# default to install

	if [ -z "${option}" ]
	then
		option="install"
	fi

	# install

	if [ "${option}" = "install" ]
	then
		# blank line - output separated from the shell prompt

		echo

		file_script="$(realpath "${self}")"

		directory_script="$(dirname "${file_script}")"

		if [ "${directory_script}" -ef "${directory_install}" ]
		then
			frobulator.inf "Already installed" "[ ${directory_install}/${script} ]"
		else
			frobulator.copy "${directory_script}" "${directory_install}" "${script}"

			frobulator.permissions public execute "${directory_install}/${script}"

			frobulator.scs "Installed" "[ ${directory_install}/${script} ]"
		fi
	fi

	exit
fi

# clear ────────────────────────────────────────────────────────────────────────

clear

# configuration ────────────────────────────────────────────────────────────────

if [ -n "${TERMUX_VERSION}" ]
then
	frobulator.fwd "Setting up..."
fi

# session ──────────────────────────────────────────────────────────────────────

if [ -z "${PS1}" ]
then
	return
fi

# options ──────────────────────────────────────────────────────────────────────

shopt -s checkwinsize
shopt -s histappend
shopt -s histverify

HISTCONTROL=ignoreboth
HISTSIZE=1000
HISTFILESIZE=2000

# completion ───────────────────────────────────────────────────────────────────

# posix mode check: status 0 in posix mode - completion is not loaded there

shopt -oq posix

status_shell_posix="${?}"

if [ "${status_shell_posix}" -ne 0 ]
then
	if [ -f "${PREFIX}"/share/bash-completion/bash_completion ]
	then
		. "${PREFIX}"/share/bash-completion/bash_completion

	elif [ -f /usr/share/bash-completion/bash_completion ]
	then
		. /usr/share/bash-completion/bash_completion

	elif [ -f /etc/bash_completion ]
	then
		. /etc/bash_completion
	fi
fi

unset status_shell_posix

# user  ────────────────────────────────────────────────────────────────────────

if [ -n "${TERMUX_VERSION}" ]
then
	if [ -z "${USER}" ]
	then
		USER="termux"
	fi
fi

# colors ───────────────────────────────────────────────────────────────────────

colors_selection=(
	white="255"
	silver="248"
	grey="243"
	black="238"

	red="1"
	crimson="88"

	green="2"
	lime="28"

	yellow="11"
	orange="202"

	blue="4"
	navy="26"

	magenta="5"
	purple="53"

	fuschia="126"
	pink="200"

	aqua="6"
	teal="30"
)

# 'tput' path - empty if not installed

command_tput="$(command -v tput)"

if [ -z "${command_tput}" ]
then
	# handle color digit length for ansi fallback method

	for color in ${colors_selection[@]}
	do
		IFS='='

		read name_color value_color <<< "${color}"

		if [ ${#value_color} = 3 ]
		then
			value_color="${value_color}"
		fi

		if [ ${#value_color} = 2 ]
		then
			value_color="0${value_color}"
		fi

		if [ ${#value_color} = 1 ]
		then
			value_color="00${value_color}"
		fi

		IFS=''

		eval "${name_color}=${value_color}"

		unset color
	done

	# ansi color attributes

	if [[ -t 1 ]]
	then
		# monochromatic colors

		white=$(echo -e \\e\[38\;5\;"${white}"m)
		silver=$(echo -e \\e\[38\;5\;"${silver}"m)
		grey=$(echo -e \\e\[38\;5\;"${grey}"m)
		black=$(echo -e \\e\[38\;5\;"${black}"m)

		# standard colors by saturation offset

		red=$(echo -e \\e\[38\;5\;"${red}"m)
		crimson=$(echo -e \\e\[38\;5\;"${crimson}"m)

		green=$(echo -e \\e\[38\;5\;"${green}"m)
		lime=$(echo -e \\e\[38\;5\;"${lime}"m)

		yellow=$(echo -e \\e\[38\;5\;"${yellow}"m)
		orange=$(echo -e \\e\[38\;5\;"${orange}"m)

		blue=$(echo -e \\e\[38\;5\;"${blue}"m)
		navy=$(echo -e \\e\[38\;5\;"${navy}"m)

		magenta=$(echo -e \\e\[38\;5\;"${magenta}"m)
		purple=$(echo -e \\e\[38\;5\;"${purple}"m)

		aqua=$(echo -e \\e\[38\;5\;"${aqua}"m)
		teal=$(echo -e \\e\[38\;5\;"${teal}"m)

		# reset all attributes

		reset=$(echo -e \\e\[39m)
	fi
else
	# handle color selections

	for color in ${colors_selection[@]}
	do
		IFS='='

		read name_color value_color <<< "${color}"

		IFS=''

		eval "${name_color}=${value_color}"

		unset color
	done

	# 'tput' colors and attributes

	if [[ -t 1 ]]
	then
		# monochromatic colors

		white=$(tput setaf "${white}")
		silver=$(tput setaf "${silver}")
		grey=$(tput setaf "${grey}")
		black=$(tput setaf "${black}")

		# standard colors by saturation offset

		red=$(tput setaf "${red}")
		crimson=$(tput setaf "${crimson}")

		green=$(tput setaf "${green}")
		lime=$(tput setaf "${lime}")

		yellow=$(tput setaf "${yellow}")
		orange=$(tput setaf "${orange}")

		blue=$(tput setaf "${blue}")
		navy=$(tput setaf "${navy}")

		magenta=$(tput setaf "${magenta}")
		purple=$(tput setaf "${purple}")

		fuschia=$(tput setaf "${fuschia}")
		pink=$(tput setaf "${pink}")

		aqua=$(tput setaf "${aqua}")
		teal=$(tput setaf "${teal}")

		# reset all attributes

		reset=$(tput sgr 0)
	fi
fi

unset command_tput

# prompt ───────────────────────────────────────────────────────────────────────

unset PS1

# logged in user name and running proot container process ids - empty outside one

name_user="$(id -u -n)"
id_process_proot="$(pidof proot)"

if [ "${name_user}" = "root" ]
then
	color_prompt="${red}"

elif [ -n "${id_process_proot}" ]
then
	color_prompt="${magenta}"

else
	color_prompt="${green}"
fi

PS1+="\[""${reset}""\][ "
PS1+="\[""${color_prompt}""\]${USER}"
PS1+="\[""${reset}""\] ]"

if [ "${name_user}" = "root" ]
then
	PS1+="\[""${white}""\] >_ # \[""${reset}""\]"
else
	PS1+="\[""${white}""\] >_ \$ \[""${reset}""\]"
fi

unset name_user

unset color_prompt

# path ─────────────────────────────────────────────────────────────────────────

PATH=""

# container

[ -d /usr/local/sbin ]       && PATH+="/usr/local/sbin:"
[ -d /usr/local/bin ]        && PATH+="/usr/local/bin:"
[ -d /usr/sbin ]             && PATH+="/usr/sbin:"
[ -d /usr/bin ]              && PATH+="/usr/bin:"
[ -d /sbin ]                 && PATH+="/sbin:"
[ -d /bin ]                  && PATH+="/bin:"

# termux

[ -d "${HOME}"/.local/sbin ] && PATH+="${HOME}/.local/sbin:"
[ -d "${HOME}"/.local/bin ]  && PATH+="${HOME}/.local/bin:"
[ -d "${HOME}"/.sbin ]       && PATH+="${HOME}/.sbin:"
[ -d "${HOME}"/.bin ]        && PATH+="${HOME}/.bin:"

[ -d "${PREFIX}"/sbin ]      && PATH+="${PREFIX}/sbin:"
[ -d "${PREFIX}"/bin ]       && PATH+="${PREFIX}/bin:"

# android

[ -d /system/sbin ]          && PATH+="/system/sbin:"
[ -d /system/bin ]           && PATH+="/system/bin:"

PATH="${PATH}"

# aliases ──────────────────────────────────────────────────────────────────────

if [ -d "${HOME}"/.bash-aliases ]
then
	for alias in "${HOME}"/.bash-aliases/*
	do
		if [ -x "${alias}" ]
		then
			. "${alias}"
		fi
	done
fi

if [ -f "${HOME}"/.bash_aliases ]
then
	. "${HOME}"/.bash_aliases
fi

# functions ────────────────────────────────────────────────────────────────────

if [ -d "${HOME}"/.bash-functions ]
then
	for function in "${HOME}"/.bash-functions/*
	do
		if [ -x "${function}" ]
		then
			. "${function}"
		fi
	done
fi

if [ -f "${HOME}"/.bash_functions ]
then
	. "${HOME}"/.bash_functions
fi

# login ────────────────────────────────────────────────────────────────────────

if [ -f "${HOME}"/.bash_login ]
then
	. "${HOME}"/.bash_login
fi

# profile ──────────────────────────────────────────────────────────────────────

# proot container processes matching by command line - empty outside a container

id_process_proot="$(pgrep -f proot)"

if [ -n "${id_process_proot}" ]
then
	if [ -f "${HOME}"/.bash_profile ]
	then
		. "${HOME}"/.bash_profile
	fi
fi

unset id_process_proot
