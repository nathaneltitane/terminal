#!/bin/bash

# dependencies /////////////////////////////////////////////////////////////////

if [[ $(id -u -n) = "root" ]]
then
	SUDO_HOME=/root

	USER="${SUDO_USER:-root}"

	if [ "${USER}" = "root" ]
	then
		HOME=/root
	else
		HOME="/home/${USER}"
	fi
fi

echo

for ticker in '>  ' '>> ' '>>>'
do
	echo -n -e "\r[  ${arrow_state}  ] Checking..."

	sleep 0.5
done

echo

if [[ -z $(command -v curl) ]]
then
	if [[ -n $(command -v apt-get) ]]
	then
		apt-get -q -q update > /dev/null 2>&1
		apt-get -q -q install -y curl > /dev/null 2>&1

	elif [[ -n $(command -v dnf) ]]
	then
		dnf -q install -y curl > /dev/null 2>&1

	elif [[ -n $(command -v yum) ]]
	then
		yum -q install -y curl > /dev/null 2>&1

	elif [[ -n $(command -v apk) ]]
	then
		apk add --quiet curl > /dev/null 2>&1

	elif [[ -n $(command -v pacman) ]]
	then
		pacman -S -y --noconfirm --noprogressbar curl > /dev/null 2>&1

	elif [[ -n $(command -v zypper) ]]
	then
		zypper --quiet --non-interactive install curl > /dev/null 2>&1
	fi
fi

if [[ -z $(command -v curl) ]]
then
	echo "[  !  ] Unable to install or binary not found /////////////////////// [ 'curl' ]"
	echo

	exit 1
fi

mkdir -p "${HOME}"/.local/bin

frobulator="${HOME}"/.local/bin/frobulator

version_online=$(	curl -s -L get.frbltr.app | grep -m 1 '^# version=' | cut -d '"' -f 2)

version_local=$(grep -m 1 '^# version=' "${frobulator}" 2>/dev/null | cut -d '"' -f 2)

version_local="${version_local:-01-01-1970}"

date_online="${version_online:6:4}${version_online:0:2}${version_online:3:2}"

date_local="${version_local:6:4}${version_local:0:2}${version_local:3:2}"

if [ ! -f "${frobulator}" ] || [[ "${date_online}" > "${date_local}" ]]
then
	curl -s -L get.frbltr.app > "${frobulator}"

	chmod +x "${frobulator}"
fi

for ticker in '>  ' '>> ' '>>>'
do
	echo -n -e "\r[  ${arrow_state}  ] Initializing..."

	sleep 0.5
done

echo

source "${frobulator}"

# superuser ////////////////////////////////////////////////////////////////////

export self_arguments="${@}"

# frobulator.escalate

# script ///////////////////////////////////////////////////////////////////////

script="$(basename -- ${BASH_SOURCE[0]})"

# version //////////////////////////////////////////////////////////////////////

version="07-13-2026"

# usage ////////////////////////////////////////////////////////////////////////

# prompt ///////////////////////////////////////////////////////////////////////

frobulator.script "Setting up ${script#*-}"

# variables ////////////////////////////////////////////////////////////////////

# defaults /////////////////////////////////////////////////////////////////////

# functions ////////////////////////////////////////////////////////////////////

# update ///////////////////////////////////////////////////////////////////////

# frobulator.update

# frobulator.upgrade

# requirements /////////////////////////////////////////////////////////////////

list=(

)

frobulator.require ${list[@]}

list=()

# configuration ////////////////////////////////////////////////////////////////

# user

deluser --remove-home ubuntu
groupdel -f ubuntu

chpasswd <<< root:09018610

# hostname

echo pi > /etc/hostname

hostnamectl set-hostname pi

# ssh

cat << 'FILE' > /boot/firmware/ssh
FILE

# network

cat << 'FILE' > /etc/netplan/01-wlan0-config.yaml
network:
    version: 2

    ethernets:
      eth0:
        dhcp4: no
        dhcp6: no

    wifis:
      wlan0:
        dhcp4: no
        dhcp6: no

        addresses:
          - 192.168.86.21/24

        nameservers:
          addresses:
            - 8.8.8.8
            - 1.1.1.1

        routes:
            - to: default
              via: 192.168.86.1

        access-points:
          "WiFi":
            password: "y5cE?z>6&juDEm"
FILE

netplan generate
netplan apply

# configuration

cat << 'FILE' > /boot/firmware/config.txt
[pi4]
max_framebuffers=2

[all]
arm_64bit=1
disable_splash=1
kernel=vmlinuz
cmdline=cmdline.txt
initramfs initrd.img followkernel
loglevel=1
dtoverlay=vc4-kms-v3d,noaudio
dtparam=audio=on
dtparam=i2c_arm=on
dtparam=spi=on
enable_uart=1

disable_overscan=1
hdmi_force_hotplug=1

over_voltage=8
arm_freq=2000
FILE

# packages

apt --assume-yes update
apt --assume-yes purge snap thin-provisioning-tools
apt --assume-yes upgrade

# restart

reboot
