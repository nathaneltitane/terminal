	fi

	# ethernet gadget loaded at boot - fixed addresses - the computer sees the same network card every time
	# locally administered addresses - first byte 02

	count_gadget="$(grep --count "${parameter_gadget_modules}" "${directory_mount_boot}/${file_boot_command}")"

	if [ "${count_gadget}" -eq 0 ]
	then
