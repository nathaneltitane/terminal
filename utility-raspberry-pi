#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-11"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-d|--device)
			device="${2}"

			shift
		;;

		-u|--power-supply)
			option_power_supply="${2}"

			shift
		;;

		-g|--usb-gadget)
			option_usb_gadget="true"
		;;

		-b|--boost)
			option_boost="${2}"

			shift
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -d [Device] [-u Power supply] [-g] [-b Level] | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-d, --device          Specify target block [d]evice to write the image to."
			echo
			echo -e "                      [ /dev/sdX ]"
			echo -e "                      [ /dev/mmcblkX ]"
			echo
			echo -e "-u, --power-supply    Add [u]ninterruptible power supply support."
			echo
			echo -e "                      ep-0136    GeeekPi UPS Plus - safe shutdown on low battery."
			echo
			echo -e "-g, --usb-gadget      Network and power over the usb-c port - usb [g]adget mode."
			echo
			echo -e "                      Not while a ups is fitted - the usb-c port must stay unplugged."
			echo
			echo -e "-b, --boost           [B]oost the processor - raspberry pi 4 - cooling needed."
			echo
			echo -e "                      1    1.9 GHz - voltage +0.05 V - graphics 500 MHz."
			echo -e "                      2    2.0 GHz - voltage +0.15 V - graphics 600 MHz."
			echo -e "                      3    2.1 GHz - voltage +0.20 V - graphics 700 MHz - not every board."
			echo -e "                      4    2.2 GHz - voltage +0.20 V - graphics 750 MHz - not every board."
			echo
			echo -e "-h, --help            Show [h]elp and usage information."
			echo
			echo -e "'${script}'           [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -d [Device] [-u Power supply] [-g] [-b Level] | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

url_image_latest="https://downloads.raspberrypi.com/raspios_lite_arm64_latest"
suffix_checksum=".sha256"
separator_checksum=" "
format_url_effective='%{url_effective}'

directory_download="${HOME}/.cache/raspberry-pi"

file_archive_image="${directory_download}/raspios_lite_arm64.img.xz"

directory_mount_boot="/mnt/raspberry-pi-boot"

directory_zoneinfo="/usr/share/zoneinfo"

file_user_data="user-data"
file_network_config="network-config"
file_ssh_marker="ssh"
file_boot_config="config.txt"
file_boot_command="cmdline.txt"
directory_power_supply="power-supply"
file_monitor="ups-plus-monitor"
file_monitor_service="${file_monitor}.service"
file_monitor_timer="${file_monitor}.timer"

model_ups="ep-0136"

package_curl="curl"
package_xz="xz-utils"
package_parted="parted"
package_util_linux="util-linux"
package_e2fsprogs="e2fsprogs"
package_dosfstools="dosfstools"
package_openssl="openssl"
package_xdg="xdg-user-dirs"
package_i2c="i2c-tools"

key_hostname="hostname"
key_username="username"
key_password_user="user_password"
key_ssid_wifi="wifi_ssid"
key_password_wifi="wifi_password"
key_country_wifi="wifi_country"
key_timezone="timezone"
separator_entry="="
name_user_forbidden="root"

pattern_hostname='^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$'
pattern_username='^[a-z][a-z0-9-]{0,31}$'
pattern_country='^[A-Z]{2}$'
pattern_timezone='^[A-Za-z_]+(/[A-Za-z0-9_+-]+)*$'
length_password_minimum="8"
length_password_maximum="63"

columns_device_list="NAME,SIZE,MODEL,TRAN,TYPE"
columns_device_detail="NAME,SIZE,MODEL,TRAN"
pattern_header_device="NAME"
pattern_type_device="disk"

size_block="4M"
flag_input="fullblock"
conversion_write="fsync"
status_write="progress"
flag_output="direct"
delay_settle="2"

pattern_device_prefixed="(mmcblk|nvme)"
letter_partition="p"
number_partition_boot="1"
number_partition_root="2"

line_i2c="dtparam=i2c_arm=on"
pattern_i2c_commented="^#${line_i2c}"
pattern_i2c_enabled="^${line_i2c}"
line_rtc="dtoverlay=i2c-rtc,ds1307"
pattern_rtc="^${line_rtc}"
line_dwc2="dtoverlay=dwc2"
pattern_dwc2="^${line_dwc2}$"
parameter_gadget_modules="modules-load=dwc2,g_ether"
parameter_address_device="g_ether.dev_addr"
parameter_address_host="g_ether.host_addr"
format_address_mac='02:%02x:%02x:%02x:%02x:%02x'
count_bytes_address="5"
count_byte_values="256"

pattern_boost="^arm_freq="
section_boost="[pi4]"
section_all="[all]"
level_boost_one="1"
level_boost_two="2"
level_boost_three="3"
level_boost_four="4"
text_boost_levels=" ${level_boost_one} ${level_boost_two} ${level_boost_three} ${level_boost_four} "

# boost table - processor MHz - over_voltage steps - graphics MHz

list_boost_one=(
	1900
	2
	500
)

list_boost_two=(
	2000
	6
	600
)

list_boost_three=(
	2100
	8
	700
)

list_boost_four=(
	2200
	8
	750
)

# defaults ─────────────────────────────────────────────────────────────────────

name_host_default="pi"
name_user_default="${USER}"
country_wifi_default="US"
zone_time_default="America/Toronto"

if [ -z "${device}" ]
then
	frobulator.err "No target device specified"

	frobulator.inf "Available block devices"

	lsblk --nodeps --output "${columns_device_list}" | grep --regexp="${pattern_type_device}" --regexp="${pattern_header_device}"
	echo

	echo "Usage: ${script} -d [Device]"
	echo

	exit 1
fi

if [ ! -b "${device}" ]
then
	frobulator.err "Not a block device" "[ '${device}' ]"

	exit 1
fi

# power supply - supported models only

if [[ "${option_power_supply}" = -* ]]
then
	frobulator.err "Missing argument for '--power-supply'."

	exit 1

elif [ -n "${option_power_supply}" ] && [ "${option_power_supply}" != "${model_ups}" ]
then
	frobulator.err "Unknown power supply" "[ ${option_power_supply} ]"

	exit 1
fi

# boost - supported levels only

if [[ "${option_boost}" = -* ]]
then
	frobulator.err "Missing argument for '--boost'."

	exit 1

elif [ -n "${option_boost}" ] && [[ ! "${text_boost_levels}" = *" ${option_boost} "* ]]
then
	frobulator.err "Unknown boost level - 1 to 4" "[ ${option_boost} ]"

	exit 1
fi

# usb gadget with a ups - allowed - the usb-c port must stay unplugged while the ups is fitted

if [ "${option_usb_gadget}" = "true" ] && [ -n "${option_power_supply}" ]
then
	frobulator.wrn "USB gadget mode with a ups" "[ keep the usb-c port unplugged while the ups is fitted ]"
fi

# functions ────────────────────────────────────────────────────────────────────

address_generate () {

	# random locally administered address

	local index_byte
	local value_byte

	local -a list_bytes=()

	for (( index_byte = 0 ; index_byte < count_bytes_address ; index_byte ++ ))
	do
		value_byte=$(( RANDOM % count_byte_values ))

		list_bytes+=("${value_byte}")
	done

	printf "${format_address_mac}" "${list_bytes[@]}"
}

# requirements ─────────────────────────────────────────────────────────────────

list=(
	"${package_curl}"
	"${package_xz}"
	"${package_parted}"
	"${package_util_linux}"
	"${package_e2fsprogs}"
	"${package_dosfstools}"
	"${package_openssl}"
)

frobulator.require ${list[@]}

list=()

# credentials

# prompt for and validate values required for headless setup

frobulator.inf "Headless configuration"

list_credentials=(
	"${key_hostname}"
	"${key_username}"
	"${key_password_user}"
	"${key_ssid_wifi}"
	"${key_password_wifi}"
	"${key_country_wifi}"
	"${key_timezone}"
)

frobulator.input "${list_credentials[@]}"

for entry in "${frobulator_return[@]}"
do
	IFS="${separator_entry}" read -r key_entry value_entry <<< "${entry}"

	if [ "${key_entry}" = "${key_hostname}" ]
	then
		name_host="${value_entry:-${name_host_default}}"
	fi

	if [ "${key_entry}" = "${key_username}" ]
	then
		name_user="${value_entry:-${name_user_default}}"
	fi

	if [ "${key_entry}" = "${key_password_user}" ]
	then
		password_user="${value_entry}"
	fi

	if [ "${key_entry}" = "${key_ssid_wifi}" ]
	then
		ssid_wifi="${value_entry}"
	fi

	if [ "${key_entry}" = "${key_password_wifi}" ]
	then
		password_wifi="${value_entry}"
	fi

	if [ "${key_entry}" = "${key_country_wifi}" ]
	then
		country_wifi="${value_entry:-${country_wifi_default}}"
	fi

	if [ "${key_entry}" = "${key_timezone}" ]
	then
		zone_time="${value_entry:-${zone_time_default}}"
	fi

done

list_credentials_missing=()

if [ -z "${name_user}" ]
then
	list_credentials_missing+=("${key_username}")
fi

if [ -z "${password_user}" ]
then
	list_credentials_missing+=("${key_password_user}")
fi

if [ -z "${ssid_wifi}" ]
then
	list_credentials_missing+=("${key_ssid_wifi}")
fi

if [ -z "${password_wifi}" ]
then
	list_credentials_missing+=("${key_password_wifi}")
fi

if [ "${#list_credentials_missing[@]}" -gt 0 ]
then
	frobulator.err "Missing required credential(s)" "[ ${list_credentials_missing[*]} ]"

	exit 1
fi

name_host="${name_host:-${name_host_default}}"

# wifi country - two letter code - radio blocked until set

country_wifi="${country_wifi:-${country_wifi_default}}"
country_wifi="${country_wifi^^}"

# timezone - region/city name - as listed under /usr/share/zoneinfo

zone_time="${zone_time:-${zone_time_default}}"

# values checked before anything is written - same rules as the first boot user setup

if [[ ! "${name_host}" =~ ${pattern_hostname} ]]
then
	frobulator.err "Invalid hostname - letters, digits and hyphens" "[ ${name_host} ]"

	exit 1
fi

if [[ ! "${name_user}" =~ ${pattern_username} ]] || [ "${name_user}" = "${name_user_forbidden}" ]
then
	frobulator.err "Invalid username - lower-case letters, digits and hyphens - starting with a letter" "[ ${name_user} ]"

	exit 1
fi

if [[ ! "${country_wifi}" =~ ${pattern_country} ]]
then
	frobulator.err "Invalid wifi country - two letter code" "[ ${country_wifi} ]"

	exit 1
fi

if [[ ! "${zone_time}" =~ ${pattern_timezone} ]] || [ ! -f "${directory_zoneinfo}/${zone_time}" ]
then
	frobulator.err "Invalid timezone - region/city" "[ ${zone_time} ]"

	exit 1
fi

if [ "${#password_wifi}" -lt "${length_password_minimum}" ] || [ "${#password_wifi}" -gt "${length_password_maximum}" ]
then
	frobulator.err "Invalid wifi password - 8 to 63 characters" "[ ${#password_wifi} ]"

	exit 1
fi

# download

# resolve and fetch latest image, verified against its published checksum

frobulator.directory "${directory_download}"

url_install=$(curl --silent --head --location --output "${sink}" --write-out "${format_url_effective}" "${url_image_latest}")

frobulator.inf "Resolved image" "[ ${url_install} ]"

checksum_expected=$(curl --silent --location "${url_install}${suffix_checksum}" | cut --delimiter="${separator_checksum}" --fields=1)

# checksum of the image already downloaded - empty if there is none

checksum_existing="$(sha256sum "${file_archive_image}" 2> "${sink}" | cut --delimiter="${separator_checksum}" --fields=1)"

if [ ! -f "${file_archive_image}" ] || [ "${checksum_existing}" != "${checksum_expected}" ]
then
	frobulator.background download "[ ${url_install} ]" -- curl --location --output "${file_archive_image}" "${url_install}"

	checksum_actual=$(sha256sum "${file_archive_image}" | cut --delimiter="${separator_checksum}" --fields=1)

	if [ -n "${checksum_expected}" ] && [ "${checksum_actual}" != "${checksum_expected}" ]
	then
		frobulator.err "Checksum verification failed"

		rm --force "${file_archive_image}"

		exit 1
	fi

	frobulator.scs "Checksum verified"
else
	frobulator.wrn "Already downloaded and verified"
fi

# confirmation

# require device path to be retyped before any destructive action

details_device="$(lsblk --nodeps --output "${columns_device_detail}" "${device}" | tail --lines=1)"

frobulator.ntf err "Destructive operation" err "This will PERMANENTLY ERASE all data on '${device}'.${NLN}${NLN}${details_device}"

frobulator.qst "Type the device path exactly to confirm" "[ ${device} ]"

read -r reply_device_confirm

if [ "${reply_device_confirm}" != "${device}" ]
then
	frobulator.err "Confirmation did not match - aborting"

	exit 1
fi

# unmount

# clear any partitions already mounted from target device

for partition in "${device}"*
do
	if [ "${partition}" != "${device}" ]
	then
		umount "${partition}" 2> "${sink}"
	fi
done

# write

# decompress and write image directly to device

frobulator.inf "Writing image" "[ ${device} ]"

xz --decompress --stdout "${file_archive_image}" | dd of="${device}" bs="${size_block}" iflag="${flag_input}" conv="${conversion_write}" status="${status_write}" oflag="${flag_output}"

# exit status of both sides of the pipe - read before any other command

list_status_write=("${PIPESTATUS[@]}")

if [ "${list_status_write[0]}" -ne 0 ] || [ "${list_status_write[1]}" -ne 0 ]
then
	frobulator.err "Image write failed" "[ xz // ${list_status_write[0]} ] [ dd // ${list_status_write[1]} ]"

	exit 1
fi

sync

partprobe "${device}" 2> "${sink}"

udevadm settle

sleep "${delay_settle}"

# partition naming

# resolve partition suffixes, which differ between /dev/sdX and mmcblk/nvme devices

if [[ "${device}" =~ ${pattern_device_prefixed} ]]
then
	path_partition_boot="${device}${letter_partition}${number_partition_boot}"
	path_partition_root="${device}${letter_partition}${number_partition_root}"
else
	path_partition_boot="${device}${number_partition_boot}"
	path_partition_root="${device}${number_partition_root}"
fi

if [ ! -b "${path_partition_boot}" ] || [ ! -b "${path_partition_root}" ]
then
	frobulator.err "Expected partitions not found" "[ '${path_partition_boot}' '${path_partition_root}' ]"

	exit 1
fi

# mount

# mount newly written boot partition - cloud-init reads the first boot configuration from it

frobulator.directory "${directory_mount_boot}"

mount "${path_partition_boot}" "${directory_mount_boot}"

frobulator.complete

# user, ssh and hostname - cloud-init user data

# password stored as a sha-512 hash

hash_password_user=$(echo "${password_user}" | openssl passwd -6 -stdin)

cat <<- FILE > "${directory_mount_boot}/${file_user_data}"
#cloud-config
hostname: ${name_host}
manage_etc_hosts: true
timezone: ${zone_time}
users:
  - name: ${name_user}
    groups: users,adm,dialout,audio,netdev,video,plugdev,cdrom,games,input,gpio,spi,i2c,render,sudo
    shell: /bin/bash
    lock_passwd: false
    passwd: ${hash_password_user}
enable_ssh: true
ssh_pwauth: true
FILE

frobulator.complete

# standard home directories - desktop documents downloads music pictures public templates videos
# lite image has no desktop session to create them

list_packages=(
	"${package_xdg}"
)

list_commands=(
	"[ su, -, \"${name_user}\", -c, xdg-user-dirs-update ]"
)

# ssh - also enabled by the boot partition marker file - independent of cloud-init

touch "${directory_mount_boot}/${file_ssh_marker}"

frobulator.complete

# wifi - cloud-init network configuration - country unblocks the radio

# ssid and password quoted for yaml - backslashes and double quotes escaped

text_ssid_wifi="${ssid_wifi//\\/\\\\}"
text_ssid_wifi="${text_ssid_wifi//\"/\\\"}"

text_password_wifi="${password_wifi//\\/\\\\}"
text_password_wifi="${text_password_wifi//\"/\\\"}"

cat <<- FILE > "${directory_mount_boot}/${file_network_config}"
network:
  version: 2
  wifis:
    wlan0:
      dhcp4: true
      optional: true
      regulatory-domain: "${country_wifi}"
      access-points:
        "${text_ssid_wifi}":
          password: "${text_password_wifi}"
FILE

frobulator.complete

# power supply - geeekpi ups plus ep-0136 - battery monitor installed on first boot

# ups plus battery gauge - four blue leds - led1 first lit at low charge - blink at 1.5 hz

# charging - usb-c input of the ups connected
#
# | charge        | led1     | led2     | led3     | led4     |
# |---------------|----------|----------|----------|----------|
# | under 25 %    | blinking | off      | off      | off      |
# | 25 to 50 %    | on       | blinking | off      | off      |
# | 50 to 75 %    | on       | on       | blinking | off      |
# | 75 % and up   | on       | on       | on       | blinking |
# | full          | on       | on       | on       | on       |

# discharging - no input - wrong battery: parameters stored in the ups do not match the cells
#
# | charge        | led1     | led2     | led3     | led4     |
# |---------------|----------|----------|----------|----------|
# | under 25 %    | on       | off      | off      | off      |
# | 25 to 50 %    | on       | on       | off      | off      |
# | 50 to 75 %    | on       | on       | on       | off      |
# | 75 % and up   | on       | on       | on       | on       |
# | wrong battery | blinking | off      | off      | off      |

# never power the raspberry pi through its own usb-c port while the ups is fitted - it may damage the ups

if [ "${option_power_supply}" = "${model_ups}" ]
then
	frobulator.inf "Adding power supply support" "[ ${model_ups} // ups plus ]"

	# i2c - the ups controller sits on bus 1 address 0x17

	count_i2c_commented="$(grep --count "${pattern_i2c_commented}" "${directory_mount_boot}/${file_boot_config}")"
	count_i2c_enabled="$(grep --count "${pattern_i2c_enabled}" "${directory_mount_boot}/${file_boot_config}")"

	if [ "${count_i2c_commented}" -gt 0 ]
	then
		sed --in-place "s/${pattern_i2c_commented}/${line_i2c}/" "${directory_mount_boot}/${file_boot_config}"

	elif [ "${count_i2c_enabled}" -eq 0 ]
	then
		echo "${line_i2c}" >> "${directory_mount_boot}/${file_boot_config}"
	fi

	# real time clock on the board - ds1307 - address 0x68

	count_rtc="$(grep --count "${pattern_rtc}" "${directory_mount_boot}/${file_boot_config}")"

	if [ "${count_rtc}" -eq 0 ]
	then
		echo "${line_rtc}" >> "${directory_mount_boot}/${file_boot_config}"
	fi

	frobulator.complete

	frobulator.directory "${directory_mount_boot}" "${directory_power_supply}"

	# monitor - runs every 5 minutes - powers off cleanly before the ups cuts a low battery
	# polled sparingly - frequent i2c polling is suspected to stall ups charging - geeekpi/upsplus issue 36

	cat << 'MONITOR' > "${directory_mount_boot}/${directory_power_supply}/${file_monitor}"
#!/bin/bash

# geeekpi ups plus - ep-0136 - controller on i2c bus 1 address 0x17
# usage: ups-plus-monitor [status]

# ups plus battery gauge - four blue leds - led1 first lit at low charge - blink at 1.5 hz

# charging - usb-c input of the ups connected
#
# | charge        | led1     | led2     | led3     | led4     |
# |---------------|----------|----------|----------|----------|
# | under 25 %    | blinking | off      | off      | off      |
# | 25 to 50 %    | on       | blinking | off      | off      |
# | 50 to 75 %    | on       | on       | blinking | off      |
# | 75 % and up   | on       | on       | on       | blinking |
# | full          | on       | on       | on       | on       |

# discharging - no input - wrong battery: parameters stored in the ups do not match the cells
#
# | charge        | led1     | led2     | led3     | led4     |
# |---------------|----------|----------|----------|----------|
# | under 25 %    | on       | off      | off      | off      |
# | 25 to 50 %    | on       | on       | off      | off      |
# | 50 to 75 %    | on       | on       | on       | off      |
# | 75 % and up   | on       | on       | on       | on       |
# | wrong battery | blinking | off      | off      | off      |

# never power the raspberry pi through its own usb-c port while the ups is fitted - it may damage the ups

bus_i2c=1
address_ups=0x17

# battery protection - the ups cuts power below it - shutdown margin above it - millivolts

voltage_protection=3700
voltage_margin=200

# charger present above this port voltage - millivolts

voltage_charger=4000

# countdown before the ups cuts power after a shutdown - seconds

seconds_countdown=240

file_state=/run/ups-plus-monitor.state

# not root - status only - no state - no settings - no power off

state_root="false"

if [ "${EUID}" -eq 0 ]
then
	state_root="true"
fi

# value of two registers - low byte first

register_read () {

	local value_low
	local value_high

	value_low="$(i2cget -y "${bus_i2c}" "${address_ups}" "${1}" 2> /dev/null)" || return 1
	value_high="$(i2cget -y "${bus_i2c}" "${address_ups}" "$(( ${1} + 1 ))" 2> /dev/null)" || return 1

	echo "$(( value_high << 8 | value_low ))"
}

register_write () {

	i2cset -y "${bus_i2c}" "${address_ups}" "${1}" "$(( ${2} & 0xFF ))"
	i2cset -y "${bus_i2c}" "${address_ups}" "$(( ${1} + 1 ))" "$(( ${2} >> 8 & 0xFF ))"
}

voltage_battery="$(register_read 0x05)"

# state of the previous run - empty on the first

state_previous="$(cat "${file_state}" 2> /dev/null)"

# controller unreachable - logged once - not every run

if [ -z "${voltage_battery}" ]
then
	if [ "${state_root}" = "true" ] && [ "${state_previous}" != "unreachable" ]
	then
		echo "unreachable" > "${file_state}"

		logger -t ups-plus "ups not reachable - i2c bus ${bus_i2c} address ${address_ups}"
	fi

	if [ "${1}" = "status" ]
	then
		echo "ups not reachable - i2c bus ${bus_i2c} address ${address_ups}"
	fi

	exit 1
fi

voltage_usb_c="$(register_read 0x07)"
voltage_usb_micro="$(register_read 0x09)"
percent_battery="$(register_read 0x13)"

# power state - charging when either port carries a charger

state_power="battery"

if [ "${voltage_usb_c}" -gt "${voltage_charger}" ] || [ "${voltage_usb_micro}" -gt "${voltage_charger}" ]
then
	state_power="charging"
fi

if [ "${1}" = "status" ]
then
	echo "power ${state_power} - battery ${percent_battery} % // ${voltage_battery} mV - usb-c ${voltage_usb_c} mV - micro-usb ${voltage_usb_micro} mV"
fi

if [ "${state_root}" != "true" ]
then
	exit 0
fi

# protection voltage and power back on when power returns - written only when different

voltage_protection_stored="$(register_read 0x11)"
state_power_restore="$(i2cget -y "${bus_i2c}" "${address_ups}" 0x19)"
state_power_restore="$(( state_power_restore ))"

if [ "${voltage_protection_stored}" != "${voltage_protection}" ]
then
	register_write 0x11 "${voltage_protection}"
fi

if [ "${state_power_restore}" -ne 1 ]
then
	i2cset -y "${bus_i2c}" "${address_ups}" 0x19 1
fi

# power state changes logged

if [ "${state_previous}" != "${state_power}" ]
then
	echo "${state_power}" > "${file_state}"

	logger -t ups-plus "power ${state_power} - battery ${percent_battery} % // ${voltage_battery} mV"
fi

# low battery on battery power - ups power cut scheduled - system powered off before it

voltage_shutdown=$(( voltage_protection + voltage_margin ))

if [ "${state_power}" = "battery" ] && [ "${voltage_battery}" -lt "${voltage_shutdown}" ]
then
	logger -t ups-plus "battery low - ${voltage_battery} mV - powering off - ups power cut in ${seconds_countdown} seconds"

	i2cset -y "${bus_i2c}" "${address_ups}" 0x18 "${seconds_countdown}"

	systemctl poweroff
fi
