# usb gadget - the usb-c port acts as a usb network card - power and network over one cable
# the usb-a ports are on another controller - unaffected

if [ "${option_usb_gadget}" = "true" ]
then
	frobulator.inf "Adding usb gadget mode" "[ usb-c // usb0 ]"

	# controller able to act as a usb device - global section - other models keep their own lines

	count_dwc2="$(grep --count "${pattern_dwc2}" "${directory_mount_boot}/${file_boot_config}")"

	if [ "${count_dwc2}" -eq 0 ]
	then
