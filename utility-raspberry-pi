#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-d|--device)
			device="${2}"

			shift
		;;

		-u|--power-supply)
			option_power_supply="${2}"

			shift
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -d [Device] [-u Power supply] | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-d, --device          Specify target block [d]evice to write the image to."
			echo
			echo -e "                      [ /dev/sdX ]"
			echo -e "                      [ /dev/mmcblkX ]"
			echo
			echo -e "-u, --power-supply    Add [u]ninterruptible power supply support."
			echo
			echo -e "                      ep-0136    GeeekPi UPS Plus - safe shutdown on low battery."
			echo
			echo -e "-h, --help            Show [h]elp and usage information."
			echo
			echo -e "'${script}'           [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -d [Device] [-u Power supply] | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

if [ -z "${device}" ]
then
	frobulator.err "No target device specified"

	frobulator.inf "Available block devices"

	lsblk --nodeps --output NAME,SIZE,MODEL,TRAN,TYPE | grep -e "disk" -e "NAME"
	echo

	echo "Usage: ${script} -d [Device]"
	echo

	exit 1
fi

if [ ! -b "${device}" ]
then
	frobulator.err "Not a block device" "[ '${device}' ]"

	exit 1
fi

# power supply - supported models only

if [[ "${option_power_supply}" = -* ]]
then
	frobulator.err "Missing argument for '--power-supply'."

	exit 1

elif [ -n "${option_power_supply}" ] && [ "${option_power_supply}" != "ep-0136" ]
then
	frobulator.err "Unknown power supply" "[ ${option_power_supply} ]"

	exit 1
fi

# variables ────────────────────────────────────────────────────────────────────

url_image_latest="https://downloads.raspberrypi.com/raspios_lite_arm64_latest"

directory_download="${HOME}/.cache/raspberry-pi"

file_archive_image="${directory_download}/raspios_lite_arm64.img.xz"

directory_mount_boot="/mnt/raspberry-pi-boot"

# defaults ─────────────────────────────────────────────────────────────────────

name_host_default="pi"
name_user_default="${USER}"
country_wifi_default="US"

# requirements ─────────────────────────────────────────────────────────────────

list=(
	curl
	xz-utils
	parted
	util-linux
	e2fsprogs
	dosfstools
	openssl
)

frobulator.require ${list[@]}

list=()

# credentials

# prompt for and validate values required for headless setup

frobulator.inf "Headless configuration"

list_credentials=(
	"hostname"
	"username"
	"user_password"
	"wifi_ssid"
	"wifi_password"
	"wifi_country"
)

frobulator.input "${list_credentials[@]}"

for entry in "${frobulator_return[@]}"
do
	IFS='=' read -r key_entry value_entry <<< "${entry}"

	if [ "${key_entry}" = "hostname" ]
	then
		name_host="${value_entry:-${name_host_default}}"
	fi

	if [ "${key_entry}" = "username" ]
	then
		name_user="${value_entry:-${name_user_default}}"
	fi

	if [ "${key_entry}" = "user_password" ]
	then
		password_user="${value_entry}"
	fi

	if [ "${key_entry}" = "wifi_ssid" ]
	then
		ssid_wifi="${value_entry}"
	fi

	if [ "${key_entry}" = "wifi_password" ]
	then
		password_wifi="${value_entry}"
	fi

	if [ "${key_entry}" = "wifi_country" ]
	then
		country_wifi="${value_entry:-${country_wifi_default}}"
	fi

done

list_credentials_missing=()

if [ -z "${name_user}" ]
then
	list_credentials_missing+=("username")
fi

if [ -z "${password_user}" ]
then
	list_credentials_missing+=("user_password")
fi

if [ -z "${ssid_wifi}" ]
then
	list_credentials_missing+=("wifi_ssid")
fi

if [ -z "${password_wifi}" ]
then
	list_credentials_missing+=("wifi_password")
fi

if [ "${#list_credentials_missing[@]}" -gt 0 ]
then
	frobulator.err "Missing required credential(s)" "[ ${list_credentials_missing[*]} ]"

	exit 1
fi

name_host="${name_host:-${name_host_default}}"

# wifi country - two letter code - radio blocked until set

country_wifi="${country_wifi:-${country_wifi_default}}"
country_wifi="${country_wifi^^}"

# values checked before anything is written - same rules as the first boot user setup

if [[ ! "${name_host}" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$ ]]
then
	frobulator.err "Invalid hostname - letters, digits and hyphens" "[ ${name_host} ]"

	exit 1
fi

if [[ ! "${name_user}" =~ ^[a-z][a-z0-9-]{0,31}$ ]] || [ "${name_user}" = "root" ]
then
	frobulator.err "Invalid username - lower-case letters, digits and hyphens - starting with a letter" "[ ${name_user} ]"

	exit 1
fi

if [[ ! "${country_wifi}" =~ ^[A-Z]{2}$ ]]
then
	frobulator.err "Invalid wifi country - two letter code" "[ ${country_wifi} ]"

	exit 1
fi

if [ "${#password_wifi}" -lt 8 ] || [ "${#password_wifi}" -gt 63 ]
then
	frobulator.err "Invalid wifi password - 8 to 63 characters" "[ ${#password_wifi} ]"

	exit 1
fi

# download

# resolve and fetch latest image, verified against its published checksum

frobulator.directory "${directory_download}"

url_install=$(curl -s -I -L -o "${sink}" -w '%{url_effective}' "${url_image_latest}")

frobulator.inf "Resolved image" "[ ${url_install} ]"

checksum_expected=$(curl -s -L "${url_install}.sha256" | cut -d ' ' -f 1)

# checksum of the image already downloaded - empty if there is none

checksum_existing="$(sha256sum "${file_archive_image}" 2> "${sink}" | cut -d ' ' -f 1)"

if [ ! -f "${file_archive_image}" ] || [ "${checksum_existing}" != "${checksum_expected}" ]
then
	curl -L -o "${file_archive_image}" "${url_install}" &

	frobulator.progress download "[ ${url_install} ]"

	checksum_actual=$(sha256sum "${file_archive_image}" | cut -d ' ' -f 1)

	if [ -n "${checksum_expected}" ] && [ "${checksum_actual}" != "${checksum_expected}" ]
	then
		frobulator.err "Checksum verification failed"

		rm -f "${file_archive_image}"

		exit 1
	fi

	frobulator.scs "Checksum verified"
else
	frobulator.wrn "Already downloaded and verified"
fi

# confirmation

# require device path to be retyped before any destructive action

details_device="$(lsblk --nodeps --output NAME,SIZE,MODEL,TRAN "${device}" | tail -n 1)"

frobulator.ntf err "Destructive operation" err "This will PERMANENTLY ERASE all data on '${device}'.${NLN}${NLN}${details_device}"

frobulator.qst "Type the device path exactly to confirm" "[ ${device} ]"

read -r reply_device_confirm

if [ "${reply_device_confirm}" != "${device}" ]
then
	frobulator.err "Confirmation did not match - aborting"

	exit 1
fi

# unmount

# clear any partitions already mounted from target device

for partition in "${device}"*
do
	if [ "${partition}" != "${device}" ]
	then
		umount "${partition}" 2> "${sink}"
	fi
done

# write

# decompress and write image directly to device

frobulator.inf "Writing image" "[ ${device} ]"

xz -dc "${file_archive_image}" | dd of="${device}" bs=4M iflag=fullblock conv=fsync status=progress oflag=direct

# exit status of both sides of the pipe - read before any other command

list_status_write=("${PIPESTATUS[@]}")

if [ "${list_status_write[0]}" -ne 0 ] || [ "${list_status_write[1]}" -ne 0 ]
then
	frobulator.err "Image write failed" "[ xz // ${list_status_write[0]} ] [ dd // ${list_status_write[1]} ]"

	exit 1
fi

sync

partprobe "${device}" 2> "${sink}"

udevadm settle

sleep 2

# partition naming

# resolve partition suffixes, which differ between /dev/sdX and mmcblk/nvme devices

if [[ "${device}" =~ (mmcblk|nvme) ]]
then
	path_partition_boot="${device}p1"
	path_partition_root="${device}p2"
else
	path_partition_boot="${device}1"
	path_partition_root="${device}2"
fi

if [ ! -b "${path_partition_boot}" ] || [ ! -b "${path_partition_root}" ]
then
	frobulator.err "Expected partitions not found" "[ '${path_partition_boot}' '${path_partition_root}' ]"

	exit 1
fi

# mount

# mount newly written boot partition - cloud-init reads the first boot configuration from it

frobulator.directory "${directory_mount_boot}"

mount "${path_partition_boot}" "${directory_mount_boot}"

frobulator.complete

# user, ssh and hostname - cloud-init user data

# password stored as a sha-512 hash

hash_password_user=$(echo "${password_user}" | openssl passwd -6 -stdin)

cat <<- FILE > "${directory_mount_boot}"/user-data
#cloud-config
hostname: ${name_host}
manage_etc_hosts: true
users:
  - name: ${name_user}
    groups: users,adm,dialout,audio,netdev,video,plugdev,cdrom,games,input,gpio,spi,i2c,render,sudo
    shell: /bin/bash
    lock_passwd: false
    passwd: ${hash_password_user}
enable_ssh: true
ssh_pwauth: true
FILE

frobulator.complete

# ssh - also enabled by the boot partition marker file - independent of cloud-init

touch "${directory_mount_boot}"/ssh

frobulator.complete

# wifi - cloud-init network configuration - country unblocks the radio

# ssid and password quoted for yaml - backslashes and double quotes escaped

text_ssid_wifi="${ssid_wifi//\\/\\\\}"
text_ssid_wifi="${text_ssid_wifi//\"/\\\"}"

text_password_wifi="${password_wifi//\\/\\\\}"
text_password_wifi="${text_password_wifi//\"/\\\"}"

cat <<- FILE > "${directory_mount_boot}"/network-config
network:
  version: 2
  wifis:
    wlan0:
      dhcp4: true
      optional: true
      regulatory-domain: "${country_wifi}"
      access-points:
        "${text_ssid_wifi}":
          password: "${text_password_wifi}"
FILE

frobulator.complete

# power supply - geeekpi ups plus ep-0136 - battery monitor installed on first boot

if [ "${option_power_supply}" = "ep-0136" ]
then
	frobulator.inf "Adding power supply support" "[ ep-0136 // ups plus ]"

	# i2c - the ups controller sits on bus 1 address 0x17

	if [ "$(grep -c '^#dtparam=i2c_arm=on' "${directory_mount_boot}"/config.txt)" -gt 0 ]
	then
		sed -i 's/^#dtparam=i2c_arm=on/dtparam=i2c_arm=on/' "${directory_mount_boot}"/config.txt

	elif [ "$(grep -c '^dtparam=i2c_arm=on' "${directory_mount_boot}"/config.txt)" -eq 0 ]
	then
		echo "dtparam=i2c_arm=on" >> "${directory_mount_boot}"/config.txt
	fi

	# real time clock on the board - ds1307 - address 0x68

	if [ "$(grep -c '^dtoverlay=i2c-rtc,ds1307' "${directory_mount_boot}"/config.txt)" -eq 0 ]
	then
		echo "dtoverlay=i2c-rtc,ds1307" >> "${directory_mount_boot}"/config.txt
	fi

	frobulator.complete

	frobulator.directory "${directory_mount_boot}" power-supply

	# monitor - runs every minute - powers off cleanly before the ups cuts a low battery

	cat << 'MONITOR' > "${directory_mount_boot}"/power-supply/ups-plus-monitor
#!/bin/bash

# geeekpi ups plus - ep-0136 - controller on i2c bus 1 address 0x17
# usage: ups-plus-monitor [status]

bus_i2c=1
address_ups=0x17

# battery protection - the ups cuts power below it - shutdown margin above it - millivolts

voltage_protection=3700
voltage_margin=200

# charger present above this port voltage - millivolts

voltage_charger=4000

# countdown before the ups cuts power after a shutdown - seconds

seconds_countdown=240

file_state=/run/ups-plus-monitor.state

# not root - status only - no state - no settings - no power off

state_root="false"

if [ "${EUID}" -eq 0 ]
then
	state_root="true"
fi

# value of two registers - low byte first

register_read () {

	local value_low
	local value_high

	value_low="$(i2cget -y "${bus_i2c}" "${address_ups}" "${1}" 2> /dev/null)" || return 1
	value_high="$(i2cget -y "${bus_i2c}" "${address_ups}" "$(( ${1} + 1 ))" 2> /dev/null)" || return 1

	echo "$(( value_high << 8 | value_low ))"
}

register_write () {

	i2cset -y "${bus_i2c}" "${address_ups}" "${1}" "$(( ${2} & 0xFF ))"
	i2cset -y "${bus_i2c}" "${address_ups}" "$(( ${1} + 1 ))" "$(( ${2} >> 8 & 0xFF ))"
}

voltage_battery="$(register_read 0x05)"

# controller unreachable - logged once - not every minute

if [ -z "${voltage_battery}" ]
then
	if [ "${state_root}" = "true" ] && [ "$(cat "${file_state}" 2> /dev/null)" != "unreachable" ]
	then
		echo "unreachable" > "${file_state}"

		logger -t ups-plus "ups not reachable - i2c bus ${bus_i2c} address ${address_ups}"
	fi

	if [ "${1}" = "status" ]
	then
		echo "ups not reachable - i2c bus ${bus_i2c} address ${address_ups}"
	fi

	exit 1
fi

voltage_usb_c="$(register_read 0x07)"
voltage_usb_micro="$(register_read 0x09)"
percent_battery="$(register_read 0x13)"

# power state - charging when either port carries a charger

state_power="battery"

if [ "${voltage_usb_c}" -gt "${voltage_charger}" ] || [ "${voltage_usb_micro}" -gt "${voltage_charger}" ]
then
	state_power="charging"
fi

if [ "${1}" = "status" ]
then
	echo "power ${state_power} - battery ${percent_battery} % // ${voltage_battery} mV - usb-c ${voltage_usb_c} mV - micro-usb ${voltage_usb_micro} mV"
fi

if [ "${state_root}" != "true" ]
then
	exit 0
fi

# protection voltage and power back on when power returns - written only when different

if [ "$(register_read 0x11)" != "${voltage_protection}" ]
then
	register_write 0x11 "${voltage_protection}"
fi

if [ "$(( $(i2cget -y "${bus_i2c}" "${address_ups}" 0x19) ))" -ne 1 ]
then
	i2cset -y "${bus_i2c}" "${address_ups}" 0x19 1
fi

# power state changes logged

if [ "$(cat "${file_state}" 2> /dev/null)" != "${state_power}" ]
then
	echo "${state_power}" > "${file_state}"

	logger -t ups-plus "power ${state_power} - battery ${percent_battery} % // ${voltage_battery} mV"
fi

# low battery on battery power - ups power cut scheduled - system powered off before it

if [ "${state_power}" = "battery" ] && [ "${voltage_battery}" -lt "$(( voltage_protection + voltage_margin ))" ]
then
	logger -t ups-plus "battery low - ${voltage_battery} mV - powering off - ups power cut in ${seconds_countdown} seconds"

	i2cset -y "${bus_i2c}" "${address_ups}" 0x18 "${seconds_countdown}"

	systemctl poweroff
fi
MONITOR

	frobulator.complete

	cat << 'SERVICE' > "${directory_mount_boot}"/power-supply/ups-plus-monitor.service
[Unit]
Description=UPS Plus battery monitor - safe shutdown on low battery

[Service]
Type=oneshot
ExecStart=/usr/local/bin/ups-plus-monitor
SERVICE

	frobulator.complete

	cat << 'TIMER' > "${directory_mount_boot}"/power-supply/ups-plus-monitor.timer
[Unit]
Description=UPS Plus battery monitor - every minute

[Timer]
OnBootSec=1min
OnUnitActiveSec=1min

[Install]
WantedBy=timers.target
TIMER

	frobulator.complete

	# first boot - i2c tools and module - monitor installed and enabled

	cat <<- FILE >> "${directory_mount_boot}"/user-data
packages:
  - i2c-tools
runcmd:
  - [ sh, -c, "echo i2c-dev > /etc/modules-load.d/i2c-dev.conf && modprobe i2c-dev" ]
  - [ install, -m, "0755", /boot/firmware/power-supply/ups-plus-monitor, /usr/local/bin/ups-plus-monitor ]
  - [ install, -m, "0644", /boot/firmware/power-supply/ups-plus-monitor.service, /etc/systemd/system/ups-plus-monitor.service ]
  - [ install, -m, "0644", /boot/firmware/power-supply/ups-plus-monitor.timer, /etc/systemd/system/ups-plus-monitor.timer ]
  - [ systemctl, daemon-reload ]
  - [ systemctl, enable, --now, ups-plus-monitor.timer ]
FILE

	frobulator.complete
fi

# unmount

# flush writes and detach boot partition

sync

umount "${directory_mount_boot}"

frobulator.complete

frobulator.result "${script}"

frobulator.scs "Boot device ready" "[ ${device} ]"
