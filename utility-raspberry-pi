#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (($#))
do
	case "${1}"
	in
		-d|--device)
			device="${2}"

			shift
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -d [Device] | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-d, --device    Specify target block [d]evice to write the image to."
			echo
			echo -e "                [ /dev/sdX ]"
			echo -e "                [ /dev/mmcblkX ]"
			echo
			echo -e "-h, --help      Show [h]elp and usage information."
			echo
			echo -e "'${script}'     [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -d [Device] | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

if [ -z "${device}" ]
then
	frobulator.err "No target device specified"

	frobulator.inf "Available block devices"

	lsblk --nodeps --output NAME,SIZE,MODEL,TRAN,TYPE | grep -e "disk" -e "NAME"
	echo

	echo "Usage: ${script} -d [Device]"
	echo

	exit 1
fi

if [ ! -b "${device}" ]
then
	frobulator.err "Not a block device" "[ '${device}' ]"

	exit 1
fi

# variables ────────────────────────────────────────────────────────────────────

image_url_latest="https://downloads.raspberrypi.com/raspios_lite_arm64_latest"

download_directory="${HOME}/.cache/raspberry-pi"

image_archive="${download_directory}/raspios_lite_arm64.img.xz"

mount_boot="/mnt/raspberry-pi-boot"
mount_root="/mnt/raspberry-pi-root"

# defaults ─────────────────────────────────────────────────────────────────────

hostname_default="pi"
username_default="${USER}"
wifi_country_default="US"

address_localhost="127.0.1.1"

# requirements ─────────────────────────────────────────────────────────────────

list=(
	curl
	xz-utils
	parted
	util-linux
	e2fsprogs
	dosfstools
	uuid-runtime
	openssl
)

frobulator.require ${list[@]}

list=()

# credentials

# prompt for and validate values required for headless setup

frobulator.inf "Headless configuration"

credentials_list=(
	"hostname"
	"username"
	"user_password"
	"wifi_ssid"
	"wifi_password"
)

frobulator.input "${credentials_list[@]}"

for entry in "${frobulator_return[@]}"
do
	IFS='=' read -r entry_key entry_value <<< "${entry}"

	if [ "${entry_key}" = "hostname" ]
	then
		hostname="${entry_value:-${hostname_default}}"
	fi

	if [ "${entry_key}" = "username" ]
	then
		username="${entry_value:-${username_default}}"
	fi

	if [ "${entry_key}" = "user_password" ]
	then
		user_password="${entry_value}"
	fi

	if [ "${entry_key}" = "wifi_ssid" ]
	then
		wifi_ssid="${entry_value}"
	fi

	if [ "${entry_key}" = "wifi_password" ]
	then
		wifi_password="${entry_value}"
	fi

done

credentials_missing_list=()

if [ -z "${username}" ]
then
	credentials_missing_list+=("username")
fi

if [ -z "${user_password}" ]
then
	credentials_missing_list+=("user_password")
fi

if [ -z "${wifi_ssid}" ]
then
	credentials_missing_list+=("wifi_ssid")
fi

if [ -z "${wifi_password}" ]
then
	credentials_missing_list+=("wifi_password")
fi

if [ "${#credentials_missing_list[@]}" -gt 0 ]
then
	frobulator.err "Missing required credential(s)" "[ ${credentials_missing_list[*]} ]"

	exit 1
fi

hostname="${hostname:-${hostname_default}}"

# download

# resolve and fetch latest image, verified against its published checksum

frobulator.directory "${download_directory}"

url_install=$(curl -s -I -L -o "${sink}" -w '%{url_effective}' "${image_url_latest}")

frobulator.inf "Resolved image" "[ ${url_install} ]"

checksum_expected=$(curl -s -L "${url_install}.sha256" | cut -d ' ' -f 1)

# checksum of the image already downloaded - empty if there is none

checksum_existing="$(sha256sum "${image_archive}" 2> "${sink}" | cut -d ' ' -f 1)"

if [ ! -f "${image_archive}" ] || [ "${checksum_existing}" != "${checksum_expected}" ]
then
	curl -L -o "${image_archive}" "${url_install}" &

	frobulator.progress download "[ ${url_install} ]"

	checksum_actual=$(sha256sum "${image_archive}" | cut -d ' ' -f 1)

	if [ -n "${checksum_expected}" ] && [ "${checksum_actual}" != "${checksum_expected}" ]
	then
		frobulator.err "Checksum verification failed"

		rm -f "${image_archive}"

		exit 1
	fi

	frobulator.scs "Checksum verified"
else
	frobulator.wrn "Already downloaded and verified"
fi

# confirmation

# require device path to be retyped before any destructive action

device_details="$(lsblk --nodeps --output NAME,SIZE,MODEL,TRAN "${device}" | tail -n 1)"

frobulator.ntf err "Destructive operation" err "This will PERMANENTLY ERASE all data on '${device}'.${NLN}${NLN}${device_details}"

frobulator.qst "Type the device path exactly to confirm" "[ ${device} ]"

read -r device_confirm

if [ "${device_confirm}" != "${device}" ]
then
	frobulator.err "Confirmation did not match - aborting"

	exit 1
fi

# unmount

# clear any partitions already mounted from target device

for partition in "${device}"*
do
	if [ "${partition}" != "${device}" ]
	then
		umount "${partition}" 2> "${sink}"
	fi
done

# write

# decompress and write image directly to device

frobulator.inf "Writing image" "[ ${device} ]"

xz -dc "${image_archive}" | dd of="${device}" bs=4M conv=fsync status=progress oflag=direct

sync

partprobe "${device}" 2> "${sink}"

udevadm settle

sleep 2

# partition naming

# resolve partition suffixes, which differ between /dev/sdX and mmcblk/nvme devices

if [[ "${device}" =~ (mmcblk|nvme) ]]
then
	partition_boot="${device}p1"
	partition_root="${device}p2"
else
	partition_boot="${device}1"
	partition_root="${device}2"
fi

if [ ! -b "${partition_boot}" ] || [ ! -b "${partition_root}" ]
then
	frobulator.err "Expected partitions not found" "[ '${partition_boot}' '${partition_root}' ]"

	exit 1
fi

# mount

# mount newly written boot and root partitions

frobulator.directory "${mount_boot}"
frobulator.directory "${mount_root}"

mount "${partition_boot}" "${mount_boot}"
mount "${partition_root}" "${mount_root}"

frobulator.complete

# ssh

# enable sshd on first boot

touch "${mount_boot}"/ssh

frobulator.complete

# user

# create default user account with a hashed password

user_password_hash=$(echo "${user_password}" | openssl passwd -6 -stdin)

echo "${username}:${user_password_hash}" > "${mount_boot}"/userconf.txt

frobulator.complete

# wifi (NetworkManager - wpa_supplicant.conf no longer works on Bookworm)

# write a network connection profile directly into rootfs partition

frobulator.directory "${mount_root}"/etc/NetworkManager/system-connections

connection_uuid="$(uuidgen)"

cat <<- FILE > "${mount_root}"/etc/NetworkManager/system-connections/preconfigured.nmconnection
[connection]
id=preconfigured
uuid=${connection_uuid}
type=wifi

[wifi]
mode=infrastructure
ssid=${wifi_ssid}

[wifi-security]
key-mgmt=wpa-psk
psk=${wifi_password}

[ipv4]
method=auto

[ipv6]
method=auto
addr-gen-mode=default

[proxy]
FILE

chmod 600 "${mount_root}"/etc/NetworkManager/system-connections/preconfigured.nmconnection

frobulator.complete

# hostname

# set system hostname and its matching /etc/hosts entry

echo "${hostname}" > "${mount_root}"/etc/hostname

sed -i "s/${address_localhost}.*/${address_localhost}\t${hostname}/" "${mount_root}"/etc/hosts

frobulator.complete

# unmount

# flush writes and detach both partitions

sync

umount "${mount_boot}"
umount "${mount_root}"

frobulator.complete

frobulator.result "${script}"

frobulator.scs "Boot device ready" "[ ${device} ]"
