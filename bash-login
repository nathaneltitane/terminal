#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

frobulator="${HOME}"/.local/bin/frobulator

# frobulator next to linked files

directory_shell="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"

if [ -f "${directory_shell}"/frobulator ]
then
	frobulator="${directory_shell}"/frobulator
fi

source "${frobulator}"

# superuser ────────────────────────────────────────────────────────────────────

# script ───────────────────────────────────────────────────────────────────────

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-21"

# variables ────────────────────────────────────────────────────────────────────

directory_install="${HOME}/.local/bin"
directory_dextop="${HOME}/.dextop"
file_release="/etc/os-release"
file_pulse_client="/etc/pulse/client.conf"
file_environment="dextop-environment"
file_checkpoint="dextop-settings-checkpoint"
file_update="dextop-update"
file_audio="dextop-audio"
file_settings="${directory_install}/container-settings"
mode_install="install"
value_audio="audio"
keyword_update="update"
keyword_dextop="dextop"
keyword_shell="shell"
keyword_utility="utility"
keyword_all="all"
name_process_proot="proot"
name_process_pulseaudio="pulseaudio"
name_module_tcp="module-native-protocol-tcp"
host_loopback="127.0.0.1"
state_daemonize="true"
time_idle_exit="-1"
value_anonymous="1"
setting_pulse_server="default-server = ${host_loopback}"
setting_pulse_localhost="auto-connect-localhost = yes"
setting_pulse_spawn="autospawn = no"

# defaults ─────────────────────────────────────────────────────────────────────

self="${BASH_SOURCE[0]}"

# usage ────────────────────────────────────────────────────────────────────────

# executed directly: install only

if [[ "${self}" = "${0}" ]]
then
	script="$(basename -- "${self}")"

	while (( $# ))
	do
		case "${1}"
		in
			-i|--install)
				option="${mode_install}"
			;;

			-h|--help)
				echo
				echo -e "Usage: ./${script} -i | -h"
				echo
				echo -e "Options:"
				echo
				echo -e "-i, --install    Run [i]nstallation of ${script} to ${directory_install}."
				echo
				echo -e "-h, --help       Show [h]elp and usage information."
				echo
				echo -e "'${script}'      [ Version // ${version} ]"
				echo

				exit
			;;

			"")
				# handle empty argument:
				# use default values specified in script

				:
			;;

			*)
				echo
				echo -e "Usage: ./${script} -i | -h"
				echo
				echo -e "Unknown option: '${script} ${1}':"
				echo -e "Type './${script} -h' for help and usage information."
				echo

				exit 1

			;;

			esac

		shift

	done

	# default to install

	if [ -z "${option}" ]
	then
		option="${mode_install}"
	fi

	# install

	if [ "${option}" = "${mode_install}" ]
	then
		# blank line - output separated from the shell prompt

		echo

		file_script="$(realpath "${self}")"

		directory_script="$(dirname "${file_script}")"

		if [ "${directory_script}" -ef "${directory_install}" ]
		then
			frobulator.inf "Already installed" "[ ${directory_install}/${script} ]"
		else
			frobulator.copy "${directory_script}" "${directory_install}" "${script}"

			frobulator.permissions public execute "${directory_install}/${script}"

			frobulator.scs "Installed" "[ ${directory_install}/${script} ]"
		fi
	fi

	exit
fi

# login ────────────────────────────────────────────────────────────────────────

if [ -n "${TERMUX_VERSION}" ]
then
	frobulator.fwd "Logging in..."
fi

# dextop ───────────────────────────────────────────────────────────────────────

if [ -n "${TERMUX_VERSION}" ]
then
	# session

	# desktop environment chosen at setup: console / i3 / xfce - empty if not set up

	name_environment="$(cat "${directory_dextop}/${file_environment}")"

	if [ -n "${name_environment}" ]
	then
		# extract session interface information

		interface_session="${name_environment}"

		# format session interface information:
		# capitalize

		interface_session=${interface_session^^}
	fi

	if [ -f "${file_release}" ]
	then
		. "${file_release}"

		name="${ID}"
		version="${VERSION_ID}"

		distribution="${name} ${version}"
	fi

	# settings

	if [ ! -f "${directory_dextop}/${file_checkpoint}" ]
	then
		frobulator.fwd "Setting up..."

		dbus-launch "${file_settings}"

		frobulator.file "${directory_dextop}" "${file_checkpoint}"

		frobulator.clear
	fi

	# update

	# proot container processes - empty outside a container

	id_process_proot="$(pgrep -f "${name_process_proot}")"

	if [ -n "${id_process_proot}" ]
	then
		:
	else
		# automatic update selection: 'update' followed by dextop / shell / utility / all

		content_update_dextop="$(cat "${directory_dextop}/${file_update}")"

		if [[ "${content_update_dextop}" = *"${keyword_update}"* ]]
		then
			if [[ "${content_update_dextop}" = *"${keyword_dextop}"* ]]
			then
				dextop -u "${keyword_dextop}"
			fi

			if [[ "${content_update_dextop}" = *"${keyword_shell}"* ]]
			then
				dextop -u "${keyword_shell}"
			fi

			if [[ "${content_update_dextop}" = *"${keyword_utility}"* ]]
			then
				dextop -u "${keyword_utility}" "${keyword_all}"
			fi

			if [[ "${content_update_dextop}" = *"${keyword_all}"* ]]
			then
				dextop -u "${keyword_all}"
			fi

			frobulator.clear
		fi
	fi

	# audio

	if [ -n "${id_process_proot}" ]
	then
		echo "${setting_pulse_server}"      >  "${file_pulse_client}"
		echo "${setting_pulse_localhost}"   >> "${file_pulse_client}"
		echo "${setting_pulse_spawn}"       >> "${file_pulse_client}"
	else
		# automatic audio selection: 'audio' when enabled

		content_audio_dextop="$(cat "${directory_dextop}/${file_audio}")"

		if [ "${content_audio_dextop}" = "${value_audio}" ]
		then
			# 'pulseaudio' path - empty if not installed

			command_pulseaudio="$(command -v pulseaudio)"

			if [ -n "${command_pulseaudio}" ]
			then
				# running pulseaudio process ids - empty if stopped

				id_process_pulseaudio="$(pgrep -f "${name_process_pulseaudio}")"

				if [ -n "${id_process_pulseaudio}" ]
				then
					:
				else
					# start pulseaudio and daemonize

					pulseaudio									\
						--start									\
						--daemonize="${state_daemonize}"		\
						--exit-idle-time="${time_idle_exit}"

					# initialize transmission control protocol

					pacmd											\
						load-module									\
							"${name_module_tcp}"					\
								auth-ip-acl="${host_loopback}"		\
								auth-anonymous="${value_anonymous}"
				fi
			fi
		fi
	fi
fi

unset command_pulseaudio name_environment id_process_proot content_update_dextop content_audio_dextop id_process_pulseaudio directory_install directory_dextop file_release file_pulse_client file_environment file_checkpoint file_update file_audio file_settings mode_install value_audio keyword_update keyword_dextop keyword_shell keyword_utility keyword_all name_process_proot name_process_pulseaudio name_module_tcp host_loopback state_daemonize time_idle_exit value_anonymous setting_pulse_server setting_pulse_localhost setting_pulse_spawn
