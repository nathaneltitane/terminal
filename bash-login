#!/bin/bash

# dependencies /////////////////////////////////////////////////////////////////

frobulator="${HOME}"/.local/bin/frobulator

source "${frobulator}"

# superuser ////////////////////////////////////////////////////////////////////

# script ///////////////////////////////////////////////////////////////////////

# version //////////////////////////////////////////////////////////////////////

version="2026-09-20"

# defaults /////////////////////////////////////////////////////////////////////

self="${BASH_SOURCE[0]}"

# usage ////////////////////////////////////////////////////////////////////////

# executed directly (not sourced as a dotfile): installation only

if [[ "${self}" = "${0}" ]]
then
	script="$(basename -- "${self}")"

	directory_install="${HOME}"/.local/bin

	while (($#))
	do
		case "${1}"
		in
			-i|--install)
				option="install"
			;;

			-h|--help)
				echo
				echo -e "Usage: ./${script} -i | -h"
				echo
				echo -e "Options:"
				echo
				echo -e "-i, --install    Run [i]nstallation of ${script} to ${directory_install}."
				echo
				echo -e "-h, --help       Show [h]elp and usage information."
				echo
				echo -e "'${script}'      [ Version // ${version} ]"
				echo

				exit
			;;

			"")
				# handle empty argument:
				# use default values specified in script

				:
			;;

			*)
				echo
				echo -e "Usage: ./${script} -i | -h"
				echo
				echo -e "Unknown option: '${script} ${1}':"
				echo -e "Type './${script} -h' for help and usage information."
				echo

				exit 1

			;;

			esac

		shift

	done

	# default to install when run without arguments

	if [ -z "${option}" ]
	then
		option="install"
	fi

	# install

	if [ "${option}" = "install" ]
	then
		file_script="$(realpath "${self}")"

		directory_script="$(dirname "${file_script}")"

		if [ "${directory_script}" -ef "${directory_install}" ]
		then
			frobulator.inf "Already installed" "[ ${directory_install}/${script} ]"
			echo
		else
			frobulator.copy "${directory_script}" "${directory_install}" "${script}"

			frobulator.permissions public execute "${directory_install}/${script}"

			frobulator.scs "Installed" "[ ${directory_install}/${script} ]"
			echo
		fi
	fi

	exit
fi

# login ////////////////////////////////////////////////////////////////////////

if [ -n "${TERMUX_VERSION}" ]
then
	frobulator.fwd "Logging in..."
	echo
fi

# dextop ///////////////////////////////////////////////////////////////////////

if [ -n "${TERMUX_VERSION}" ]
then
	# session

	if [[ $(cat "${HOME}"/.dextop/dextop-environment) ]]
	then
		# extract session interface information

		session_interface=$(cat "${HOME}"/.dextop/dextop-environment)

		# format session interface information:
		# capitalize

		session_interface=${session_interface^^}
	fi

	if [ -f /etc/os-release ]
	then
		. /etc/os-release

		name="${ID}"
		version="${VERSION_ID}"

		distribution="${name} ${version}"
	fi

	# settings

	if [ ! -f "${HOME}"/.dextop/dextop-settings-checkpoint ]
	then
		frobulator.fwd "Setting up..."
		echo

		dbus-launch "${HOME}"/.local/bin/container-settings

		frobulator.file "${HOME}"/.dextop dextop-settings-checkpoint

		frobulator.clear
	fi

	# update

	if [[ $(pgrep -f proot) ]]
	then
		:
	else
		if [[ $(cat "${HOME}"/.dextop/dextop-update) = *update* ]]
		then
			if [[ $(cat "${HOME}"/.dextop/dextop-update) = *dextop* ]]
			then
				dextop -u dextop
			fi

			if [[ $(cat "${HOME}"/.dextop/dextop-update) = *shell* ]]
			then
				dextop -u shell
			fi

			if [[ $(cat "${HOME}"/.dextop/dextop-update) = *utility* ]]
			then
				dextop -u utility all
			fi

			if [[ $(cat "${HOME}"/.dextop/dextop-update) = *all* ]]
			then
				dextop -u all
			fi

			frobulator.clear
		fi
	fi

	# audio

	if [[ $(pgrep -f proot) ]]
	then
		echo 'default-server = 127.0.0.1'   >  /etc/pulse/client.conf
		echo 'auto-connect-localhost = yes' >> /etc/pulse/client.conf
		echo 'autospawn = no'               >> /etc/pulse/client.conf
	else
		if [[ $(cat "${HOME}"/.dextop/dextop-audio) = "audio" ]]
		then
			if [[ $(command -v pulseaudio) ]]
			then
				if [[ $(pgrep -f pulseaudio) ]]
				then
					:
				else
					# start pulseaudio and daemonize

					pulseaudio					\
						--start					\
						--daemonize=true		\
						--exit-idle-time=-1

					# initialize transmission control protocol

					pacmd								\
						load-module						\
							module-native-protocol-tcp	\
								auth-ip-acl=127.0.0.1	\
								auth-anonymous=1
				fi
			fi
		fi
	fi
fi
