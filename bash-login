#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

frobulator="${HOME}"/.local/bin/frobulator

source "${frobulator}"

# superuser ────────────────────────────────────────────────────────────────────

# script ───────────────────────────────────────────────────────────────────────

# version ──────────────────────────────────────────────────────────────────────

version="2026-09-20"

# defaults ─────────────────────────────────────────────────────────────────────

self="${BASH_SOURCE[0]}"

# usage ────────────────────────────────────────────────────────────────────────

# executed directly: install only

if [[ "${self}" = "${0}" ]]
then
	script="$(basename -- "${self}")"

	directory_install="${HOME}"/.local/bin

	while (( $# ))
	do
		case "${1}"
		in
			-i|--install)
				option="install"
			;;

			-h|--help)
				echo
				echo -e "Usage: ./${script} -i | -h"
				echo
				echo -e "Options:"
				echo
				echo -e "-i, --install    Run [i]nstallation of ${script} to ${directory_install}."
				echo
				echo -e "-h, --help       Show [h]elp and usage information."
				echo
				echo -e "'${script}'      [ Version // ${version} ]"
				echo

				exit
			;;

			"")
				# handle empty argument:
				# use default values specified in script

				:
			;;

			*)
				echo
				echo -e "Usage: ./${script} -i | -h"
				echo
				echo -e "Unknown option: '${script} ${1}':"
				echo -e "Type './${script} -h' for help and usage information."
				echo

				exit 1

			;;

			esac

		shift

	done

	# default to install

	if [ -z "${option}" ]
	then
		option="install"
	fi

	# install

	if [ "${option}" = "install" ]
	then
		# blank line - output separated from the shell prompt

		echo

		file_script="$(realpath "${self}")"

		directory_script="$(dirname "${file_script}")"

		if [ "${directory_script}" -ef "${directory_install}" ]
		then
			frobulator.inf "Already installed" "[ ${directory_install}/${script} ]"
		else
			frobulator.copy "${directory_script}" "${directory_install}" "${script}"

			frobulator.permissions public execute "${directory_install}/${script}"

			frobulator.scs "Installed" "[ ${directory_install}/${script} ]"
		fi
	fi

	exit
fi

# login ────────────────────────────────────────────────────────────────────────

if [ -n "${TERMUX_VERSION}" ]
then
	frobulator.fwd "Logging in..."
fi

# dextop ───────────────────────────────────────────────────────────────────────

if [ -n "${TERMUX_VERSION}" ]
then
	# session

	# desktop environment chosen at setup: console / i3 / xfce - empty if not set up

	name_environment="$(cat "${HOME}"/.dextop/dextop-environment)"

	if [ -n "${name_environment}" ]
	then
		# extract session interface information

		interface_session="${name_environment}"

		# format session interface information:
		# capitalize

		interface_session=${interface_session^^}
	fi

	if [ -f /etc/os-release ]
	then
		. /etc/os-release

		name="${ID}"
		version="${VERSION_ID}"

		distribution="${name} ${version}"
	fi

	# settings

	if [ ! -f "${HOME}"/.dextop/dextop-settings-checkpoint ]
	then
		frobulator.fwd "Setting up..."

		dbus-launch "${HOME}"/.local/bin/container-settings

		frobulator.file "${HOME}"/.dextop dextop-settings-checkpoint

		frobulator.clear
	fi

	# update

	# proot container processes - empty outside a container

	id_process_proot="$(pgrep -f proot)"

	if [ -n "${id_process_proot}" ]
	then
		:
	else
		# automatic update selection: 'update' followed by dextop / shell / utility / all

		content_update_dextop="$(cat "${HOME}"/.dextop/dextop-update)"

		if [[ "${content_update_dextop}" = *update* ]]
		then
			if [[ "${content_update_dextop}" = *dextop* ]]
			then
				dextop -u dextop
			fi

			if [[ "${content_update_dextop}" = *shell* ]]
			then
				dextop -u shell
			fi

			if [[ "${content_update_dextop}" = *utility* ]]
			then
				dextop -u utility all
			fi

			if [[ "${content_update_dextop}" = *all* ]]
			then
				dextop -u all
			fi

			frobulator.clear
		fi
	fi

	# audio

	if [ -n "${id_process_proot}" ]
	then
		echo 'default-server = 127.0.0.1'   >  /etc/pulse/client.conf
		echo 'auto-connect-localhost = yes' >> /etc/pulse/client.conf
		echo 'autospawn = no'               >> /etc/pulse/client.conf
	else
		# automatic audio selection: 'audio' when enabled

		content_audio_dextop="$(cat "${HOME}"/.dextop/dextop-audio)"

		if [ "${content_audio_dextop}" = "audio" ]
		then
			# 'pulseaudio' path - empty if not installed

			command_pulseaudio="$(command -v pulseaudio)"

			if [ -n "${command_pulseaudio}" ]
			then
				# running pulseaudio process ids - empty if stopped

				id_process_pulseaudio="$(pgrep -f pulseaudio)"

				if [ -n "${id_process_pulseaudio}" ]
				then
					:
				else
					# start pulseaudio and daemonize

					pulseaudio					\
						--start					\
						--daemonize=true		\
						--exit-idle-time=-1

					# initialize transmission control protocol

					pacmd								\
						load-module						\
							module-native-protocol-tcp	\
								auth-ip-acl=127.0.0.1	\
								auth-anonymous=1
				fi
			fi
		fi
	fi
fi

unset command_pulseaudio name_environment id_process_proot content_update_dextop content_audio_dextop id_process_pulseaudio
