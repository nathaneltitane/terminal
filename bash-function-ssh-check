#!/bin/bash

# loaded by "${HOME}"/.local/bin/bash-functions

# ssh-check ────────────────────────────────────────────────────────────────────

ssh-check () {

	local timeout_probe="0.5"
	local prefix_lan
	local index_host
	local address_host
	local status_probe

	# lan prefix - first three octets of the given address

	if [[ ! "${1}" =~ ^([0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}) ]]
	then
		frobulator.err "No lan prefix specified" "[ ssh-check 192.168.0 ]"

		return 1
	fi

	prefix_lan="${BASH_REMATCH[1]}"

	# every lan address - ssh port probed - open ones reported

	for index_host in {1..254}
	do
		address_host="${prefix_lan}.${index_host}"

		timeout "${timeout_probe}" bash -c "echo > /dev/tcp/${address_host}/22" 2> "${sink}"

		status_probe="${?}"

		if [ "${status_probe}" -eq 0 ]
		then
			frobulator.scs "SSH open" "[ ${address_host} ]"
		fi
	done
}
