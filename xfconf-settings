#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-f|--file)
			file_settings="${2}"

			shift
		;;

		-h|--help)
			echo
			echo -e "Usage: ./${script} -f [File] | -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-f, --file    Specify settings [f]ile to generate."
			echo
			echo -e "-h, --help    Show [h]elp and usage information."
			echo
			echo -e "'${script}'   [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -f [File] | -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# variables ────────────────────────────────────────────────────────────────────

format_stamp="+%m-%d-%Y-%H-%M-%S"
command_create="xfconf-query --create"
type_boolean="bool"
type_double="double"
type_integer="int"
type_string="string"
state_true="true"
state_false="false"
pattern_double='^[-+]?[0-9]+\.[0-9]*$'
pattern_integer='^[0-9]+$'
pattern_channel_header='/Channel.*/d'
channel_displays="displays"
channel_session="xfce4-session"
channel_editor="xfce4-settings-editor"
channel_manager="xfce4-settings-manager"
channel_appfinder="xfce4-appfinder"
channel_desktop="xfce4-desktop"
channel_window="xfwm4"
channel_shortcuts="xfce4-keyboard-shortcuts"
property_actions="/actions"
property_backdrop="/backdrop/screen0/monitorVNC-0/workspace"
property_rgba="/rgba"
property_names="/general/workspace_names"
property_providers="/providers"
provider_window="xfwm4"
provider_commands="commands"
value_color_default="1.0"
label_workspace="Workspace 0"
command_replace="bash -c 'xfwm4 --replace & > /dev/null 2>&1'"
count_rgba="2"
count_workspace_backdrop="8"
count_workspace_name="9"

stamp=$(date "${format_stamp}")

# defaults ─────────────────────────────────────────────────────────────────────

# validate arguments

if [ -z "${file_settings}" ]
then
	frobulator.err "Missing settings file."

	exit 1

elif [[ "${file_settings}" = -* ]]
then
	frobulator.err "Missing argument for '--file'."

	exit 1
fi

# functions ────────────────────────────────────────────────────────────────────

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(
	xfconf-query
)

frobulator.require ${list[@]}

list=()

# configuration ────────────────────────────────────────────────────────────────

# read settings

frobulator.inf "Generating" "[ ${file_settings} ]"

xfconf-query -l | sed "${pattern_channel_header}" | while read channel
do
	xfconf-query -l -v -c "${channel}" | while read property setting
	do
		# provide data type:
		# needs to be researched before making a new .xfconf file
		# “bool”   - boolean value: either 'true'or 'false'
		# “int”    - 32-bit signed integer value, in the range from -2·147·483·648 through 2·147·483·647
		# “uint”   - 32-bit unsigned integer value, in the range from 0 through 4·294·967·295
		# “int64”  - 64-bit signed integer value, in the range from -9·223·372·036·854·775·808 through 9·223·372·036·854·775·807
		# “uint64” - 64-bit unsigned integer value, in the range from 0 through 18·446·744·073·709·551·615
		# “double” - presumably a double-precision floating-point value, even though it will be stored as a fixed-point value instead, with six decimal places following the decimal point
		# “string” - character string

		# parse data types

		if [[ ${setting} = "${state_true}" ]] || [[ ${setting} = "${state_false}" ]]
		then
			type="${type_boolean}"

		elif [[ ${setting} =~ ${pattern_double} ]]
		then
			type="${type_double}"

		elif [[ ${setting} =~ ${pattern_integer} ]]
		then
			type="${type_integer}"

		else
			type="${type_string}"
		fi

		if [[ ${channel} = "${channel_displays}" ]] ||
		   [[ ${channel} = "${channel_session}" ]] ||
		   [[ ${channel} = "${channel_editor}" ]] ||
		   [[ ${channel} = "${channel_manager}" ]]
		then
			:
		else
			echo "${command_create} -c '${channel}' -p '${property}' -t ${type} -s '${setting}'"
		fi
	done

done > "${file_settings}"

# fix 'UNSUPPORTED' values:
# write essential values back into settings file

# add 'xfce4-appfinder' actions string

echo "${command_create} -c '${channel_appfinder}' -p '${property_actions}' -t ${type_string} -s ''" >> "${file_settings}"

# add workspace background settings

for (( number_rgba = 1 ; number_rgba <= count_rgba ; number_rgba ++ ))
do
	for (( number_workspace = 0 ; number_workspace <= count_workspace_backdrop ; number_workspace ++ ))
	do
		value_red="${value_color_default}"
		value_green="${value_color_default}"
		value_blue="${value_color_default}"
		value_alpha="${value_color_default}"

		unset text_command

		text_command+="${command_create}"
		text_command+=" -c '${channel_desktop}'"
		text_command+=" -p '${property_backdrop}${number_workspace}${property_rgba}${number_rgba}'"
		text_command+=" -t ${type_double} -s '${value_red}'"
		text_command+=" -t ${type_double} -s '${value_green}'"
		text_command+=" -t ${type_double} -s '${value_blue}'"
		text_command+=" -t ${type_double} -s '${value_alpha}'"

		echo ${text_command} >> "${file_settings}"
	done
done

# add workspace name settings

unset text_command

text_command+="${command_create}"
text_command+=" -c '${channel_window}'"
text_command+=" -p '${property_names}'"

for (( number_workspace = 1 ; number_workspace <= count_workspace_name ; number_workspace ++ ))
do
	text_command+=" -t ${type_string} -s '${label_workspace}${number_workspace}'"
done

echo ${text_command} >> "${file_settings}"

# add keyboard-shortcut providers

unset text_command

text_command+="${command_create}"
text_command+=" -c '${channel_shortcuts}'"
text_command+=" -p '${property_providers}'"
text_command+=" -t ${type_string} -s '${provider_window}'"
text_command+=" -t ${type_string} -s '${provider_commands}'"

echo ${text_command} >> "${file_settings}"

echo "${command_replace}" >> "${file_settings}"

frobulator.scs "Done."

frobulator.msg "Use newly generated settings file as follows:"
frobulator.msg "'bash <settings_file>'"
