#!/bin/bash

script=$(basename -- "${BASH_SOURCE[0]}")

separator=" // "
name_font="Monospace"
size_font=10
font="${name_font}:size=${size_font}"

lines=15
prompt="EXIT SESSION?"

label_cancel="CANCEL"
label_logout="LOGOUT"
label_poweroff="POWEROFF"
label_reboot="REBOOT"
format_menu="%s\n%s\n"
color_background="#000000"
color_foreground="#FFFFFF"
color_selected_background="#666666"
color_selected_foreground="#000000"

while [ "${selection}" != "${label_cancel}" ] &&
      [ "${selection}" != "${label_logout}" ] &&
      [ "${selection}" != "${label_poweroff}" ] &&
      [ "${selection}" != "${label_reboot}" ]
do
	selection=$(printf "${format_menu}" "${label_cancel}" "${label_logout}" | dmenu -i -l "${lines}" -p "${prompt}" -fn "${font}" -nb "${color_background}" -nf "${color_foreground}" -sb "${color_selected_background}" -sf "${color_selected_foreground}")

	if [ -z "${selection}" ]
	then
		exit 0
	fi
done

if [ "${selection}" = "${label_cancel}" ]
then
	exit 0
fi

if [ "${selection}" = "${label_logout}" ]
then
	i3-msg exit
fi
