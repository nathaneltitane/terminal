#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (($#))
do
	case "${1}"
	in
		-h|--help)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-h, --help    Show [h]elp and usage information."
			echo
			echo -e "'${script}'   [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# prompt ───────────────────────────────────────────────────────────────────────

# variables ────────────────────────────────────────────────────────────────────

if [ ! -d /media/internal/ ]
then
	configuration_directory="${HOME}"
else
	configuration_directory=/media/internal
fi

configuration=.dns-dynamic

use=$(cat "${configuration_directory}"/"${configuration}" | sed -n 1p)
protocol=$(cat "${configuration_directory}"/"${configuration}" | sed -n 2p)
server=$(cat "${configuration_directory}"/"${configuration}" | sed -n 3p)

login=$(cat "${configuration_directory}"/"${configuration}" | sed -n 4p)
password=$(cat "${configuration_directory}"/"${configuration}" | sed -n 5p)

process="ddclient"
service="${process}.service"

web="www"

# defaults ─────────────────────────────────────────────────────────────────────

hostname="${HOSTNAME}"

# functions ────────────────────────────────────────────────────────────────────

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(
	ddclient
)

frobulator.require ${list[@]}

list=()

# configuration ────────────────────────────────────────────────────────────────

if [ ! -e "${configuration_directory}"/"${configuration}" ]
then
	frobulator.err "Configuration file not found" "[ ${configuration} ]"

	frobulator.fwd "Aborting"

	exit 1
fi

# write ddclient configuration

cat <<- FILE > /etc/"${process}".conf
# ddclient #

daemon=300                                  # check every 5 minutes
syslog=yes                                  # log update messages to syslog
mail-failure=root                           # mail failed updates to user
pid=/var/run/ddclient.pid                   # record PID to file
ssl=yes                                     # use ssl
cache=/var/cache/ddclient/ddclient.cache    # set cache file

use=${use}
protocol=${protocol}
server=${server}

login=${login}
password=${password}

${web}
${hostname}
FILE

# reconfigure prccess handlers

sed -i -e 's|\PIDFile|#PIDFile|g' /usr/lib/systemd/system/"${process}".service

# purge service cache file

if [ -d /var/cache/"${process}" ]
then
	rm					\
		--recursive		\
		--force			 /var/cache/"${process}"/"${process}".cache
fi

# service activation

# status line if the service is running - empty otherwise

service_running="$(systemctl status "${service}" | grep -e "active.*running")"

if [ -n "${service_running}" ]
then
	frobulator.wrn "Service running" " [ ${service} ]"

	service_actions_list=(
		disable
		stop
	)
fi

service_actions_list+=(
	enable
	start
)

for service_action in ${service_actions_list[@]}
do
	systemctl "${service_action}" "${service}" > "${sink}" 2>&1 &

	frobulator.process "Service ${service_action}" "[ ${service} ]"

	sleep 1

	systemctl daemon-reload > "${sink}" 2>&1 &

	frobulator.process "Reloading"

	sleep 1
done

service_actions_list=()

# service process verification

# status lines if the service is running or inactive - empty otherwise

service_running="$(systemctl status "${service}" | grep -e "active.*running")"
service_inactive="$(systemctl status "${service}" | grep -e "inactive.*")"

if [ -n "${service_running}" ]
then
	frobulator.scs "Service activation success" "[ ${service} ]"

elif [ -n "${service_inactive}" ]
then
	frobulator.err "Service activation failed" "[ ${service} ]"

	exit 1
fi

frobulator.scs "Done"
