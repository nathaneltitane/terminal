#!/bin/bash

# dependencies ─────────────────────────────────────────────────────────────────

script="$(basename -- "${BASH_SOURCE[0]}")"

# script arguments for escalation

self_arguments=("${@}")

if [ "${frobulator_loaded}" != "true" ]
then
	echo
	echo "[  >  ] Checking..."
	echo

	# root through sudo keeps using the user's frobulator

	if [ -n "${SUDO_USER}" ]
	then
		USER="${SUDO_USER}"
		HOME="$(getent passwd "${SUDO_USER}" | cut -d ':' -f 6)"
	fi

	frobulator="${HOME}/.local/bin/frobulator"
	frobulator_download="$(mktemp)"

	mkdir -p "${HOME}/.local/bin"

	# latest release - curl or wget - local copy replaced only by a newer one

	curl -s -L -o "${frobulator_download}" get.frbltr.app 2> /dev/null ||
	wget -q -O "${frobulator_download}" get.frbltr.app 2> /dev/null

	version_online="$(grep -m 1 '^update=' "${frobulator_download}")"
	version_local="$(grep -m 1 '^update=' "${frobulator}" 2> /dev/null)"

	if [[ "${version_online}" > "${version_local}" ]]
	then
		mv -f "${frobulator_download}" "${frobulator}"

		chmod +x "${frobulator}"
	fi

	rm -f "${frobulator_download}"

	if [ ! -f "${frobulator}" ]
	then
		echo "[  !  ] Unable to fetch frobulator ── [ get.frbltr.app ]"
		echo

		exit 1
	fi

	source "${frobulator}"
fi

# superuser ────────────────────────────────────────────────────────────────────

frobulator.escalate

# script ───────────────────────────────────────────────────────────────────────

frobulator.script

# version ──────────────────────────────────────────────────────────────────────

version="2026-10-04"

# usage ────────────────────────────────────────────────────────────────────────

while (( $# ))
do
	case "${1}"
	in
		-h|--help)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Options:"
			echo
			echo -e "-h, --help    Show [h]elp and usage information."
			echo
			echo -e "'${script}'   [ Version // ${version} ]"
			echo

			exit
		;;

		"")
			# handle empty argument:
			# use default values specified in script

			:
		;;

		*)
			echo
			echo -e "Usage: ./${script} -h"
			echo
			echo -e "Unknown option: '${script} ${1}':"
			echo -e "Type './${script} -h' for help and usage information."
			echo

			exit 1

		;;

		esac

	shift

done

# prompt ───────────────────────────────────────────────────────────────────────

# variables ────────────────────────────────────────────────────────────────────

directory_media="/media/internal"
directory_home="${HOME}"
directory_etc="/etc"
directory_unit="/usr/lib/systemd/system"
directory_cache_parent="/var/cache"
package_ddclient="ddclient"
configuration=".dns-dynamic"
extension_conf=".conf"
extension_service=".service"
extension_cache=".cache"
expression_pidfile='s|\PIDFile|#PIDFile|g'
pattern_running="active.*running"
pattern_inactive="inactive.*"
delay_service="1"
index_line_use="0"
index_line_protocol="1"
index_line_server="2"
index_line_login="3"
index_line_password="4"
web="www"

process="${package_ddclient}"
service="${process}${extension_service}"

if [ ! -d "${directory_media}/" ]
then
	directory_configuration="${directory_home}"
else
	directory_configuration="${directory_media}"
fi

file_configuration="${directory_configuration}/${configuration}"
file_ddclient="${directory_etc}/${process}${extension_conf}"
file_unit="${directory_unit}/${service}"
directory_cache="${directory_cache_parent}/${process}"
file_cache="${directory_cache}/${process}${extension_cache}"

mapfile -t list_configuration < "${file_configuration}"

use="${list_configuration[index_line_use]}"
protocol="${list_configuration[index_line_protocol]}"
server="${list_configuration[index_line_server]}"

login="${list_configuration[index_line_login]}"
password="${list_configuration[index_line_password]}"

# defaults ─────────────────────────────────────────────────────────────────────

hostname="${HOSTNAME}"

# functions ────────────────────────────────────────────────────────────────────

# update ───────────────────────────────────────────────────────────────────────

# frobulator.update

# frobulator.upgrade

# requirements ─────────────────────────────────────────────────────────────────

list=(
	"${package_ddclient}"
)

frobulator.require ${list[@]}

list=()

# configuration ────────────────────────────────────────────────────────────────

if [ ! -e "${file_configuration}" ]
then
	frobulator.err "Configuration file not found" "[ ${configuration} ]"

	frobulator.fwd "Aborting"

	exit 1
fi

# write ddclient configuration

cat <<- FILE > "${file_ddclient}"
# ddclient #

daemon=300                                  # check every 5 minutes
syslog=yes                                  # log update messages to syslog
mail-failure=root                           # mail failed updates to user
pid=/var/run/ddclient.pid                   # record PID to file
ssl=yes                                     # use ssl
cache=/var/cache/ddclient/ddclient.cache    # set cache file

use=${use}
protocol=${protocol}
server=${server}

login=${login}
password=${password}

${web}
${hostname}
FILE

# reconfigure prccess handlers

sed --in-place --expression="${expression_pidfile}" "${file_unit}"

# purge service cache file

if [ -d "${directory_cache}" ]
then
	rm				\
		--recursive	\
		--force		\
					"${file_cache}"
fi

# service activation

# status line if the service is running - empty otherwise

line_service_running="$(systemctl status "${service}" | grep --regexp="${pattern_running}")"

if [ -n "${line_service_running}" ]
then
	frobulator.wrn "Service running" " [ ${service} ]"

	list_actions_service=(
		disable
		stop
	)
fi

list_actions_service+=(
	enable
	start
)

for action_service in "${list_actions_service[@]}"
do
	frobulator.background quiet process "Service ${action_service}" "[ ${service} ]" -- systemctl "${action_service}" "${service}"

	sleep "${delay_service}"

	frobulator.background quiet process "Reloading" -- systemctl daemon-reload

	sleep "${delay_service}"
done

list_actions_service=()

# service process verification

# status lines if the service is running or inactive - empty otherwise

line_service_running="$(systemctl status "${service}" | grep --regexp="${pattern_running}")"
line_service_inactive="$(systemctl status "${service}" | grep --regexp="${pattern_inactive}")"

if [ -n "${line_service_running}" ]
then
	frobulator.scs "Service activation success" "[ ${service} ]"

elif [ -n "${line_service_inactive}" ]
then
	frobulator.err "Service activation failed" "[ ${service} ]"

	exit 1
fi

frobulator.scs "Done"
